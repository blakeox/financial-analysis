{
  "name": "financial-analysis",
  "version": "0.1.1",
  "description": "Financial analysis tooling with LLM integration via MCP",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "build:web": "cd apps/web && pnpm build",
    "build:workers": "pnpm --filter @financial-analysis/web-worker run build && pnpm --filter @financial-analysis/api run build",
    "dev": "pnpm run dev:all",
    "dev:remote": "cd workers/api && pnpm run dev:remote",
    "dev:api": "cd workers/api && pnpm dev",
    "dev:web:build": "cd apps/web && pnpm build",
    "dev:web:worker": "cd workers/web && pnpm dev",
    "dev:workers": "(cd workers/api && pnpm dev) & (cd workers/web && pnpm dev) && wait",
    "dev:all": "node scripts/dev-all.mjs",
    "rebuild:ui": "pnpm --filter @financial-analysis/ui run build",
    "clean:vite:web": "rm -rf apps/web/node_modules/.vite",
    "test": "pnpm --recursive --sort --workspace-concurrency=1 run test",
    "test:smoke": "pnpm --filter @financial-analysis/api run test:smoke",
    "test:fast": "pnpm --filter @financial-analysis/analysis run test:fast && pnpm --filter \"!@financial-analysis/analysis\" run test",
    "test:slow": "pnpm --filter @financial-analysis/analysis run test:slow",
    "test:flaky": "pnpm --recursive --sort --workspace-concurrency=1 run test -- --retry=3 --grep @flaky",
    "test:chat:integration:api": "pnpm --filter @financial-analysis/api run test:chat:integration",
    "lint": "pnpm --recursive run lint",
    "format": "pnpm --recursive run format",
    "format:check": "pnpm --recursive exec prettier --check .",
    "typecheck": "pnpm --recursive run typecheck",
    "changeset": "changeset",
    "clean": "pnpm --recursive run clean",
    "smoke": "node scripts/smoke.mjs",
    "deploy:api": "cd workers/api && pnpm run deploy",
    "deploy:web": "cd workers/web && pnpm run deploy",
    "deploy:api:preview": "cd workers/api && pnpm run deploy:preview",
    "deploy:api:production": "cd workers/api && pnpm run deploy:production",
    "deploy:web:preview": "cd workers/web && pnpm run deploy:preview",
    "deploy:web:production": "cd workers/web && pnpm run deploy:production",
    "deploy:all": "pnpm run deploy:api && pnpm run deploy:web",
    "install:all": "pnpm install",
    "prepare": "lefthook install",
    "test:e2e:hmr:web": "pnpm --filter @financial-analysis/web run test:e2e:hmr"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "4.1.6",
    "astro-eslint-parser": "^1.4.0",
    "chokidar": "^5.0.0",
    "esbuild": "0.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "undici": "^8.3.0",
    "vite": "8.0.13",
    "vitest": "4.1.6",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "js-yaml": ">=4.1.1",
      "astro@<5.18.1": ">=5.18.1",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7"
    }
  }
}
