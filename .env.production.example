# Production Environment Variables
# Set these in your Cloudflare Dashboard or deployment system

# Cloudflare Account Information
CLOUDFLARE_API_TOKEN=your_production_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=cc3bb24ae3c87cff38c2be85df3dab29

# Production Configuration
NODE_ENV=production
LOG_LEVEL=warn

# API Configuration
API_BASE_URL=https://your-worker-domain.workers.dev

# Security (use strong, unique secrets)
AUTH_SECRET=production-secret-key-min-32-chars

# MCP Configuration
MCP_API_KEY=your_production_mcp_api_key
ANALYSIS_CACHE_TTL=7200

# Feature Flags
ENABLE_DEBUG_LOGGING=false
ENABLE_RATE_LIMITING=true

# Monitoring & Analytics
ENABLE_METRICS=true
ENABLE_ERROR_TRACKING=true