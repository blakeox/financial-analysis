{
  "name": "@financial-analysis/web",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "pnpm -C ../../packages/ui run build && rm -rf node_modules/.vite",
    "build": "astro build",
    "preview": "astro preview",
    "preview:clean": "node ./scripts/ensure-port-free.mjs && astro preview --port 4321 --host 127.0.0.1 --strictPort",
    "astro": "astro",
    "pretypecheck": "pnpm -C ../../packages/ui run build",
    "pretest": "pnpm -C ../../packages/analysis run build",
    "dev:prebuilt": "node ./scripts/dev-with-prebuild.mjs",
    "pretest:e2e:hmr": "pnpm -C ../../packages/analysis run build && pnpm -C ../../packages/ui run build",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "typecheck:tests": "tsc -p tsconfig.playwright.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/scripts/__tests__/",
    "test:journey": "vitest run src/scripts/__tests__/journey-tests.test.ts",
    "test:calculator": "vitest run src/scripts/__tests__/calculator-tests.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:calculator": "playwright test tests/calculator-e2e.spec.ts",
    "test:e2e:journey": "playwright test tests/journey-e2e.spec.ts",
    "test:e2e:journey-accessibility": "playwright test tests/journey-accessibility.spec.ts",
    "test:e2e:dev": "playwright test -c playwright.dev.config.ts -g 'Navbar dev HMR stability'",
    "test:e2e:hmr": "PLAYWRIGHT_DEV=1 playwright test -c playwright.dev.config.ts -g 'Navbar dev HMR stability'",
    "test:all": "node scripts/test-runner.mjs",
    "test:ci": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.6.0",
    "@financial-analysis/analysis": "workspace:*",
    "@financial-analysis/tools": "workspace:*",
    "@financial-analysis/ui": "workspace:*",
    "astro": "^5.15.8",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "happy-dom": "^20.0.10",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "4.0.9"
  }
}
