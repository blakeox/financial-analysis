{
  "name": "@financial-analysis/web",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
  "prebuild": "pnpm -C ../../packages/ui run build && rm -rf node_modules/.vite",
    "build": "astro build",
    "preview": "astro preview",
    "preview:clean": "node ./scripts/ensure-port-free.mjs && astro preview --port 4321 --host 127.0.0.1 --strictPort",
    "astro": "astro",
    "pretypecheck": "pnpm -C ../../packages/ui run build",
  "pretest": "pnpm -C ../../packages/analysis run build",
  "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "typecheck:tests": "tsc -p tsconfig.playwright.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test -c playwright.dev.config.ts -g 'Navbar dev HMR stability'",
    "test:e2e:hmr": "PLAYWRIGHT_DEV=1 playwright test -c playwright.dev.config.ts -g 'Navbar dev HMR stability'"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@astrojs/sitemap": "^3.6.0",
    "@financial-analysis/analysis": "workspace:*",
    "@financial-analysis/tools": "workspace:*",
    "@financial-analysis/ui": "workspace:*",
    "astro": "^5.15.1",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "eslint-plugin-astro": "^1.3.1",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "4.0.2"
  }
}
