---
import SEO from '../components/SEO.astro';
import ChatPanel from '../components/ChatPanel.astro';
import ToolAnalysisPanel from '../components/ToolAnalysisPanel.tsx';
import '../styles/global.css';
import ModernNavBar from '../components/ModernNavBar.astro';
import SiteFooter from '../components/site/Footer.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import { THEME_BOOT_INLINE } from '../scripts/_shared/theme';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  showNav?: boolean;
  showFooter?: boolean;
  navLinks?: { label: string; href: string }[];
  showChat?: boolean;
  showToolAnalysis?: boolean;
  keywords?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
}

const {
  title,
  description = 'Fanalyx - Professional Financial Analysis Tools',
  canonical,
  image,
  showNav = true,
  showFooter = true,
  navLinks: navLinksProp,
  showChat = true,
  showToolAnalysis = true,
  keywords,
  noindex,
  type,
} = Astro.props as Props;

const navLinks = navLinksProp ?? [
  { label: 'Home', href: '/' },
  { label: 'Models', href: '/models' },
  { label: 'Journey', href: '/journey' },
  { label: 'Agent', href: '/agent' },
  { label: 'Developers', href: '/developers' },
  { label: 'Status', href: '/status' },
];

// Determine current context for tool analysis panel
function getCurrentContext(pathname: string): string {
  const path = pathname.split('/')[1] || '';

  // Check for journey pages first
  if (path === 'journey') {
    const journeyId = pathname.split('/')[2] || '';
    return `journey-${journeyId}`;
  }

  // Direct page mappings
  const contextMap: Record<string, string> = {
    amortization: 'amortization',
    'lease-analysis': 'lease',
    'commercial-real-estate-lease': 'lease',
    'ebitda-forecasting': 'ebitda',
    'auto-loan': 'auto-loan',
    'debt-payoff': 'debt-payoff',
    'savings-goal': 'savings-goal',
    'student-loans': 'student-loans',
    retirement: 'retirement',
    budget: 'budget',
    'bond-pricing': 'bond-pricing',
    'options-pricing': 'options-pricing',
    'cash-flow': 'cash-flow',
    models: 'models',
    journey: 'general',
    '': 'general',
  };

  return contextMap[path] || 'general';
}

const currentContext = getCurrentContext(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />

    <!-- Theme Colors for Mobile Browsers -->
    <meta name="theme-color" content="#6d4aff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050816" media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-TileColor" content="#6d4aff" />

    <!-- Icons and App Manifest -->
    <link rel="icon" type="image/png" href="/fanalyx_favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/fanalyx_favicon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Security Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=()" />

    <!-- Generator Meta -->
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      url={Astro.url.href}
      canonical={canonical}
      image={image}
      keywords={keywords}
      noindex={noindex}
      type={type}
    />

    <!-- Google AdSense (prod only) -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1672390365903308"
          crossorigin="anonymous"
        />
      )
    }

    {/* Cloudflare Web Analytics (optional) */}
    {
      import.meta.env.PROD && import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token":"${import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN}"}`}
        />
      )
    }

    <!-- Theme FOUC boot — keep in sync via THEME_BOOT_INLINE (#376) -->
    <script is:inline set:html={THEME_BOOT_INLINE} />
    <slot name="head" />

    {/* Fonts: production preconnect + stylesheet to avoid @import blocking */}
    {
      import.meta.env.PROD && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@100..900&display=swap"
            rel="stylesheet"
          />
          {/* Preconnect to AdSense for better performance */}
          <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
          <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
        </>
      )
    }

    {/* Dev: force system font to avoid font-swap metric shifts */}
    {
      import.meta.env.DEV && (
        <script is:inline>{"document.documentElement.dataset.devFontSans='system';"}</script>
      )
    }
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-900 dark:bg-slate-950 dark:text-white">
    <!-- Skip Link (visually hidden until focus) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Header / Navigation -->
    {
      showNav && (
        <div id="site-header">
          <ModernNavBar links={navLinks} currentPath={Astro.url.pathname} brand="Fanalyx" />
        </div>
      )
    }

    {/* Spacer to reserve header height and prevent content jump (h-16 = 4rem) */}
    {showNav && <div aria-hidden="true" class="h-16" />}

    <!-- Main Content -->
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    {showFooter && <SiteFooter />}

    <!-- Chat Panel -->
    {showChat && <ChatPanel />}

    <!-- Tool Analysis Panel -->
    {showToolAnalysis && <ToolAnalysisPanel client:only="react" currentContext={currentContext} />}

    <slot name="pageScripts" />
    <ClientScriptLoader client:load name="a11y-interactive-cards" />
  </body>
</html>

<script>
  import { enhanceScrollablePromptPanels } from '../scripts/a11y/scrollable-prompt-panels.ts';

  const runScrollablePromptPanelEnhancement = () => enhanceScrollablePromptPanels();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runScrollablePromptPanelEnhancement, {
      once: true,
    });
  } else {
    runScrollablePromptPanelEnhancement();
  }
  document.addEventListener('astro:page-load', runScrollablePromptPanelEnhancement);
</script>
