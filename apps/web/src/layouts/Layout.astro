---
import { Footer } from '@financial-analysis/ui';
import SEO from '../components/SEO.astro';
import ChatPanel from '../components/ChatPanel.astro';
import ToolAnalysisPanel from '../components/ToolAnalysisPanel.tsx';
import '../styles/global.css';
import ModernNavBar from '../components/ModernNavBar.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  showNav?: boolean;
  keywords?: string;
}

const { title, description = "Fanalyx - Professional Financial Analysis Tools", canonical, image, showNav = true, keywords } = Astro.props as Props;

  const navLinks = [
    { label: 'Home', href: '/' },
    { label: 'Models', href: '/models' },
    { label: 'Journey', href: '/journey' },
    { label: 'Developers', href: '/developers' },
    { label: 'Status', href: '/status' },
  ];

// Determine current context for tool analysis panel
function getCurrentContext(pathname: string): string {
  const path = pathname.split('/')[1] || '';
  
  // Check for journey pages first
  if (path === 'journey') {
    const journeyId = pathname.split('/')[2] || '';
    return `journey-${journeyId}`;
  }
  
  // Direct page mappings
  const contextMap: Record<string, string> = {
    'amortization': 'amortization',
    'lease-analysis': 'lease',
    'enhanced-lease': 'lease',
    'ebitda-forecasting': 'ebitda',
    'auto-loan': 'auto-loan',
    'debt-payoff': 'debt-payoff',
    'savings-goal': 'savings-goal',
    'student-loans': 'student-loans',
    'retirement': 'retirement',
    'budget': 'budget',
    'bond-pricing': 'bond-pricing',
    'options-pricing': 'options-pricing',
    'cash-flow': 'cash-flow',
    'models': 'models',
    'journey': 'general',
    '': 'general',
  };
  
  return contextMap[path] || 'general';
}

const currentContext = getCurrentContext(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" type="image/png" href="/fanalyx_favicon.png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/fanalyx_favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} url={Astro.url.href} canonical={canonical} image={image} keywords={keywords} />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1672390365903308"
     crossorigin="anonymous"></script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1672390365903308"
     crossorigin="anonymous"></script>

    <!-- Tailwind CSS -->
    <script is:inline>
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      }
    </script>

      {/* Fonts: production preconnect + stylesheet to avoid @import blocking */}
      {import.meta.env.PROD && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
            rel="stylesheet"
          />
        </>
      )}

      {/* Dev: force system font to avoid font-swap metric shifts */}
      {import.meta.env.DEV && (
        <script is:inline>
          {"document.documentElement.dataset.devFontSans='system';"}
        </script>
      )}
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white min-h-screen font-sans">
    <!-- Skip Link (visually hidden until focus) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    

    <!-- Header / Navigation -->
    {showNav && (
      <div id="site-header">
  <ModernNavBar links={navLinks} currentPath={Astro.url.pathname} brand="Fanalyx" />
      </div>
    )}

      {/* Spacer to reserve header height and prevent content jump (h-16 = 4rem) */}
      <div aria-hidden="true" class="h-16" />

    <!-- Main Content -->
      <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer client:only="react" />

    <!-- Chat Panel -->
    <ChatPanel />

    <!-- Tool Analysis Panel -->
    <ToolAnalysisPanel client:only="react" currentContext={currentContext} />

    <slot name="pageScripts" />
  </body>
</html>
