      </div>
    </section>

    <!-- Features -->
    <section class="mb-12">
      <h2 class="fa-display fa-display-section !mt-0 mb-6">
        Why Use Our API?
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="flex">
          <div class="text-3xl mr-4">⚡</div>
          <div>
            <h3 class="fa-panel-title text-xl mb-2">Edge Deployed</h3>
            <p class="fa-card-copy !mt-0">
              Running on Cloudflare's global network for ultra-low latency from anywhere in the
              world.
            </p>
          </div>
        </div>

        <div class="flex">
          <div class="text-3xl mr-4">🔒</div>
          <div>
            <h3 class="fa-panel-title text-xl mb-2">Secure & Tested</h3>
