			<div class="mb-6">
				<h3 class="text-xl font-semibold mb-3">Webhook Signature Verification</h3>
				<pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto"><code>const crypto = require('crypto');

function verifyWebhook(payload, signature, secret) &lbrace;
  const hash = crypto
    .createHmac('sha256', secret)
    .update(payload)
    .digest('hex');
  
  return hash === signature;
&rbrace;

// In your webhook handler
const isValid = verifyWebhook(
  req.body,
  req.headers['x-fanalyx-signature'],
  process.env.WEBHOOK_SECRET
);

if (!isValid) &lbrace;
  return res.status(401).send('Invalid signature');
&rbrace;</code></pre>
