          </ul>
          <p class="fa-card-copy fa-card-copy-sm !mt-0">For production applications</p>
        </div>

        <!-- Enterprise Tier -->
        <div class="fa-card p-6">
          <h3 class="fa-panel-title mb-2 text-2xl">Enterprise</h3>
