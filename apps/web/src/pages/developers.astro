          </div>
          <ul class="space-y-2 mb-6">
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
              <span>1,000 requests/month</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
              <span>All calculation endpoints</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
              <span>Basic support</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
