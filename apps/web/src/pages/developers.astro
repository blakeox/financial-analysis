---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Developer API - Financial Analysis | REST API for Financial Calculators';
const description =
  'Access powerful financial calculation engines via our REST API. Deterministic, tested, and edge-deployed for low latency worldwide. Free tier with 1,000 requests/month.';
const keywords =
  'financial api, rest api, financial calculator api, amortization api, loan calculation api, developer tools, financial data api, json api';

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Developer API',
          item: currentUrl,
        },
      ],
    },
    {
      '@type': 'WebAPI',
      name: 'Fanalyx Financial Analysis API',
      description: description,
      documentation: `${baseUrl}/developers`,
      provider: {
        '@type': 'Organization',
        name: 'Fanalyx',
        url: baseUrl,
      },
      potentialAction: {
        '@type': 'Action',
        name: 'Get API Key',
        target: `${baseUrl}/dashboard`,
      },
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Developer API' }]} />

  <div class="fa-page-shell">
    <PageHero
      eyebrow="Developers"
      title="Developer API"
      description="Access Fanalyx financial calculation engines through a deterministic, tested, edge-deployed API built for low-latency analysis workflows."
      actions={[
        { href: '/api/signup', label: 'Get Free API Key' },
        { href: '/pricing', label: 'View pricing', variant: 'secondary' },
        { href: '/developers/design-system', label: 'Design system', variant: 'secondary' },
      ]}
    />

    <div class="fa-highlight-card mb-10">
      <p class="fa-eyebrow">New during Agents Week</p>
      <h2 class="fa-panel-title mt-2 text-2xl">
        Try the new Project Think-powered Fanalyx Agent
      </h2>
      <p class="fa-body-copy !mt-3 max-w-3xl">
        We now expose a first-class Cloudflare agent runtime in the app with persistent sessions and
        deterministic finance tools.
      </p>
      <a
        href="/agent"
        class="fa-button-primary mt-4 inline-flex"
      >
        Open the agent
      </a>
    </div>

    <div class="grid gap-6 mb-12 md:grid-cols-3">
      <a href="#api-keys" class="block">
        <SurfaceCard
          title="API Keys"
          description="Get your free API key and start building immediately."
          className="h-full fa-card-interactive"
        >
          <span class="fa-inline-link mt-4 inline-flex">Get Started →</span>
        </SurfaceCard>
      </a>

      <a href="/pricing" class="block">
        <SurfaceCard
          title="Pricing"
          description="Free tier with 1,000 requests per month. Scale as your usage grows."
          className="h-full fa-card-interactive"
        >
          <span class="fa-inline-link mt-4 inline-flex">View Plans →</span>
        </SurfaceCard>
      </a>

      <a href="/dashboard" class="block">
        <SurfaceCard
          title="Dashboard"
          description="Monitor usage, manage keys, and view analytics."
          className="h-full fa-card-interactive"
        >
          <span class="fa-inline-link mt-4 inline-flex">Open Dashboard →</span>
        </SurfaceCard>
      </a>
    </div>

    <!-- Quick Start -->
    <section class="mb-12" id="api-keys">
      <h2 class="fa-display fa-display-section !mt-0 mb-4">
        Quick Start
      </h2>
      <div class="fa-card p-6 mb-6">
        <h2 class="fa-panel-title mb-3 text-xl">1. Get Your API Key</h2>
        <p class="fa-scenario-copy mb-4">Sign up for a free developer account to get your API key:</p>
        <a
          href="/api/signup"
          class="fa-button-primary"
        >
          Get Free API Key
        </a>
      </div>

      <div class="fa-card p-6 mb-6">
        <h2 class="fa-panel-title mb-3 text-xl">2. Make Your First Request</h2>

        <!-- Language Tabs -->
        <div class="fa-segmented-control mb-4" role="group" aria-label="Code example language">
          <button
            type="button"
            class="code-tab fa-segmented-button-active"
            data-lang="curl"
            aria-pressed="true">cURL</button>
          <button
            type="button"
            class="code-tab fa-segmented-button"
            data-lang="javascript"
            aria-pressed="false">JavaScript</button>
          <button
            type="button"
            class="code-tab fa-segmented-button"
            data-lang="python"
            aria-pressed="false">Python</button>
          <button
            type="button"
            class="code-tab fa-segmented-button"
            data-lang="typescript"
            aria-pressed="false">TypeScript</button>
        </div>

        <!-- cURL -->
        <pre
          class="code-block fa-prompt-panel"
          data-lang="curl"><code>curl -X POST https://fanalyx.com/v1/api/analysis/amortization \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '&lbrace;
    "principal": 300000,
    "annualRate": 0.045,
    "years": 30,
    "startDate": "2025-01-01"
  &rbrace;'</code></pre>

        <!-- JavaScript -->
        <pre
          class="code-block fa-prompt-panel hidden"
          data-lang="javascript"><code>const response = await fetch('https://fanalyx.com/v1/api/analysis/amortization', &lbrace;
  method: 'POST',
  headers: &lbrace;
    'Authorization': 'Bearer YOUR_API_KEY',
    'Content-Type': 'application/json'
  &rbrace;,
  body: JSON.stringify(&lbrace;
    principal: 300000,
    annualRate: 0.045,
    years: 30,
    startDate: '2025-01-01'
  &rbrace;)
&rbrace;);

const data = await response.json();
console.log(data);</code></pre>

        <!-- Python -->
        <pre
          class="code-block fa-prompt-panel hidden"
          data-lang="python"><code>import requests

response = requests.post(
    'https://fanalyx.com/v1/api/analysis/amortization',
    headers=&lbrace;
        'Authorization': 'Bearer YOUR_API_KEY',
        'Content-Type': 'application/json'
    &rbrace;,
    json=&lbrace;
        'principal': 300000,
        'annualRate': 0.045,
        'years': 30,
        'startDate': '2025-01-01'
    &rbrace;
)

data = response.json()
print(data)</code></pre>

        <!-- TypeScript -->
        <pre
          class="code-block fa-prompt-panel hidden"
          data-lang="typescript"><code>import type &lbrace; AmortizationInput, AmortizationResult &rbrace; from '@fanalyx/sdk';

const input: AmortizationInput = &lbrace;
  principal: 300000,
  annualRate: 0.045,
  years: 30,
  startDate: '2025-01-01'
&rbrace;;

const response = await fetch('https://fanalyx.com/v1/api/analysis/amortization', &lbrace;
  method: 'POST',
  headers: &lbrace;
    'Authorization': `Bearer $&lbrace;process.env.FANALYX_API_KEY&rbrace;`,
    'Content-Type': 'application/json'
  &rbrace;,
  body: JSON.stringify(input)
&rbrace;);

const result: AmortizationResult = await response.json();</code></pre>
      </div>

      <div class="fa-card p-6 mb-6">
        <h3 class="fa-panel-title mb-3 text-xl">3. Try the Interactive Playground</h3>
        <p class="fa-scenario-copy mb-4">Test endpoints directly in your browser without an API key:</p>
        <a
          href="/playground"
          class="fa-button-primary"
        >
          Open API Playground
        </a>
      </div>

      <div class="fa-card p-6">
        <h3 class="fa-panel-title mb-3 text-xl">4. Explore the API</h3>
        <p class="fa-scenario-copy mb-4">View interactive documentation and try all endpoints:</p>
        <a href="/docs" class="fa-inline-link font-medium">
          View OpenAPI Documentation →
        </a>
      </div>
    </section>

    <script is:inline>
      // Code tab switching
      document.addEventListener('DOMContentLoaded', () => {
        // Scrollable <pre> panels need tabindex for keyboard access (axe scrollable-region-focusable).
        document.querySelectorAll('pre.fa-prompt-panel').forEach((panel) => {
          panel.setAttribute('tabindex', '0');
        });

        const tabs = document.querySelectorAll('.code-tab');
        const blocks = document.querySelectorAll('.code-block');

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const lang = tab.dataset.lang;

            // Update tab styles
            tabs.forEach((t) => {
              const isActive = t.dataset.lang === lang;
              t.setAttribute('aria-pressed', isActive ? 'true' : 'false');
              if (isActive) {
                t.classList.remove('fa-segmented-button');
                t.classList.add('fa-segmented-button-active');
              } else {
                t.classList.remove('fa-segmented-button-active');
                t.classList.add('fa-segmented-button');
              }
            });

            // Show corresponding code block
            blocks.forEach((block) => {
              if (block.dataset.lang === lang) {
                block.classList.remove('hidden');
              } else {
                block.classList.add('hidden');
              }
            });
          });
        });
      });
    </script>
    <!-- API Tiers -->
    <section class="mb-12">
      <h2 class="fa-display fa-display-section !mt-0 mb-6">
        API Tiers
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
