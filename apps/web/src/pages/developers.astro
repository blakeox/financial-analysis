		<!-- Quick Start -->
		<section class="mb-12" id="api-keys">
			<h2 class="text-3xl font-bold mb-4">Quick Start</h2>
			<div class="bg-gray-100 dark:bg-gray-800 rounded-lg p-6 mb-6">
				<h3 class="text-xl font-semibold mb-3">1. Get Your API Key</h3>
				<p class="mb-4">Sign up for a free developer account to get your API key:</p>
