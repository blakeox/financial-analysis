            </li>
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
              <span>Dedicated support</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
              <span>SLA guarantee</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-600 mr-2">✓</span>
              <span>White-label options</span>
            </li>
          </ul>
          <p class="fa-card-copy fa-card-copy-sm !mt-0">For large-scale deployments</p>
        </div>
      </div>
    </section>

    <!-- Available Endpoints -->
    <section class="mb-12">
      <h2 class="fa-display fa-display-section !mt-0 mb-6">
        Available Endpoints
      </h2>
      <div class="space-y-4">
        <!-- Amortization -->
        <div class="fa-card p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="fa-panel-title text-xl">Loan Amortization</h3>
            <span
