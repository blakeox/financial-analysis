---
import Layout from '../layouts/Layout.astro';
import { StorageUsageCard } from '@financial-analysis/ui';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL || 'http://127.0.0.1:8787';

const title = "System Status - Fanalyx Financial Tools";
const description = "Check the operational status of Fanalyx financial calculators, API services, and storage systems. Real-time monitoring of all financial analysis tools.";
const keywords = "system status, fanalyx status, api status, financial calculator status, service monitoring, uptime";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl },
        { "@type": "ListItem", "position": 2, "name": "System Status", "item": currentUrl }
      ]
    },
    {
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": currentUrl,
      "isPartOf": { "@type": "WebSite", "name": "Fanalyx", "url": baseUrl }
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'System Status' }]} />

  <div class="fa-page-shell">
    <PageHero
      eyebrow="Status"
      title="System Status"
      description="Check the current health of Fanalyx storage and operational surfaces in one place."
    />

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <SurfaceCard title="R2 Storage">
        <div class="mt-4" data-testid="storage-card">
          <StorageUsageCard client:load apiBase={apiBase} />
        </div>
      </SurfaceCard>

      <SurfaceCard title="Notes">
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-600">
          <li>Usage refreshes automatically every 30 seconds.</li>
          <li>Locked state indicates uploads are temporarily disabled.</li>
          <li>Admins can reconcile usage via /v1/storage/reconcile.</li>
        </ul>
      </SurfaceCard>
    </div>
  </div>
</Layout>
