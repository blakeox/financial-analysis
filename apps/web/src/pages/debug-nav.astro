---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
---

<!-- Nav Isolation Debug Page: Renders minimal content to test navbar persistence without other page sections. -->
<Layout title="Nav Debug" description="Debug navbar persistence" noindex={true}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Debug Nav' }]} />

  <div class="fa-page-shell">
    <PageHero
      eyebrow="Debug"
      title="Navigation Isolation Debug"
      description="A minimal shell for checking whether navigation issues come from shared chrome or page-specific content."
    />

    <SurfaceCard className="max-w-3xl">
      <div class="fa-prose mt-4 space-y-4 text-sm">
        <p>
          This page intentionally keeps the DOM light so you can observe whether the main navigation
          disappears independently of heavier layouts or scripts.
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li>Open DevTools Console and watch for [NAV MUTATION] or [NAV RESTORE] logs.</li>
          <li>If the nav disappears visually, capture the last 10 console lines.</li>
          <li>Run in console: <code>window.__navCheck && window.__navCheck()</code> to force an integrity check.</li>
          <li>Report any mutation stack traces you see here.</li>
        </ol>
        <p>
          If this page keeps the nav stable while another page does not, the issue likely relates to
          content or scripts specific to that other page.
        </p>
      </div>
    </SurfaceCard>
  </div>
</Layout>
