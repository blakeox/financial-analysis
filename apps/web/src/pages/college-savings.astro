---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
import ToolPageShell from '../components/site/ToolPageShell.astro';
import WorkflowSupportRail from '../components/WorkflowSupportRail.astro';
---

<Layout
  title="College Savings Planner - 529 Plan & Education Funding Calculator | Fanalyx"
  description="Comprehensive college savings planner with 529 plan optimization, Coverdell ESA analysis, financial aid impact, multiple children planning, and tax-advantaged savings strategies."
  keywords="college savings, 529 plan, education funding, college planning, Coverdell ESA, financial aid, college cost calculator, education savings"
  canonical={Astro.url.href}
  type="article"

  showChat={false}
  showToolAnalysis={false}
>
  <!-- Structured Data for SEO -->
  <StructuredData
    type="breadcrumb"
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Personal Finance', url: '/models/personal' },
      { name: 'College Savings', url: '/college-savings' },
    ]}
  />

  <StructuredData
    type="software"
    softwareApp={{
      name: 'College Savings Planner',
      description:
        'Comprehensive college savings planning tool with 529 plan optimization, Coverdell ESA analysis, financial aid impact, and multiple children planning.',
      category: 'FinanceApplication',
      rating: 4.7,
      ratingCount: 170,
    }}
  />

  <StructuredData
    type="faq"
    faqs={[
      {
        question: 'What is a 529 plan and how does it work?',
        answer:
          'A 529 plan is a tax-advantaged savings plan designed to encourage saving for future education costs. Contributions grow tax-free, and withdrawals are tax-free when used for qualified education expenses. Many states offer tax deductions or credits for 529 contributions.',
      },
      {
        question: 'How much should I save for college?',
        answer:
          "College costs vary by type: public colleges average $25,000/year, private colleges $55,000/year, and Ivy League schools $80,000/year. Our calculator projects future costs with inflation and helps you determine how much to save based on your children's ages and college type preferences.",
      },
      {
        question: 'What is the difference between a 529 plan and Coverdell ESA?',
        answer:
          '529 plans have higher contribution limits ($300,000+ per beneficiary) and can be used for K-12 and college expenses. Coverdell ESAs have lower limits ($2,000/year) but offer more investment flexibility. Both offer tax-free growth for qualified education expenses.',
      },
      {
        question: 'How does saving for college affect financial aid?',
        answer:
          "529 plans owned by parents are assessed at up to 5.64% for financial aid purposes, while student-owned assets are assessed at 20%. Grandparent-owned 529s don't count in FAFSA but distributions count as student income. Our calculator helps optimize savings strategies to minimize financial aid impact.",
      },
      {
        question: 'Can I use 529 plans for multiple children?',
        answer:
          "Yes! You can change the beneficiary of a 529 plan to another family member. If one child doesn't use all the funds, you can transfer the remainder to another child. Our calculator helps plan for multiple children with different college timelines and costs.",
      },
    ]}
  />

  <ToolPageShell
    eyebrow="Personal finance"
    title="College Savings Calculator"
    description="Project education costs, monthly savings needs, and 529-style contribution strategies"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Models', href: '/models' },
      { label: 'Personal Finance', href: '/models/personal' },
      { label: 'College Savings' },
    ]}
  >
    <div id="results" class="hidden" aria-hidden="true"></div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1.55fr)_minmax(320px,0.95fr)]">
      <div class="space-y-8">
    <!-- College Savings Form -->
    <div class="fa-card p-6 mb-8">
      <h2 class="fa-panel-title mb-6">Family Information</h2>

      <form id="college-savings-form" class="space-y-6">
        <!-- Family Info Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label
              for="numberOfChildren"
              class="fa-field-label mb-2"
            >
              Number of Children
            </label>
            <input
              type="number"
              id="numberOfChildren"
              name="numberOfChildren"
              min="1"
              max="10"
              value="1"
              class="fa-input-surface w-full"
              required
            />
          </div>

          <div>
            <label
              for="stateOfResidence"
              class="fa-field-label mb-2"
            >
              State of Residence
            </label>
            <input
              type="text"
              id="stateOfResidence"
              name="stateOfResidence"
              class="fa-input-surface w-full"
              placeholder="CA"
              required
            />
          </div>

          <div>
            <label
              for="maritalStatus"
              class="fa-field-label mb-2"
            >
              Marital Status
            </label>
            <select
              id="maritalStatus"
              name="maritalStatus"
              class="fa-input-surface w-full"
              required
            >
              <option value="single">Single</option>
              <option value="married" selected>Married</option>
              <option value="divorced">Divorced</option>
              <option value="widowed">Widowed</option>
            </select>
          </div>
        </div>

        <!-- Current Savings Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">Current Savings</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="total529Balance"
                class="fa-field-label mb-2"
              >
                529 Plan Balance ($)
              </label>
              <input
                type="number"
                id="total529Balance"
                name="total529Balance"
                min="0"
                step="1000"
                value="0"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="monthlyContribution"
                class="fa-field-label mb-2"
              >
                Monthly Contribution ($)
              </label>
              <input
                type="number"
                id="monthlyContribution"
                name="monthlyContribution"
                min="0"
                step="100"
                value="500"
                class="fa-input-surface w-full"
              />
            </div>
          </div>
        </div>

        <!-- Goals Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">Savings Goals</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="targetCoverage"
                class="fa-field-label mb-2"
              >
                Target Coverage (%)
              </label>
              <input
                type="number"
                id="targetCoverage"
                name="targetCoverage"
                min="0"
                max="100"
                step="5"
                value="100"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="riskTolerance"
                class="fa-field-label mb-2"
              >
                Risk Tolerance
              </label>
              <select
                id="riskTolerance"
                name="riskTolerance"
                class="fa-input-surface w-full"
                required
              >
                <option value="conservative">Conservative</option>
                <option value="moderate" selected>Moderate</option>
                <option value="aggressive">Aggressive</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-6 fa-panel-divider-top mt-6">
          <button type="submit" class="fa-button-primary"> Analyze College Savings </button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <div id="college-savings-results" class="fa-card hidden p-6 mb-8">
      <h2 class="fa-panel-title text-xl mb-4">
        College Savings Analysis
      </h2>
      <div id="college-savings-results-content" class="space-y-4"></div>
    </div>

    <!-- AdSense -->
    <AdSense slot="0123456789" format="horizontal" className="mt-8" />
      </div>

      <WorkflowSupportRail modelType="college-savings" />
    </div>
  </ToolPageShell>

  <ClientScriptLoader client:load slot="pageScripts" name="college-savings" />
</Layout>
