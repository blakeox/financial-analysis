---
import Layout from '../../layouts/Layout.astro';
import ClientScriptLoader from '../../components/ClientScriptLoader.tsx';

const keywords = "personal finance, mortgage calculator, retirement planning, auto loan calculator, debt payoff, savings goal calculator, student loan calculator, budget planner, amortization calculator";
const enhancedDescription = "Free personal finance calculators and planning tools for mortgages, retirement, auto loans, debt payoff, savings goals, student loans, and budgeting. Professional-grade financial modeling made simple.";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Personal Finance Models",
  "description": enhancedDescription,
  "url": currentUrl,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": baseUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Models",
        "item": `${baseUrl}/models`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Personal Finance",
        "item": currentUrl
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "SoftwareApplication",
        "name": "Mortgage Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Calculate monthly mortgage payments with principal, interest, taxes, and insurance"
      },
      {
        "@type": "SoftwareApplication",
        "name": "Retirement Planning Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Plan your retirement savings with compound growth projections"
      },
      {
        "@type": "SoftwareApplication",
        "name": "Auto Loan Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Vehicle loan analysis with trade-in value and sales tax calculations"
      },
      {
        "@type": "SoftwareApplication",
        "name": "Debt Payoff Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Compare debt payoff strategies to eliminate debt faster"
      }
    ]
  }
};

// FAQ Schema for featured snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are these personal finance calculators free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, all our personal finance calculators are completely free to use. No registration or payment required. Access mortgage calculators, retirement planning tools, auto loan analysis, debt payoff strategies, savings goal planning, student loan calculators, and budget planners at no cost."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate are the mortgage and loan calculators?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our calculators use industry-standard financial formulas and are highly accurate for estimation purposes. They include principal, interest, taxes, insurance (PITI), and closing costs. However, final loan terms should always be confirmed with your lender as rates and fees may vary."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between the debt avalanche and snowball methods?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The debt avalanche method pays off debts with the highest interest rates first, saving you the most money. The debt snowball method pays off smallest debts first, providing psychological wins. Our debt payoff calculator compares both strategies to help you choose the best approach for your situation."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use these calculators for retirement planning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, our retirement calculator helps you plan for retirement by projecting savings growth with compound interest, employer matching, and inflation adjustments. Enter your current age, retirement age, current savings, and monthly contributions to see if you're on track."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account to save my calculations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No account is required for basic use. Your calculations are saved locally in your browser. For advanced features like saving multiple scenarios and accessing them across devices, you can optionally create a free account."
      }
    }
  ]
};
---

<Layout title="Personal Finance Models | Fanalyx" description={enhancedDescription} canonical={Astro.url.href} keywords={keywords}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <!-- FAQ Schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Breadcrumb Navigation -->
    <nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700" aria-label="Breadcrumb">
      <div class="container mx-auto px-4 py-3">
        <ol class="flex items-center space-x-2 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" itemprop="item">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li class="text-gray-400 dark:text-gray-600">/</li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/models" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" itemprop="item">
              <span itemprop="name">Models</span>
            </a>
            <meta itemprop="position" content="2" />
          </li>
          <li class="text-gray-400 dark:text-gray-600">/</li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="text-gray-900 dark:text-white font-medium" itemprop="name">Personal Finance</span>
            <meta itemprop="position" content="3" />
          </li>
        </ol>
      </div>
    </nav>

    <!-- Main Content Container with Chat Panel Integration -->
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-16">
        <!-- Header Section -->
        <div class="text-center mb-16">
          <div class="flex items-center justify-center mb-4">
            <a href="/models" class="mr-4 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
            </a>
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white">
              Personal Finance Models
            </h1>
          </div>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6">
            Financial planning tools for individuals and families. Calculate mortgages, plan for retirement, and analyze personal investments.
          </p>
          <div class="flex items-center justify-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <span>Click the chat icon to get AI-powered analysis of your model results</span>
          </div>
        </div>

        <!-- Personal Finance Models Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16" role="main">
          
          <!-- Residential Mortgage -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-blue-500 group cursor-pointer model-card"
            data-model="Residential Mortgage"
            onclick="selectModel(this, 'residential-mortgage')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300">
                  Residential Mortgage
                </h3>
                <div class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
                  Available
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Home loan amortization with PITI (Principal, Interest, Taxes, Insurance), APR analysis, and total cost of ownership calculations
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  PITI calculations (Principal, Interest, Taxes, Insurance)
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  APR & closing cost analysis
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
