---
import Layout from '../../layouts/Layout.astro';
import ClientScriptLoader from '../../components/ClientScriptLoader.tsx';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import PageHero from '../../components/site/PageHero.astro';

const keywords = "personal finance, mortgage calculator, retirement planning, auto loan calculator, debt payoff, savings goal calculator, student loan calculator, budget planner, amortization calculator";
const enhancedDescription = "Free personal finance calculators and planning tools for mortgages, retirement, auto loans, debt payoff, savings goals, student loans, and budgeting. Professional-grade financial modeling made simple.";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Personal Finance Models",
  "description": enhancedDescription,
  "url": currentUrl,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": baseUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Models",
        "item": `${baseUrl}/models`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Personal Finance",
        "item": currentUrl
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "SoftwareApplication",
        "name": "Mortgage Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Calculate monthly mortgage payments with principal, interest, taxes, and insurance"
      },
      {
        "@type": "SoftwareApplication",
        "name": "Retirement Planning Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Plan your retirement savings with compound growth projections"
      },
      {
        "@type": "SoftwareApplication",
        "name": "Auto Loan Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Vehicle loan analysis with trade-in value and sales tax calculations"
      },
      {
        "@type": "SoftwareApplication",
        "name": "Debt Payoff Calculator",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Compare debt payoff strategies to eliminate debt faster"
      }
    ]
  }
};

// FAQ Schema for featured snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are these personal finance calculators free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, all our personal finance calculators are completely free to use. No registration or payment required. Access mortgage calculators, retirement planning tools, auto loan analysis, debt payoff strategies, savings goal planning, student loan calculators, and budget planners at no cost."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate are the mortgage and loan calculators?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our calculators use industry-standard financial formulas and are highly accurate for estimation purposes. They include principal, interest, taxes, insurance (PITI), and closing costs. However, final loan terms should always be confirmed with your lender as rates and fees may vary."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between the debt avalanche and snowball methods?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The debt avalanche method pays off debts with the highest interest rates first, saving you the most money. The debt snowball method pays off smallest debts first, providing psychological wins. Our debt payoff calculator compares both strategies to help you choose the best approach for your situation."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use these calculators for retirement planning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, our retirement calculator helps you plan for retirement by projecting savings growth with compound interest, employer matching, and inflation adjustments. Enter your current age, retirement age, current savings, and monthly contributions to see if you're on track."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account to save my calculations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No account is required for basic use. Your calculations are saved locally in your browser. For advanced features like saving multiple scenarios and accessing them across devices, you can optionally create a free account."
      }
    }
  ]
};
---

<Layout title="Personal Finance Models | Fanalyx" description={enhancedDescription} canonical={Astro.url.href} keywords={keywords} showChat={false}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <!-- FAQ Schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Models', href: '/models' },
      { label: 'Personal Finance' },
    ]}
  />

  <div class="fa-page-shell">
    <!-- Main Content Container with Chat Panel Integration -->
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="mx-auto max-w-7xl">
        <PageHero
          eyebrow="Models"
          title="Personal Finance Models"
          description="Financial planning tools for individuals and families. Calculate mortgages, plan for retirement, and analyze personal investments."
        />
        <div class="fa-model-intro mb-16">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <span>Open a model, calculate once, then use guided analysis to compare scenarios and change inputs.</span>
        </div>

        <!-- Personal Finance Models Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16" role="main">
          
          <!-- Residential Mortgage -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Residential Mortgage"
            onclick="selectModel(this, 'residential-mortgage')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Residential Mortgage
                </h3>
                <div class="fa-chip fa-chip-success">
                  Available
                </div>
              </div>
              <p class="fa-model-description">
                Home loan amortization with PITI (Principal, Interest, Taxes, Insurance), APR analysis, and total cost of ownership calculations
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  PITI calculations (Principal, Interest, Taxes, Insurance)
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  APR & closing cost analysis
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Total cost of ownership over loan term
                </div>
              </div>
              <a
                href="/calculator/amortization"
                class="fa-button-primary w-full justify-center"
              >
                Open Model
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Rent vs Buy Calculator -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Rent vs Buy Calculator"
            onclick="selectModel(this, 'rent-vs-buy')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Rent vs Buy Calculator
                </h3>
                <div class="fa-chip fa-chip-accent">
                  New
                </div>
              </div>
              <p class="fa-model-description">
                Should you rent or buy a home? Compare 5+ year financial outcomes including equity building, tax benefits, opportunity costs, and break-even analysis.
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Side-by-side rent vs buy comparison
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Tax benefits and opportunity cost analysis
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Break-even point calculator
                </div>
              </div>
              <a href="/calculator/rent-vs-buy" class="fa-inline-link inline-flex items-center font-semibold">
                Calculate Now
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Invest vs Pay Off Debt -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Invest vs Pay Off Debt"
            onclick="selectModel(this, 'invest-vs-payoff-debt')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Invest vs Pay Off Debt
                </h3>
                <div class="fa-chip fa-chip-accent">
                  New
                </div>
              </div>
              <p class="fa-model-description">
                Should you use extra money to pay off debt or invest it? Compare guaranteed returns from debt payoff vs potential investment gains with risk analysis.
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Guaranteed vs expected returns comparison
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Employer match optimization
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  3 strategies: pay debt, invest, or hybrid
                </div>
              </div>
              <a href="/calculator/invest-vs-payoff-debt" class="fa-inline-link inline-flex items-center font-semibold">
                Calculate Now
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Side Hustle Income Calculator -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Side Hustle Income"
            onclick="selectModel(this, 'side-hustle-income')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Side Hustle Income Calculator
                </h3>
                <div class="fa-chip fa-chip-warning">
                  New
                </div>
              </div>
              <p class="fa-model-description">
                Calculate your true after-tax income from freelance or gig work. Includes self-employment tax (15.3%), quarterly estimated taxes, and business expense deductions.
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  True hourly rate after all taxes
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Quarterly estimated tax calculator
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  W-2 salary equivalent comparison
                </div>
              </div>
              <a href="/calculator/side-hustle-income" class="fa-inline-link inline-flex items-center font-semibold">
                Calculate Now
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Credit Card Payoff Calculator -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Credit Card Payoff"
            onclick="selectModel(this, 'credit-card-payoff')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Credit Card Payoff Calculator
                </h3>
                <div class="fa-chip fa-chip-danger">
                  New
                </div>
              </div>
              <p class="fa-model-description">
                Optimize credit card debt payoff with balance transfer analysis, 0% APR offers, credit utilization impact, and escape the minimum payment trap.
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Balance transfer savings analysis
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Credit utilization & score impact
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Minimum payment trap warning
                </div>
              </div>
              <a href="/calculator/credit-card-payoff" class="fa-inline-link inline-flex items-center font-semibold">
                Calculate Now
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Mortgage Scenario Planner -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Mortgage Scenario Planner"
            onclick="selectModel(this, 'mortgage-scenario-planning')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Mortgage Scenario Planner
                </h3>
                <div class="fa-chip fa-chip-success">
                  Available
                </div>
              </div>
              <p class="fa-model-description">
                Compare multiple mortgage options with different rates, down payments, and early payoff strategies. Includes refinancing scenarios to find your best deal.
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Compare 2+ mortgage scenarios side-by-side
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Early payoff analysis with extra payments
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Refinancing scenarios after 5 years
                </div>
              </div>
              <a
                href="/calculator/mortgage-scenario-planning"
                class="fa-button-primary w-full justify-center"
              >
                Open Planner
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Auto Loan Calculator -->
          <div class="fa-model-card group cursor-pointer model-card"
            data-model="Auto Loan Calculator"
            onclick="selectModel(this, 'auto-loan')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="fa-model-title">
                  Auto Loan Calculator
                </h3>
                <div class="fa-chip fa-chip-success">
                  Available
                </div>
              </div>
              <p class="fa-model-description">
                Vehicle loan analysis with trade-in value, sales tax, registration fees, and early payoff scenarios. Includes GAP insurance and extended warranty options.
              </p>
              <div class="space-y-3 mb-6">
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Trade-in value & negative equity
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Sales tax, fees, rebates
                </div>
                <div class="fa-model-feature">
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Early payoff scenarios
                </div>
              </div>
              <a
                href="/auto-loan"
                class="fa-button-primary w-full justify-center"
              >
                Open Calculator
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </a>
            </div>
