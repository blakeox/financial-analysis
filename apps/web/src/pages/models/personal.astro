            data-model="Side Hustle Income"
            onclick="selectModel(this, 'side-hustle-income')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-yellow-600 dark:text-yellow-400 group-hover:text-yellow-700 dark:group-hover:text-yellow-300">
                  Side Hustle Income Calculator
                </h3>
                <div class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">
                  New
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Calculate your true after-tax income from freelance or gig work. Includes self-employment tax (15.3%), quarterly estimated taxes, and business expense deductions.
              </p>
              <div class="space-y-3 mb-6">
