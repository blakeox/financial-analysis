              </div>
              <a href="/calculator/invest-vs-payoff-debt" class="inline-flex items-center text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 font-semibold group-hover:translate-x-2 transition-transform">
