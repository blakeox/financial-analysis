                Open Calculator
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Debt Payoff Optimizer -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-teal-500 group cursor-pointer model-card"
            data-model="Debt Payoff Optimizer"
            onclick="selectModel(this, 'debt-payoff')">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-teal-600 dark:text-teal-400 group-hover:text-teal-700 dark:group-hover:text-teal-300">
                  Debt Payoff Optimizer
                </h3>
                <div class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
                  Available
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Compare avalanche vs snowball debt payoff strategies with month-by-month schedules. Includes balance transfer analysis with intro rate calculations to maximize interest savings.
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400">
