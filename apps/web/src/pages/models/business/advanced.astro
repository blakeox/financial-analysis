// FAQ Schema for featured snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is DCF analysis and when should I use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DCF (Discounted Cash Flow) analysis is a valuation method that estimates the intrinsic value of a company by projecting its future cash flows and discounting them to present value. Use DCF for fundamental valuation, especially when you have reliable cash flow projections and want to understand the underlying value drivers of a business."
      }
    },
    {
      "@type": "Question",
      "name": "How do I select appropriate peer companies for comparable analysis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select peer companies based on industry, size (revenue/market cap), geography, business model, and growth characteristics. Look for companies with similar revenue streams, customer bases, and operational models. Avoid companies with significantly different capital structures or business models."
      }
    },
    {
      "@type": "Question",
      "name": "What are the key components of M&A analysis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "M&A analysis includes valuation of both companies, synergy analysis (cost and revenue synergies), accretion/dilution analysis, integration planning, risk assessment, and financing considerations. The analysis should evaluate whether the transaction creates value for shareholders."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate WACC for DCF analysis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WACC (Weighted Average Cost of Capital) is calculated as: WACC = (E/V × Re) + (D/V × Rd × (1-T)), where E is equity value, D is debt value, V is total value, Re is cost of equity (using CAPM), Rd is cost of debt, and T is tax rate. Cost of equity = Risk-free rate + Beta × Market risk premium."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between EV/EBITDA and P/E multiples?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "EV/EBITDA uses enterprise value (market cap + debt - cash) divided by EBITDA, while P/E uses market cap divided by net income. EV/EBITDA is capital structure neutral and better for comparing companies with different debt levels, while P/E reflects the actual cost to equity holders."
      }
    }
  ]
};
