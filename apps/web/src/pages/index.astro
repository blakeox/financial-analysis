---
import Layout from '../layouts/Layout.astro';
import StructuredData from '../components/StructuredData.astro';
import fanalyxLogo from '../assets/fanalyx_favicon.png?url';

const title = 'Fanalyx | AI-Powered Financial Analysis';
const description =
  'Ask financial questions in plain English, run formulas without fighting spreadsheets, and compare scenarios with AI-powered financial analysis.';
const keywords =
  'AI-powered financial analysis, financial formulas, scenario comparison, financial questions, plain-English finance explanations, decision support';

const featureCards = [
  {
    title: 'Solve Financial Formulas',
    description:
      'Run calculations for loans, savings, investing, affordability, interest, and more.',
    icon: 'calculator',
  },
  {
    title: 'Ask in Plain English',
    description: 'Ask natural questions instead of building complex spreadsheet formulas.',
    icon: 'message-circle',
  },
  {
    title: 'Explain the Math',
    description: 'See assumptions, formulas, and step-by-step explanations behind each answer.',
    icon: 'sparkles',
  },
  {
    title: 'Compare Scenarios',
    description: 'Test different options side-by-side before making a financial decision.',
    icon: 'bar-chart',
  },
];

const steps = [
  {
    title: 'Ask Your Question',
    description: 'Type or paste a financial question in plain English.',
  },
  {
    title: 'AI Does the Math',
    description: 'Fanalyx runs the calculation, applies formulas, and identifies key assumptions.',
  },
  {
    title: 'Get Clear Answers',
    description: 'Receive results, explanations, and next-step questions to consider.',
  },
];

const promptChips = [
  'How much house can I afford?',
  'Should I pay off debt or invest?',
  'What is the real cost of this loan?',
  'How much do I need to retire?',
  'Compare renting vs. buying',
  'What happens if interest rates change?',
  'How long until I reach $100K?',
  'Explain this amortization schedule',
  'What monthly payment can I afford?',
  'Which option has the lowest total cost?',
];

const useCases = [
  {
    title: 'Personal Decisions',
    description:
      'Mortgage affordability, car loans, savings goals, debt payoff, and budgeting tradeoffs.',
  },
  {
    title: 'Business Decisions',
    description:
      'Pricing, cash flow scenarios, financing options, ROI estimates, and break-even questions.',
  },
  {
    title: 'Learning & Clarity',
    description:
      'Understand formulas, assumptions, compounding, amortization, interest rates, and financial tradeoffs.',
  },
];

const trustCards = [
  {
    title: 'Transparent Calculations',
    description: 'Shows assumptions and explains how answers are calculated.',
  },
  {
    title: 'Privacy-Conscious',
    description: 'Designed to answer questions without requiring bank connections.',
  },
  {
    title: 'Educational First',
    description: 'Helps you understand options. It does not pretend to be your financial advisor.',
  },
];

const iconMarkup: Record<string, string> = {
  calculator:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2.5" width="16" height="19" rx="3"/><path d="M8 7.5h8"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/><path d="M8 16h.01"/><path d="M12 16h.01"/><path d="M16 16h.01"/></svg>',
  'message-circle':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10h10"/><path d="M7 14h6"/><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.27 0-2.48-.28-3.57-.78L3 21l1.93-4.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>',
  sparkles:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/><path d="m5 14 .7 1.8L7.5 16l-1.8.7L5 18.5l-.7-1.8L2.5 16l1.8-.2L5 14Z"/></svg>',
  'bar-chart':
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20v-4"/><path d="M3 20h19"/></svg>',
  shield:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v6c0 4.7 2.8 7.9 7 9 4.2-1.1 7-4.3 7-9V6l-7-3Z"/><path d="m9.5 12 1.7 1.7 3.3-3.7"/></svg>',
  brain:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 3.5a3.5 3.5 0 0 0-2.6 5.8A3.5 3.5 0 0 0 8 16v1a3 3 0 0 0 6 0v-1"/><path d="M14.5 3.5a3.5 3.5 0 0 1 2.6 5.8A3.5 3.5 0 0 1 16 16v1a3 3 0 0 1-6 0"/><path d="M9 9.5c0-1 .8-1.8 1.8-1.8H12"/><path d="M15 9.5c0-1-.8-1.8-1.8-1.8H12"/><path d="M12 7.7V20"/></svg>',
  trending:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/></svg>',
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={Astro.url.href}
  showFooter={false}
  showChat={false}
  showToolAnalysis={false}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <StructuredData
    type="website"
    website={{
      name: 'Fanalyx',
      url: 'https://fanalyx.com',
      description,
    }}
  />
  <StructuredData
    type="organization"
    organization={{
      name: 'Fanalyx',
      url: 'https://fanalyx.com',
      logo: fanalyxLogo,
      description: 'AI-powered financial analysis for clearer questions and clearer answers.',
    }}
  />
  <StructuredData
    type="faq"
    faqs={[
      {
        question: 'What is Fanalyx?',
        answer:
          'Fanalyx is an AI-powered financial analysis website for asking financial questions, running formulas, comparing scenarios, and understanding the math in plain English.',
      },
      {
        question: 'Does Fanalyx connect to my bank account?',
        answer:
          'No. Fanalyx is designed for question answering and analysis without requiring bank connections.',
      },
      {
        question: 'Is Fanalyx financial advice?',
        answer:
          'No. Fanalyx is educational decision support only and does not replace a financial, tax, legal, or investment professional.',
      },
    ]}
  />

  <div class="landing-page text-[var(--color-navy)]">
    <main class="overflow-hidden">
      <section class="relative isolate px-4 pb-20 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pb-28">
        <div class="landing-glow" aria-hidden="true"></div>
        <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.02fr_0.98fr]">
          <div class="relative z-10">
            <p class="hero-badge">AI-Powered Financial Analysis</p>
            <h1 class="hero-title mt-6 max-w-3xl">
              Ask anything.
              <br />
              Get <span class="text-[var(--color-purple)]">clear financial answers.</span>
            </h1>
            <p
              class="mt-6 max-w-2xl text-[1.05rem] leading-[1.7] text-[var(--color-muted-text)] sm:text-[1.08rem]"
            >
              Fanalyx uses AI to run calculations, solve formulas, and explain financial concepts in
              plain English — so you can compare options and make decisions with more confidence.
            </p>

            <ul
              class="mt-8 space-y-3 text-sm font-medium text-[var(--color-navy)] sm:text-[0.98rem]"
            >
              <li class="flex items-start gap-3">
                <span class="check-icon">✓</span>
                <span>Solve financial problems and formulas instantly</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="check-icon">✓</span>
                <span>Get plain-English explanations of assumptions and results</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="check-icon">✓</span>
                <span>Compare scenarios before making big decisions</span>
              </li>
            </ul>

            <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
              <a href="/agent" class="primary-button inline-flex items-center justify-center">
                Try Fanalyx Free
              </a>
              <a href="#examples" class="secondary-button inline-flex items-center justify-center">
                See Examples
              </a>
            </div>

            <p class="mt-4 text-sm text-[var(--color-muted-text)]">
              No credit card required · Start in seconds
            </p>
            <p class="mt-2 text-sm text-[var(--color-soft-text)]">
              Educational decision support only. Not financial advice.
            </p>
          </div>

          <div class="relative">
            <div class="mockup-card relative overflow-hidden rounded-[32px] p-5 sm:p-6">
              <div
                class="browser-bar flex items-center justify-between rounded-[20px] border border-[var(--color-border)] bg-white/85 px-4 py-3"
              >
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-[rgba(109,74,255,0.22)]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[rgba(109,74,255,0.34)]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[rgba(109,74,255,0.5)]"></span>
                </div>
                <span
                  class="rounded-full border border-[var(--color-border)] bg-[var(--color-off-white)] px-3 py-1 text-xs font-semibold text-[var(--color-muted-text)]"
                >
                  fanalyx.com
                </span>
              </div>

              <div
                class="mt-5 rounded-[26px] border border-[var(--color-border)] bg-[rgba(255,255,255,0.72)] p-5"
              >
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <p class="text-lg font-semibold text-[var(--color-navy)]">Hi Alex 👋</p>
                    <p class="mt-1 text-sm text-[var(--color-muted-text)]">
                      What financial question can I help you with today?
                    </p>
                  </div>
                  <span
                    class="inline-flex items-center rounded-full border border-[rgba(109,74,255,0.16)] bg-[var(--color-lavender)] px-3 py-1 text-xs font-semibold text-[var(--color-purple)]"
                  >
                    AI analysis ready
                  </span>
                </div>

                <div class="mt-6 space-y-4">
                  <div
                    class="user-bubble ml-auto max-w-[28rem] rounded-[22px] px-4 py-3 text-sm leading-6 text-[var(--color-navy)]"
                  >
                    If I invest $500 per month at a 7% annual return for 20 years, how much will I
                    have?
                  </div>

                  <div class="response-card rounded-[24px] p-4 sm:p-5">
                    <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
                      <div class="max-w-md">
                        <p
                          class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-soft-text)]"
                        >
                          Estimated future value
                        </p>
                        <p
                          class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-[var(--color-navy)]"
                        >
                          $276,611
                        </p>
                        <p class="mt-3 text-sm leading-6 text-[var(--color-muted-text)]">
                          Assuming monthly contributions, monthly compounding, and a constant 7%
                          annual return.
                        </p>
                      </div>

                      <div
                        class="chart-card min-w-[15rem] rounded-[20px] border border-[var(--color-border)] bg-[var(--color-off-white)] p-4"
                      >
                        <p
                          class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-soft-text)]"
                        >
                          Growth trend
                        </p>
                        <svg
                          class="mt-3 h-24 w-full"
                          viewBox="0 0 220 96"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M10 78C38 76 47 71 72 60C95 49 105 52 129 38C151 25 171 27 210 8"
                            stroke="#6D4AFF"
                            stroke-width="3.5"
                            stroke-linecap="round"></path>
                          <path
                            d="M10 82h200"
                            stroke="#D9D4EC"
                            stroke-width="1.2"
                            stroke-dasharray="4 6"></path>
                          <circle cx="210" cy="8" r="5.5" fill="#6D4AFF"></circle>
                        </svg>
                        <div
                          class="mt-2 flex items-center justify-between text-xs text-[var(--color-muted-text)]"
                        >
                          <span>20 years</span>
                          <span class="font-semibold text-[var(--color-success)]"
                            >+ steady compounding</span
                          >
                        </div>
                      </div>
                    </div>

                    <div
                      class="mt-5 rounded-[20px] border border-[var(--color-border)] bg-[var(--color-off-white)] px-4 py-3"
                    >
                      <div class="flex items-center justify-between gap-4">
                        <div>
                          <p class="text-sm font-semibold text-[var(--color-navy)]">
                            How this was calculated
                          </p>
                          <p class="mt-1 text-xs text-[var(--color-muted-text)]">
                            FV = P × [((1 + r/n)^(nt) - 1) / (r/n)]
                          </p>
                        </div>
                        <span
                          class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-[var(--color-purple)]"
                        >
                          Expand
                        </span>
                      </div>
                    </div>
                  </div>
                </div>

                <div
                  class="mt-5 rounded-[20px] border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-soft-text)]"
                >
                  Ask a follow-up…
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="scroll-mt-28 px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-eyebrow">Why Fanalyx</p>
            <h2 class="section-title mt-4">Powerful AI for financial decisions</h2>
            <p class="section-copy mt-5">
              Get accurate calculations, clear explanations, and practical insight without wrestling
              with spreadsheets.
            </p>
          </div>

          <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            {
              featureCards.map((feature) => (
                <article class="feature-card group">
                  <div class="icon-shell" set:html={iconMarkup[feature.icon]} />
                  <h3 class="mt-6 text-xl font-semibold tracking-[-0.03em] text-[var(--color-navy)]">
                    {feature.title}
                  </h3>
                  <p class="mt-3 text-sm leading-7 text-[var(--color-muted-text)]">
                    {feature.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="how-it-works"
        class="scroll-mt-28 bg-[linear-gradient(180deg,#F7F4FF_0%,#FCFBFF_100%)] px-4 py-20 sm:px-6 lg:px-8"
      >
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-eyebrow">How it works</p>
            <h2 class="section-title mt-4">How Fanalyx Works</h2>
            <p class="section-copy mt-5">Three simple steps to get the insight you need.</p>
          </div>

          <div class="steps-grid mt-14 grid gap-6 lg:grid-cols-3">
            {
              steps.map((step, index) => (
                <article class="step-card relative rounded-[28px] border border-[var(--color-border)] bg-white/90 p-7 shadow-[0_18px_50px_rgba(9,14,36,0.07)]">
                  <div class="flex items-center gap-4">
                    <span class="step-index">{index + 1}</span>
                    <h3 class="text-xl font-semibold tracking-[-0.03em] text-[var(--color-navy)]">
                      {step.title}
                    </h3>
                  </div>
                  <p class="mt-5 text-sm leading-7 text-[var(--color-muted-text)]">
                    {step.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="examples" class="scroll-mt-28 px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-eyebrow">Examples</p>
            <h2 class="section-title mt-4">Examples of what you can ask</h2>
          </div>

          <div class="mt-12 flex flex-wrap justify-center gap-3">
            {
              promptChips.map((prompt) => (
                <a href="/agent" class="prompt-chip">
                  {prompt}
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="scroll-mt-28 px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
            <div class="max-w-2xl">
              <p class="section-eyebrow">What it is good for</p>
              <h2 class="section-title mt-4">Built for questions spreadsheets make annoying</h2>
              <p class="section-copy mt-5">
                Fanalyx is for the moments when you need to understand a financial choice, but do
                not want to build a spreadsheet from scratch. Ask the question, adjust the
                assumptions, and get a clear explanation of the math.
              </p>
            </div>

            <div class="grid gap-6 md:grid-cols-3">
              {
                useCases.map((useCase, index) => (
                  <article class="feature-card">
                    <div
                      class="icon-shell"
                      set:html={
                        index === 0
                          ? iconMarkup.trending
                          : index === 1
                            ? iconMarkup['bar-chart']
                            : iconMarkup.brain
                      }
                    />
                    <h3 class="mt-6 text-xl font-semibold tracking-[-0.03em] text-[var(--color-navy)]">
                      {useCase.title}
                    </h3>
                    <p class="mt-3 text-sm leading-7 text-[var(--color-muted-text)]">
                      {useCase.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="bg-[var(--color-lavender)] px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="section-eyebrow">Built carefully</p>
            <h2 class="section-title mt-4">Built carefully for clearer financial thinking</h2>
          </div>

          <div class="mt-14 grid gap-6 md:grid-cols-3">
            {
              trustCards.map((card, index) => (
                <article class="feature-card">
                  <div
                    class="icon-shell"
                    set:html={
                      index === 0
                        ? iconMarkup.calculator
                        : index === 1
                          ? iconMarkup.shield
                          : iconMarkup.sparkles
                    }
                  />
                  <h3 class="mt-6 text-xl font-semibold tracking-[-0.03em] text-[var(--color-navy)]">
                    {card.title}
                  </h3>
                  <p class="mt-3 text-sm leading-7 text-[var(--color-muted-text)]">
                    {card.description}
                  </p>
                </article>
              ))
            }
          </div>

          <p
            class="mx-auto mt-10 max-w-4xl text-center text-sm leading-7 text-[var(--color-muted-text)]"
          >
            Fanalyx provides educational analysis and decision support. It is not a financial
            advisor, broker, tax professional, or legal advisor. Always verify important decisions
            with a qualified professional.
          </p>
        </div>
      </section>

      <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div
            class="final-cta relative overflow-hidden rounded-[32px] px-6 py-10 sm:px-10 sm:py-12 lg:px-14 lg:py-14"
          >
            <div class="relative grid gap-10 lg:grid-cols-[1fr_0.92fr] lg:items-center">
              <div>
                <p class="section-eyebrow !text-white/70">Start with one question</p>
                <h2 class="hero-title mt-4 max-w-2xl text-white !text-[clamp(2.6rem,5vw,4.4rem)]">
                  Better questions.
                  <br />
                  Better financial decisions.
                </h2>
                <p class="mt-5 max-w-2xl text-base leading-8 text-white/78">
                  Start with one question and see how much clearer your options become.
                </p>
              </div>

              <div class="rounded-[28px] border border-white/10 bg-white/8 p-4 backdrop-blur">
                <label class="sr-only" for="landing-email">Email</label>
                <div class="flex flex-col gap-3 sm:flex-row">
                  <input
                    id="landing-email"
                    type="email"
                    placeholder="Enter your email"
                    class="min-h-[58px] flex-1 rounded-[18px] border border-white/14 bg-white px-4 text-base text-[var(--color-navy)] outline-none ring-0 placeholder:text-[var(--color-soft-text)]"
                  />
                  <a
                    href="/agent"
                    class="primary-button inline-flex min-h-[58px] items-center justify-center whitespace-nowrap"
                  >
                    Try Fanalyx Free
                  </a>
                </div>
                <p class="mt-4 text-sm text-white/72">
                  No credit card required · Educational decision support only
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[var(--color-border)] bg-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.1fr_0.9fr_0.9fr_0.9fr]">
        <div class="max-w-sm">
          <a href="/" class="flex items-center gap-3" aria-label="Fanalyx home">
            <span class="brand-icon flex h-11 w-11 items-center justify-center rounded-2xl">F</span>
            <span class="text-lg font-semibold tracking-[-0.03em] text-[var(--color-navy)]">
              Fanalyx
            </span>
          </a>
          <p class="mt-5 text-sm leading-7 text-[var(--color-muted-text)]">
            AI-powered financial analysis for everyday decisions.
          </p>
        </div>

        <div>
          <h2
            class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-soft-text)]"
          >
            Product
          </h2>
          <ul class="mt-5 space-y-3 text-sm text-[var(--color-muted-text)]">
            <li><a href="#features" class="footer-link">Features</a></li>
            <li><a href="#examples" class="footer-link">Examples</a></li>
            <li><a href="/pricing" class="footer-link">Pricing</a></li>
          </ul>
        </div>

        <div>
          <h2
            class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-soft-text)]"
          >
            Company
          </h2>
          <ul class="mt-5 space-y-3 text-sm text-[var(--color-muted-text)]">
            <li><a href="#about" class="footer-link">About</a></li>
