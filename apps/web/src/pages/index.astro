---
import Layout from '../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@financial-analysis/ui';
import AdSense from '../components/AdSense.astro';
import fanalyxLogo from '../assets/fanalyx_favicon.png?url';

export const organizationLogo = fanalyxLogo;
---

<Layout title="Free Financial Calculators & AI Insights" description="29 free calculators for loans, savings, retirement, investments, and business planning. Get instant calculations plus AI-powered guidance.">
  <div class="min-h-screen bg-slate-950 text-white">
    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Financial Analysis',
        url: Astro.url.origin,
        description: 'Free financial calculators with AI-powered insights for loans, savings, retirement, investments, and business planning.'
      })}
    </script>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Financial Analysis',
        url: Astro.url.origin,
  logo: new URL(organizationLogo, Astro.url).toString(),
      })}
    </script>
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-linear-to-br from-blue-600/30 via-indigo-500/25 to-purple-500/20" aria-hidden="true" />
      <div class="absolute -top-40 -right-40 h-72 w-72 rounded-full bg-blue-500/40 blur-3xl" aria-hidden="true" />
      <div class="absolute -bottom-52 -left-32 h-96 w-96 rounded-full bg-indigo-500/30 blur-3xl" aria-hidden="true" />
      <div class="relative container mx-auto px-4 py-24 lg:py-32">
        <div class="max-w-4xl mx-auto text-center space-y-12">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-2 text-sm font-medium text-blue-100 shadow-lg shadow-blue-900/40">
            <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true" />
            Free financial calculators • AI-powered insights • No signup required
          </div>
          <div class="space-y-6">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-white">
              Free Financial
              <span class="block text-transparent bg-clip-text bg-linear-to-r from-sky-300 via-blue-200 to-indigo-300">
                Calculators & AI Insights
              </span>
            </h1>
            <p class="text-lg sm:text-xl text-slate-200/90 max-w-3xl mx-auto leading-relaxed">
              29 powerful calculators for mortgages, loans, savings, retirement, and business planning. 
              Get instant calculations plus AI-powered guidance to make smarter financial decisions.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/models"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-linear-to-r from-blue-500 to-indigo-500 px-8 py-3 text-base font-semibold text-white shadow-lg shadow-blue-900/40 transition-transform duration-300 hover:-translate-y-0.5"
            >
              Browse Calculators
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <a
              href="/journey"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 px-8 py-3 text-base font-semibold text-white/90 backdrop-blur transition hover:bg-white/10"
            >
              Start My Journey
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5" />
              </svg>
            </a>
          </div>
          <dl class="grid grid-cols-1 gap-6 sm:grid-cols-3 text-left">
            <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <dt class="text-sm font-medium text-slate-200/70">Financial Calculators</dt>
              <dd class="mt-3 text-3xl font-semibold text-white">29 tools</dd>
              <dd class="mt-2 text-xs text-slate-300/80">Covering personal finance, loans, investments, and business.</dd>
            </div>
            <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <dt class="text-sm font-medium text-slate-200/70">AI-Powered</dt>
              <dd class="mt-3 text-3xl font-semibold text-white">Instant</dd>
              <dd class="mt-2 text-xs text-slate-300/80">Get personalized guidance with every calculation.</dd>
            </div>
            <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <dt class="text-sm font-medium text-slate-200/70">100% Free</dt>
              <dd class="mt-3 text-3xl font-semibold text-white">No signup</dd>
              <dd class="mt-2 text-xs text-slate-300/80">Use all calculators immediately, no account required.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Feature Highlights -->
    <section class="py-24 bg-slate-950">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl text-center mx-auto mb-16 space-y-4">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-200/80">Everything You Need</p>
          <h2 class="text-4xl font-semibold text-white">Smart calculators that adapt to your goals</h2>
          <p class="text-base text-slate-300/90 leading-relaxed">
            From buying a home to planning retirement—get accurate calculations and personalized AI advice instantly.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <Card className="group bg-white/5 border-white/5 backdrop-blur-xl">
            <CardHeader>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-linear-to-br from-sky-500/30 to-indigo-500/30 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 10l5 5 5-5" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5h2a2 2 0 012 2v11a2 2 0 01-2 2h-2a2 2 0 01-2-2V7a2 2 0 012-2z" />
                </svg>
              </div>
              <CardTitle className="text-xl font-semibold text-white">Accurate Calculations</CardTitle>
            </CardHeader>
            <CardContent>
              <CardDescription className="text-slate-300/90">
                Professional-grade financial calculations with precise math. Every result is verified and reproducible.
              </CardDescription>
            </CardContent>
          </Card>

          <Card className="group bg-white/5 border-white/5 backdrop-blur-xl">
            <CardHeader>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-linear-to-br from-emerald-500/30 to-blue-500/30 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h3l3 8 4-16 3 8h5" />
                </svg>
              </div>
              <CardTitle className="text-xl font-semibold text-white">Instant Results</CardTitle>
            </CardHeader>
            <CardContent>
              <CardDescription className="text-slate-300/90">
                Get your answers <span class="text-white">instantly</span>. No waiting, no loading screens. Just fast, reliable calculations.
              </CardDescription>
            </CardContent>
          </Card>

          <Card className="group bg-white/5 border-white/5 backdrop-blur-xl">
            <CardHeader>
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-linear-to-br from-purple-500/30 to-pink-500/30 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
                  <circle cx="12" cy="12" r="9" />
                </svg>
              </div>
              <CardTitle className="text-xl font-semibold text-white">AI-Powered Guidance</CardTitle>
            </CardHeader>
            <CardContent>
              <CardDescription className="text-slate-300/90">
                Get personalized recommendations and insights. Our AI understands your situation and provides actionable advice.
              </CardDescription>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    <!-- Workflow Section -->
  <section class="py-24 bg-linear-to-b from-slate-950 to-slate-900">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
          <div class="lg:col-span-1 space-y-6">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-200/80">How It Works</p>
            <h2 class="text-4xl font-semibold text-white">Simple, fast, and helpful—in three steps</h2>
            <p class="text-base text-slate-300/90 leading-relaxed">
              Choose your calculator, enter your information, and get instant answers plus personalized AI guidance.
            </p>
            <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <p class="text-sm text-slate-200/80">"Finally, financial calculators that actually help me make decisions. The AI guidance is incredibly thoughtful."</p>
              <p class="mt-4 text-xs uppercase tracking-[0.2em] text-slate-300">Real User</p>
            </div>
          </div>
          <div class="lg:col-span-2 grid grid-cols-1 gap-6">
            <div class="flex gap-4 rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-500/40 text-white font-semibold">1</div>
              <div class="space-y-2">
                <h3 class="text-xl font-semibold text-white">Pick Your Calculator</h3>
                <p class="text-sm text-slate-300/90">Choose from 29 calculators for loans, savings, retirement, investments, or business planning.</p>
                <div class="inline-flex items-center gap-3 text-xs text-blue-200/80">
                  <span class="rounded-full bg-white/10 px-3 py-1">29 Calculators</span>
                  <span class="rounded-full bg-white/10 px-3 py-1">All Free</span>
                </div>
              </div>
            </div>
            <div class="flex gap-4 rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-500/40 text-white font-semibold">2</div>
              <div class="space-y-2">
                <h3 class="text-xl font-semibold text-white">Enter Your Info</h3>
                <p class="text-sm text-slate-300/90">Quick and easy forms guide you through. No confusing fields—just clear questions.</p>
                <div class="inline-flex items-center gap-3 text-xs text-blue-200/80">
                  <span class="rounded-full bg-white/10 px-3 py-1">Simple Forms</span>
                  <span class="rounded-full bg-white/10 px-3 py-1">Safe & Private</span>
                </div>
              </div>
            </div>
            <div class="flex gap-4 rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-purple-500/40 text-white font-semibold">3</div>
              <div class="space-y-2">
                <h3 class="text-xl font-semibold text-white">Get Instant Results</h3>
                <p class="text-sm text-slate-300/90">See your calculations immediately, then chat with AI to understand what they mean for your goals.</p>
                <div class="inline-flex items-center gap-3 text-xs text-blue-200/80">
                  <span class="rounded-full bg-white/10 px-3 py-1">Instant Answers</span>
                  <span class="rounded-full bg-white/10 px-3 py-1">AI Guidance</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-24">
      <div class="container mx-auto px-4">
  <div class="rounded-4xl relative overflow-hidden border border-white/10 bg-linear-to-r from-blue-600 to-indigo-600 px-8 py-16 sm:px-16">
          <div class="absolute inset-0 opacity-40" aria-hidden="true">
            <div class="absolute -top-24 -left-24 h-48 w-48 rounded-full bg-white/40 blur-3xl" />
            <div class="absolute bottom-0 right-0 h-52 w-52 rounded-full bg-indigo-400/50 blur-3xl" />
          </div>
          <div class="relative grid gap-8 lg:grid-cols-[1.25fr,1fr] items-center">
            <div class="space-y-4">
              <h2 class="text-3xl sm:text-4xl font-semibold text-white">Get started in seconds</h2>
              <p class="text-sm sm:text-base text-white/80 max-w-xl">
                Browse our calculators or start a personalized financial journey. No signup, no credit card—just helpful tools.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/models"
                  class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-7 py-3 text-sm font-semibold text-blue-600 shadow-lg shadow-blue-900/40 hover:shadow-xl hover:-translate-y-0.5 transition"
                >
                  View All Calculators
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M3.172 7l5.657-5.657a4 4 0 015.657 0L18.828 6.4a4 4 0 010 5.657l-5.656 5.657A4 4 0 017.515 16.4L1.858 10.743a2 2 0 010-2.828z" clip-rule="evenodd" />
                  </svg>
                </a>
                <a
                  href="/journey"
                  class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-7 py-3 text-sm font-semibold text-white/90 backdrop-blur hover:bg-white/10 transition"
                >
                  Start My Journey
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </a>
              </div>
            </div>
            <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
              <dl class="space-y-4">
                <div class="flex items-center justify-between">
                  <dt class="text-sm text-white/70">100% Free</dt>
                  <dd class="text-lg font-semibold text-white">Forever</dd>
                </div>
                <div class="flex items-center justify-between">
                  <dt class="text-sm text-white/70">29 Calculators</dt>
                  <dd class="text-lg font-semibold text-white">Always Growing</dd>
                </div>
                <div class="flex items-center justify-between">
                  <dt class="text-sm text-white/70">AI Guidance</dt>
                  <dd class="text-lg font-semibold text-white">Included</dd>
                </div>
                <div class="flex items-center justify-between">
                  <dt class="text-sm text-white/70">Privacy First</dt>
                  <dd class="text-lg font-semibold text-white">No Tracking</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AdSense: Bottom of page ad -->
    <AdSense slot="1234567890" format="horizontal" className="max-w-6xl mx-auto px-4" />
  </div>
</Layout>