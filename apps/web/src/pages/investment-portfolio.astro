---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Investment Portfolio Analyzer - Portfolio Rebalancing & Analysis | Fanalyx" 
  description="Comprehensive investment portfolio analysis with allocation analysis, rebalancing recommendations, diversification assessment, risk analysis, and performance projections."
  keywords="investment portfolio, portfolio analysis, portfolio rebalancing, asset allocation, diversification, investment strategy, portfolio optimization"
  canonical={Astro.url.href}
  type="article"
>
  <!-- Structured Data for SEO -->
  <StructuredData 
    type="breadcrumb" 
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Personal Finance', url: '/models/personal' },
      { name: 'Investment Portfolio', url: '/investment-portfolio' }
    ]}
  />
  
  <StructuredData 
    type="software" 
    softwareApp={{
      name: 'Investment Portfolio Analyzer',
      description: 'Comprehensive portfolio analysis tool with allocation analysis, rebalancing recommendations, diversification assessment, and risk analysis.',
      category: 'FinanceApplication',
      rating: 4.8,
      ratingCount: 190
    }}
  />
  
  <StructuredData 
    type="faq" 
    faqs={[
      {
        question: 'What is portfolio rebalancing and why is it important?',
        answer: 'Rebalancing involves adjusting your portfolio back to target allocations when market movements cause drift. It helps maintain your desired risk level and can improve returns by selling high and buying low. Our analyzer identifies when and how to rebalance your portfolio.'
      },
      {
        question: 'What is asset allocation and how do I choose the right one?',
        answer: 'Asset allocation is how you divide investments between stocks, bonds, cash, and alternatives. The right allocation depends on your age, risk tolerance, time horizon, and financial goals. A common rule is "100 minus your age" in stocks, but our calculator provides personalized recommendations.'
      },
      {
        question: 'How do I know if my portfolio is diversified?',
        answer: 'A well-diversified portfolio spreads investments across different asset classes, sectors, and geographies. Our analyzer checks sector concentration, asset class diversity, and provides recommendations to improve diversification and reduce risk.'
      },
      {
        question: 'What is portfolio drift and when should I rebalance?',
        answer: 'Portfolio drift occurs when market movements change your actual allocation away from your target. Rebalance when drift exceeds 5-10% or on a regular schedule (quarterly or annually). Our calculator identifies specific rebalancing actions needed.'
      },
      {
        question: 'How do I optimize my investment portfolio?',
        answer: 'Portfolio optimization involves aligning your current allocation with your target, ensuring proper diversification, managing risk, and maximizing tax efficiency. Our analyzer provides specific recommendations for buying/selling to optimize your portfolio.'
      }
    ]}
  />

  <div class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-white">Investment Portfolio Analyzer</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        Analyze and optimize your investment portfolio with allocation analysis and rebalancing recommendations
      </p>

      <!-- Investment Portfolio Form -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold mb-6 text-gray-900 dark:text-white">Portfolio Information</h2>

        <form id="investment-portfolio-form" class="space-y-6">
          <!-- Personal Info Section -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="age" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Age
              </label>
              <input
                type="number"
                id="age"
                name="age"
                min="18"
                max="100"
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
                placeholder="35"
                required
              />
            </div>

            <div>
              <label for="totalValue" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Total Portfolio Value ($)
              </label>
              <input
                type="number"
                id="totalValue"
                name="totalValue"
                min="0"
                step="1000"
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
                placeholder="100000"
                required
              />
            </div>
          </div>

          <!-- Target Allocation Section -->
          <div class="border-t border-gray-200 dark:border-gray-700 pt-6 mt-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Target Allocation</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="targetStocks" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Stocks (%)
                </label>
                <input
                  type="number"
                  id="targetStocks"
                  name="targetStocks"
                  min="0"
                  max="100"
                  step="5"
                  value="70"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
                />
              </div>

              <div>
                <label for="targetBonds" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Bonds (%)
                </label>
                <input
                  type="number"
                  id="targetBonds"
                  name="targetBonds"
                  min="0"
                  max="100"
                  step="5"
                  value="20"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
                />
              </div>

              <div>
                <label for="targetCash" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Cash (%)
                </label>
                <input
                  type="number"
                  id="targetCash"
                  name="targetCash"
                  min="0"
                  max="100"
                  step="5"
                  value="10"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
                />
              </div>

              <div>
                <label for="riskTolerance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Risk Tolerance
                </label>
                <select
                  id="riskTolerance"
                  name="riskTolerance"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:text-white"
                  required
                >
                  <option value="conservative">Conservative</option>
                  <option value="moderate" selected>Moderate</option>
                  <option value="aggressive">Aggressive</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="flex justify-end pt-6 border-t border-gray-200 dark:border-gray-700 mt-6">
            <button
              type="submit"
              class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-md shadow-sm transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
            >
              Analyze Portfolio
            </button>
          </div>
        </form>
      </div>

      <!-- Results Section -->
      <div id="portfolio-results" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold mb-4 text-gray-900 dark:text-white">Portfolio Analysis Results</h2>
        <div id="portfolio-results-content" class="space-y-4"></div>
      </div>

      <!-- AdSense -->
      <AdSense slot="0123456789" format="horizontal" className="mt-8" />
    </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name="investment-portfolio" />
</Layout>
