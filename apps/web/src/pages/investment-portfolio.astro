---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
import ToolPageShell from '../components/site/ToolPageShell.astro';
import WorkflowSupportRail from '../components/WorkflowSupportRail.astro';
---

<Layout
  title="Investment Portfolio Analyzer - Portfolio Rebalancing & Analysis | Fanalyx"
  description="Comprehensive investment portfolio analysis with allocation analysis, rebalancing recommendations, diversification assessment, risk analysis, and performance projections."
  keywords="investment portfolio, portfolio analysis, portfolio rebalancing, asset allocation, diversification, investment strategy, portfolio optimization"
  canonical={Astro.url.href}
  type="article"

  showChat={false}
  showToolAnalysis={false}
>
  <!-- Structured Data for SEO -->
  <StructuredData
    type="breadcrumb"
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Personal Finance', url: '/models/personal' },
      { name: 'Investment Portfolio', url: '/investment-portfolio' },
    ]}
  />

  <StructuredData
    type="software"
    softwareApp={{
      name: 'Investment Portfolio Analyzer',
      description:
        'Comprehensive portfolio analysis tool with allocation analysis, rebalancing recommendations, diversification assessment, and risk analysis.',
      category: 'FinanceApplication',
      rating: 4.8,
      ratingCount: 190,
    }}
  />

  <StructuredData
    type="faq"
    faqs={[
      {
        question: 'What is portfolio rebalancing and why is it important?',
        answer:
          'Rebalancing involves adjusting your portfolio back to target allocations when market movements cause drift. It helps maintain your desired risk level and can improve returns by selling high and buying low. Our analyzer identifies when and how to rebalance your portfolio.',
      },
      {
        question: 'What is asset allocation and how do I choose the right one?',
        answer:
          'Asset allocation is how you divide investments between stocks, bonds, cash, and alternatives. The right allocation depends on your age, risk tolerance, time horizon, and financial goals. A common rule is "100 minus your age" in stocks, but our calculator provides personalized recommendations.',
      },
      {
        question: 'How do I know if my portfolio is diversified?',
        answer:
          'A well-diversified portfolio spreads investments across different asset classes, sectors, and geographies. Our analyzer checks sector concentration, asset class diversity, and provides recommendations to improve diversification and reduce risk.',
      },
      {
        question: 'What is portfolio drift and when should I rebalance?',
        answer:
          'Portfolio drift occurs when market movements change your actual allocation away from your target. Rebalance when drift exceeds 5-10% or on a regular schedule (quarterly or annually). Our calculator identifies specific rebalancing actions needed.',
      },
      {
        question: 'How do I optimize my investment portfolio?',
        answer:
          'Portfolio optimization involves aligning your current allocation with your target, ensuring proper diversification, managing risk, and maximizing tax efficiency. Our analyzer provides specific recommendations for buying/selling to optimize your portfolio.',
      },
    ]}
  />

  <ToolPageShell
    eyebrow="Personal finance"
    title="Investment Portfolio Analyzer"
    description="Analyze and optimize your investment portfolio with allocation analysis and rebalancing recommendations"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Models', href: '/models' },
      { label: 'Personal Finance', href: '/models/personal' },
      { label: 'Investment Portfolio' },
    ]}
  >
    <div id="results" class="hidden" aria-hidden="true"></div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1.55fr)_minmax(320px,0.95fr)]">
      <div class="space-y-8">
    <!-- Investment Portfolio Form -->
    <div class="fa-card p-6 mb-8">
      <h2 class="fa-panel-title mb-6">
        Portfolio Information
      </h2>

      <form id="investment-portfolio-form" class="space-y-6">
        <!-- Personal Info Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label
              for="age"
              class="fa-field-label mb-2"
            >
              Age
            </label>
            <input
              type="number"
              id="age"
              name="age"
              min="18"
              max="100"
              class="fa-input-surface w-full"
              placeholder="35"
              required
            />
          </div>

          <div>
            <label
              for="totalValue"
              class="fa-field-label mb-2"
            >
              Total Portfolio Value ($)
            </label>
            <input
              type="number"
              id="totalValue"
              name="totalValue"
              min="0"
              step="1000"
              class="fa-input-surface w-full"
              placeholder="100000"
              required
            />
          </div>
        </div>

        <!-- Target Allocation Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">
            Target Allocation
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="targetStocks"
                class="fa-field-label mb-2"
              >
                Stocks (%)
              </label>
              <input
                type="number"
                id="targetStocks"
                name="targetStocks"
                min="0"
                max="100"
                step="5"
                value="70"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="targetBonds"
                class="fa-field-label mb-2"
              >
                Bonds (%)
              </label>
              <input
                type="number"
                id="targetBonds"
                name="targetBonds"
                min="0"
                max="100"
                step="5"
                value="20"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="targetCash"
                class="fa-field-label mb-2"
              >
                Cash (%)
              </label>
              <input
                type="number"
                id="targetCash"
                name="targetCash"
                min="0"
                max="100"
                step="5"
                value="10"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="riskTolerance"
                class="fa-field-label mb-2"
              >
                Risk Tolerance
              </label>
              <select
                id="riskTolerance"
                name="riskTolerance"
                class="fa-input-surface w-full"
                required
              >
                <option value="conservative">Conservative</option>
                <option value="moderate" selected>Moderate</option>
                <option value="aggressive">Aggressive</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-6 fa-panel-divider-top mt-6">
          <button type="submit" class="fa-button-primary"> Analyze Portfolio </button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <div id="portfolio-results" class="fa-card hidden p-6 mb-8">
      <h2 class="fa-panel-title text-xl mb-4">
        Portfolio Analysis Results
      </h2>
      <div id="portfolio-summary-cards" class="grid grid-cols-1 gap-4 md:grid-cols-2 mb-6"></div>
      <div id="portfolio-results-content" class="space-y-4"></div>
    </div>

    <!-- AdSense -->
    <AdSense slot="0123456789" format="horizontal" className="mt-8" />
      </div>

      <WorkflowSupportRail modelType="investment-portfolio" />
    </div>
  </ToolPageShell>

  <ClientScriptLoader client:load slot="pageScripts" name="investment-portfolio" />
</Layout>
