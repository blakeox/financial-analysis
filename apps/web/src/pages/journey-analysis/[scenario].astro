---
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import PageHero from '../../components/site/PageHero.astro';
import SurfaceCard from '../../components/site/SurfaceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getJourneyData } from '../../utils/journeyData';
import JourneyAnalysisResults from '../../components/JourneyAnalysisResults.tsx';
import type { JourneyData, JourneyScenario } from '../../utils/journeyData';

type JourneyAnalysisContext = {
  scenarioId: string;
  journeyName: string;
  completedSteps: number;
  isJourneyAnalysis: boolean;
};

/* eslint-disable no-unused-vars */
declare global {
  interface Window {
    journeyAnalysisContext?: JourneyAnalysisContext;
  }
}
/* eslint-enable no-unused-vars */

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths = Object.keys(journeyData).map((scenarioId) => ({
    params: { scenario: scenarioId },
  }));

  return paths;
}

export interface Props {
  scenario: string;
}

const { scenario } = Astro.params as Props;

// Get journey data
const journeyData: JourneyData = getJourneyData();
const journey: JourneyScenario | undefined = journeyData[scenario];

if (!journey) {
  throw new Error(`Journey not found: ${scenario}`);
}

// SEO-optimized content
const seoTitle = `${journey.name} - Complete Financial Analysis`;
const seoDescription = `Complete analysis of your ${journey.name.toLowerCase()} journey with AI-powered insights and recommendations.`;
const journeyName = journey.name;
const totalSteps = journey.models.length;
const journeyScript = `
  if (typeof window !== 'undefined') {
    const context = {
      scenarioId: ${JSON.stringify(scenario)},
      journeyName: ${JSON.stringify(journeyName)},
      completedSteps: ${totalSteps},
      isJourneyAnalysis: true
    };

    window.journeyAnalysisContext = context;

    window.dispatchEvent(
      new CustomEvent('journey-analysis-context-loaded', {
        detail: context
      })
    );

    window.dispatchEvent(
      new CustomEvent('journey-analytics', {
        detail: {
          event: 'journey_analysis_viewed',
          properties: {
            scenario_id: ${JSON.stringify(scenario)},
            journey_name: ${JSON.stringify(journeyName)},
            total_steps: ${totalSteps},
            timestamp: new Date().toISOString()
          }
        }
      })
    );
  }
`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: journey.name, href: `/journey/${scenario}` },
      { label: 'Analysis' },
    ]}
  />

  <div class="fa-page-shell">
      <!-- Journey Completion Header -->
      <div class="fa-highlight-card mb-8">
        <div class="text-center">
          <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-success mx-auto mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <PageHero
            eyebrow="Journey complete"
            title="🎉 Journey Complete!"
            description={`You've successfully completed the ${journey.name} financial journey`}
          />
          <div class="fa-chip fa-chip-success text-sm">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z" clip-rule="evenodd" />
            </svg>
            All {journey.models.length} steps completed
          </div>
        </div>
      </div>

      <!-- Journey Summary -->
      <SurfaceCard className="mb-8">
        <h2 class="fa-panel-title mb-4">Journey Summary</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {journey.models.map((model, index) => (
            <div class="fa-highlight-card">
              <h3 class="fa-scenario-title mb-2">{model.name}</h3>
              <p class="fa-meta-copy mb-2 text-sm">{model.description}</p>
              <div class="flex items-center text-sm text-emerald-600 dark:text-emerald-300">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z" clip-rule="evenodd" />
                </svg>
                Step {index + 1} - Completed
              </div>
            </div>
          ))}
        </div>
      </SurfaceCard>

      <!-- AI-Powered Analysis -->
      <JourneyAnalysisResults 
        scenarioId={scenario}
        journeyData={journey}
        className="mb-8"
      />

      <!-- Action Buttons -->
      <SurfaceCard>
        <h2 class="fa-panel-title mb-4">What's Next?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a 
            href="/journey" 
            class="fa-button-primary justify-center"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Explore More Journeys
          </a>
          <a 
            href="/models" 
            class="fa-button-secondary justify-center"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            Browse Individual Calculators
          </a>
        </div>
      </SurfaceCard>
  </div>

  <!-- Client Scripts -->
  <script is:inline set:html={journeyScript}></script>
</Layout>
