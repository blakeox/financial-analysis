---
import Layout from '../../layouts/Layout.astro';
import { getJourneyData } from '../../utils/journeyData';
import JourneyAnalysisResults from '../../components/JourneyAnalysisResults.tsx';
import type { JourneyData, JourneyScenario } from '../../utils/journeyData';

type JourneyAnalysisContext = {
  scenarioId: string;
  journeyName: string;
  completedSteps: number;
  isJourneyAnalysis: boolean;
};

/* eslint-disable no-unused-vars */
declare global {
  interface Window {
    journeyAnalysisContext?: JourneyAnalysisContext;
  }
}
/* eslint-enable no-unused-vars */

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths = Object.keys(journeyData).map((scenarioId) => ({
    params: { scenario: scenarioId },
  }));

  return paths;
}

export interface Props {
  scenario: string;
}

const { scenario } = Astro.params as Props;

// Get journey data
const journeyData: JourneyData = getJourneyData();
const journey: JourneyScenario | undefined = journeyData[scenario];

if (!journey) {
  throw new Error(`Journey not found: ${scenario}`);
}

// SEO-optimized content
const seoTitle = `${journey.name} - Complete Financial Analysis`;
const seoDescription = `Complete analysis of your ${journey.name.toLowerCase()} journey with AI-powered insights and recommendations.`;
const journeyName = journey.name;
const totalSteps = journey.models.length;
const journeyScript = `
  if (typeof window !== 'undefined') {
    const context = {
      scenarioId: ${JSON.stringify(scenario)},
      journeyName: ${JSON.stringify(journeyName)},
      completedSteps: ${totalSteps},
      isJourneyAnalysis: true
    };

    window.journeyAnalysisContext = context;

    window.dispatchEvent(
      new CustomEvent('journey-analysis-context-loaded', {
        detail: context
      })
    );

    window.dispatchEvent(
      new CustomEvent('journey-analytics', {
        detail: {
          event: 'journey_analysis_viewed',
          properties: {
            scenario_id: ${JSON.stringify(scenario)},
            journey_name: ${JSON.stringify(journeyName)},
            total_steps: ${totalSteps},
            timestamp: new Date().toISOString()
          }
        }
      })
    );
  }
`;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey" class="hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href={`/journey/${scenario}`} class="hover:text-gray-700 dark:hover:text-gray-300">{journey.name}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">Analysis</span>
          </li>
        </ol>
      </nav>

      <!-- Journey Completion Header -->
      <div class="bg-linear-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg shadow-md p-8 mb-8">
        <div class="text-center">
          <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 dark:bg-green-900/30 mb-4">
            <svg class="h-8 w-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
            🎉 Journey Complete!
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
            You've successfully completed the <strong>{journey.name}</strong> financial journey
          </p>
          <div class="inline-flex items-center px-4 py-2 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-200 rounded-full text-sm font-medium">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z" clip-rule="evenodd" />
            </svg>
            All {journey.models.length} steps completed
          </div>
        </div>
      </div>

      <!-- Journey Summary -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Journey Summary</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {journey.models.map((model, index) => (
            <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
              <h3 class="font-medium text-gray-900 dark:text-white mb-2">{model.name}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">{model.description}</p>
              <div class="flex items-center text-sm text-green-600 dark:text-green-400">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z" clip-rule="evenodd" />
                </svg>
                Step {index + 1} - Completed
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- AI-Powered Analysis -->
      <JourneyAnalysisResults 
        scenarioId={scenario}
        journeyData={journey}
        className="mb-8"
      />

      <!-- Action Buttons -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">What's Next?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a 
            href="/journey" 
            class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Explore More Journeys
          </a>
          <a 
            href="/models" 
            class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-lg transition-colors duration-200"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            Browse Individual Calculators
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Client Scripts -->
  <script is:inline set:html={journeyScript}></script>
</Layout>