---
import Layout from '../layouts/Layout.astro';
import { StorageUsageCard } from '@financial-analysis/ui';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL || 'http://127.0.0.1:8787';
---

<Layout title="Debug Navbar" description="Debug page for testing navbar functionality" noindex={true} showNav={false}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Debug Navbar' }]} />

  <div class="fa-page-shell">
    <PageHero
      eyebrow="Debug"
      title="Debug Navbar"
      description="A shell for testing layout utilities, responsive classes, and the isolated manual navbar without the shared site nav."
    />

    <div class="grid gap-6 lg:grid-cols-2">
      <SurfaceCard title="Basic Tailwind Test">
        <div class="mt-4 rounded-2xl bg-blue-500 p-4 text-white">
          If you can see this blue box with white text, Tailwind is working.
        </div>
      </SurfaceCard>

      <SurfaceCard title="Responsive Test">
        <div class="mt-4 rounded-2xl bg-red-500 p-4 text-white sm:bg-green-500 md:bg-blue-500 lg:bg-purple-500">
          <p>This box changes color based on screen size:</p>
          <ul class="mt-2 list-inside list-disc">
            <li>Red on mobile (default)</li>
            <li>Green on small screens (sm: 640px+)</li>
            <li>Blue on medium screens (md: 768px+)</li>
            <li>Purple on large screens (lg: 1024px+)</li>
          </ul>
        </div>
      </SurfaceCard>

      <SurfaceCard title="Hidden/Flex Test">
        <div class="mt-4 space-y-3">
          <div class="hidden rounded-2xl bg-green-100 p-4 text-green-800 sm:block">
            This should be hidden on mobile and visible on sm+ screens.
          </div>
          <div class="block rounded-2xl bg-red-100 p-4 text-red-800 sm:hidden">
            This should be visible on mobile and hidden on sm+ screens.
          </div>
        </div>
      </SurfaceCard>

      <SurfaceCard title="Storage Usage">
        <div class="mt-4">
          <StorageUsageCard client:idle apiBase={apiBase} />
        </div>
      </SurfaceCard>
    </div>

    <SurfaceCard title="Manual Navbar Test" className="mt-6">
      <nav class="mt-4 rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-8">
            <span class="text-xl font-bold text-blue-600">Test Brand</span>
            <div class="hidden sm:flex sm:space-x-8">
              <a href="#" class="fa-tab-button fa-tab-active !px-1 !pt-1">Home</a>
              <a href="#" class="fa-tab-button fa-tab-inactive !px-1 !pt-1 border-b-2 border-transparent">Models</a>
              <a href="#" class="fa-tab-button fa-tab-inactive !px-1 !pt-1 border-b-2 border-transparent">Analysis</a>
            </div>
          </div>
          <div class="flex items-center sm:hidden">
            <button type="button" class="inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500">
              <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </nav>
    </SurfaceCard>

    <div class="fixed bottom-4 right-4 rounded-xl bg-black px-3 py-2 text-sm text-white shadow-lg">
      <span class="sm:hidden">XS</span>
      <span class="hidden sm:inline md:hidden">SM</span>
      <span class="hidden md:inline lg:hidden">MD</span>
      <span class="hidden lg:inline xl:hidden">LG</span>
      <span class="hidden xl:inline">XL</span>
    </div>
  </div>
</Layout>
