---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';

// FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I calculate how much to save each month?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Enter your savings goal amount, target date, current savings, and expected interest rate. Our calculator shows exactly how much you need to save monthly to reach your goal, accounting for compound interest growth."
      }
    },
    {
      "@type": "Question",
      "name": "What's a realistic savings interest rate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High-yield savings accounts currently offer 4-5% APY. Money market accounts and short-term CDs offer similar rates. For longer-term goals (5+ years), consider investment accounts which historically return 7-10% annually but with more risk."
      }
    },
    {
      "@type": "Question",
      "name": "Should I adjust my savings goal for inflation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, especially for long-term goals. With average inflation around 3% per year, a $50,000 goal in 10 years really needs about $67,000 in today's purchasing power. Our calculator includes inflation adjustment to show the real amount you need to save."
      }
    },
    {
      "@type": "Question",
      "name": "How does compound interest help my savings grow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Compound interest earns interest on your interest, accelerating growth over time. For example, saving $500/month at 5% grows to about $78,000 in 10 years - $18,000 more than simple deposits alone. The longer you save, the more powerful compounding becomes."
      }
    }
  ]
};
---

<Layout 
  title="Savings Goal Planner" 
  description="Plan and track progress toward financial goals with compound interest calculations and inflation adjustments"
  canonical={Astro.url.href}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center mb-4">
            <a href="/models/personal" class="mr-4 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
            </a>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
              Savings Goal Planner
            </h1>
          </div>
          <p class="text-gray-600 dark:text-gray-300">
            Calculate how long it takes to reach your savings goal with compound interest and inflation adjustments
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Input Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Goal Details</h2>
            
            <form id="savings-goal-form" class="space-y-6">
              <!-- Goal Amount -->
              <div>
                <label for="goalAmount" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Savings Goal
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-gray-500">$</span>
                  <input
                    type="number"
                    id="goalAmount"
                    name="goalAmount"
                    value="50000"
                    min="100"
                    max="10000000"
                    step="100"
                    required
                    class="w-full pl-8 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  />
                </div>
                <p class="text-xs text-gray-500 mt-1">The amount you want to save</p>
              </div>

              <!-- Current Savings -->
              <div>
                <label for="currentSavings" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Current Savings
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-gray-500">$</span>
                  <input
                    type="number"
                    id="currentSavings"
                    name="currentSavings"
                    value="5000"
                    min="0"
                    step="100"
                    required
                    class="w-full pl-8 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  />
                </div>
              </div>

              <!-- Monthly Contribution -->
              <div>
                <label for="monthlyContribution" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Monthly Contribution
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-gray-500">$</span>
                  <input
                    type="number"
                    id="monthlyContribution"
                    name="monthlyContribution"
                    value="1000"
                    min="0"
                    step="10"
                    required
                    class="w-full pl-8 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  />
                </div>
              </div>

              <!-- Annual Interest Rate -->
              <div>
                <label for="annualInterestRate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Annual Return Rate
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="annualInterestRate"
                    name="annualInterestRate"
                    value="5.0"
                    min="0"
                    max="100"
                    step="0.1"
                    required
                    class="w-full pr-8 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  />
                  <span class="absolute right-3 top-2 text-gray-500">%</span>
                </div>
                <p class="text-xs text-gray-500 mt-1">Expected annual rate of return on savings</p>
              </div>

              <!-- Annual Inflation Rate -->
              <div>
                <label for="annualInflationRate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Inflation Rate
                </label>
                <div class="relative">
                  <input
                    type="number"
                    id="annualInflationRate"
                    name="annualInflationRate"
                    value="3.0"
                    min="0"
                    max="20"
                    step="0.1"
                    class="w-full pr-8 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  />
                  <span class="absolute right-3 top-2 text-gray-500">%</span>
                </div>
                <p class="text-xs text-gray-500 mt-1">Adjust for inflation (optional)</p>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-4">
                <button
                  type="submit"
                  id="calculate-btn"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition"
                >
                  Calculate
                </button>
                <button
                  type="button"
                  id="reset-btn"
                  class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition"
                >
                  Reset
                </button>
              </div>
            </form>

            <!-- Loading State -->
            <div id="loading" class="hidden mt-6 text-center">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
              <p class="text-gray-600 dark:text-gray-400 mt-2">Calculating...</p>
            </div>

            <!-- Error State -->
            <div id="error" class="hidden mt-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
              <p class="text-red-800 dark:text-red-200" id="error-message"></p>
            </div>
          </div>

          <!-- Results -->
          <div>
            <div id="results" class="hidden space-y-6">
              <!-- Summary Cards -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Timeline</h3>
                <div class="space-y-4">
                  <div class="flex justify-between items-center pb-3 border-b border-gray-200 dark:border-gray-700">
                    <span class="text-gray-600 dark:text-gray-400">Months to Goal</span>
                    <span id="months-to-goal" class="text-2xl font-bold text-blue-600 dark:text-blue-400"></span>
                  </div>
                  <div class="flex justify-between items-center pb-3 border-b border-gray-200 dark:border-gray-700">
                    <span class="text-gray-600 dark:text-gray-400">Years</span>
                    <span id="years-to-goal" class="text-lg font-semibold text-gray-900 dark:text-white"></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-600 dark:text-gray-400">Target Date</span>
                    <span id="target-date" class="text-lg font-semibold text-gray-900 dark:text-white"></span>
                  </div>
                </div>
              </div>

              <!-- Financial Breakdown -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Financial Breakdown</h3>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Saved</span>
                    <span id="total-saved" class="font-semibold text-gray-900 dark:text-white"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Your Contributions</span>
                    <span id="total-contributions" class="font-semibold text-gray-900 dark:text-white"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Interest Earned</span>
                    <span id="total-interest" class="font-semibold text-green-600 dark:text-green-400"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Effective Rate</span>
                    <span id="effective-rate" class="font-semibold text-gray-900 dark:text-white"></span>
                  </div>
                </div>
              </div>

              <!-- Recommendations -->
              <div id="recommendations" class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">💡 Recommendations</h3>
                <ul id="recommendations-list" class="space-y-2"></ul>
              </div>

              <!-- Chat Button -->
              <button
                id="savings-goal-chat-button"
                type="button"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-md transition flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                Ask AI about this analysis
              </button>
            </div>

            <!-- AdSense: After results ad -->
            <AdSense slot="4567890123" format="auto" className="mt-6" />
          </div>
        </div>
      </div>
    </div>
  </div>

    <AdSense slot="9012345678" format="horizontal" className="container mx-auto px-4 mb-8" />

    <ClientScriptLoader client:load slot="pageScripts" name="savingsGoal" />
  </Layout>
