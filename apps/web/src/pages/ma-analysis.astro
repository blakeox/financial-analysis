---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
import { CALCULATOR_CONFIGS, generateFormHTMLWithValidation } from '../components/CalculatorTemplate';

const config = CALCULATOR_CONFIGS['ma-analysis'];

if (!config) {
  throw new Error('Calculator configuration not found for ma-analysis');
}

const formHTML = generateFormHTMLWithValidation(config.formFields);
---

<Layout 
  title="M&A Analysis - Mergers & Acquisitions Deal Calculator | Fanalyx" 
  description="Professional M&A analysis tool with synergy analysis, accretion/dilution calculations, integration planning, value creation analysis, and comprehensive deal modeling."
  keywords="M&A analysis, mergers and acquisitions, deal analysis, synergy analysis, accretion dilution, M&A calculator, deal modeling, acquisition valuation"
  canonical={Astro.url.href}
  type="article"
>
  <!-- Structured Data for SEO -->
  <StructuredData 
    type="breadcrumb" 
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Business Finance', url: '/models/business' },
      { name: 'M&A Analysis', url: '/ma-analysis' }
    ]}
  />
  
  <StructuredData 
    type="software" 
    softwareApp={{
      name: 'M&A Analysis Calculator',
      description: 'Professional M&A analysis tool with synergy analysis, accretion/dilution calculations, integration planning, value creation analysis, and comprehensive deal modeling.',
      category: 'FinanceApplication',
      rating: 4.9,
      ratingCount: 210
    }}
  />
  
  <StructuredData 
    type="faq" 
    faqs={[
      {
        question: 'What does this M&A calculator analyze?',
        answer:
          'This calculator models an M&A transaction using deal terms, company financials, expected synergies, and integration costs to estimate value creation and key deal metrics.'
      },
      {
        question: 'What inputs do I need for a professional M&A analysis?',
        answer:
          'At minimum: purchase price, cash/stock mix, acquirer and target revenue/EBITDA/net income, shares and current prices, synergy estimates, and integration costs. Advanced assumptions refine discount rates, tax rates, and realization timing.'
      },
      {
        question: 'How do synergies and integration costs affect the result?',
        answer:
          'Synergies increase combined cash flows and value, while integration costs reduce near-term benefits. Realistic timing and probability assumptions help avoid overstating value creation.'
      },
      {
        question: 'What is accretion/dilution?',
        answer:
          'Accretion/dilution measures whether the combined company’s earnings per share (EPS) increases (accretive) or decreases (dilutive) after the deal, based on financing mix, purchase price, and expected benefits.'
      },
      {
        question: 'Is this financial advice?',
        answer:
          'No. Results are for educational modeling purposes and depend heavily on assumptions. For investment decisions, consult qualified professionals.'
      }
    ]}
  />

  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <div class="max-w-7xl mx-auto">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
          <div class="flex items-center mb-4">
            <span class="text-3xl mr-3">{config.icon}</span>
            <div>
              <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{config.title}</h1>
              <p class="text-gray-600 dark:text-gray-400">{config.description}</p>
              <div class="mt-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                  Business Finance
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
          <div id="calculator-form-container">
            <Fragment set:html={formHTML} />
          </div>

          <div id="loading-state" class="hidden text-center py-8">
            <div class="inline-flex items-center px-4 py-2 font-semibold leading-6 text-sm shadow rounded-md text-white bg-blue-500 hover:bg-blue-400 transition ease-in-out duration-150 cursor-not-allowed">
              <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Calculating...
            </div>
          </div>

          <div id="error-state" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
            <div class="flex">
              <div class="shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Error</h3>
                <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                  <p id="error-message"></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="results-section" class="mt-6 hidden">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h2 class="text-lg font-semibold mb-4">Analysis Results</h2>
            <div id="summary-cards" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8"></div>
            <div id="results-container" class="hidden"></div>
          </div>
        </div>

        <div class="mt-8">
          <AdSense slot="0123456789" format="horizontal" className="mt-8" />
        </div>
      </div>
    </div>
  </main>

  <ClientScriptLoader client:load slot="pageScripts" name="ma-analysis" />
</Layout>
