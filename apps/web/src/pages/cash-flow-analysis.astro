---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
import ToolPageShell from '../components/site/ToolPageShell.astro';
import WorkflowSupportRail from '../components/WorkflowSupportRail.astro';
---

<Layout
  title="Cash Flow Analysis - Business Cash Flow Projections & Analysis | Fanalyx"
  description="Professional cash flow analysis tool with NPV, IRR, burn rate, runway calculations, and sensitivity testing. Comprehensive cash flow projections for business planning and investment analysis."
  keywords="cash flow analysis, cash flow projection, NPV calculator, IRR calculator, burn rate, cash runway, working capital, cash flow forecasting, business cash flow"
  canonical={Astro.url.href}
  type="article"

  showChat={false}
  showToolAnalysis={false}
>
  <!-- Structured Data for SEO -->
  <StructuredData
    type="breadcrumb"
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Business Finance', url: '/models/business' },
      { name: 'Cash Flow Analysis', url: '/cash-flow-analysis' },
    ]}
  />

  <StructuredData
    type="software"
    softwareApp={{
      name: 'Cash Flow Analysis',
      description:
        'Professional cash flow analysis tool with NPV, IRR, burn rate, runway calculations, working capital analysis, and comprehensive cash flow projections.',
      category: 'FinanceApplication',
      rating: 4.8,
      ratingCount: 220,
    }}
  />

  <StructuredData
    type="faq"
    faqs={[
      {
        question: 'What is cash flow analysis and why is it important?',
        answer:
          "Cash flow analysis tracks the movement of money in and out of a business. It's critical for understanding liquidity, planning for growth, managing working capital, and ensuring you have enough cash to operate. Positive cash flow is essential for business survival.",
      },
      {
        question: 'What is the difference between operating, investing, and financing cash flows?',
        answer:
          "Operating cash flows come from core business activities (revenue, expenses). Investing cash flows involve buying/selling assets. Financing cash flows involve debt, equity, and dividends. All three are important for understanding a company's financial health.",
      },
      {
        question: 'What is burn rate and cash runway?',
        answer:
          'Burn rate is how quickly a company spends cash (usually monthly). Cash runway is how many months until cash runs out at the current burn rate. These metrics are critical for startups and businesses with negative cash flow.',
      },
      {
        question: 'How do I calculate NPV and IRR?',
        answer:
          "NPV (Net Present Value) discounts future cash flows to today's value using a discount rate. IRR (Internal Rate of Return) is the discount rate that makes NPV zero. Both help evaluate investment opportunities and project profitability.",
      },
      {
        question: 'What is working capital and why does it matter for cash flow?',
        answer:
          'Working capital is current assets minus current liabilities. Changes in working capital (like accounts receivable, inventory, accounts payable) directly impact cash flow. Managing working capital efficiently is crucial for maintaining positive cash flow.',
      },
    ]}
  />

  <ToolPageShell
    eyebrow="Business finance"
    title="Cash Flow Analysis"
    description="Comprehensive cash flow projections with NPV, IRR, burn rate, and runway analysis"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Models', href: '/models' },
      { label: 'Business Finance', href: '/models/business' },
      { label: 'Cash Flow Analysis' },
    ]}
  >
    <div id="results" class="hidden" aria-hidden="true"></div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1.55fr)_minmax(320px,0.95fr)]">
      <div class="space-y-8">
    <!-- Cash Flow Analysis Form -->
    <div class="fa-card p-6 mb-8">
      <h2 class="fa-panel-title mb-6">Analysis Parameters</h2>

      <form id="cash-flow-analysis-form" class="space-y-6">
        <!-- Basic Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label
              for="companyName"
              class="fa-field-label mb-2"
            >
              Company Name (Optional)
            </label>
            <input
              type="text"
              id="companyName"
              name="companyName"
              class="fa-input-surface w-full"
              placeholder="My Company"
            />
          </div>

          <div>
            <label
              for="analysisPeriodMonths"
              class="fa-field-label mb-2"
            >
              Analysis Period (Months)
            </label>
            <input
              type="number"
              id="analysisPeriodMonths"
              name="analysisPeriodMonths"
              min="1"
              max="120"
              value="12"
              class="fa-input-surface w-full"
              required
            />
          </div>

          <div>
            <label
              for="openingCashBalance"
              class="fa-field-label mb-2"
            >
              Opening Cash Balance ($)
            </label>
            <input
              type="number"
              id="openingCashBalance"
              name="openingCashBalance"
              min="0"
              step="1000"
              value="0"
              class="fa-input-surface w-full"
              required
            />
          </div>

          <div>
            <label
              for="minimumCashBalance"
              class="fa-field-label mb-2"
            >
              Minimum Cash Balance ($)
            </label>
            <input
              type="number"
              id="minimumCashBalance"
              name="minimumCashBalance"
              min="0"
              step="1000"
              value="0"
              class="fa-input-surface w-full"
            />
          </div>

          <div>
            <label
              for="discountRate"
              class="fa-field-label mb-2"
            >
              Discount Rate (%)
            </label>
            <input
              type="number"
              id="discountRate"
              name="discountRate"
              min="0"
              max="100"
              step="0.1"
              value="10"
              class="fa-input-surface w-full"
            />
          </div>

          <div>
            <label
              for="taxRate"
              class="fa-field-label mb-2"
            >
              Tax Rate (%)
            </label>
            <input
              type="number"
              id="taxRate"
              name="taxRate"
              min="0"
              max="100"
              step="0.1"
              value="25"
              class="fa-input-surface w-full"
            />
          </div>
        </div>

        <!-- Cash Flow Items Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">Cash Flow Items</h3>
          <div id="cash-flow-items" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 fa-highlight-card p-4">
              <div>
                <label class="fa-field-label mb-2"
                  >Description</label
                >
                <input
                  type="text"
                  name="itemDescription"
                  class="fa-input-surface w-full"
                  placeholder="Monthly Revenue"
                />
              </div>
              <div>
                <label class="fa-field-label mb-2"
                  >Amount ($)</label
                >
                <input
                  type="number"
                  name="itemAmount"
                  step="100"
                  class="fa-input-surface w-full"
                  placeholder="10000"
                />
              </div>
              <div>
                <label class="fa-field-label mb-2"
                  >Type</label
                >
                <select
                  name="itemType"
                  aria-label="Cash flow item type"
                  class="fa-input-surface w-full"
                >
                  <option value="operating">Operating</option>
                  <option value="investing">Investing</option>
                  <option value="financing">Financing</option>
                </select>
              </div>
              <div>
                <label class="fa-field-label mb-2"
                  >Frequency</label
                >
                <select
                  name="itemFrequency"
                  aria-label="Cash flow item frequency"
                  class="fa-input-surface w-full"
                >
                  <option value="monthly">Monthly</option>
                  <option value="quarterly">Quarterly</option>
                  <option value="annual">Annual</option>
                  <option value="one-time">One-Time</option>
                </select>
              </div>
            </div>
          </div>
          <button type="button" id="add-cash-flow-item" class="fa-button-secondary mt-4">
            + Add Cash Flow Item
          </button>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-6 fa-panel-divider-top mt-6">
          <button type="submit" class="fa-button-primary"> Analyze Cash Flow </button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <div id="cash-flow-results" class="fa-card hidden p-6 mb-8">
      <h2 class="fa-panel-title text-xl mb-4">
        Cash Flow Analysis Results
      </h2>
      <div id="cash-flow-results-content" class="space-y-4"></div>
    </div>

    <!-- AdSense -->
    <AdSense slot="0123456789" format="horizontal" className="mt-8" />
      </div>

      <WorkflowSupportRail modelType="cash-flow" />
    </div>
  </ToolPageShell>

  <ClientScriptLoader client:load slot="pageScripts" name="cash-flow-analysis" />
</Layout>
