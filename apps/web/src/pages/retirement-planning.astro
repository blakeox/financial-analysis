---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
import ToolPageShell from '../components/site/ToolPageShell.astro';
import WorkflowSupportRail from '../components/WorkflowSupportRail.astro';
---

<Layout
  title="Retirement Planning Engine - Advanced Retirement Analysis | Fanalyx"
  description="Advanced retirement planning with multi-account projections, Social Security optimization, tax-advantaged strategies, withdrawal strategies, healthcare cost planning, and comprehensive retirement readiness analysis."
  keywords="retirement planning, retirement calculator, Social Security optimization, retirement readiness, retirement accounts, 401k, IRA, retirement strategy"
  canonical={Astro.url.href}
  type="article"

  showChat={false}
  showToolAnalysis={false}
>
  <!-- Structured Data for SEO -->
  <StructuredData
    type="breadcrumb"
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Personal Finance', url: '/models/personal' },
      { name: 'Retirement Planning', url: '/retirement-planning' },
    ]}
  />

  <StructuredData
    type="software"
    softwareApp={{
      name: 'Retirement Planning Engine',
      description:
        'Advanced retirement planning tool with multi-account projections, Social Security optimization, tax-advantaged strategies, and comprehensive retirement readiness analysis.',
      category: 'FinanceApplication',
      rating: 4.9,
      ratingCount: 240,
    }}
  />

  <StructuredData
    type="faq"
    faqs={[
      {
        question: 'What is the difference between retirement planning and retirement savings?',
        answer:
          'Retirement savings focuses on accumulating wealth, while retirement planning is comprehensive analysis including multiple account types, Social Security optimization, withdrawal strategies, healthcare costs, and estate planning. Our advanced engine coordinates all aspects of retirement planning.',
      },
      {
        question: 'When should I claim Social Security?',
        answer:
          'You can claim Social Security as early as 62 (with reduced benefits) or delay until 70 (with increased benefits). Full retirement age is typically 67. Delaying increases benefits by 8% per year. Our calculator analyzes optimal claiming strategies based on your situation.',
      },
      {
        question: 'What is the 4% rule for retirement withdrawals?',
        answer:
          'The 4% rule suggests withdrawing 4% of your retirement portfolio in the first year, then adjusting for inflation. This historically allowed portfolios to last 30 years. Our calculator uses risk-adjusted withdrawal rates and analyzes how long your portfolio will last.',
      },
      {
        question: 'How do I optimize my retirement accounts?',
        answer:
          'Optimization involves maximizing employer matches, choosing between Traditional and Roth accounts based on tax brackets, coordinating multiple accounts, and planning withdrawal sequences. Our engine provides personalized recommendations for your specific situation.',
      },
      {
        question: 'What is retirement readiness and how is it calculated?',
        answer:
          "Retirement readiness measures whether you're on track to meet your retirement income needs. It considers projected savings, Social Security benefits, expected expenses, and withdrawal strategies. Our calculator provides a readiness score (0-100) with specific recommendations.",
      },
    ]}
  />

  <ToolPageShell
    eyebrow="Personal finance"
    title="Retirement Planning Calculator"
    description="Plan long-term retirement savings, income needs, and contribution strategies with clearer projections"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Models', href: '/models' },
      { label: 'Personal Finance', href: '/models/personal' },
      { label: 'Retirement Planning' },
    ]}
  >
    <div id="results" class="hidden" aria-hidden="true"></div>

    <div class="fa-workflow-grid">
      <div class="space-y-8">
    <!-- Retirement Planning Form -->
    <div class="fa-card p-6 mb-8">
      <h2 class="fa-panel-title mb-6">Personal Information</h2>

      <form id="retirement-planning-form" class="space-y-6">
        <!-- Personal Info Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label
              for="age"
              class="fa-field-label mb-2"
            >
              Current Age
            </label>
            <input
              type="number"
              id="age"
              name="age"
              min="18"
              max="100"
              class="fa-input-surface w-full"
              placeholder="35"
              required
            />
          </div>

          <div>
            <label
              for="retirementAge"
              class="fa-field-label mb-2"
            >
              Target Retirement Age
            </label>
            <input
              type="number"
              id="retirementAge"
              name="retirementAge"
              min="50"
              max="80"
              value="65"
              class="fa-input-surface w-full"
              required
            />
          </div>

          <div>
            <label
              for="lifeExpectancy"
              class="fa-field-label mb-2"
            >
              Life Expectancy
            </label>
            <input
              type="number"
              id="lifeExpectancy"
              name="lifeExpectancy"
              min="70"
              max="120"
              value="85"
              class="fa-input-surface w-full"
              required
            />
          </div>

          <div>
            <label
              for="maritalStatus"
              class="fa-field-label mb-2"
            >
              Marital Status
            </label>
            <select
              id="maritalStatus"
              name="maritalStatus"
              class="fa-input-surface w-full"
              required
            >
              <option value="single">Single</option>
              <option value="married" selected>Married</option>
              <option value="divorced">Divorced</option>
              <option value="widowed">Widowed</option>
            </select>
          </div>
        </div>

        <!-- Income Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">
            Income Information
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="currentAnnual"
                class="fa-field-label mb-2"
              >
                Current Annual Income ($)
              </label>
              <input
                type="number"
                id="currentAnnual"
                name="currentAnnual"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="100000"
                required
              />
            </div>

            <div>
              <label
                for="expectedGrowthRate"
                class="fa-field-label mb-2"
              >
                Expected Income Growth Rate (%)
              </label>
              <input
                type="number"
                id="expectedGrowthRate"
                name="expectedGrowthRate"
                min="0"
                max="10"
                step="0.1"
                value="3"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="socialSecurity"
                class="fa-field-label mb-2"
              >
                Expected Social Security Benefit ($/year)
              </label>
              <input
                type="number"
                id="socialSecurity"
                name="socialSecurity"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="30000"
              />
            </div>
          </div>
        </div>

        <!-- Expenses Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">
            Expense Information
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="currentAnnualExpenses"
                class="fa-field-label mb-2"
              >
                Current Annual Expenses ($)
              </label>
              <input
                type="number"
                id="currentAnnualExpenses"
                name="currentAnnualExpenses"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="60000"
                required
              />
            </div>

            <div>
              <label
                for="retirementAnnualExpenses"
                class="fa-field-label mb-2"
              >
                Expected Retirement Annual Expenses ($)
              </label>
              <input
                type="number"
                id="retirementAnnualExpenses"
                name="retirementAnnualExpenses"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="48000"
                required
              />
            </div>

            <div>
              <label
                for="inflationRate"
                class="fa-field-label mb-2"
              >
                Expected Inflation Rate (%)
              </label>
              <input
                type="number"
                id="inflationRate"
                name="inflationRate"
                min="0"
                max="10"
                step="0.1"
                value="3"
                class="fa-input-surface w-full"
              />
            </div>
          </div>
        </div>

        <!-- Goals Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">Retirement Goals</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="targetRetirementIncome"
                class="fa-field-label mb-2"
              >
                Target Retirement Income ($/year)
              </label>
              <input
                type="number"
                id="targetRetirementIncome"
                name="targetRetirementIncome"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="80000"
                required
              />
            </div>

            <div>
              <label
                for="riskTolerance"
                class="fa-field-label mb-2"
              >
                Risk Tolerance
              </label>
              <select
                id="riskTolerance"
                name="riskTolerance"
                class="fa-input-surface w-full"
                required
              >
                <option value="conservative">Conservative</option>
                <option value="moderate" selected>Moderate</option>
                <option value="aggressive">Aggressive</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-6 fa-panel-divider-top mt-6">
          <button type="submit" class="fa-button-primary"> Analyze Retirement Plan </button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <div id="retirement-planning-results" class="fa-card hidden p-6 mb-8">
      <h2 class="fa-panel-title text-xl mb-4">
        Retirement Planning Analysis
      </h2>
      <div id="retirement-planning-results-content" class="space-y-4"></div>
    </div>

    <!-- AdSense -->
    <AdSense slot="0123456789" format="horizontal" className="mt-8" />
      </div>

      <WorkflowSupportRail modelType="retirement-planning" />
    </div>
  </ToolPageShell>

  <ClientScriptLoader client:load slot="pageScripts" name="retirement-planning" />
</Layout>
