              <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mr-4">
                <span class="text-2xl">🚀</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Startup Financial Planning</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Early Stage</p>
