---
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import Layout from '../layouts/Layout.astro';
// ChatPanel is now in Layout.astro

// FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are multi-model financial analysis scenarios?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Multi-model scenarios combine multiple financial analysis tools to provide comprehensive financial planning. Personal finance scenarios focus on individual and family financial planning, while business finance scenarios cover advanced corporate financial analysis, M&A, and strategic planning."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between personal and business finance scenarios?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Personal finance scenarios focus on individual and family financial planning like home buying, retirement planning, and debt management. Business finance scenarios cover comprehensive corporate analysis including M&A, DCF valuation, LBO analysis, risk management, credit analysis, portfolio optimization, ESG risk assessment, and strategic planning for businesses, investors, and financial professionals."
      }
    },
    {
      "@type": "Question",
      "name": "How do I choose the right financial scenario?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Choose personal finance scenarios for individual and family financial planning. Select business finance scenarios for corporate analysis, investment decisions, or M&A activities. Each scenario is designed for specific complexity levels and includes both required and optional analysis models."
      }
    },
    {
      "@type": "Question",
      "name": "Can I customize scenarios or skip certain models?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Each scenario includes both required and optional models. Required models are essential for the scenario's success, while optional models provide additional insights. You can complete models in any order and revisit them as needed. The chatbot will guide you through the optimal sequence."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a complete scenario analysis take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Scenario duration varies by complexity: Personal finance scenarios (2-4 hours), Business finance scenarios (2-5 hours). You can complete scenarios over multiple sessions - your progress is automatically saved and the chatbot remembers where you left off."
      }
    }
  ]
};

---

<Layout title="Multi-Model Financial Analysis" description="Comprehensive personal and business financial planning scenarios combining multiple analysis tools for complete financial insights" keywords="financial planning, multi-model analysis, personal finance scenarios, business finance scenarios, financial journey, financial roadmap" canonical={Astro.url.href}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <div class="container mx-auto px-4 py-8">
    <!-- Structured Data: Breadcrumbs + SoftwareApplication -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.url).toString() },
          { '@type': 'ListItem', position: 2, name: 'Multi-Model Analysis', item: Astro.url.href },
        ],
      })}
    </script>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Multi-Model Financial Analysis',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web',
        url: Astro.url.href,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
      })}
    </script>
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold mb-4">Multi-Model Financial Analysis</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">
          Comprehensive financial planning scenarios that combine multiple analysis tools for complete insights
        </p>
        <p class="text-gray-500 dark:text-gray-500 max-w-3xl mx-auto">
          Choose a scenario that matches your life stage and financial goals. Each scenario guides you through a sequence of related analyses, 
          with our AI chatbot providing personalized recommendations and insights throughout your journey.
        </p>
      </div>

      <!-- Category Tabs -->
      <div class="flex justify-center mb-8">
        <div class="bg-gray-100 dark:bg-gray-800 rounded-lg p-1">
          <button 
            id="personal-tab" 
            class="px-6 py-2 rounded-md font-medium transition-colors duration-200 tab-button active"
            data-category="personal"
          >
            Personal Finance
          </button>
          <button 
            id="business-tab" 
            class="px-6 py-2 rounded-md font-medium transition-colors duration-200 tab-button"
            data-category="business"
          >
            Business Finance
          </button>
        </div>
      </div>

      <!-- Personal Finance Scenarios -->
      <div id="personal-scenarios" class="scenario-category">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Personal Finance Scenarios</h2>
          <p class="text-gray-600 dark:text-gray-400">Comprehensive personal financial planning for individuals and families</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <!-- Young Professional Journey -->
        <div class="scenario-card bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 cursor-pointer transition-all duration-200 hover:shadow-lg hover:scale-105" data-scenario="young-professional">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mr-4">
              <span class="text-2xl">🎓</span>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Young Professional Journey</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Ages 25-35</p>
            </div>
          </div>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Complete financial planning for early career professionals focusing on debt management, emergency funds, and retirement planning.
          </p>
          <div class="flex items-center justify-between">
            <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">Beginner</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">2-3 hours</span>
          </div>
            </div>

        <!-- Family Planning Journey -->
        <div class="scenario-card bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 cursor-pointer transition-all duration-200 hover:shadow-lg hover:scale-105" data-scenario="family-planning">
