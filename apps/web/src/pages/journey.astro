---
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';

// FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are multi-model financial analysis scenarios?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Multi-model scenarios combine multiple financial analysis tools to provide comprehensive financial planning. Personal finance scenarios focus on individual and family financial planning, while business finance scenarios cover advanced corporate financial analysis, M&A, and strategic planning."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between personal and business finance scenarios?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Personal finance scenarios focus on individual and family financial planning like home buying, retirement planning, and debt management. Business finance scenarios cover comprehensive corporate analysis including M&A, DCF valuation, LBO analysis, risk management, credit analysis, portfolio optimization, ESG risk assessment, and strategic planning for businesses, investors, and financial professionals."
      }
    },
    {
      "@type": "Question",
      "name": "How do I choose the right financial scenario?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Choose personal finance scenarios for individual and family financial planning. Select business finance scenarios for corporate analysis, investment decisions, or M&A activities. Each scenario is designed for specific complexity levels and includes both required and optional analysis models."
      }
    },
    {
      "@type": "Question",
      "name": "Can I customize scenarios or skip certain models?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Each scenario includes both required and optional models. Required models are essential for the scenario's success, while optional models provide additional insights. You can complete models in any order and revisit them as needed. Each step shows the recommended sequence and the next useful analysis to run."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a complete scenario analysis take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Scenario duration varies by complexity: Personal finance scenarios (2-4 hours), Business finance scenarios (2-5 hours). You can complete scenarios over multiple sessions, and your progress is saved so you can return where you left off."
      }
    }
  ]
};

---

<Layout title="Multi-Model Financial Analysis" description="Comprehensive personal and business financial planning scenarios combining multiple analysis tools for complete financial insights" keywords="financial planning, multi-model analysis, personal finance scenarios, business finance scenarios, financial journey, financial roadmap" canonical={Astro.url.href} showChat={false}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Multi-Model Analysis' }]} />

  <div class="fa-page-shell">
    <!-- Structured Data: Breadcrumbs + SoftwareApplication -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.url).toString() },
          { '@type': 'ListItem', position: 2, name: 'Multi-Model Analysis', item: Astro.url.href },
        ],
      })}
    </script>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Multi-Model Financial Analysis',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web',
        url: Astro.url.href,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
      })}
    </script>
    <div class="mx-auto max-w-6xl">
      <PageHero
        eyebrow="Journey"
        title="Multi-Model Financial Analysis"
        description="Choose a scenario that matches your life stage and financial goals. Each scenario guides you through a sequence of related analyses and shows the next model to run at each stage."
      />

      <!-- Category Tabs -->
      <div class="flex justify-center mb-8">
        <div class="fa-segmented-control">
          <button 
            id="personal-tab" 
            class="tab-button active"
            data-category="personal"
          >
            Personal Finance
          </button>
          <button 
            id="business-tab" 
            class="tab-button"
            data-category="business"
          >
            Business Finance
          </button>
        </div>
      </div>

      <!-- Personal Finance Scenarios -->
      <div id="personal-scenarios" class="scenario-category">
        <div class="text-center mb-8">
          <h2 class="fa-display fa-display-section !mt-0 mb-2">
            Personal Finance Scenarios
          </h2>
          <p class="fa-scenario-copy !mt-0">Comprehensive personal financial planning for individuals and families</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <!-- Young Professional Journey -->
        <div class="scenario-card" data-scenario="young-professional">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-info mr-4">
              <span class="text-2xl">🎓</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Young Professional Journey</h3>
              <p class="fa-meta-copy !mt-0">Ages 25-35</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Complete financial planning for early career professionals focusing on debt management, emergency funds, and retirement planning.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-success">Beginner</span>
            <span class="fa-meta-copy !mt-0">2-3 hours</span>
          </div>
            </div>

        <!-- Family Planning Journey -->
        <div class="scenario-card" data-scenario="family-planning">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-success mr-4">
              <span class="text-2xl">👨‍👩‍👧‍👦</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Family Planning Journey</h3>
              <p class="fa-meta-copy !mt-0">Ages 30-45</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Comprehensive family financial planning including home buying, education funding, and family protection strategies.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-warning">Intermediate</span>
            <span class="fa-meta-copy !mt-0">3-4 hours</span>
          </div>
            </div>

        <!-- Home Buying Journey -->
        <div class="scenario-card" data-scenario="home-buying" onclick="window.selectScenario && window.selectScenario('home-buying'); window.scenarioManager && window.scenarioManager.selectScenario('home-buying'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/home-buying'; }">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-accent mr-4">
              <span class="text-2xl">🏠</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Home Buying Journey</h3>
              <p class="fa-meta-copy !mt-0">Major Purchase</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Complete home buying analysis from affordability assessment to mortgage optimization and ongoing cost planning.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-warning">Intermediate</span>
            <span class="fa-meta-copy !mt-0">2-3 hours</span>
          </div>
            </div>

        <!-- Auto Lease Decision Journey -->
        <div class="scenario-card" data-scenario="auto-lease-decision" onclick="window.selectScenario && window.selectScenario('auto-lease-decision'); window.scenarioManager && window.scenarioManager.selectScenario('auto-lease-decision'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/auto-lease-decision'; }">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-success mr-4">
              <span class="text-2xl">🚙</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Auto Lease Decision</h3>
              <p class="fa-meta-copy !mt-0">Lease vs buy vs replace</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Compare finishing your lease, buying out, or switching to a new/used vehicle with clear total cost, cash needs, and risk checks.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-success">Intermediate</span>
            <span class="fa-meta-copy !mt-0">60-90 minutes</span>
          </div>
            </div>

        <!-- Debt Freedom Journey -->
        <div class="scenario-card" data-scenario="debt-freedom" onclick="window.selectScenario && window.selectScenario('debt-freedom'); window.scenarioManager && window.scenarioManager.selectScenario('debt-freedom'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/debt-freedom'; }">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-danger mr-4">
              <span class="text-2xl">💳</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Debt Freedom Journey</h3>
              <p class="fa-meta-copy !mt-0">Ages 25-45</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Complete debt elimination journey for credit cards, student loans, and other debts. Create your path to financial freedom.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-success">Beginner</span>
            <span class="fa-meta-copy !mt-0">1-2 hours</span>
          </div>
      </div>

        <!-- Investment Portfolio Build -->
        <div class="scenario-card" data-scenario="investment-portfolio">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-accent mr-4">
              <span class="text-2xl">📈</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Investment Portfolio Build</h3>
              <p class="fa-meta-copy !mt-0">Debt & Investment</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Build and optimize investment portfolios with tax-efficient strategies and risk management for long-term wealth building.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-danger">Advanced</span>
            <span class="fa-meta-copy !mt-0">3-4 hours</span>
          </div>
        </div>

        <!-- Pre-Retirement Planning -->
        <div class="scenario-card" data-scenario="pre-retirement">
          <div class="flex items-center mb-4">
            <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-warning mr-4">
              <span class="text-2xl">🏖️</span>
            </div>
            <div>
              <h3 class="fa-scenario-title">Pre-Retirement Planning</h3>
              <p class="fa-meta-copy !mt-0">Ages 50-65</p>
            </div>
          </div>
          <p class="fa-scenario-copy mb-4">
            Comprehensive pre-retirement planning focusing on catch-up contributions, tax optimization, and retirement readiness assessment.
          </p>
          <div class="flex items-center justify-between">
            <span class="fa-chip fa-chip-danger">Advanced</span>
            <span class="fa-meta-copy !mt-0">3-4 hours</span>
          </div>
          </div>
        </div>
      </div>

      <!-- Business Finance Scenarios -->
      <div id="business-scenarios" class="scenario-category hidden">
        <div class="text-center mb-8">
          <h2 class="fa-display fa-display-section !mt-0 mb-2">
            Business Finance Scenarios
          </h2>
          <p class="fa-scenario-copy !mt-0">Comprehensive business financial analysis including M&A, risk management, portfolio optimization, and strategic planning</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          <!-- Startup Financial Planning Journey -->
          <div class="scenario-card" data-scenario="startup-planning">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-success mr-4">
                <span class="text-2xl">🚀</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Startup Financial Planning</h3>
                <p class="fa-meta-copy !mt-0">Early Stage</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Complete financial planning for startups including revenue projections, unit economics, cash flow, funding strategy, and business valuation. Perfect for fundraising.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-success">Beginner</span>
              <span class="fa-meta-copy !mt-0">3-4 hours</span>
            </div>
          </div>

          <!-- Business Expansion Loan Journey -->
          <div class="scenario-card" data-scenario="business-expansion-loan" onclick="window.selectScenario && window.selectScenario('business-expansion-loan'); window.scenarioManager && window.scenarioManager.selectScenario('business-expansion-loan'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/business-expansion-loan'; }">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-warning mr-4">
                <span class="text-2xl">📈</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Business Expansion Loan</h3>
                <p class="fa-meta-copy !mt-0">Growth Financing</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Comprehensive journey for businesses considering expansion loans including financial health assessment, debt capacity analysis, DSCR, cash flow projections, and risk assessment.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-warning">Intermediate</span>
              <span class="fa-meta-copy !mt-0">2-3 hours</span>
            </div>
          </div>

          <!-- Business Growth Journey -->
          <div class="scenario-card" data-scenario="business-growth" onclick="window.selectScenario && window.selectScenario('business-growth'); window.scenarioManager && window.scenarioManager.selectScenario('business-growth'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/business-growth'; }">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-accent mr-4">
                <span class="text-2xl">📊</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Business Growth Journey</h3>
                <p class="fa-meta-copy !mt-0">SMB Growth</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Comprehensive growth planning covering financial health, unit economics, revenue forecasting, cash flow, pricing strategy, and business valuation.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-success">New</span>
              <span class="fa-meta-copy !mt-0">2-3 hours</span>
            </div>
          </div>

          <!-- M&A Analysis Journey -->
          <div class="scenario-card" data-scenario="ma-analysis-journey">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-accent mr-4">
                <span class="text-2xl">🤝</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">M&A Analysis Journey</h3>
                <p class="fa-meta-copy !mt-0">Strategic Planning</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Comprehensive M&A analysis journey including valuation, synergy assessment, risk analysis, and integration planning.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-danger">Advanced</span>
              <span class="fa-meta-copy !mt-0">4-5 hours</span>
            </div>
          </div>

          <!-- Investment Analysis Journey -->
          <div class="scenario-card" data-scenario="investment-analysis-journey" onclick="window.selectScenario && window.selectScenario('investment-analysis-journey'); window.scenarioManager && window.scenarioManager.selectScenario('investment-analysis-journey'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/investment-analysis-journey'; }">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-info mr-4">
                <span class="text-2xl">📊</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Investment Analysis Journey</h3>
                <p class="fa-meta-copy !mt-0">Investment Analysis</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Complete investment analysis journey including DCF valuation, comparable analysis, risk assessment, and portfolio optimization.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-warning">Intermediate</span>
              <span class="fa-meta-copy !mt-0">3-4 hours</span>
            </div>
          </div>

          <!-- Risk Management Journey -->
          <div class="scenario-card" data-scenario="risk-management-journey">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-danger mr-4">
                <span class="text-2xl">⚠️</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Risk Management Journey</h3>
                <p class="fa-meta-copy !mt-0">Risk Assessment</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Comprehensive risk management journey including VaR analysis, stress testing, credit risk assessment, and portfolio optimization.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-warning">Intermediate</span>
              <span class="fa-meta-copy !mt-0">3-4 hours</span>
            </div>
          </div>

          <!-- Capital Structure Journey -->
          <div class="scenario-card" data-scenario="capital-structure-journey">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-warning mr-4">
                <span class="text-2xl">⚖️</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Capital Structure Journey</h3>
                <p class="fa-meta-copy !mt-0">Financial Strategy</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Complete capital structure optimization journey including debt analysis, cost of capital, and optimal financing mix.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-danger">Advanced</span>
              <span class="fa-meta-copy !mt-0">3-4 hours</span>
            </div>
          </div>

          <!-- Project Finance Journey -->
          <div class="scenario-card" data-scenario="project-finance-journey">
            <div class="flex items-center mb-4">
              <div class="fa-icon-tile fa-icon-tile-sm fa-icon-tile-success mr-4">
                <span class="text-2xl">🏗️</span>
              </div>
              <div>
                <h3 class="fa-scenario-title">Project Finance Journey</h3>
                <p class="fa-meta-copy !mt-0">Infrastructure</p>
              </div>
            </div>
            <p class="fa-scenario-copy mb-4">
              Comprehensive project finance journey for infrastructure projects including feasibility analysis, risk assessment, and financing optimization.
            </p>
            <div class="flex items-center justify-between">
              <span class="fa-chip fa-chip-danger">Advanced</span>
              <span class="fa-meta-copy !mt-0">4-5 hours</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Selected Scenario Information -->
      <div id="selected-scenario-info" class="hidden">
        <SurfaceCard className="mb-8">
        <div class="flex items-center justify-between mb-6">
          <h2 id="selected-scenario-title" class="fa-model-title"></h2>
          <button 
            onclick="clearScenarioSelection()" 
            class="fa-icon-button-ghost px-4 py-2"
          >
            ✕ Clear Selection
          </button>
        </div>
        <p id="selected-scenario-description" class="fa-scenario-copy mb-6 !mt-0"></p>
        <div id="scenario-models">
          <!-- Models will be populated here -->
        </div>
        </SurfaceCard>
      </div>

      <!-- How It Works Section -->
      <div class="fa-highlight-card mb-8">
        <h2 class="fa-display fa-display-section !mt-0 mb-6 text-center">
          How Multi-Model Analysis Works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-info mx-auto mb-4">
              <span class="text-2xl">1️⃣</span>
            </div>
            <h3 class="fa-scenario-title mb-2">Choose Your Scenario</h3>
            <p class="fa-scenario-copy !mt-0">Select a scenario that matches your life stage and financial goals. Each scenario is designed for specific age ranges and complexity levels.</p>
          </div>
          <div class="text-center">
            <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-success mx-auto mb-4">
              <span class="text-2xl">2️⃣</span>
            </div>
            <h3 class="fa-scenario-title mb-2">Complete Analysis Models</h3>
            <p class="fa-scenario-copy !mt-0">Work through each analysis model in the recommended sequence, then review the takeaways attached to each completed step.</p>
          </div>
          <div class="text-center">
            <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-accent mx-auto mb-4">
              <span class="text-2xl">3️⃣</span>
            </div>
            <h3 class="fa-scenario-title mb-2">Get Comprehensive Insights</h3>
            <p class="fa-scenario-copy !mt-0">Receive integrated insights that combine all analyses into a cohesive financial plan with actionable recommendations.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name="multi-model-scenarios" />
  
</Layout>
