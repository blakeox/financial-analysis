            <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">Intermediate</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">3-4 hours</span>
          </div>
            </div>

        <!-- Home Buying Journey -->
        <div class="scenario-card bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 cursor-pointer transition-all duration-200 hover:shadow-lg hover:scale-105" data-scenario="home-buying" onclick="window.selectScenario && window.selectScenario('home-buying'); window.scenarioManager && window.scenarioManager.selectScenario('home-buying'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/home-buying'; }">
