            </div>
          </div>

          <!-- Business Growth Journey -->
          <div class="scenario-card bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 cursor-pointer transition-all duration-200 hover:shadow-lg hover:scale-105" data-scenario="business-growth" onclick="window.selectScenario && window.selectScenario('business-growth'); window.scenarioManager && window.scenarioManager.selectScenario('business-growth'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/business-growth'; }">
