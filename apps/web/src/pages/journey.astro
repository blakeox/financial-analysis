              <div class="w-12 h-12 bg-teal-100 dark:bg-teal-900 rounded-lg flex items-center justify-center mr-4">
                <span class="text-2xl">🏗️</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Project Finance Journey</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Infrastructure</p>
              </div>
            </div>
