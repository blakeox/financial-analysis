                <span class="text-2xl">🤝</span>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">M&A Analysis Journey</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Strategic Planning</p>
              </div>
            </div>
