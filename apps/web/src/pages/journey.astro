        <div class="scenario-card bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 cursor-pointer transition-all duration-200 hover:shadow-lg hover:scale-105" data-scenario="debt-freedom" onclick="window.selectScenario && window.selectScenario('debt-freedom'); window.scenarioManager && window.scenarioManager.selectScenario('debt-freedom'); if (!window.selectScenario && !window.scenarioManager) { window.location.href = '/journey/debt-freedom'; }">
