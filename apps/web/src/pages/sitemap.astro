---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';
import { getCalculatorSitemapLinksByCategory } from '../calculators/sitemap-links';

const title = "Site Map | Fanalyx";
const description = "Complete directory of all Fanalyx financial calculators, tools, and resources. Find the financial calculator you need quickly.";
const keywords = "sitemap, financial calculators directory, all calculators, fanalyx tools, financial tools list";
const noindex = true; // Avoid duplicate content with XML sitemap

const { personal: personalCalculatorLinks, business: businessCalculatorLinks } =
  getCalculatorSitemapLinksByCategory();

// Define site sections
const sections = [
  {
    title: "Financial Calculators",
    icon: "🧮",
    links: [
      { name: "All Calculators", href: "/models", description: "Browse all financial calculators" },
      { name: "Personal Finance", href: "/models/personal", description: "Mortgage, retirement, loans & more" },
      { name: "Business Finance", href: "/models/business", description: "Commercial real estate, EBITDA, leases" },
    ]
  },
  {
    title: "Personal Finance Tools",
    icon: "👤",
    links: personalCalculatorLinks,
  },
  {
    title: "Business Finance Tools",
    icon: "🏢",
    links: businessCalculatorLinks,
  },
  {
    title: "Financial Journeys",
    icon: "🗺️",
    links: [
      { name: "All Journeys", href: "/journey", description: "Multi-model financial planning scenarios" },
      { name: "Young Professional", href: "/journey/young-professional", description: "Starting your financial journey" },
      { name: "First Home Buyer", href: "/journey/first-home", description: "Complete home buying guide" },
      { name: "Retirement Planning", href: "/journey/retirement", description: "Comprehensive retirement planning" },
      { name: "Business Owner", href: "/journey/business-owner", description: "Business financial planning" },
      { name: "Debt Freedom", href: "/journey/debt-freedom", description: "Path to becoming debt-free" },
    ]
  },
  {
    title: "Resources",
    icon: "📚",
    links: [
      { name: "Developer API", href: "/developers", description: "API documentation & integration" },
      { name: "Pricing", href: "/pricing", description: "API pricing plans" },
      { name: "API Status", href: "/status", description: "Service health & uptime" },
    ]
  },
  {
    title: "Legal & Info",
    icon: "📋",
    links: [
      { name: "Privacy Policy", href: "/privacy", description: "How we protect your data" },
      { name: "Terms of Service", href: "/terms", description: "Usage terms & conditions" },
    ]
  }
];

// Structured data for sitemap page
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Fanalyx Site Map",
  "description": description,
  "url": "https://fanalyx.com/sitemap",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": sections.flatMap((section, sectionIndex) => 
      section.links.map((link, linkIndex) => ({
        "@type": "ListItem",
        "position": sectionIndex * 20 + linkIndex + 1,
        "name": link.name,
        "url": `https://fanalyx.com${link.href}`
      }))
    )
  }
};
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href} noindex={noindex}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Site Map' }]} />

  <div class="fa-page-shell">
    <div class="max-w-6xl mx-auto">
      <PageHero
        eyebrow="Utility"
        title="Site Map"
        description="Find all of Fanalyx's financial calculators, planning tools, and resources in one place."
      />
      <div class="fa-meta-copy mb-12 mt-4 flex items-center justify-center gap-4 text-sm">
        <a href="/sitemap-index.xml" class="fa-inline-link">
          XML Sitemap
        </a>
        <span aria-hidden="true">•</span>
        <a href="/robots.txt" class="fa-inline-link">
          robots.txt
        </a>
      </div>

      <!-- Sitemap Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sections.map((section) => (
          <SurfaceCard>
            <h2 class="fa-panel-title mb-4 flex items-center gap-2">
              <span aria-hidden="true">{section.icon}</span>
              {section.title}
            </h2>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  <a 
                    href={link.href}
                    class="group block rounded-lg p-2 -mx-2 transition-colors hover:bg-primary-50/60 dark:hover:bg-primary-950/30"
                  >
                    <span class="fa-inline-link font-medium">
                      {link.name}
                    </span>
                    <p class="fa-meta-copy mt-0.5 text-sm">
                      {link.description}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </SurfaceCard>
        ))}
      </div>

      <!-- Footer CTA -->
      <div class="mt-12 text-center">
        <div class="fa-highlight-card inline-flex items-center gap-4 px-6 py-4">
          <span class="text-2xl" aria-hidden="true">💡</span>
          <div class="text-left">
            <p class="fa-list-copy-strong">Can't find what you're looking for?</p>
            <p class="fa-meta-copy">
              Use our <a href="/journey" class="fa-inline-link">Financial Journey</a> to get guided recommendations.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
