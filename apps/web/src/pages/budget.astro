---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';
---

<Layout 
  title="Budget Optimizer" 
  description="Optimize your budget with the 50/30/20 rule and personalized recommendations"
  canonical={Astro.url.href}
>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center mb-4">
            <a href="/models/personal" class="mr-4 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
            </a>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
              Budget Optimizer
            </h1>
          </div>
          <p class="text-gray-600 dark:text-gray-300">
            Optimize your spending with the 50/30/20 rule and personalized budget recommendations
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Input Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 space-y-6">
            <form id="budget-form" class="space-y-6">
              <!-- Income Section -->
              <div>
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Monthly Income</h3>
                  <button type="button" id="add-income-btn" class="text-sm text-green-600 hover:text-green-700">
                    + Add Income
                  </button>
                </div>
                <div id="income-container" class="space-y-3">
                  <div class="income-item grid grid-cols-3 gap-2">
                    <input type="text" name="income-name-0" placeholder="Source" value="Salary" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                    <input type="number" name="income-amount-0" placeholder="Amount" value="5000" min="0" step="100" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                    <select name="income-type-0" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm">
                      <option value="salary">Salary</option>
                      <option value="business">Business</option>
                      <option value="investment">Investment</option>
                      <option value="rental">Rental</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Expenses Section -->
              <div>
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Monthly Expenses</h3>
                  <button type="button" id="add-expense-btn" class="text-sm text-red-600 hover:text-red-700">
                    + Add Expense
                  </button>
                </div>
                <div id="expenses-container" class="space-y-3">
                  <div class="expense-item grid grid-cols-4 gap-2">
                    <input type="text" name="expense-name-0" placeholder="Category" value="Rent" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                    <input type="number" name="expense-amount-0" placeholder="Amount" value="1500" min="0" step="50" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                    <select name="expense-type-0" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm">
                      <option value="housing">Housing</option>
                      <option value="food">Food</option>
                      <option value="transportation">Transportation</option>
                      <option value="utilities">Utilities</option>
                      <option value="insurance">Insurance</option>
                      <option value="entertainment">Entertainment</option>
                      <option value="other">Other</option>
                    </select>
                    <div class="flex items-center gap-1 text-xs">
                      <input type="checkbox" name="expense-essential-0" checked class="rounded" />
                      <span class="text-gray-600 dark:text-gray-400">Essential</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Savings Goal -->
              <div>
                <label for="savingsGoalMonthly" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Monthly Savings Goal
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-gray-500">$</span>
                  <input type="number" id="savingsGoalMonthly" name="savingsGoalMonthly" value="1000" min="0" step="50"
                    class="w-full pl-8 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-purple-500 dark:bg-gray-700 dark:text-white" />
                </div>
              </div>

              <!-- Optimization Goal -->
              <div>
                <label for="optimizationGoal" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Optimization Focus
                </label>
                <select id="optimizationGoal" name="optimizationGoal"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-purple-500 dark:bg-gray-700 dark:text-white">
                  <option value="balance">Balanced Approach</option>
                  <option value="maximize_savings">Maximize Savings</option>
                  <option value="reduce_debt">Reduce Debt</option>
                  <option value="reduce_discretionary">Cut Discretionary</option>
                </select>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-4">
                <button type="submit" id="calculate-btn" class="flex-1 bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-md transition">
                  Optimize Budget
                </button>
                <button type="button" id="reset-btn" class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                  Reset
                </button>
              </div>
            </form>

            <!-- Loading/Error States -->
            <div id="loading" class="hidden mt-6 text-center">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
              <p class="text-gray-600 dark:text-gray-400 mt-2">Optimizing...</p>
            </div>
            <div id="error" class="hidden mt-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
              <p class="text-red-800 dark:text-red-200" id="error-message"></p>
            </div>
          </div>

          <!-- Results -->
          <div>
            <div id="results" class="hidden space-y-6">
              <!-- Budget Summary -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Budget Summary</h3>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Income:</span>
                    <span id="total-income" class="font-semibold text-green-600"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Expenses:</span>
                    <span id="total-expenses" class="font-semibold text-red-600"></span>
                  </div>
                  <div class="flex justify-between pt-2 border-t border-gray-200 dark:border-gray-700">
                    <span class="text-gray-900 dark:text-white font-semibold">Net Income:</span>
                    <span id="net-income" class="font-bold"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Savings Rate:</span>
                    <span id="savings-rate" class="font-semibold"></span>
                  </div>
                </div>
              </div>

              <!-- 50/30/20 Analysis -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">50/30/20 Rule Analysis</h3>
                <div id="rule-analysis" class="space-y-2 text-sm"></div>
              </div>

              <!-- Recommendations -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recommendations</h3>
                <ul id="recommendations" class="space-y-2 text-sm list-disc list-inside"></ul>
              </div>

              <!-- Chat Button -->
              <button
                onclick="if (window.toggleChatPanel) { window.toggleChatPanel(); if (window.updateChatContext) { window.updateChatContext('Budget Optimizer', { tool: 'analyze_budget' }); } }"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-md transition flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                Ask AI about budget strategy
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { storeAnalysisResult } from '../scripts/analysis-results';
  import { BudgetEngine } from '@financial-analysis/analysis';

  const form = document.getElementById('budget-form') as HTMLFormElement;
  const addIncomeBtn = document.getElementById('add-income-btn');
  const addExpenseBtn = document.getElementById('add-expense-btn');
  const incomeContainer = document.getElementById('income-container');
  const expensesContainer = document.getElementById('expenses-container');
  let incomeCount = 1;
  let expenseCount = 1;

  const currencyFormatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  });

  addIncomeBtn?.addEventListener('click', () => {
    const html = `
      <div class="income-item grid grid-cols-3 gap-2">
        <input type="text" name="income-name-${incomeCount}" placeholder="Source" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
        <input type="number" name="income-amount-${incomeCount}" placeholder="Amount" min="0" step="100" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
        <select name="income-type-${incomeCount}" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"><option value="salary">Salary</option><option value="business">Business</option><option value="investment">Investment</option><option value="rental">Rental</option><option value="other">Other</option></select>
      </div>
    `;
    incomeContainer?.insertAdjacentHTML('beforeend', html);
    incomeCount++;
  });

  addExpenseBtn?.addEventListener('click', () => {
    const html = `
      <div class="expense-item grid grid-cols-4 gap-2">
        <input type="text" name="expense-name-${expenseCount}" placeholder="Category" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
        <input type="number" name="expense-amount-${expenseCount}" placeholder="Amount" min="0" step="50" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
        <select name="expense-type-${expenseCount}" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"><option value="housing">Housing</option><option value="food">Food</option><option value="transportation">Transportation</option><option value="utilities">Utilities</option><option value="insurance">Insurance</option><option value="entertainment">Entertainment</option><option value="other">Other</option></select>
        <div class="flex items-center gap-1 text-xs"><input type="checkbox" name="expense-essential-${expenseCount}" checked class="rounded" /><span class="text-gray-600 dark:text-gray-400">Essential</span></div>
      </div>
    `;
    expensesContainer?.insertAdjacentHTML('beforeend', html);
    expenseCount++;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    document.getElementById('results')?.classList.add('hidden');
    document.getElementById('error')?.classList.add('hidden');
    document.getElementById('loading')?.classList.remove('hidden');

    try {
      const formData = new FormData(form);
      const savingsGoalMonthly = parseFloat(formData.get('savingsGoalMonthly') as string) || 0;
      const optimizationGoal = formData.get('optimizationGoal') as 'maximize_savings' | 'reduce_debt' | 'balance' | 'reduce_discretionary';

      const income = [];
      for (let i = 0; i < incomeCount; i++) {
        const name = formData.get(`income-name-${i}`) as string;
        const amount = parseFloat(formData.get(`income-amount-${i}`) as string);
        const type = formData.get(`income-type-${i}`) as 'salary' | 'business' | 'investment' | 'rental' | 'other';
        
        if (name && !isNaN(amount)) {
          income.push({ name, monthlyAmount: amount, type: type || 'salary', recurring: true });
        }
      }

      const expenses = [];
      for (let i = 0; i < expenseCount; i++) {
        const name = formData.get(`expense-name-${i}`) as string;
        const amount = parseFloat(formData.get(`expense-amount-${i}`) as string);
        const type = formData.get(`expense-type-${i}`) as string;
        const isEssential = formData.get(`expense-essential-${i}`) === 'on';
        
        if (name && !isNaN(amount)) {
          expenses.push({ 
            name, 
            monthlyAmount: amount, 
            type: (type || 'other') as any,
            isFixed: false,
            isEssential 
          });
        }
      }

      if (income.length === 0) throw new Error('Please add at least one income source');
      if (expenses.length === 0) throw new Error('Please add at least one expense');

      const input = { income, expenses, debts: [], savingsGoalMonthly, optimizationGoal };
      const result = BudgetEngine.analyze(input);
      
      storeAnalysisResult('analyze_budget', result);
      displayResults(result);

    } catch (err) {
      const errorEl = document.getElementById('error-message');
      if (errorEl) errorEl.textContent = err instanceof Error ? err.message : 'An error occurred';
      document.getElementById('error')?.classList.remove('hidden');
    } finally {
      document.getElementById('loading')?.classList.add('hidden');
    }
  });

  document.getElementById('reset-btn')?.addEventListener('click', () => {
    form.reset();
    document.getElementById('results')?.classList.add('hidden');
    document.getElementById('error')?.classList.add('hidden');
  });

  function displayResults(result: any) {
    document.getElementById('total-income')!.textContent = result.summary?.totalIncome || 'N/A';
    document.getElementById('total-expenses')!.textContent = result.summary?.totalExpenses || 'N/A';
    document.getElementById('net-income')!.textContent = result.summary?.netIncome || 'N/A';
    document.getElementById('savings-rate')!.textContent = result.summary?.savingsRate || 'N/A';

    const ruleEl = document.getElementById('rule-analysis');
    if (ruleEl && result.rule503020) {
      ruleEl.innerHTML = `
        <p><strong>Needs (50%):</strong> ${result.rule503020.actualNeeds || 'N/A'} ${result.rule503020.needsStatus || ''}</p>
        <p><strong>Wants (30%):</strong> ${result.rule503020.actualWants || 'N/A'} ${result.rule503020.wantsStatus || ''}</p>
        <p><strong>Savings (20%):</strong> ${result.rule503020.actualSavings || 'N/A'} ${result.rule503020.savingsStatus || ''}</p>
      `;
    }

    const recEl = document.getElementById('recommendations');
    if (recEl && result.recommendations) {
      recEl.innerHTML = result.recommendations.map((rec: string) => `<li class="text-gray-700 dark:text-gray-300">${rec}</li>`).join('');
    }

    document.getElementById('results')?.classList.remove('hidden');
  }
</script>

<!-- AdSense: Bottom of page ad -->
<AdSense slot="7890123456" format="horizontal" className="container mx-auto px-4 mb-8" />
</Layout>
