---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';
import { AnalyticsDashboard } from '@financial-analysis/ui';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
---

<Layout 
  title="Analytics Dashboard" 
  description="Real-time page interaction and API performance analytics"
  canonical={Astro.url.href}
  keywords="analytics dashboard, api monitoring, performance metrics"
  noindex={true}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Analytics' }]} />

  <div class="fa-page-shell">
    <PageHero
      eyebrow="Analytics"
      title="Analytics Dashboard"
      description="Real-time monitoring of page interactions and API performance."
    />

    <div class="fa-highlight-card mb-6">
      <h2 class="fa-scenario-title mb-2">
        📊 What's Being Tracked
      </h2>
      <ul class="fa-list-copy ml-4 list-disc space-y-1">
        <li><strong>Page Views:</strong> Every page load with referrer, viewport, user agent</li>
        <li><strong>API Calls:</strong> Endpoint, method, duration, status, cache hits</li>
        <li><strong>Form Submissions:</strong> Completion rate, validation errors, time to complete</li>
        <li><strong>User Actions:</strong> Button clicks, scroll depth, time on page</li>
        <li><strong>Errors:</strong> Client-side errors with stack traces and context</li>
      </ul>
    </div>

    <div id="analytics-dashboard">
      <SurfaceCard>
        <AnalyticsDashboard client:load autoRefresh={true} refreshInterval={5000} />
      </SurfaceCard>
    </div>

    <SurfaceCard className="mt-8">
      <h2 class="fa-panel-title mb-4">
        💡 How to Use Analytics in Your App
      </h2>
      
      <div class="fa-list-copy space-y-4 text-sm">
        <div>
          <h3 class="fa-scenario-title mb-2">1. Initialize Analytics</h3>
          <pre class="fa-prompt-panel"><code>{`import { initAnalytics } from '@financial-analysis/ui';

// In your app initialization
initAnalytics('http://127.0.0.1:8787'); // API base URL`}</code></pre>
        </div>

        <div>
          <h3 class="fa-scenario-title mb-2">2. Track Page Views (Automatic)</h3>
          <pre class="fa-prompt-panel"><code>{`// Page views are tracked automatically on initialization
// Includes: path, referrer, title, viewport, user agent`}</code></pre>
        </div>

        <div>
          <h3 class="fa-scenario-title mb-2">3. Track API Calls</h3>
          <pre class="fa-prompt-panel"><code>{`import { monitoredFetch } from '@financial-analysis/ui';

// Use monitored fetch instead of regular fetch
const { data, metrics } = await monitoredFetch('/v1/api/analysis/lease', {
  method: 'POST',
  body: JSON.stringify({ /* ... */ })
});

// Metrics automatically tracked:
// - Duration, status code, success/failure
// - Request/response size, cache hits
// - Errors with messages`}</code></pre>
        </div>

        <div>
          <h3 class="fa-scenario-title mb-2">4. Track Form Submissions</h3>
          <pre class="fa-prompt-panel"><code>{`import { trackFormSubmit } from '@financial-analysis/ui';

trackFormSubmit({
  formId: 'lease-analysis-form',
  fieldsCompleted: 8,
  totalFields: 10,
  validationErrors: ['Invalid rate'],
  timeToComplete: 45000, // ms
});`}</code></pre>
        </div>

        <div>
          <h3 class="fa-scenario-title mb-2">5. Track User Actions</h3>
          <pre class="fa-prompt-panel"><code>{`import { trackUserAction } from '@financial-analysis/ui';

trackUserAction({
  action: 'button_click',
  element: 'analyze-button',
  value: 'analyze-lease',
  context: { formValid: true }
});`}</code></pre>
        </div>

        <div>
          <h3 class="fa-scenario-title mb-2">6. View Analytics Dashboard</h3>
          <pre class="fa-prompt-panel"><code>{`import { AnalyticsDashboard, getApiMonitor } from '@financial-analysis/ui';

// React component
<AnalyticsDashboard autoRefresh={true} refreshInterval={5000} />

// Or access programmatically
const monitor = getApiMonitor();
const analysis = monitor.getAnalysis();
console.log(analysis.successRate, analysis.averageDuration);`}</code></pre>
        </div>
      </div>
    </SurfaceCard>

  <div class="mt-8 fa-highlight-card">
      <h2 class="fa-panel-title mb-4">
        🧪 Test Analytics Tracking
      </h2>
      <p class="fa-list-copy mb-4">
        Click these buttons to generate test events and see them appear in the dashboard above:
      </p>
      <div class="flex flex-wrap gap-4">
        <button
          id="test-api-call"
          class="fa-button-primary"
        >
          Test API Call
        </button>
        <button
          id="test-error"
          class="fa-button-secondary"
        >
          Test Error Tracking
        </button>
        <button
          id="test-action"
          class="fa-button-primary"
        >
          Test User Action
        </button>
      </div>
    </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name="analytics" />
</Layout>
