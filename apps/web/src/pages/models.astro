---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';

const keywords = "financial models, personal finance calculator, business finance tools, mortgage calculator, retirement planning, lease analysis, EBITDA calculator, financial planning";
const description = "Free financial models and calculators. Choose personal finance tools for mortgages, retirement, and investments or business finance for commercial real estate, lease analysis, and EBITDA forecasting.";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": baseUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Financial Models",
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": "Financial Models",
      "description": description,
      "url": currentUrl,
      "hasPart": [
        {
          "@type": "WebPage",
          "name": "Personal Finance Models",
          "url": `${baseUrl}/models/personal`
        },
        {
          "@type": "WebPage",
          "name": "Business Finance Models",
          "url": `${baseUrl}/models/business`
        }
      ]
    }
  ]
};
---

<Layout title="Financial Models" description={description} keywords={keywords} canonical={Astro.url.href} showChat={false}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Financial Models' }]} />

  <div class="fa-page-shell">
    <div id="main-container" class="transition-all duration-300 ease-in-out">
        <PageHero
          eyebrow="Models"
          title="Financial Models"
          description="Choose between personal finance tools or business analysis models. Each is designed for precision and backed by deterministic calculations."
        />

        <div class="fa-model-intro mb-16">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <span>Pick a model, run the numbers, then use guided analysis to compare scenarios and change inputs.</span>
        </div>

        <div class="mx-auto mb-16 grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
          <a
            href="/models/personal"
            aria-label="Explore Personal Tools"
            class="block"
          >
            <SurfaceCard
              title="Personal Finance"
              description="Mortgage calculators, retirement planning, and personal investment tools designed for individuals and families."
              className="h-full fa-card-interactive bg-gradient-to-br from-emerald-50 to-violet-50"
            >
              <span class="fa-inline-link mt-6 inline-flex">Explore Personal Tools</span>
            </SurfaceCard>
          </a>

          <a
            href="/models/business"
            aria-label="Explore Business Tools"
            class="block"
          >
            <SurfaceCard
              title="Business Finance"
              description="Commercial real estate, lease analysis, EBITDA forecasting, and enterprise financial modeling tools."
              className="h-full fa-card-interactive bg-gradient-to-br from-violet-50 to-purple-50"
            >
              <span class="fa-inline-link mt-6 inline-flex">Explore Business Tools</span>
            </SurfaceCard>
          </a>
        </div>

        <!-- AdSense: Between categories and features -->
        <AdSense slot="3456789012" format="horizontal" className="max-w-4xl mx-auto mb-16" />

        <!-- Featured Models -->
        <section class="max-w-5xl mx-auto mb-16">
          <h2 class="fa-display fa-display-section !mt-0 mb-8">
            Featured Financial Models
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Amortization Calculator -->
            <div class="fa-model-card group cursor-pointer model-card"
              data-model="Amortization Calculator">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="fa-model-title">
                    Amortization Calculator
                  </h3>
                  <div class="fa-chip fa-chip-success">
                    Available
                  </div>
                </div>
                <p class="fa-model-description">
                  Generate detailed payment schedules, compare principal versus interest, and model extra payment strategies.
                </p>
                <div class="space-y-3 mb-6">
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Payment schedules
                  </div>
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Principal vs interest breakdown
                  </div>
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Extra payment modeling
                  </div>
                </div>
                <a
                  href="/calculator/amortization"
                  class="fa-button-primary w-full justify-center"
                >
                  Open Calculator
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Enhanced Lease Analysis -->
            <div class="fa-model-card group cursor-pointer model-card"
              data-model="Enhanced Lease Analysis">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="fa-model-title">
                    Enhanced Lease Analysis
                  </h3>
                  <div class="fa-chip fa-chip-success">
                    Available
                  </div>
                </div>
                <p class="fa-model-description">
                  Evaluate lease scenarios, run sensitivity analyses, and compare lease-versus-buy outcomes with AI-assisted workflows.
                </p>
                <div class="space-y-3 mb-6">
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Lease scenario evaluation
                  </div>
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Sensitivity analysis
                  </div>
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Lease vs buy comparison
                  </div>
                </div>
                <a
                  href="/lease-analysis"
                  class="fa-button-primary w-full justify-center"
                >
                  Open Analysis
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>

            <!-- EBITDA Forecasting -->
            <div class="fa-model-card group cursor-pointer model-card"
              data-model="EBITDA Forecasting">
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="fa-model-title">
                    EBITDA Forecasting
                  </h3>
                  <div class="fa-chip fa-chip-success">
                    Available
                  </div>
                </div>
                <p class="fa-model-description">
                  Service industry financial projections with deterministic controls for revenue, staffing, and expense scenarios.
                </p>
                <div class="space-y-3 mb-6">
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Revenue forecasting
                  </div>
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Staffing & expense planning
                  </div>
                  <div class="fa-model-feature">
                    <svg class="w-4 h-4 mr-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    Scenario analysis
                  </div>
                </div>
                <a
                  href="/ebitda-forecasting"
                  class="fa-button-primary w-full justify-center"
                >
                  Open Forecaster
                  <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- Active Model Section -->
        <div id="selected-model-info" class="fa-card hidden p-6 mb-8">
          <div class="flex items-center justify-between mb-4">
            <h2 id="selected-model-title" class="fa-model-title"></h2>
            <button 
              onclick="clearSelection()"
              class="fa-icon-button-ghost"
              title="Clear selection"
              aria-label="Clear model selection"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <p id="selected-model-description" class="fa-model-description !mb-4 !mt-0"></p>
          <div class="flex items-center space-x-4">
            <span class="fa-meta-copy">Run the model first, then use guided analysis to interpret the result or decide what to change next.</span>
            <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="text-center">
          <div class="fa-card p-8">
            <h2 class="fa-display fa-display-section !mt-0 mb-4">
              Guided analysis after every calculation
            </h2>
            <p class="fa-card-copy !mt-0 mb-6">
              Start with a calculator, get the result first, then use guided follow-up prompts to understand the outcome, compare scenarios, and decide what to change next.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="/calculator/amortization"
                class="fa-button-primary"
              >
                Start with Amortization
                <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
              <a
                href="/status"
                class="fa-button-secondary"
              >
                API Status
              </a>
            </div>
          </div>
        </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name="models" />
</Layout>
