---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';

const keywords = "financial models, personal finance calculator, business finance tools, mortgage calculator, retirement planning, lease analysis, EBITDA calculator, financial planning";
const description = "Free financial models and calculators. Choose personal finance tools for mortgages, retirement, and investments or business finance for commercial real estate, lease analysis, and EBITDA forecasting.";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": baseUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Financial Models",
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": "Financial Models",
      "description": description,
      "url": currentUrl,
      "hasPart": [
        {
          "@type": "WebPage",
          "name": "Personal Finance Models",
          "url": `${baseUrl}/models/personal`
        },
        {
          "@type": "WebPage",
          "name": "Business Finance Models",
          "url": `${baseUrl}/models/business`
        }
      ]
    }
  ]
};
---

<Layout title="Financial Models" description={description} keywords={keywords} canonical={Astro.url.href}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  
  <!-- Breadcrumb Navigation -->
  <nav class="container mx-auto px-4 py-4" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
      <li><a href="/" class="hover:text-blue-600">Home</a></li>
      <li><span aria-hidden="true">/</span></li>
      <li><span class="text-gray-900 dark:text-white font-medium" aria-current="page">Financial Models</span></li>
    </ol>
  </nav>
  
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Main Content Container with Chat Panel Integration -->
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-16">
        <!-- Header Section -->
        <div class="text-center mb-16">
          <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Financial Models
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6">
            Choose between personal finance tools or business analysis models. Each is designed for precision and powered by deterministic calculations.
          </p>
          <div class="flex items-center justify-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <span>Click the chat icon to get AI-powered analysis of your model results</span>
          </div>
        </div>

        <!-- Category Selection -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16" role="main">
          
          <!-- Personal Finance Category -->
          <a href="/models/personal" class="block group">
            <div class="bg-linear-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-2 border-blue-200 dark:border-blue-700 hover:border-blue-400 dark:hover:border-blue-500">
              <div class="flex items-center mb-6">
                <div class="p-4 bg-blue-600 dark:bg-blue-500 rounded-xl mr-4 group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                  </svg>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Personal Finance</h2>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg">
                Mortgage calculators, retirement planning, and personal investment tools designed for individuals and families.
              </p>
              <div class="flex items-center text-blue-600 dark:text-blue-400 font-semibold group-hover:translate-x-2 transition-transform duration-300">
                <span>Explore Personal Tools</span>
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </a>

          <!-- Business Finance Category -->
          <a href="/models/business" class="block group">
            <div class="bg-linear-to-br from-violet-50 to-purple-50 dark:from-violet-900/20 dark:to-purple-900/20 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border-2 border-violet-200 dark:border-violet-700 hover:border-violet-400 dark:hover:border-violet-500">
              <div class="flex items-center mb-6">
                <div class="p-4 bg-violet-600 dark:bg-violet-500 rounded-xl mr-4 group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                  </svg>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Business Finance</h2>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg">
                Commercial real estate, lease analysis, EBITDA forecasting, and enterprise financial modeling tools.
              </p>
              <div class="flex items-center text-violet-600 dark:text-violet-400 font-semibold group-hover:translate-x-2 transition-transform duration-300">
                <span>Explore Business Tools</span>
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </a>

        </div>

        <!-- AdSense: Between categories and features -->
        <AdSense slot="3456789012" format="horizontal" className="max-w-4xl mx-auto mb-16" />

        <!-- Featured Models -->
        <section class="max-w-5xl mx-auto mb-16">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-8">
            Featured Financial Models
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a
              href="/amortization"
              class="model-card block rounded-2xl border border-blue-200 dark:border-blue-700 bg-white dark:bg-gray-800 shadow hover:shadow-lg transition-all duration-200 p-6 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-model="Amortization Calculator"
            >
              <div data-model="Amortization Calculator">
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white text-lg font-bold">A</span>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Amortization Calculator</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-300 mb-4">
                  Generate detailed payment schedules, compare principal versus interest, and model extra payment strategies.
                </p>
                <span class="inline-flex items-center text-blue-700 dark:text-blue-300 font-medium">
                  Explore calculator
                  <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </a>

            <a
              href="/lease-analysis"
              class="model-card block rounded-2xl border border-violet-200 dark:border-violet-700 bg-white dark:bg-gray-800 shadow hover:shadow-lg transition-all duration-200 p-6 focus:outline-none focus:ring-2 focus:ring-violet-500"
              data-model="Enhanced Lease Analysis"
            >
              <div data-model="Enhanced Lease Analysis">
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-violet-600 text-white text-lg font-bold">L</span>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Enhanced Lease Analysis</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-300 mb-4">
                  Evaluate lease scenarios, run sensitivity analyses, and compare lease-versus-buy outcomes with AI-assisted workflows.
                </p>
                <span class="inline-flex items-center text-violet-700 dark:text-violet-300 font-medium">
                  Open analysis
                  <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </a>

            <a
              href="/ebitda-forecasting"
              class="model-card block rounded-2xl border border-emerald-200 dark:border-emerald-700 bg-white dark:bg-gray-800 shadow hover:shadow-lg transition-all duration-200 p-6 focus:outline-none focus:ring-2 focus:ring-emerald-500"
              data-model="EBITDA Forecasting"
            >
              <div data-model="EBITDA Forecasting">
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-emerald-600 text-white text-lg font-bold">E</span>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">EBITDA Forecasting</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-300 mb-4">
                  Service industry financial projections with deterministic controls for revenue, staffing, and expense scenarios to forecast EBITDA with confidence.
                </p>
                <span class="inline-flex items-center text-emerald-700 dark:text-emerald-300 font-medium">
                  Forecast EBITDA
                  <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </a>
          </div>
        </section>

        <!-- Active Model Section -->
        <div id="selected-model-info" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
          <div class="flex items-center justify-between mb-4">
            <h2 id="selected-model-title" class="text-2xl font-bold text-gray-900 dark:text-white"></h2>
            <button 
              onclick="clearSelection()"
              class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
              title="Clear selection"
              aria-label="Clear model selection"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <p id="selected-model-description" class="text-gray-600 dark:text-gray-300 mb-4"></p>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-500 dark:text-gray-400">Use the AI assistant to analyze this model's results and get insights</span>
            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="text-center">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              AI-Powered Financial Analysis
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              Select any model above to get started, then use our AI assistant to interpret results, run scenarios, and gain deeper insights into your financial data.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <button
                onclick="openChatPanel()"
                class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-200"
                aria-label="Open AI assistant chat panel"
              >
                Try AI Assistant
                <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </button>
              <a
                href="/status"
                class="inline-flex items-center px-6 py-3 border border-gray-300 dark:border-gray-600 text-base font-medium rounded-md text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200"
              >
                API Status
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name="models" />
</Layout>