---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Financial Modeler" description="Watch AI modify financial models in real-time with live thinking process visualization">
  <div class="min-h-screen bg-slate-950 text-white">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-600/30 via-blue-500/25 to-purple-500/20" aria-hidden="true" />
      <div class="relative container mx-auto px-4 py-8">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-white mb-4">
              🤖 AI Financial Modeler
            </h1>
            <p class="text-xl text-gray-300">
              Watch AI think and modify financial models in real-time
            </p>
          </div>
          
          <!-- Main Chat Interface -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Chat Panel -->
            <div class="lg:col-span-1 bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
              <h2 class="text-xl font-semibold mb-4 text-emerald-400">💬 Chat with AI</h2>
              <div id="chat-messages" class="h-96 overflow-y-auto mb-4 space-y-3 bg-slate-800/50 rounded-lg p-4">
                <div class="text-gray-400 text-sm">
                  👋 Ask me to modify financial models! Try:
                  <br/>• "Analyze a $100k equipment lease"
                  <br/>• "Show me a 30-year mortgage scenario"
                  <br/>• "Forecast EBITDA with 10% growth"
                </div>
              </div>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="chat-input" 
                  placeholder="Ask AI to modify models..."
                  class="flex-1 px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-emerald-500"
                />
                <button 
                  id="send-btn"
                  class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 rounded-lg font-medium transition-colors"
                >
                  Send
                </button>
              </div>
            </div>

            <!-- AI Thinking Process -->
            <div class="lg:col-span-1 bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
              <h2 class="text-xl font-semibold mb-4 text-blue-400">🧠 AI Thinking Process</h2>
              <div id="thinking-display" class="h-96 overflow-y-auto bg-slate-800/50 rounded-lg p-4">
                <div class="text-gray-400 text-sm">
                  AI thinking process will appear here...
                </div>
              </div>
              <div class="mt-4">
                <div class="flex items-center gap-2 text-sm text-gray-400">
                  <div id="thinking-status" class="w-2 h-2 rounded-full bg-gray-500"></div>
                  <span id="thinking-text">Ready</span>
                </div>
              </div>
            </div>

            <!-- Model Modifications -->
            <div class="lg:col-span-1 bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
              <h2 class="text-xl font-semibold mb-4 text-purple-400">⚙️ Model Changes</h2>
              <div id="model-changes" class="h-96 overflow-y-auto bg-slate-800/50 rounded-lg p-4">
                <div class="text-gray-400 text-sm">
                  Model parameter changes will appear here...
                </div>
              </div>
            </div>
          </div>

          <!-- Live Financial Models Display -->
          <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Lease Analysis -->
            <div class="bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
              <h3 class="text-lg font-semibold mb-4 text-yellow-400">🏗️ Lease Analysis</h3>
              <div id="lease-model" class="space-y-3">
                <div class="text-gray-400 text-sm">No lease analysis active</div>
              </div>
            </div>

            <!-- Amortization Schedule -->
            <div class="bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
              <h3 class="text-lg font-semibold mb-4 text-green-400">🏦 Amortization</h3>
              <div id="amortization-model" class="space-y-3">
                <div class="text-gray-400 text-sm">No amortization analysis active</div>
              </div>
            </div>

            <!-- EBITDA Forecast -->
            <div class="bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
              <h3 class="text-lg font-semibent mb-4 text-cyan-400">📈 EBITDA Forecast</h3>
              <div id="ebitda-model" class="space-y-3">
                <div class="text-gray-400 text-sm">No EBITDA forecast active</div>
              </div>
            </div>
          </div>

          <!-- Live Chart Visualization -->
          <div class="mt-8 bg-slate-900/50 rounded-xl p-6 backdrop-blur-sm border border-slate-700">
            <h3 class="text-lg font-semibold mb-4 text-indigo-400">📊 Live Model Visualization</h3>
            <div id="chart-container" class="h-64 bg-slate-800/50 rounded-lg p-4">
              <canvas id="financial-chart" class="max-w-full max-h-full"></canvas>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Chart.js for visualization -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <!-- Client-side JavaScript for real-time interaction -->
  <script>
    interface ChatMessage {
      role: 'user' | 'assistant' | 'system';
      content: string;
      timestamp: number;
    }

    interface ThinkingStep {
      step: number;
      thought: string;
      action?: string;
      parameters?: Record<string, any>;
    }

    interface ModelChange {
      type: 'lease' | 'amortization' | 'ebitda';
      parameters: Record<string, any>;
      result: Record<string, any>;
      timestamp: number;
    }

    class AIModelerUI {
      private messages: ChatMessage[] = [];
      private chatMessages: HTMLElement;
      private chatInput: HTMLInputElement;
      private sendBtn: HTMLButtonElement;
      private thinkingDisplay: HTMLElement;
      private thinkingStatus: HTMLElement;
      private thinkingText: HTMLElement;
      private modelChanges: HTMLElement;
      private leaseModel: HTMLElement;
      private amortizationModel: HTMLElement;
      private ebitdaModel: HTMLElement;
      private chartContainer: HTMLElement;
      private chart: any = null;

      constructor() {
        this.chatMessages = document.getElementById('chat-messages')!;
        this.chatInput = document.getElementById('chat-input') as HTMLInputElement;
        this.sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
        this.thinkingDisplay = document.getElementById('thinking-display')!;
        this.thinkingStatus = document.getElementById('thinking-status')!;
        this.thinkingText = document.getElementById('thinking-text')!;
        this.modelChanges = document.getElementById('model-changes')!;
        this.leaseModel = document.getElementById('lease-model')!;
        this.amortizationModel = document.getElementById('amortization-model')!;
        this.ebitdaModel = document.getElementById('ebitda-model')!;
        this.chartContainer = document.getElementById('chart-container')!;

        this.setupEventListeners();
        this.initializeChart();
      }

      private initializeChart() {
        const canvas = document.getElementById('financial-chart') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d');
        
        if (!ctx) return;

        this.chart = new (window as any).Chart(ctx, {
          type: 'line',
          data: {
            labels: [],
            datasets: []
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              title: {
                display: true,
                text: 'Financial Model Visualization',
                color: '#e2e8f0'
              },
              legend: {
                labels: {
                  color: '#e2e8f0'
                }
              }
            },
            scales: {
              x: {
                ticks: { color: '#94a3b8' },
                grid: { color: '#334155' }
              },
              y: {
                ticks: { color: '#94a3b8' },
                grid: { color: '#334155' }
              }
            }
          }
        });
      }

      private setupEventListeners() {
        this.sendBtn.addEventListener('click', () => this.sendMessage());
        this.chatInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') this.sendMessage();
        });
      }

      private async sendMessage() {
        const message = this.chatInput.value.trim();
        if (!message) return;

        this.addChatMessage('user', message);
        this.chatInput.value = '';
        this.setThinkingStatus('thinking', 'AI is analyzing your request...');

        try {
          await this.processAIRequest(message);
        } catch (error) {
          this.addChatMessage('assistant', `❌ Error: ${error}`);
          this.setThinkingStatus('error', 'Error processing request');
        }
      }

      private addChatMessage(role: 'user' | 'assistant', content: string) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `p-3 rounded-lg ${
          role === 'user' 
            ? 'bg-emerald-600/20 border-l-4 border-emerald-500 ml-4' 
            : 'bg-blue-600/20 border-l-4 border-blue-500 mr-4'
        }`;
        
        const roleIcon = role === 'user' ? '👤' : '🤖';
        messageDiv.innerHTML = `
          <div class="text-xs text-gray-400 mb-1">${roleIcon} ${role.toUpperCase()}</div>
          <div class="text-sm">${content}</div>
        `;
        
        this.chatMessages.appendChild(messageDiv);
        this.chatMessages.scrollTop = this.chatMessages.scrollHeight;
      }

      private setThinkingStatus(status: 'ready' | 'thinking' | 'error', text: string) {
        const statusColors = {
          ready: 'bg-gray-500',
          thinking: 'bg-yellow-500 animate-pulse',
          error: 'bg-red-500'
        };
        
        this.thinkingStatus.className = `w-2 h-2 rounded-full ${statusColors[status]}`;
        this.thinkingText.textContent = text;
      }

      private addThinkingStep(step: ThinkingStep) {
        const stepDiv = document.createElement('div');
        stepDiv.className = 'mb-3 p-3 bg-slate-700/50 rounded-lg border-l-4 border-blue-400';
        stepDiv.innerHTML = `
          <div class="text-xs text-blue-300 font-semibold mb-1">Step ${step.step}</div>
          <div class="text-sm mb-2">${step.thought}</div>
          ${step.action ? `<div class="text-xs text-yellow-300">🔧 ${step.action}</div>` : ''}
          ${step.parameters ? `<div class="text-xs text-gray-400 mt-1">
            <code>${JSON.stringify(step.parameters, null, 2)}</code>
          </div>` : ''}
        `;
        
        this.thinkingDisplay.appendChild(stepDiv);
        this.thinkingDisplay.scrollTop = this.thinkingDisplay.scrollHeight;
      }

      private addModelChange(change: ModelChange) {
        const changeDiv = document.createElement('div');
        changeDiv.className = 'mb-3 p-3 bg-slate-700/50 rounded-lg border-l-4 border-purple-400';
        
        const typeIcons = {
          lease: '🏗️',
          amortization: '🏦',
          ebitda: '📈'
        };
        
        changeDiv.innerHTML = `
          <div class="text-xs text-purple-300 font-semibold mb-1">
            ${typeIcons[change.type]} ${change.type.toUpperCase()} Modified
          </div>
          <div class="text-xs text-gray-300 mb-2">
            <strong>Input:</strong> <code>${JSON.stringify(change.parameters, null, 2)}</code>
          </div>
          <div class="text-xs text-green-300">
            <strong>Result:</strong> <code>${JSON.stringify(change.result, null, 2)}</code>
          </div>
        `;
        
        this.modelChanges.appendChild(changeDiv);
        this.modelChanges.scrollTop = this.modelChanges.scrollHeight;
      }

      private updateModelDisplay(type: 'lease' | 'amortization' | 'ebitda', result: any) {
        const containers = {
          lease: this.leaseModel,
          amortization: this.amortizationModel,
          ebitda: this.ebitdaModel
        };
        
        const container = containers[type];
        
        if (type === 'lease' && result.monthlyPayment) {
          container.innerHTML = `
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-gray-400">Monthly Payment:</span>
                <span class="text-yellow-400 font-semibold">$${result.monthlyPayment.toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Total Cost:</span>
                <span class="text-white">$${result.totalCost.toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Total Interest:</span>
                <span class="text-red-300">$${result.totalInterest.toLocaleString()}</span>
              </div>
            </div>
          `;
          this.updateChart('lease', result);
        } else if (type === 'amortization' && result.monthlyPayment) {
          container.innerHTML = `
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-gray-400">Monthly Payment:</span>
                <span class="text-green-400 font-semibold">$${result.monthlyPayment.toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Total Interest:</span>
                <span class="text-red-300">$${result.totalInterest.toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Payoff Time:</span>
                <span class="text-white">${Math.round(result.termMonths / 12)} years</span>
              </div>
            </div>
          `;
          this.updateChart('amortization', result);
        } else if (type === 'ebitda' && result.summary) {
          container.innerHTML = `
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-gray-400">Total EBITDA:</span>
                <span class="text-cyan-400 font-semibold">$${result.summary.totalEbitda.toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Avg Monthly:</span>
                <span class="text-white">$${(result.summary.totalEbitda / result.forecast.length).toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-400">Revenue Growth:</span>
                <span class="text-green-300">${((result.summary.revenueGrowth || 0) * 100).toFixed(1)}%</span>
              </div>
            </div>
          `;
          this.updateChart('ebitda', result);
        }
      }
      
      private updateChart(type: 'lease' | 'amortization' | 'ebitda', result: any) {
        if (!this.chart) return;

        let labels: string[] = [];
        let datasets: any[] = [];

        if (type === 'lease') {
          // Show payment breakdown over time
          const termMonths = result.termMonths || 36;
          labels = Array.from({length: Math.min(termMonths, 12)}, (_, i) => `Month ${i + 1}`);
          datasets = [{
            label: 'Monthly Payment',
            data: Array(labels.length).fill(result.monthlyPayment),
            borderColor: '#facc15',
            backgroundColor: '#facc15',
            tension: 0.1
          }];
        } else if (type === 'amortization' && result.schedule) {
          // Show first 12 months of amortization schedule
          const schedule = result.schedule.slice(0, 12);
          labels = schedule.map((_: any, i: number) => `Month ${i + 1}`);
          datasets = [
            {
              label: 'Principal Payment',
              data: schedule.map((p: any) => p.principalPayment),
              borderColor: '#22c55e',
              backgroundColor: '#22c55e',
              tension: 0.1
            },
            {
              label: 'Interest Payment',
              data: schedule.map((p: any) => p.interestPayment),
              borderColor: '#ef4444',
              backgroundColor: '#ef4444',
              tension: 0.1
            }
          ];
        } else if (type === 'ebitda' && result.forecast) {
          // Show EBITDA forecast
          labels = result.forecast.map((f: any, i: number) => `Month ${i + 1}`);
          datasets = [
            {
              label: 'Revenue',
              data: result.forecast.map((f: any) => f.revenue),
              borderColor: '#06b6d4',
              backgroundColor: '#06b6d4',
              tension: 0.1
            },
            {
              label: 'EBITDA',
              data: result.forecast.map((f: any) => f.ebitda),
              borderColor: '#8b5cf6',
              backgroundColor: '#8b5cf6',
              tension: 0.1
            }
          ];
        }

        this.chart.data.labels = labels;
        this.chart.data.datasets = datasets;
        this.chart.update();
      }

      private async processAIRequest(message: string) {
        try {
          // Call the enhanced chat endpoint
          const response = await fetch('/v1/chat/enhanced', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              messages: [
                { role: 'user', content: message }
              ]
            })
          });

          if (!response.ok) {
            throw new Error(`Chat API call failed: ${response.status}`);
          }

          const result = await response.json();

          // Display thinking steps if provided
          if (result.thinking && Array.isArray(result.thinking)) {
            for (const step of result.thinking) {
              this.addThinkingStep(step);
              // Add a small delay to show the thinking process unfolding
              await new Promise(resolve => setTimeout(resolve, 300));
            }
          }

          // Display model changes if provided
          if (result.model_changes && Array.isArray(result.model_changes)) {
            for (const change of result.model_changes) {
              this.addModelChange(change);
              this.updateModelDisplay(change.type, change.result);
            }
          }

          // Display the assistant's response
          this.addChatMessage('assistant', result.content);
          this.setThinkingStatus('ready', 'Analysis complete');

        } catch (error) {
          console.error('Chat processing error:', error);
          this.addChatMessage('assistant', `❌ Error: ${error}`);
          this.setThinkingStatus('error', 'Error processing request');
        }
      }
    }

    // Initialize the UI when the page loads
    document.addEventListener('DOMContentLoaded', () => {
      new AIModelerUI();
    });
  </script>
</Layout>