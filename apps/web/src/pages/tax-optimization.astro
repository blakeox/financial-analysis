---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
import ToolPageShell from '../components/site/ToolPageShell.astro';
import WorkflowSupportRail from '../components/WorkflowSupportRail.astro';
---

<Layout
  title="Tax Optimization Planner - Free Tax Planning & Strategy Tool | Fanalyx"
  description="Comprehensive tax optimization planner with tax-loss harvesting, Roth vs Traditional IRA analysis, capital gains optimization, charitable giving strategies, and tax bracket optimization. Professional tax planning made simple."
  keywords="tax optimization, tax planning, tax strategy, Roth IRA, Traditional IRA, tax-loss harvesting, capital gains, charitable giving, tax bracket, tax calculator"
  canonical={Astro.url.href}
  type="article"

  showChat={false}
  showToolAnalysis={false}
>
  <!-- Structured Data for SEO -->
  <StructuredData
    type="breadcrumb"
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Personal Finance', url: '/models/personal' },
      { name: 'Tax Optimization', url: '/tax-optimization' },
    ]}
  />

  <StructuredData
    type="software"
    softwareApp={{
      name: 'Tax Optimization Planner',
      description:
        'Professional tax optimization tool with tax-loss harvesting, Roth vs Traditional IRA analysis, capital gains optimization, charitable giving strategies, and comprehensive tax planning.',
      category: 'FinanceApplication',
      rating: 4.8,
      ratingCount: 240,
    }}
  />

  <StructuredData
    type="faq"
    faqs={[
      {
        question: 'What is tax optimization and why is it important?',
        answer:
          'Tax optimization involves strategically managing your finances to minimize tax liability while staying compliant. It includes strategies like tax-loss harvesting, retirement account optimization, charitable giving, and timing income and deductions. Proper tax optimization can save thousands of dollars annually.',
      },
      {
        question: 'Should I contribute to a Roth or Traditional IRA?',
        answer:
          'The choice depends on your current tax bracket, expected future tax bracket, and time horizon. Generally, Roth IRAs are better if you expect to be in a higher tax bracket in retirement, while Traditional IRAs provide immediate tax deductions. Our calculator analyzes your specific situation to recommend the best strategy.',
      },
      {
        question: 'What is tax-loss harvesting?',
        answer:
          'Tax-loss harvesting involves selling investments at a loss to offset capital gains and reduce taxes. You can deduct up to $3,000 in net capital losses against ordinary income each year, with excess losses carrying forward. This strategy is most effective in taxable investment accounts.',
      },
      {
        question: 'How can charitable giving reduce my taxes?',
        answer:
          'Charitable contributions are tax-deductible if you itemize. Donating appreciated assets (like stocks) can be especially tax-efficient, as you avoid capital gains tax while getting a deduction for the full fair market value. Donor-advised funds allow you to donate now and distribute later.',
      },
      {
        question: 'What is tax bracket optimization?',
        answer:
          'Tax bracket optimization involves managing your income and deductions to stay in a lower tax bracket. Strategies include timing income recognition, maximizing deductions, contributing to retirement accounts, and using tax-loss harvesting to offset gains.',
      },
    ]}
  />

  <ToolPageShell
    eyebrow="Personal finance"
    title="Tax Optimization Planner"
    description="Comprehensive tax planning and optimization strategies to minimize your tax liability"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Models', href: '/models' },
      { label: 'Personal Finance', href: '/models/personal' },
      { label: 'Tax Optimization' },
    ]}
  >
    <div id="results" class="hidden" aria-hidden="true"></div>

    <div class="fa-workflow-grid">
      <div class="space-y-8">
    <!-- Tax Optimization Form -->
    <div class="fa-card p-6 mb-8">
      <h2 class="fa-panel-title mb-6">Personal Information</h2>

      <form id="tax-optimization-form" class="space-y-6">
        <!-- Personal Info Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label
              for="age"
              class="fa-field-label mb-2"
            >
              Age
            </label>
            <input
              type="number"
              id="age"
              name="age"
              min="18"
              max="100"
              class="fa-input-surface w-full"
              placeholder="35"
              required
            />
          </div>

          <div>
            <label
              for="maritalStatus"
              class="fa-field-label mb-2"
            >
              Marital Status
            </label>
            <select
              id="maritalStatus"
              name="maritalStatus"
              class="fa-input-surface w-full"
              required
            >
              <option value="">Select...</option>
              <option value="single">Single</option>
              <option value="married-filing-jointly">Married Filing Jointly</option>
              <option value="married-filing-separately">Married Filing Separately</option>
              <option value="head-of-household">Head of Household</option>
              <option value="qualifying-widow">Qualifying Widow(er)</option>
            </select>
          </div>

          <div>
            <label
              for="dependents"
              class="fa-field-label mb-2"
            >
              Number of Dependents
            </label>
            <input
              type="number"
              id="dependents"
              name="dependents"
              min="0"
              max="20"
              value="0"
              class="fa-input-surface w-full"
            />
          </div>

          <div>
            <label
              for="state"
              class="fa-field-label mb-2"
            >
              State of Residence
            </label>
            <input
              type="text"
              id="state"
              name="state"
              class="fa-input-surface w-full"
              placeholder="CA"
            />
          </div>
        </div>

        <!-- Income Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">
            Income Information
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="annualIncome"
                class="fa-field-label mb-2"
              >
                Annual Income ($)
              </label>
              <input
                type="number"
                id="annualIncome"
                name="annualIncome"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="100000"
                required
              />
            </div>

            <div>
              <label
                for="adjustedGrossIncome"
                class="fa-field-label mb-2"
              >
                Adjusted Gross Income ($)
              </label>
              <input
                type="number"
                id="adjustedGrossIncome"
                name="adjustedGrossIncome"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="95000"
                required
              />
            </div>

            <div>
              <label
                for="taxableIncome"
                class="fa-field-label mb-2"
              >
                Taxable Income ($)
              </label>
              <input
                type="number"
                id="taxableIncome"
                name="taxableIncome"
                min="0"
                step="1000"
                class="fa-input-surface w-full"
                placeholder="75000"
                required
              />
            </div>

            <div>
              <label
                for="federalTaxOwed"
                class="fa-field-label mb-2"
              >
                Federal Tax Owed ($)
              </label>
              <input
                type="number"
                id="federalTaxOwed"
                name="federalTaxOwed"
                min="0"
                step="100"
                class="fa-input-surface w-full"
                placeholder="12000"
                required
              />
            </div>
          </div>
        </div>

        <!-- Retirement Accounts Section -->
        <div class="fa-panel-divider-top pt-6 mt-6">
          <h3 class="fa-scenario-title mb-4">
            Retirement Accounts
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                for="traditional401k"
                class="fa-field-label mb-2"
              >
                Traditional 401(k) Balance ($)
              </label>
              <input
                type="number"
                id="traditional401k"
                name="traditional401k"
                min="0"
                step="1000"
                value="0"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="roth401k"
                class="fa-field-label mb-2"
              >
                Roth 401(k) Balance ($)
              </label>
              <input
                type="number"
                id="roth401k"
                name="roth401k"
                min="0"
                step="1000"
                value="0"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="traditionalIRA"
                class="fa-field-label mb-2"
              >
                Traditional IRA Balance ($)
              </label>
              <input
                type="number"
                id="traditionalIRA"
                name="traditionalIRA"
                min="0"
                step="1000"
                value="0"
                class="fa-input-surface w-full"
              />
            </div>

            <div>
              <label
                for="rothIRA"
                class="fa-field-label mb-2"
              >
                Roth IRA Balance ($)
              </label>
              <input
                type="number"
                id="rothIRA"
                name="rothIRA"
                min="0"
                step="1000"
                value="0"
                class="fa-input-surface w-full"
              />
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-6 fa-panel-divider-top mt-6">
          <button type="submit" class="fa-button-primary"> Analyze Tax Optimization </button>
        </div>
      </form>
    </div>

    <!-- Results Section -->
    <div id="tax-results" class="fa-card hidden p-6 mb-8">
      <h2 class="fa-panel-title text-xl mb-4">
        Tax Optimization Results
      </h2>
      <div id="tax-results-content" class="space-y-4"></div>
    </div>

    <!-- AdSense -->
    <AdSense slot="0123456789" format="horizontal" className="mt-8" />
      </div>

      <WorkflowSupportRail modelType="tax-optimization" />
    </div>
  </ToolPageShell>

  <ClientScriptLoader client:load slot="pageScripts" name="tax-optimization" />
</Layout>
