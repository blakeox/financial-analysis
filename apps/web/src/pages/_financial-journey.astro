---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';

const pageMeta = {
  title: 'Financial Journey Analysis - Multi-Stage Planning',
  description: 'Multi-stage financial planning and analysis system with personalized roadmaps, cross-model integration, and journey-based recommendations.',
  canonical: '/financial-journey',
  keywords: 'financial journey, multi-stage planning, financial roadmap, personal finance planning, financial milestones, journey analysis',
};
---

<Layout
  title={pageMeta.title}
  description={pageMeta.description}
  canonical={pageMeta.canonical}
  keywords={pageMeta.keywords}
>
  <SEO
    title={pageMeta.title}
    description="Comprehensive multi-stage financial journey analysis with personalized roadmaps, cross-model integration, and journey-based recommendations for your financial success."
    canonical={pageMeta.canonical}
    keywords={pageMeta.keywords}
  />

  <main class="min-h-screen bg-linear-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800">
    <!-- Hero Section -->
    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Your Financial Journey
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
          Navigate your financial future with our comprehensive multi-stage planning system. 
          Get personalized roadmaps, cross-model analysis, and journey-based recommendations.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/journey" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
            Start Your Journey
          </a>
          <a href="#how-it-works" class="bg-white dark:bg-gray-800 text-blue-600 dark:text-blue-400 px-8 py-3 rounded-lg font-semibold border-2 border-blue-600 dark:border-blue-400 hover:bg-blue-50 dark:hover:bg-gray-700 transition-colors">
            Learn More
          </a>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="py-16 px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
          How Financial Journey Analysis Works
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="text-center">
            <div class="bg-blue-100 dark:bg-blue-900 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-blue-600 dark:text-blue-400">1</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
              Assess Your Current Stage
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              Our system analyzes your financial situation to determine which stage of your journey you're in.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="text-center">
            <div class="bg-blue-100 dark:bg-blue-900 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-blue-600 dark:text-blue-400">2</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
              Get Personalized Roadmap
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              Receive a customized roadmap with specific models and recommendations for your financial goals.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="text-center">
            <div class="bg-blue-100 dark:bg-blue-900 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-blue-600 dark:text-blue-400">3</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
              Track Your Progress
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              Monitor your progress across multiple financial models and get insights for continuous improvement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Journey Stages Section -->
    <section class="py-16 px-4 bg-white dark:bg-gray-800">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
          Financial Journey Stages
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Getting Started -->
          <div class="bg-linear-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg p-6 border border-green-200 dark:border-green-700">
            <h3 class="text-lg font-semibold text-green-800 dark:text-green-300 mb-3">
              Getting Started
            </h3>
            <p class="text-green-700 dark:text-green-400 text-sm mb-4">
              Build emergency fund, optimize budget, and establish financial foundation.
            </p>
            <div class="text-xs text-green-600 dark:text-green-500">
              Models: Budget, Emergency Fund, Basic Insurance
            </div>
          </div>

          <!-- Debt Management -->
          <div class="bg-linear-to-br from-orange-50 to-red-50 dark:from-orange-900/20 dark:to-red-900/20 rounded-lg p-6 border border-orange-200 dark:border-orange-700">
            <h3 class="text-lg font-semibold text-orange-800 dark:text-orange-300 mb-3">
              Debt Management
            </h3>
            <p class="text-orange-700 dark:text-orange-400 text-sm mb-4">
              Eliminate high-interest debt and optimize repayment strategies.
            </p>
            <div class="text-xs text-orange-600 dark:text-orange-500">
              Models: Student Loans, Debt Payoff, Auto Loans
            </div>
          </div>

          <!-- Investment Building -->
          <div class="bg-linear-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-700">
            <h3 class="text-lg font-semibold text-blue-800 dark:text-blue-300 mb-3">
              Investment Building
            </h3>
            <p class="text-blue-700 dark:text-blue-400 text-sm mb-4">
              Build diversified portfolios and optimize investment strategies.
            </p>
            <div class="text-xs text-blue-600 dark:text-blue-500">
              Models: Investment Portfolio, Tax Optimization
            </div>
          </div>

          <!-- Retirement Planning -->
          <div class="bg-linear-to-br from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20 rounded-lg p-6 border border-purple-200 dark:border-purple-700">
            <h3 class="text-lg font-semibold text-purple-800 dark:text-purple-300 mb-3">
              Retirement Planning
            </h3>
            <p class="text-purple-700 dark:text-purple-400 text-sm mb-4">
              Maximize retirement savings and plan for long-term financial security.
            </p>
            <div class="text-xs text-purple-600 dark:text-purple-500">
              Models: Retirement Planning, Tax Optimization
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">
          Ready to Start Your Financial Journey?
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
          Get personalized recommendations and track your progress across multiple financial models.
        </p>
        <a href="/journey" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors inline-block">
          Begin Your Journey Analysis
        </a>
      </div>
    </section>
  </main>
</Layout>