---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['invest-vs-payoff-debt'];

if (!currentScenario) {
  throw new Error('Journey not found: invest-vs-payoff-debt');
}

const currentStep = currentScenario.models.find(m => m.id === 'evaluate-investments');
const currentStepOrder = currentStep?.order || 3;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'invest-vs-payoff-debt',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: '/journey/invest-vs-payoff-debt'
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <JourneyStepHero
            icon="📈"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Investment Evaluation Form -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Evaluate Your Investment Options</h2>
            
            <div class="fa-callout-success mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm">
                    <strong>Key Factor:</strong> Compare expected investment returns with your debt interest rate. Also consider employer match - that's free money you shouldn't miss!
                  </p>
                </div>
              </div>
            </div>
            
            <form id="investment-form" class="space-y-6">
              <!-- Expected Returns -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">📊 Expected Investment Returns</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="expected-return" class="fa-field-label mb-2">
                      Expected Annual Return (%) *
                    </label>
                    <input 
                      type="number" 
                      step="0.1"
                      id="expected-return" 
                      name="expectedReturn"
                       class="fa-input-surface w-full"
                      placeholder="10"
                      required
                    />
                    <p class="fa-help-copy mt-1">S&P 500 historical average: ~10% annually</p>
                  </div>
                  <div>
                    <label for="investment-type" class="fa-field-label mb-2">
                      Investment Type *
                    </label>
                    <select 
                      id="investment-type" 
                      name="investmentType"
                       class="fa-input-surface w-full"
                      required
                    >
                      <option value="">Select type</option>
                      <option value="401k">401(k) Retirement Account</option>
                      <option value="ira">IRA (Traditional or Roth)</option>
                      <option value="brokerage">Taxable Brokerage Account</option>
                      <option value="other">Other Investment Account</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Employer Match -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🎁 Employer Match (If Applicable)</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      Do you have employer match available?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="hasEmployerMatch" value="yes" class="mt-1 mr-3" id="has-match-yes">
                        <div>
                          <span class="fa-list-copy-strong">Yes, I have employer match</span>
                          <p class="fa-help-copy">This is free money - usually prioritize this!</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="hasEmployerMatch" value="no" class="mt-1 mr-3" id="has-match-no" checked>
                        <div>
                          <span class="fa-list-copy-strong">No employer match</span>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div id="employer-match-details" class="hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <label for="employer-match-rate" class="fa-field-label mb-2">
                          Employer Match Rate (%)
                        </label>
                        <input 
                          type="number" 
                          step="0.1"
                          id="employer-match-rate" 
                          name="employerMatchRate"
                           class="fa-input-surface w-full"
                          placeholder="50"
                        />
                         <p class="fa-help-copy mt-1">e.g., 50% means employer contributes $0.50 per $1.00 you contribute</p>
                      </div>
                      <div>
                        <label for="match-limit" class="fa-field-label mb-2">
                          Match Limit (% of salary)
                        </label>
                        <input 
                          type="number" 
                          step="0.1"
                          id="match-limit" 
                          name="matchLimit"
                           class="fa-input-surface w-full"
                          placeholder="6"
                        />
                         <p class="fa-help-copy mt-1">e.g., 6% means match up to 6% of your salary</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Risk Tolerance -->
              <div class="pb-6">
                 <h3 class="fa-scenario-title mb-4">⚖️ Risk Considerations</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      Investment Risk Tolerance
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="riskTolerance" value="conservative" class="mt-1 mr-3">
                        <div>
                           <span class="fa-list-copy-strong">Conservative</span>
                           <p class="fa-help-copy">Prefer guaranteed returns (debt payoff)</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="riskTolerance" value="moderate" class="mt-1 mr-3" checked>
                        <div>
                           <span class="fa-list-copy-strong">Moderate</span>
                           <p class="fa-help-copy">Balance between risk and return</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="riskTolerance" value="aggressive" class="mt-1 mr-3">
                        <div>
                           <span class="fa-list-copy-strong">Aggressive</span>
                           <p class="fa-help-copy">Comfortable with market risk for higher returns</p>
                        </div>
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="button" id="save-investment-btn" class="fa-button-primary">
                  Save & Continue
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="investment-results" class="fa-highlight-card hidden mt-8 p-6">
              <h3 class="fa-scenario-title mb-4">📊 Your Investment Summary</h3>
              <div id="investment-results-content" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>

          <!-- Journey Navigation -->
          <div class="fa-card p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="fa-button-secondary"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="fa-button-secondary"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a 
                    href={journeyNav.nextStep.url}
                    class="fa-button-primary"
                  >
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href={`/journey-analysis/${journeyNav.scenarioId}`}
                    class="fa-button-primary"
                  >
                    Complete Journey
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="fa-card p-5 mb-6">
             <h3 class="fa-scenario-title mb-4">💡 Return Expectations</h3>
             <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>S&P 500:</strong> ~10% annual average (long-term)</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Bonds:</strong> ~3-5% annual average</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Remember:</strong> Past performance doesn't guarantee future results</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
             <h3 class="fa-scenario-title mb-4">🎁 Employer Match</h3>
             <div class="space-y-3 fa-list-copy">
              <p><strong>Free Money:</strong> Employer match is typically 50-100% return immediately</p>
              <p><strong>Priority:</strong> Usually best to get full match before paying extra on debt</p>
              <p><strong>Example:</strong> 50% match on 6% = 3% free money from employer</p>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('investment-form') as HTMLFormElement | null;
      const saveBtn = document.getElementById('save-investment-btn');
      const resetBtn = document.getElementById('reset-btn');
      const investmentResults = document.getElementById('investment-results');
      const investmentResultsContent = document.getElementById('investment-results-content');
      const employerMatchDetails = document.getElementById('employer-match-details');
      const hasMatchRadios = document.querySelectorAll<HTMLInputElement>('input[name="hasEmployerMatch"]');

      if (!form) {
        console.error('Investment form not found');
        return;
      }

      // Show/hide employer match details
      hasMatchRadios.forEach(radio => {
        radio.addEventListener('change', (event) => {
          const target = event.target as HTMLInputElement;
          if (target.value === 'yes') {
            employerMatchDetails?.classList.remove('hidden');
          } else {
            employerMatchDetails?.classList.add('hidden');
          }
        });
      });

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          const formData = new FormData(form);
          const expectedReturn = parseFloat(formData.get('expectedReturn') as string || '0');
          const investmentType = formData.get('investmentType') as string;
          const hasEmployerMatch = formData.get('hasEmployerMatch') as string;
          const employerMatchRate = parseFloat(formData.get('employerMatchRate') as string || '0');
          const matchLimit = parseFloat(formData.get('matchLimit') as string || '0');
          const riskTolerance = formData.get('riskTolerance') as string || 'moderate';

          if (!expectedReturn || !investmentType) {
            alert('Please fill in all required fields.');
            return;
          }

          // Calculate effective return with employer match
          let effectiveReturn = expectedReturn;
          if (hasEmployerMatch === 'yes' && employerMatchRate > 0) {
            // Employer match adds immediate return
            effectiveReturn = expectedReturn + (employerMatchRate / 100 * 100); // Simplified calculation
          }

          // Store in journey state
          const investmentData = {
            expectedReturn,
            effectiveReturn: effectiveReturn.toFixed(2),
            investmentType,
            hasEmployerMatch,
            employerMatchRate: hasEmployerMatch === 'yes' ? employerMatchRate : 0,
            matchLimit: hasEmployerMatch === 'yes' ? matchLimit : 0,
            riskTolerance,
            completedAt: new Date().toISOString()
          };

          const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['evaluate-investments'] = investmentData;
          localStorage.setItem('fanalyx-journey-state-invest-vs-payoff-debt', JSON.stringify(journeyState));

          // Show results
          investmentResultsContent!.innerHTML = `
            <div class="fa-subcard">
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Expected Return:</span>
                  <span class="fa-list-copy-strong">${expectedReturn}%</span>
                </div>
                ${hasEmployerMatch === 'yes' && employerMatchRate > 0 ? `
                  <div class="flex justify-between">
                    <span class="fa-meta-copy">Employer Match:</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-300">${employerMatchRate}%</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="fa-meta-copy">Effective Return:</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-300">${effectiveReturn.toFixed(1)}%</span>
                  </div>
                ` : ''}
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Investment Type:</span>
                  <span class="fa-list-copy-strong">${investmentType.toUpperCase()}</span>
                </div>
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Risk Tolerance:</span>
                  <span class="fa-list-copy-strong">${riskTolerance.charAt(0).toUpperCase() + riskTolerance.slice(1)}</span>
                </div>
              </div>
              <div class="fa-highlight-card mt-4 p-3">
                <p class="text-sm text-violet-800 dark:text-violet-200">
                  ${hasEmployerMatch === 'yes' ? '🎁 Employer match significantly increases your effective return! Consider prioritizing this.' : expectedReturn >= 8 ? '💡 Good expected return. Compare with your debt interest rate.' : '💡 Lower expected return. Paying off debt may be better if interest rate is high.'}
                </p>
              </div>
            </div>
          `;

          investmentResults?.classList.remove('hidden');

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-violet-600', 'hover:bg-violet-700');
          saveBtn.classList.add('bg-violet-500');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save & Continue';
            saveBtn.classList.remove('bg-violet-500');
            saveBtn.classList.add('bg-violet-600', 'hover:bg-violet-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'evaluate-investments',
              result: investmentData,
              formData: investmentData
            }
          }));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form.reset();
          investmentResults?.classList.add('hidden');
          employerMatchDetails?.classList.add('hidden');
        });
      }

      // Load saved data if exists
      const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
      if (journeyState.collectedData?.['evaluate-investments']) {
        const saved = journeyState.collectedData['evaluate-investments'];
        if (saved.expectedReturn) {
          (document.getElementById('expected-return') as HTMLInputElement).value = saved.expectedReturn;
        }
        if (saved.investmentType) {
          (document.getElementById('investment-type') as HTMLSelectElement).value = saved.investmentType;
        }
        if (saved.hasEmployerMatch) {
          const radio = form.querySelector(`input[value="${saved.hasEmployerMatch}"]`) as HTMLInputElement;
          if (radio) {
            radio.checked = true;
            if (saved.hasEmployerMatch === 'yes') {
              employerMatchDetails?.classList.remove('hidden');
            }
          }
        }
        if (saved.employerMatchRate) {
          (document.getElementById('employer-match-rate') as HTMLInputElement).value = saved.employerMatchRate;
        }
        if (saved.matchLimit) {
          (document.getElementById('match-limit') as HTMLInputElement).value = saved.matchLimit;
        }
        if (saved.riskTolerance) {
          const radio = form.querySelector(`input[value="${saved.riskTolerance}"]`) as HTMLInputElement;
          if (radio) radio.checked = true;
        }
      }
    });
  </script>
</Layout>
