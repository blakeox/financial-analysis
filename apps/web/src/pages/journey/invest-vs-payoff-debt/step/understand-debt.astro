---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['invest-vs-payoff-debt'];

if (!currentScenario) {
  throw new Error('Journey not found: invest-vs-payoff-debt');
}

const currentStep = currentScenario.models.find(m => m.id === 'understand-debt');
const currentStepOrder = currentStep?.order || 2;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'invest-vs-payoff-debt',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: '/journey/invest-vs-payoff-debt'
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <main class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <JourneyStepHero
            icon="💳"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Debt Documentation Form -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Document Your Debts</h2>
            
            <div class="fa-highlight-card mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-blue-700 dark:text-blue-300">
                    <strong>Key Information:</strong> To make the best decision, we need to know your debt balances, interest rates, and minimum payments. Higher interest rates (typically above 7-8%) usually favor paying off debt first.
                  </p>
                </div>
              </div>
            </div>
            
            <form id="debt-form" class="space-y-6">
              <!-- Primary Debt -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">💳 Primary Debt</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="debt-balance" class="fa-field-label mb-2">
                      Total Debt Balance ($) *
                    </label>
                    <input 
                      type="number" 
                      id="debt-balance" 
                      name="debtBalance"
                       class="fa-input-surface w-full"
                      placeholder="10000"
                      required
                    />
                  </div>
                  <div>
                    <label for="debt-interest-rate" class="fa-field-label mb-2">
                      Interest Rate (%) *
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="debt-interest-rate" 
                      name="debtInterestRate"
                       class="fa-input-surface w-full"
                      placeholder="18"
                      required
                    />
                     <p class="fa-help-copy mt-1">APR (Annual Percentage Rate)</p>
                  </div>
                  <div>
                    <label for="minimum-payment" class="fa-field-label mb-2">
                      Minimum Monthly Payment ($) *
                    </label>
                    <input 
                      type="number" 
                      id="minimum-payment" 
                      name="minimumPayment"
                       class="fa-input-surface w-full"
                      placeholder="200"
                      required
                    />
                  </div>
                  <div>
                    <label for="debt-type" class="fa-field-label mb-2">
                      Debt Type *
                    </label>
                    <select 
                      id="debt-type" 
                      name="debtType"
                       class="fa-input-surface w-full"
                      required
                    >
                      <option value="">Select type</option>
                      <option value="credit-card">Credit Card</option>
                      <option value="student-loan">Student Loan</option>
                      <option value="auto-loan">Auto Loan</option>
                      <option value="mortgage">Mortgage</option>
                      <option value="personal-loan">Personal Loan</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Additional Context -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">📊 Additional Context</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      Is this debt tax-deductible?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="taxDeductible" value="yes" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Yes (e.g., mortgage, student loans)</span>
                          <p class="fa-help-copy">May reduce effective interest rate</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="taxDeductible" value="no" class="mt-1 mr-3" checked>
                        <div>
                          <span class="fa-list-copy-strong">No (e.g., credit cards, auto loans)</span>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="time-horizon" class="fa-field-label mb-2">
                      Time Horizon for This Decision *
                    </label>
                    <select 
                      id="time-horizon" 
                      name="timeHorizon"
                       class="fa-input-surface w-full"
                      required
                    >
                      <option value="">Select timeline</option>
                      <option value="1">1 year</option>
                      <option value="3">3 years</option>
                      <option value="5" selected>5 years</option>
                      <option value="10">10 years</option>
                      <option value="20">20+ years</option>
                    </select>
                     <p class="fa-help-copy mt-1">How long will you follow this strategy?</p>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="button" id="save-debt-btn" class="fa-button-primary">
                  Save & Continue
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="debt-results" class="fa-highlight-card hidden mt-8 p-6">
              <h3 class="fa-scenario-title mb-4">📊 Your Debt Summary</h3>
              <div id="debt-results-content" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>

          <!-- Journey Navigation -->
          <div class="fa-card p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="fa-button-secondary"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="fa-button-secondary"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a 
                    href={journeyNav.nextStep.url}
                    class="fa-button-primary"
                  >
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href={`/journey-analysis/${journeyNav.scenarioId}`}
                    class="fa-button-primary"
                  >
                    Complete Journey
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title mb-4">💡 Interest Rate Guide</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>High (8%+):</strong> Usually better to pay off debt first. Credit cards, personal loans.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Medium (4-8%):</strong> Depends on investment returns. Student loans, some auto loans.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Low (&lt;4%):</strong> Often better to invest. Mortgages, some student loans.</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-4">📋 Debt Types</h3>
            <div class="space-y-3 fa-list-copy">
              <p><strong>Credit Cards:</strong> Usually highest interest (15-25%)</p>
              <p><strong>Student Loans:</strong> Often 3-7%, may be tax-deductible</p>
              <p><strong>Auto Loans:</strong> Typically 3-8%</p>
              <p><strong>Mortgages:</strong> Usually lowest (2-5%), tax-deductible</p>
              <p><strong>Personal Loans:</strong> Varies widely (6-36%)</p>
            </div>
          </div>
        </div>
      </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('debt-form') as HTMLFormElement | null;
      const saveBtn = document.getElementById('save-debt-btn');
      const resetBtn = document.getElementById('reset-btn');
      const debtResults = document.getElementById('debt-results');
      const debtResultsContent = document.getElementById('debt-results-content');

      if (!form) {
        console.error('Debt form not found');
        return;
      }

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          const formData = new FormData(form);
          const debtBalance = parseFloat(formData.get('debtBalance') as string || '0');
          const debtInterestRate = parseFloat(formData.get('debtInterestRate') as string || '0');
          const minimumPayment = parseFloat(formData.get('minimumPayment') as string || '0');
          const debtType = formData.get('debtType') as string;
          const taxDeductible = formData.get('taxDeductible') as string || 'no';
          const timeHorizon = formData.get('timeHorizon') as string;

          if (!debtBalance || !debtInterestRate || !minimumPayment || !debtType || !timeHorizon) {
            alert('Please fill in all required fields.');
            return;
          }

          // Calculate effective interest rate if tax-deductible
          const effectiveRate = taxDeductible === 'yes' ? debtInterestRate * 0.75 : debtInterestRate; // Assuming 25% tax bracket

          // Store in journey state
          const debtData = {
            debtBalance,
            debtInterestRate,
            effectiveRate: effectiveRate.toFixed(2),
            minimumPayment,
            debtType,
            taxDeductible,
            timeHorizon: parseInt(timeHorizon),
            completedAt: new Date().toISOString()
          };

          const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['understand-debt'] = debtData;
          localStorage.setItem('fanalyx-journey-state-invest-vs-payoff-debt', JSON.stringify(journeyState));

          // Show results
          const rateCategory = debtInterestRate >= 8 ? 'High' : debtInterestRate >= 4 ? 'Medium' : 'Low';
          const rateColor = debtInterestRate >= 8 ? 'red' : debtInterestRate >= 4 ? 'yellow' : 'green';

          debtResultsContent!.innerHTML = `
            <div class="fa-subcard">
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Debt Balance:</span>
                  <span class="fa-list-copy-strong">$${debtBalance.toLocaleString()}</span>
                </div>
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Interest Rate:</span>
                  <span class="fa-list-copy-strong">${debtInterestRate}%</span>
                </div>
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Rate Category:</span>
                  <span class="font-semibold text-${rateColor}-600 dark:text-${rateColor}-400">${rateCategory}</span>
                </div>
                ${taxDeductible === 'yes' ? `
                  <div class="flex justify-between">
                    <span class="fa-meta-copy">Effective Rate (after tax):</span>
                    <span class="fa-list-copy-strong">${effectiveRate}%</span>
                  </div>
                ` : ''}
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Minimum Payment:</span>
                  <span class="fa-list-copy-strong">$${minimumPayment.toLocaleString()}/month</span>
                </div>
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Debt Type:</span>
                  <span class="fa-list-copy-strong">${debtType.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
                </div>
                <div class="flex justify-between">
                  <span class="fa-meta-copy">Time Horizon:</span>
                  <span class="fa-list-copy-strong">${timeHorizon} years</span>
                </div>
              </div>
              <div class="fa-highlight-card mt-4 p-3">
                <p class="text-sm text-purple-800 dark:text-purple-200">
                  ${debtInterestRate >= 8 ? '💡 High interest rate suggests paying off debt first may be better.' : debtInterestRate >= 4 ? '💡 Medium interest rate - compare with investment returns.' : '💡 Low interest rate - investing may be more beneficial.'}
                </p>
              </div>
            </div>
          `;

          debtResults?.classList.remove('hidden');

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-purple-600', 'hover:bg-purple-700');
          saveBtn.classList.add('bg-purple-500');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save & Continue';
            saveBtn.classList.remove('bg-purple-500');
            saveBtn.classList.add('bg-purple-600', 'hover:bg-purple-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'understand-debt',
              result: debtData,
              formData: debtData
            }
          }));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form.reset();
          debtResults?.classList.add('hidden');
        });
      }

      // Load saved data if exists
      const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
      if (journeyState.collectedData?.['understand-debt']) {
        const saved = journeyState.collectedData['understand-debt'];
        if (saved.debtBalance) {
          (document.getElementById('debt-balance') as HTMLInputElement).value = saved.debtBalance;
        }
        if (saved.debtInterestRate) {
          (document.getElementById('debt-interest-rate') as HTMLInputElement).value = saved.debtInterestRate;
        }
        if (saved.minimumPayment) {
          (document.getElementById('minimum-payment') as HTMLInputElement).value = saved.minimumPayment;
        }
        if (saved.debtType) {
          (document.getElementById('debt-type') as HTMLSelectElement).value = saved.debtType;
        }
        if (saved.taxDeductible) {
          const radio = form.querySelector(`input[value="${saved.taxDeductible}"]`) as HTMLInputElement;
          if (radio) radio.checked = true;
        }
        if (saved.timeHorizon) {
          (document.getElementById('time-horizon') as HTMLSelectElement).value = saved.timeHorizon.toString();
        }
      }
    });
  </script>
</Layout>
