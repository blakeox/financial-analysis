---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import { buildJourneyNavFromOrder } from '../../../../utils/journeyNavigation';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['invest-vs-payoff-debt'];

if (!currentScenario) {
  throw new Error('Journey not found: invest-vs-payoff-debt');
}

const currentStep = currentScenario.models.find(m => m.id === 'compare-strategies');
const currentStepOrder = currentStep?.order || 4;
const { journeyNav } = buildJourneyNavFromOrder({
  currentScenario,
  scenarioId: 'invest-vs-payoff-debt',
  currentStepOrder,
});

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="fa-workflow-grid">
        <!-- Main Content -->
        <div class="space-y-6">
          <JourneyStepHero
            icon="⚖️"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Strategy Comparison Calculator -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Compare Investment vs Debt Payoff Strategies</h2>
            
            <div class="fa-highlight-card mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-violet-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-violet-700 dark:text-violet-300">
                    <strong>Use the calculator below</strong> to compare three strategies: paying off debt first, investing while making minimum payments, or a hybrid 50/50 approach. The calculator will use data from your previous steps.
                  </p>
                </div>
              </div>
            </div>

            <!-- Embed the existing calculator -->
            <div id="invest-vs-payoff-calculator-container">
              <!-- The calculator will be loaded here -->
            </div>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title text-lg mb-4">💡 Strategy Comparison</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>Pay Debt First:</strong> Guaranteed return equal to your interest rate. Lower risk.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Invest First:</strong> Potential for higher returns, but market risk. Good if debt interest is low.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Hybrid (50/50):</strong> Balanced approach - reduces debt while building investments.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', async function() {
      // Load saved journey data
      const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
      const foundationData = journeyState.collectedData?.['financial-foundation'];
      const debtData = journeyState.collectedData?.['understand-debt'];
      const investmentData = journeyState.collectedData?.['evaluate-investments'];

      // Dynamically import and initialize the calculator
      try {
        await import('../../../../scripts/calculators/invest-vs-payoff-debt.client.ts');
        
        // Pre-fill calculator with journey data
        const calculatorContainer = document.getElementById('invest-vs-payoff-calculator-container');
        if (calculatorContainer) {
          // Create calculator form structure
          calculatorContainer.innerHTML = `
            <div id="invest-vs-payoff-form-container">
              <!-- Calculator will be initialized here -->
            </div>
          `;

          // Initialize with pre-filled data
          if (foundationData && debtData && investmentData) {
            // Pre-fill the calculator with journey data
            // The calculator initialization will handle this
          }
        }
      } catch (error) {
        console.error('Failed to load calculator:', error);
        const container = document.getElementById('invest-vs-payoff-calculator-container');
        if (container) {
          container.innerHTML = `
            <div class="fa-highlight-card p-4">
              <p class="text-yellow-800 dark:text-yellow-200">
                Calculator loading... If this persists, please <a href="/calculator/invest-vs-payoff-debt" class="underline">use the standalone calculator</a>.
              </p>
            </div>
          `;
        }
      }

      // Redirect to standalone calculator as fallback
      const container = document.getElementById('invest-vs-payoff-calculator-container');
      if (container) {
        container.innerHTML = `
          <div class="fa-highlight-card p-6 mb-6">
            <p class="mb-4 text-violet-800 dark:text-violet-200">
              Use the comprehensive calculator to compare strategies:
            </p>
            <a 
              href="/calculator/invest-vs-payoff-debt" 
              class="fa-button-primary"
            >
              Open Calculator
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        `;
      }
    });
  </script>
</Layout>
