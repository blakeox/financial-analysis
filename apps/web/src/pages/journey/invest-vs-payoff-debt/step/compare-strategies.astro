---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';

const journeyData = getJourneyData();
const currentScenario = journeyData['invest-vs-payoff-debt'];

if (!currentScenario) {
  throw new Error('Journey not found: invest-vs-payoff-debt');
}

const currentStep = currentScenario.models.find(m => m.id === 'compare-strategies');
const currentStepOrder = currentStep?.order || 4;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'invest-vs-payoff-debt',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: '/journey/invest-vs-payoff-debt'
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey" class="hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey/invest-vs-payoff-debt" class="hover:text-gray-700 dark:hover:text-gray-300">{currentScenario.name}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">{currentStep?.name}</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <!-- Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">⚖️</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{currentStep?.name}</h1>
                <p class="text-gray-600 dark:text-gray-400">{currentStep?.description}</p>
                <div class="mt-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">
                    Step {currentStepOrder} of {currentScenario.models.length} - {currentScenario.name}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Journey Progress Bar -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Journey Progress</h3>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                Step {currentStepOrder} of {currentScenario.models.length}
              </span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
              <div 
                class="bg-gradient-to-r from-purple-500 to-purple-600 h-2 rounded-full transition-all duration-300"
                style={`width: ${(currentStepOrder / currentScenario.models.length) * 100}%`}
              ></div>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              {currentScenario.name} - {Math.round((currentStepOrder / currentScenario.models.length) * 100)}% Complete
            </p>
          </div>

          <!-- Strategy Comparison Calculator -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Compare Investment vs Debt Payoff Strategies</h2>
            
            <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-400 p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-blue-700 dark:text-blue-300">
                    <strong>Use the calculator below</strong> to compare three strategies: paying off debt first, investing while making minimum payments, or a hybrid 50/50 approach. The calculator will use data from your previous steps.
                  </p>
                </div>
              </div>
            </div>

            <!-- Embed the existing calculator -->
            <div id="invest-vs-payoff-calculator-container">
              <!-- The calculator will be loaded here -->
            </div>
          </div>

          <!-- Journey Navigation -->
          <div class="bg-gradient-to-r from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-900/20 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a 
                    href={journeyNav.nextStep.url}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href={`/journey-analysis/${journeyNav.scenarioId}`}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Complete Journey
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold mb-4">💡 Strategy Comparison</h3>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400">
              <div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
                <p><strong>Pay Debt First:</strong> Guaranteed return equal to your interest rate. Lower risk.</p>
              </div>
              <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                <p><strong>Invest First:</strong> Potential for higher returns, but market risk. Good if debt interest is low.</p>
              </div>
              <div class="p-3 bg-purple-50 dark:bg-purple-900/20 rounded-lg">
                <p><strong>Hybrid (50/50):</strong> Balanced approach - reduces debt while building investments.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', async function() {
      // Load saved journey data
      const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
      const foundationData = journeyState.collectedData?.['financial-foundation'];
      const debtData = journeyState.collectedData?.['understand-debt'];
      const investmentData = journeyState.collectedData?.['evaluate-investments'];

      // Dynamically import and initialize the calculator
      try {
        await import('../../../../scripts/calculators/invest-vs-payoff-debt.client.ts');
        
        // Pre-fill calculator with journey data
        const calculatorContainer = document.getElementById('invest-vs-payoff-calculator-container');
        if (calculatorContainer) {
          // Create calculator form structure
          calculatorContainer.innerHTML = `
            <div id="invest-vs-payoff-form-container">
              <!-- Calculator will be initialized here -->
            </div>
          `;

          // Initialize with pre-filled data
          if (foundationData && debtData && investmentData) {
            // Pre-fill the calculator with journey data
            // The calculator initialization will handle this
          }
        }
      } catch (error) {
        console.error('Failed to load calculator:', error);
        const container = document.getElementById('invest-vs-payoff-calculator-container');
        if (container) {
          container.innerHTML = `
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
              <p class="text-yellow-800 dark:text-yellow-200">
                Calculator loading... If this persists, please <a href="/calculator/invest-vs-payoff-debt" class="underline">use the standalone calculator</a>.
              </p>
            </div>
          `;
        }
      }

      // Redirect to standalone calculator as fallback
      const container = document.getElementById('invest-vs-payoff-calculator-container');
      if (container) {
        container.innerHTML = `
          <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6 mb-6">
            <p class="text-blue-800 dark:text-blue-200 mb-4">
              Use the comprehensive calculator to compare strategies:
            </p>
            <a 
              href="/calculator/invest-vs-payoff-debt" 
              class="inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition-colors duration-200"
            >
              Open Calculator
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        `;
      }
    });
  </script>
</Layout>

