---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import { buildJourneyNavFromOrder } from '../../../../utils/journeyNavigation';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['invest-vs-payoff-debt'];

if (!currentScenario) {
  throw new Error('Journey not found: invest-vs-payoff-debt');
}

const currentStep = currentScenario.models.find(m => m.id === 'financial-foundation');
const currentStepOrder = currentStep?.order || 1;
const { journeyNav } = buildJourneyNavFromOrder({
  currentScenario,
  scenarioId: 'invest-vs-payoff-debt',
  currentStepOrder,
});

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <JourneyStepHero
            icon="🛡️"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Financial Foundation Assessment -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Assess Your Financial Foundation</h2>
            
            <div class="fa-callout-warning mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm">
                    <strong>Critical First Step:</strong> Before deciding between investing and paying off debt, you need a solid financial foundation. Without an emergency fund, unexpected expenses could force you into more debt.
                  </p>
                </div>
              </div>
            </div>
            
            <form id="financial-foundation-form" class="space-y-6">
              <!-- Emergency Fund Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🛡️ Emergency Fund Status</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      Do you have an emergency fund? *
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="hasEmergencyFund" value="yes" class="mt-1 mr-3" required>
                        <div>
                          <span class="fa-list-copy-strong">Yes, I have 3-6 months saved</span>
                          <p class="fa-help-copy">Great! You can proceed with the invest vs debt decision.</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="hasEmergencyFund" value="partial" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Partial (less than 3 months)</span>
                          <p class="fa-help-copy">Consider building emergency fund first before extra debt payments or investing.</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="hasEmergencyFund" value="no" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">No emergency fund</span>
                          <p class="fa-help-copy">Priority #1: Build emergency fund before making this decision.</p>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div id="emergency-fund-details" class="hidden">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <label for="emergency-fund-amount" class="fa-field-label mb-2">
                          Current Emergency Fund Amount ($)
                        </label>
                        <input 
                          type="number" 
                          id="emergency-fund-amount" 
                          name="emergencyFundAmount"
                           class="fa-input-surface w-full"
                          placeholder="5000"
                        />
                      </div>
                      <div>
                        <label for="monthly-expenses" class="fa-field-label mb-2">
                          Monthly Expenses ($)
                        </label>
                        <input 
                          type="number" 
                          id="monthly-expenses" 
                          name="monthlyExpenses"
                           class="fa-input-surface w-full"
                          placeholder="3000"
                        />
                         <p class="fa-help-copy mt-1">Used to calculate months of expenses covered</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Current Financial Situation -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">💰 Current Financial Situation</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="monthly-income" class="fa-field-label mb-2">
                      Monthly Income (After Tax) ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-income" 
                      name="monthlyIncome"
                       class="fa-input-surface w-full"
                      placeholder="5000"
                    />
                  </div>
                  <div>
                    <label for="extra-money" class="fa-field-label mb-2">
                      Extra Money Available Per Month ($) *
                    </label>
                    <input 
                      type="number" 
                      id="extra-money" 
                      name="extraMoney"
                       class="fa-input-surface w-full"
                      placeholder="500"
                      required
                    />
                     <p class="fa-help-copy mt-1">Money available after all expenses and minimum debt payments</p>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="button" id="save-foundation-btn" class="fa-button-primary">
                  Save & Continue
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="foundation-results" class="fa-highlight-card hidden mt-8 p-6">
              <h3 class="fa-scenario-title mb-4">📊 Your Financial Foundation Assessment</h3>
              <div id="foundation-results-content" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title mb-4">💡 Why This Matters</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>No Emergency Fund:</strong> Build 3-6 months of expenses before investing or paying extra on debt.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Emergency Fund Ready:</strong> You can safely make the invest vs debt decision.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Extra Money:</strong> This is what you'll allocate between investing and debt payoff.</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-4">📋 Emergency Fund Guidelines</h3>
            <div class="space-y-3 fa-list-copy">
              <p><strong>3-6 Months:</strong> Standard recommendation for most people</p>
              <p><strong>6-12 Months:</strong> If self-employed or in volatile industry</p>
              <p><strong>High-Interest Debt:</strong> Consider 1 month minimum, then tackle debt</p>
              <p><strong>Low-Interest Debt:</strong> Build full emergency fund first</p>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script type="application/json" id="journey-nav-data" is:inline>{JSON.stringify(journeyNav)}</script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const navDataElement = document.getElementById('journey-nav-data');
      const journeyNavData = navDataElement
        ? JSON.parse(navDataElement.textContent ?? 'null')
        : null;

      const form = document.getElementById('financial-foundation-form');
      const saveBtn = document.getElementById('save-foundation-btn');
      const resetBtn = document.getElementById('reset-btn');
      const emergencyFundDetails = document.getElementById('emergency-fund-details');
      const emergencyFundRadios = document.querySelectorAll('input[name="hasEmergencyFund"]');
      const foundationResults = document.getElementById('foundation-results');
      const foundationResultsContent = document.getElementById('foundation-results-content');

      if (!form) {
        console.error('Financial foundation form not found');
        return;
      }

      // Show/hide emergency fund details
      emergencyFundRadios.forEach(radio => {
        radio.addEventListener('change', (event) => {
          const target = event.target;
          if (target && 'value' in target && (target.value === 'yes' || target.value === 'partial')) {
            emergencyFundDetails?.classList.remove('hidden');
          } else {
            emergencyFundDetails?.classList.add('hidden');
          }
        });
      });

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();

          if (!form) {
            console.error('Financial foundation form not found');
            return;
          }
          
          const formData = new FormData(form);
          const hasEmergencyFund = formData.get('hasEmergencyFund');
          const emergencyFundAmount = parseFloat(formData.get('emergencyFundAmount')?.toString() ?? '0');
          const monthlyExpenses = parseFloat(formData.get('monthlyExpenses')?.toString() ?? '0');
          const monthlyIncome = parseFloat(formData.get('monthlyIncome')?.toString() ?? '0');
          const extraMoney = parseFloat(formData.get('extraMoney')?.toString() ?? '0');

          if (!hasEmergencyFund || !extraMoney) {
            alert('Please fill in all required fields.');
            return;
          }

          // Calculate months of expenses covered
          const monthsCovered = monthlyExpenses > 0 ? emergencyFundAmount / monthlyExpenses : 0;
          
          // Store in journey state
          const foundationData = {
            hasEmergencyFund,
            emergencyFundAmount,
            monthlyExpenses,
            monthlyIncome,
            extraMoney,
            monthsCovered: monthsCovered.toFixed(1),
            completedAt: new Date().toISOString()
          };

          const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['financial-foundation'] = foundationData;
          localStorage.setItem('fanalyx-journey-state-invest-vs-payoff-debt', JSON.stringify(journeyState));

          // Show results
          const recommendation = hasEmergencyFund === 'yes' 
            ? '✅ You have a solid emergency fund! You can proceed with the invest vs debt decision.'
            : hasEmergencyFund === 'partial'
            ? '⚠️ Consider building your emergency fund to 3-6 months before making extra debt payments or investments.'
            : '🚨 Priority #1: Build an emergency fund before deciding between investing and paying off debt.';

          if (foundationResultsContent) {
            foundationResultsContent.innerHTML = `
            <div class="fa-subcard">
              <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                   <span class="fa-meta-copy">Emergency Fund Status:</span>
                   <span class="fa-list-copy-strong">${hasEmergencyFund === 'yes' ? '✅ Ready' : hasEmergencyFund === 'partial' ? '⚠️ Partial' : '❌ Not Ready'}</span>
                </div>
                ${emergencyFundAmount > 0 ? `
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Emergency Fund Amount:</span>
                     <span class="fa-list-copy-strong">$${emergencyFundAmount.toLocaleString()}</span>
                  </div>
                  ${monthsCovered > 0 ? `
                    <div class="flex justify-between">
                       <span class="fa-meta-copy">Months Covered:</span>
                       <span class="fa-list-copy-strong">${monthsCovered.toFixed(1)} months</span>
                    </div>
                  ` : ''}
                ` : ''}
                <div class="flex justify-between">
                   <span class="fa-meta-copy">Extra Money Available:</span>
                   <span class="fa-list-copy-strong">$${extraMoney.toLocaleString()}/month</span>
                </div>
              </div>
              <div class="fa-highlight-card mt-4 p-3">
                <p class="text-sm text-violet-800 dark:text-violet-200">${recommendation}</p>
              </div>
            </div>
          `;
          }

          foundationResults?.classList.remove('hidden');

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-violet-600', 'hover:bg-violet-700');
          saveBtn.classList.add('bg-violet-500');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save & Continue';
            saveBtn.classList.remove('bg-violet-500');
            saveBtn.classList.add('bg-violet-600', 'hover:bg-violet-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'financial-foundation',
              result: foundationData,
              formData: foundationData
            }
          }));

          // Auto-advance after 2 seconds if emergency fund is ready
          if (hasEmergencyFund === 'yes') {
            const nextStepUrl = journeyNavData?.nextStep?.url;
            if (nextStepUrl) {
              setTimeout(() => {
                window.location.href = nextStepUrl;
              }, 2000);
            }
          }
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form?.reset();
          foundationResults?.classList.add('hidden');
          emergencyFundDetails?.classList.add('hidden');
        });
      }

      // Load saved data if exists
      const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
      if (journeyState.collectedData?.['financial-foundation']) {
        const saved = journeyState.collectedData['financial-foundation'];
        if (saved.hasEmergencyFund) {
          const radio = form?.querySelector(`input[value="${saved.hasEmergencyFund}"]`);
          if (radio && 'checked' in radio) radio.checked = true;
          if (saved.hasEmergencyFund === 'yes' || saved.hasEmergencyFund === 'partial') {
            emergencyFundDetails?.classList.remove('hidden');
          }
        }
        if (saved.emergencyFundAmount) {
          const emergencyFundAmountInput = document.getElementById('emergency-fund-amount');
          if (emergencyFundAmountInput && 'value' in emergencyFundAmountInput) {
            emergencyFundAmountInput.value = saved.emergencyFundAmount;
          }
        }
        if (saved.monthlyExpenses) {
          const monthlyExpensesInput = document.getElementById('monthly-expenses');
          if (monthlyExpensesInput && 'value' in monthlyExpensesInput) {
            monthlyExpensesInput.value = saved.monthlyExpenses;
          }
        }
        if (saved.monthlyIncome) {
          const monthlyIncomeInput = document.getElementById('monthly-income');
          if (monthlyIncomeInput && 'value' in monthlyIncomeInput) {
            monthlyIncomeInput.value = saved.monthlyIncome;
          }
        }
        if (saved.extraMoney) {
          const extraMoneyInput = document.getElementById('extra-money');
          if (extraMoneyInput && 'value' in extraMoneyInput) {
            extraMoneyInput.value = saved.extraMoney;
          }
        }
      }
    });
  </script>
</Layout>
