---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['invest-vs-payoff-debt'];

if (!currentScenario) {
  throw new Error('Journey not found: invest-vs-payoff-debt');
}

const currentStep = currentScenario.models.find(m => m.id === 'make-decision');
const currentStepOrder = currentStep?.order || 5;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'invest-vs-payoff-debt',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/invest-vs-payoff-debt/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: '/journey/invest-vs-payoff-debt'
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <main class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <!-- Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">🎯</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{currentStep?.name}</h1>
                <p class="text-gray-600 dark:text-gray-400">{currentStep?.description}</p>
                <div class="mt-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">
                    Step {currentStepOrder} of {currentScenario.models.length} - {currentScenario.name}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Journey Progress Bar -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Journey Progress</h3>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                Step {currentStepOrder} of {currentScenario.models.length}
              </span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
              <div 
                class="bg-gradient-to-r from-purple-500 to-purple-600 h-2 rounded-full transition-all duration-300"
                style={`width: ${(currentStepOrder / currentScenario.models.length) * 100}%`}
              ></div>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              {currentScenario.name} - {Math.round((currentStepOrder / currentScenario.models.length) * 100)}% Complete
            </p>
          </div>

          <!-- Personalized Recommendation -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Your Personalized Recommendation</h2>
            
            <div id="recommendation-container" class="space-y-6">
              <!-- Recommendation will be generated by JavaScript -->
              <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-400 p-4">
                <p class="text-blue-700 dark:text-blue-300">
                  Loading your personalized recommendation based on your journey data...
                </p>
              </div>
            </div>
          </div>

          <!-- Action Plan -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">📋 Your Action Plan</h2>
            <div id="action-plan-container" class="space-y-4">
              <!-- Action plan will be generated by JavaScript -->
            </div>
          </div>

          <!-- Journey Navigation -->
          <div class="bg-gradient-to-r from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-900/20 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                <a 
                  href={`/journey-analysis/${journeyNav.scenarioId}`}
                  class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                >
                  Complete Journey Analysis
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold mb-4">💡 Key Factors</h3>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400">
              <div class="p-3 bg-red-50 dark:bg-red-900/20 rounded-lg">
                <p><strong>High Debt Rate:</strong> Usually better to pay off debt first</p>
              </div>
              <div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
                <p><strong>Employer Match:</strong> Usually prioritize getting full match</p>
              </div>
              <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                <p><strong>Low Debt Rate:</strong> Investing may be better long-term</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
            <h3 class="text-lg font-semibold mb-4">📊 Remember</h3>
            <div class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
              <p>• This is a recommendation, not financial advice</p>
              <p>• Your situation is unique</p>
              <p>• Review periodically as circumstances change</p>
              <p>• Consider consulting a financial advisor</p>
            </div>
          </div>
        </div>
      </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Load all journey data
      const journeyState = JSON.parse(localStorage.getItem('fanalyx-journey-state-invest-vs-payoff-debt') || '{}');
      const foundationData = journeyState.collectedData?.['financial-foundation'];
      const debtData = journeyState.collectedData?.['understand-debt'];
      const investmentData = journeyState.collectedData?.['evaluate-investments'];

      const recommendationContainer = document.getElementById('recommendation-container');
      const actionPlanContainer = document.getElementById('action-plan-container');

      if (!foundationData || !debtData || !investmentData) {
        if (recommendationContainer) {
          recommendationContainer.innerHTML = `
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border-l-4 border-yellow-400 p-4">
              <p class="text-yellow-700 dark:text-yellow-300">
                <strong>Missing Data:</strong> Please complete all previous steps to get a personalized recommendation.
                <a href="/journey/invest-vs-payoff-debt" class="underline ml-1">Go back to start</a>
              </p>
            </div>
          `;
        }
        return;
      }

      // Calculate recommendation
      const debtRate = parseFloat(debtData.debtInterestRate || debtData.effectiveRate || '0');
      const investReturn = parseFloat(investmentData.expectedReturn || '0');
      const hasEmployerMatch = investmentData.hasEmployerMatch === 'yes';
      const employerMatchRate = parseFloat(investmentData.employerMatchRate || '0');
      const hasEmergencyFund = foundationData.hasEmergencyFund === 'yes';
      const extraMoney = parseFloat(foundationData.extraMoney || '0');

      // Decision logic
      let recommendation = '';
      let recommendationColor = 'blue';
      let strategy = '';
      let reasoning = '';

      if (!hasEmergencyFund) {
        recommendation = 'Build Emergency Fund First';
        recommendationColor = 'red';
        strategy = 'emergency-fund';
        reasoning = 'Priority #1: Build a 3-6 month emergency fund before making extra debt payments or investments. Without this safety net, unexpected expenses could force you into more debt.';
      } else if (hasEmployerMatch && employerMatchRate > 0) {
        recommendation = 'Invest to Get Employer Match';
        recommendationColor = 'green';
        strategy = 'invest-match';
        reasoning = `Your employer offers ${employerMatchRate}% match - this is free money! Prioritize getting the full employer match first, as this provides an immediate ${employerMatchRate}% return plus your expected ${investReturn}% investment return.`;
      } else if (debtRate >= 8) {
        recommendation = 'Pay Off Debt First';
        recommendationColor = 'red';
        strategy = 'pay-debt';
        reasoning = `Your debt interest rate (${debtRate}%) is higher than typical investment returns. Paying off debt provides a guaranteed ${debtRate}% return, which is better than the uncertain ${investReturn}% expected from investments.`;
      } else if (debtRate >= investReturn + 2) {
        recommendation = 'Pay Off Debt First';
        recommendationColor = 'orange';
        strategy = 'pay-debt';
        reasoning = `Your debt interest rate (${debtRate}%) is significantly higher than your expected investment return (${investReturn}%). The guaranteed return from debt payoff outweighs the uncertain investment returns.`;
      } else if (debtRate <= 4 && investReturn >= 7) {
        recommendation = 'Invest While Making Minimum Payments';
        recommendationColor = 'green';
        strategy = 'invest';
        reasoning = `Your debt interest rate (${debtRate}%) is low, and your expected investment return (${investReturn}%) is good. Over the long term, investing while making minimum debt payments should provide better returns.`;
      } else {
        recommendation = 'Hybrid Approach (50/50 Split)';
        recommendationColor = 'blue';
        strategy = 'hybrid';
        reasoning = `Your debt rate (${debtRate}%) and expected investment return (${investReturn}%) are relatively close. A balanced approach of splitting extra money between debt payoff and investing provides both guaranteed returns and growth potential.`;
      }

      // Generate recommendation display
      if (recommendationContainer) {
        recommendationContainer.innerHTML = `
          <div class="bg-${recommendationColor}-50 dark:bg-${recommendationColor}-900/20 border-l-4 border-${recommendationColor}-400 p-6 rounded-lg">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <span class="text-4xl">${strategy === 'emergency-fund' ? '🛡️' : strategy === 'invest-match' ? '🎁' : strategy === 'pay-debt' ? '💳' : strategy === 'invest' ? '📈' : '⚖️'}</span>
              </div>
              <div class="ml-4 flex-1">
                <h3 class="text-2xl font-bold text-${recommendationColor}-900 dark:text-${recommendationColor}-200 mb-2">
                  ${recommendation}
                </h3>
                <p class="text-${recommendationColor}-800 dark:text-${recommendationColor}-300 mb-4">
                  ${reasoning}
                </p>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 mt-4">
                  <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Quick Comparison:</h4>
                  <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                      <span class="text-gray-600 dark:text-gray-400">Debt Interest Rate:</span>
                      <span class="font-semibold text-gray-900 dark:text-white ml-2">${debtRate}%</span>
                    </div>
                    <div>
                      <span class="text-gray-600 dark:text-gray-400">Expected Investment Return:</span>
                      <span class="font-semibold text-gray-900 dark:text-white ml-2">${investReturn}%</span>
                    </div>
                    <div>
                      <span class="text-gray-600 dark:text-gray-400">Extra Money Available:</span>
                      <span class="font-semibold text-gray-900 dark:text-white ml-2">$${extraMoney.toLocaleString()}/month</span>
                    </div>
                    ${hasEmployerMatch ? `
                      <div>
                        <span class="text-gray-600 dark:text-gray-400">Employer Match:</span>
                        <span class="font-semibold text-green-600 dark:text-green-400 ml-2">${employerMatchRate}%</span>
                      </div>
                    ` : ''}
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }

      // Generate action plan
      if (actionPlanContainer) {
        const actionSteps = [];

        if (strategy === 'emergency-fund') {
          actionSteps.push(
            'Build emergency fund to 3-6 months of expenses',
            'Once emergency fund is complete, revisit this decision',
            'Continue making minimum debt payments during this time'
          );
        } else if (strategy === 'invest-match') {
          actionSteps.push(
            `Contribute enough to get full employer match (up to ${investmentData.matchLimit || 6}% of salary)`,
            'After getting full match, evaluate remaining extra money',
            'Consider paying extra on debt if rate is still high'
          );
        } else if (strategy === 'pay-debt') {
          actionSteps.push(
            `Apply all extra money ($${extraMoney.toLocaleString()}/month) to debt payments`,
            `Continue until debt is paid off (estimated ${Math.ceil(parseFloat(debtData.debtBalance) / (parseFloat(debtData.minimumPayment) + extraMoney))} months)`,
            'Once debt-free, redirect all payments to investments'
          );
        } else if (strategy === 'invest') {
          actionSteps.push(
            `Invest all extra money ($${extraMoney.toLocaleString()}/month) in your ${investmentData.investmentType}`,
            'Continue making minimum debt payments',
            'Monitor debt balance and adjust if needed'
          );
        } else {
          actionSteps.push(
            `Split extra money: $${Math.floor(extraMoney / 2).toLocaleString()}/month to debt, $${Math.floor(extraMoney / 2).toLocaleString()}/month to investments`,
            'Review progress quarterly and adjust as needed',
            'Once debt is paid off, redirect all to investments'
          );
        }

        actionPlanContainer.innerHTML = actionSteps.map((step, index) => `
          <div class="flex items-start p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
            <span class="flex-shrink-0 w-8 h-8 bg-purple-600 text-white rounded-full flex items-center justify-center font-semibold mr-4">
              ${index + 1}
            </span>
            <p class="text-gray-700 dark:text-gray-300 flex-1">${step}</p>
          </div>
        `).join('');
      }

      // Save final recommendation
      const finalRecommendation = {
        recommendation,
        strategy,
        reasoning,
        timestamp: new Date().toISOString()
      };

      journeyState.collectedData = journeyState.collectedData || {};
      journeyState.collectedData['make-decision'] = finalRecommendation;
      journeyState.completed = true;
      journeyState.completedAt = new Date().toISOString();
      localStorage.setItem('fanalyx-journey-state-invest-vs-payoff-debt', JSON.stringify(journeyState));

      // Dispatch completion event
      window.dispatchEvent(new CustomEvent('journey-completed', {
        detail: {
          journeyId: 'invest-vs-payoff-debt',
          recommendation: finalRecommendation
        }
      }));
    });
  </script>
</Layout>

