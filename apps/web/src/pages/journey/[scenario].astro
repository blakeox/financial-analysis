---
import ClientScriptLoader from '../../components/ClientScriptLoader.tsx';
import Layout from '../../layouts/Layout.astro';
import { getJourneyData } from '../../utils/journeyData';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  return Object.keys(journeyData).map(scenario => ({
    params: { scenario }
  }));
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}
---

<Layout title={`${currentScenario.name} - Financial Journey`} description={currentScenario.description}>
  <main id="main-content" class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="list-none p-0 inline-flex">
          <li class="flex items-center">
            <a href="/" class="text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">Home</a>
            <svg class="fill-current w-3 h-3 mx-3 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568 0 33.941z"/></svg>
          </li>
          <li class="flex items-center">
            <img src="/fanalyx_favicon.png" alt="Journey" class="w-4 h-4 mr-2">
            <a href="/journey" class="text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
            <svg class="fill-current w-3 h-3 mx-3 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568 0 33.941z"/></svg>
          </li>
          <li class="text-gray-500 dark:text-gray-500" aria-current="page">{currentScenario.name}</li>
        </ol>
      </nav>

      <!-- Journey Header -->
      <div class="mb-8">
        <div class="flex items-start mb-6">
          <div class="flex items-center mr-4">
            <span class="text-5xl">{currentScenario.icon}</span>
          </div>
          <div class="flex-1">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">{currentScenario.name}</h1>
            <p class="text-lg text-gray-600 dark:text-gray-400 mb-4">{currentScenario.ageRange}</p>
          </div>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed max-w-4xl mb-6">
          {currentScenario.description}
        </p>
        <div class="flex items-center space-x-6 text-sm text-gray-600 dark:text-gray-400">
          <div class="flex items-center">
            <span class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-3 py-1 rounded-full text-xs font-medium mr-2">
              {currentScenario.complexity}
            </span>
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              {currentScenario.duration}
            </span>
          </div>
        </div>
      </div>

      <!-- Journey Progress -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Journey Progress</h2>
        <div class="grid grid-cols-3 gap-4 mb-4">
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white">0</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Completed</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white">{currentScenario.models.length}</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Total Steps</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white">0%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Progress</div>
          </div>
        </div>
      </div>

      <!-- Analysis Models -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Analysis Models</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {currentScenario.models.map((model, index) => (
            <div class="border border-gray-200 dark:border-gray-600 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start mb-4">
                <div class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold mr-3">
                  {index + 1}
                </div>
                <div class="flex-1">
                  <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{model.name}</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">{model.description}</p>
                  <span class={`inline-block px-2 py-1 rounded-full text-xs font-medium ${
                    model.required 
                      ? 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200' 
                      : 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200'
                  }`}>
                    {model.required ? 'Required' : 'Optional'}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Workflow Steps -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Workflow Steps</h3>
        <div class="space-y-4">
          {currentScenario.workflow.map((step, index) => (
            <div class="flex items-start">
              <div class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold mr-4 flex-shrink-0">
                {index + 1}
              </div>
              <p class="text-gray-700 dark:text-gray-300 pt-1">{step}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
          <h4 class="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-2">💡 Pro Tip</h4>
          <p class="text-blue-800 dark:text-blue-200 text-sm">
            Complete the required models first, then move on to optional ones. Our AI chatbot will guide you through each step and provide personalized insights based on your results.
          </p>
        </div>
      </div>

      <!-- Start Journey Button -->
      <div class="text-center mb-8">
        <a href={`/journey/${scenario}/step/${currentScenario.models[0].id}`} 
           class="inline-flex items-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white text-lg font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105">
          <span class="mr-2">{currentScenario.icon}</span>
          Start Your Journey
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <p class="text-gray-600 dark:text-gray-400 mt-4">
          Begin with the first step: <strong>{currentScenario.models[0].name}</strong>
        </p>
      </div>
    </div>
  </main>
</Layout>

<ClientScriptLoader script="journey-page" />