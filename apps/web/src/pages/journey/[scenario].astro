---
import ClientScriptLoader from '../../components/ClientScriptLoader.tsx';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import PageHero from '../../components/site/PageHero.astro';
import SurfaceCard from '../../components/site/SurfaceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getJourneyData } from '../../utils/journeyData';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  return Object.keys(journeyData).map(scenario => ({
    params: { scenario }
  }));
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}/journey/${scenario}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl },
        { "@type": "ListItem", "position": 2, "name": "Journey", "item": `${baseUrl}/journey` },
        { "@type": "ListItem", "position": 3, "name": currentScenario.name, "item": currentUrl }
      ]
    },
    {
      "@type": "HowTo",
      "name": currentScenario.name,
      "description": currentScenario.description,
      "totalTime": currentScenario.duration,
      "step": currentScenario.models.map((model: { name: string; description: string }, index: number) => ({
        "@type": "HowToStep",
        "position": index + 1,
        "name": model.name,
        "text": model.description
      }))
    }
  ]
};
---

<Layout title={`${currentScenario.name} - Financial Journey`} description={currentScenario.description} keywords={`financial journey, ${currentScenario.name.toLowerCase()}, financial planning, ${currentScenario.complexity.toLowerCase()} finance`} showChat={false}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name },
    ]}
  />

  <main id="main-content" class="fa-page-shell">
      <div class="mb-8 flex items-start gap-4">
        <span class="text-5xl">{currentScenario.icon}</span>
        <div class="min-w-0 flex-1">
          <PageHero
            eyebrow="Journey overview"
            title={currentScenario.name}
            description={currentScenario.description}
          />
          <p class="fa-body-lg -mt-2">{currentScenario.ageRange}</p>
          <div class="mt-4 flex items-center space-x-6 text-sm text-gray-600 dark:text-gray-400">
            <div class="flex items-center">
              <span class="mr-2 rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                {currentScenario.complexity}
              </span>
              <span class="flex items-center">
                <svg class="mr-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
                {currentScenario.duration}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Journey Progress -->
      <SurfaceCard className="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Journey Progress</h2>
        <div class="grid grid-cols-3 gap-4 mb-4">
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white">0</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Completed</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white">{currentScenario.models.length}</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Total Steps</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 dark:text-white">0%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Progress</div>
          </div>
        </div>
      </SurfaceCard>

      <!-- Analysis Models -->
      <SurfaceCard className="mb-8">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Analysis Models</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {currentScenario.models.map((model, index) => (
            <a href={model.url} class="block border border-gray-200 dark:border-gray-600 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start mb-4">
                <div class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold mr-3">
                  {index + 1}
                </div>
                <div class="flex-1">
                  <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{model.name}</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">{model.description}</p>
                  <span class={`inline-block px-2 py-1 rounded-full text-xs font-medium ${
                    model.required 
                      ? 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200' 
                      : 'bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200'
                  }`}>
                    {model.required ? 'Required' : 'Optional'}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </SurfaceCard>

      <!-- Workflow Steps -->
      <SurfaceCard className="mb-8">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Workflow Steps</h3>
        <div class="space-y-4">
          {currentScenario.workflow.map((step, index) => (
            <div class="flex items-start">
              <div class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-full w-8 h-8 flex items-center justify-center text-sm font-bold mr-4 flex-shrink-0">
                {index + 1}
              </div>
              <p class="text-gray-700 dark:text-gray-300 pt-1">{step}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
          <h4 class="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-2">💡 Pro Tip</h4>
          <p class="text-blue-800 dark:text-blue-200 text-sm">
            Complete the required models first, then move on to optional ones. Each completed step adds result-specific takeaways so you can decide what to change next.
          </p>
        </div>
      </SurfaceCard>

      <!-- Start Journey Button -->
      <div class="text-center mb-8">
        <form action={`/journey/${scenario}/step/${currentScenario.models[0].id}`} method="get">
          <button
            type="submit"
            class="inline-flex items-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white text-lg font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
          >
            <span class="mr-2">{currentScenario.icon}</span>
            Start Your Journey
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </form>
        <p class="text-gray-600 dark:text-gray-400 mt-4">
          Begin with the first step: <strong>{currentScenario.models[0].name}</strong>
        </p>
      </div>
  </main>
</Layout>

<ClientScriptLoader name="journey-page" />
