---
import JourneyCalculatorPage from '../../../../components/JourneyCalculatorPage.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import {
  canRenderJourneyFallbackStep,
  getJourneyModelHref,
} from '../../../../utils/journeyStepAvailability';
import { resolveJourneyStepCalculatorId } from '../../../../utils/journeyStepAvailability';

export async function getStaticPaths() {
  const paths: Array<{ params: { scenario: string; stepId: string } }> = [];
  const journeyData = getJourneyData();

  // Generate fallback step pages for models that still point to calculator routes.
  for (const [scenarioId, scenario] of Object.entries(journeyData)) {
    for (const model of scenario.models) {
      if (canRenderJourneyFallbackStep(scenarioId, model.id, model.url)) {
        paths.push({
          params: { scenario: scenarioId, stepId: model.id },
        });
      }
    }
  }

  return paths;
}

const { scenario, stepId } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

const currentModel = currentScenario.models.find(m => m.id === stepId);
if (!currentModel) {
  throw new Error(`Step not found in scenario ${scenario}: ${stepId}`);
}

const stepNumber = currentModel.order;
const nextStep = currentScenario.models.find(model => model.order === stepNumber + 1);
const previousStep = currentScenario.models.find(model => model.order === stepNumber - 1);
const calculatorId =
  resolveJourneyStepCalculatorId(scenario!, currentModel.id, currentModel.url) ??
  currentModel.id;
if (!canRenderJourneyFallbackStep(scenario!, currentModel.id, currentModel.url)) {
  throw new Error(`Unsupported journey fallback step: ${scenario}/${stepId}`);
}

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: stepNumber,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep
    ? {
        id: nextStep.id,
        name: nextStep.name,
        url: getJourneyModelHref(scenario!, nextStep.id, nextStep.url),
      }
    : null,
  previousStep: previousStep
    ? {
        id: previousStep.id,
        name: previousStep.name,
        url: getJourneyModelHref(scenario!, previousStep.id, previousStep.url),
      }
    : null,
  journeyOverviewUrl: `/journey/${scenario}`,
};

// SEO-optimized content
const seoTitle = `${currentModel?.name} - Step ${stepNumber} of ${currentScenario.name}`;
const seoDescription = `${currentModel?.description} This is step ${stepNumber} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<JourneyCalculatorPage 
  calculatorId={calculatorId}
  title={seoTitle}
  description={seoDescription}
  journeyNav={journeyNav}
/>
