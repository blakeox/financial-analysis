                        required
                      />
                    </div>
                    <div>
                      <label for="scenario1-rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Interest Rate (%) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario1-rate" 
                        name="scenario1Rate"
                        step="0.01"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="7.5"
                        required
                      />
                    </div>
                  </div>
                </div>

                <!-- Scenario 2: Alternative Option -->
                <div class="pb-6">
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">💰 Scenario 2: Alternative Option</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="scenario2-down" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Down Payment ($) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario2-down" 
                        name="scenario2Down"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="100000"
                        required
                      />
                    </div>
                    <div>
                      <label for="scenario2-rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Interest Rate (%) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario2-rate" 
                        name="scenario2Rate"
                        step="0.01"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="6.75"
                        required
                      />
                    </div>
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-4 pt-6 border-t border-gray-200 dark:border-gray-700">
                  <button type="button" id="compare-mortgages-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                    Compare Scenarios
                  </button>
                  <button type="button" id="save-compare-btn" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                    Save Comparison
                  </button>
                  <button type="button" id="reset-btn" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                    Reset Form
                  </button>
                </div>
              </form>

              <!-- Results Section -->
              <div id="comparison-results" class="hidden mt-8 p-6 bg-linear-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">📊 Mortgage Comparison Results</h3>
                <div id="comparison-content">
                  <!-- Results will be populated by JavaScript -->
                </div>
              </div>
            </div>
          ) : (
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Plan Your Financial Goals</h2>
              
              <form id="goal-planning-form" data-journey-scenario-id={journeyNav.scenarioId} class="space-y-6">
              <!-- Short-term Goals (1-2 years) -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🏃‍♂️ Short-term Goals (1-2 years)</h3>
                <div class="space-y-4">
                  <div>
                    <label for="short-term-goal-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Goal 1: What do you want to achieve?
                    </label>
                    <input 
                      type="text" 
                      id="short-term-goal-1" 
                      name="shortTermGoal1"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="e.g., Build emergency fund, pay off credit card debt"
                    />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="short-term-cost-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Estimated Cost ($)
                      </label>
                      <input 
                        type="number" 
                        id="short-term-cost-1" 
                        name="shortTermCost1"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="5000"
                      />
                    </div>
                    <div>
                      <label for="short-term-timeline-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Timeline (months)
                      </label>
                      <input 
                        type="number" 
                        id="short-term-timeline-1" 
                        name="shortTermTimeline1"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="12"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Medium-term Goals (3-5 years) -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🚗 Medium-term Goals (3-5 years)</h3>
                <div class="space-y-4">
                  <div>
                    <label for="medium-term-goal-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Goal 1: What's your next big milestone?
                    </label>
                    <input 
                      type="text" 
                      id="medium-term-goal-1" 
                      name="mediumTermGoal1"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="e.g., Buy a car, save for home down payment, travel"
                    />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="medium-term-cost-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Estimated Cost ($)
                      </label>
                      <input 
                        type="number" 
                        id="medium-term-cost-1" 
                        name="mediumTermCost1"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="25000"
                      />
                    </div>
                    <div>
                      <label for="medium-term-timeline-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Timeline (years)
                      </label>
                      <input 
                        type="number" 
                        id="medium-term-timeline-1" 
                        name="mediumTermTimeline1"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="3"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Long-term Goals (5+ years) -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🏠 Long-term Goals (5+ years)</h3>
                <div class="space-y-4">
                  <div>
                    <label for="long-term-goal-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Goal 1: What's your dream?
                    </label>
                    <input 
                      type="text" 
                      id="long-term-goal-1" 
                      name="longTermGoal1"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="e.g., Buy a home, start a business, early retirement"
                    />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="long-term-cost-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Estimated Cost ($)
                      </label>
                      <input 
                        type="number" 
                        id="long-term-cost-1" 
                        name="longTermCost1"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="100000"
                      />
                    </div>
                    <div>
                      <label for="long-term-timeline-1" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Timeline (years)
                      </label>
                      <input 
                        type="number" 
                        id="long-term-timeline-1" 
                        name="longTermTimeline1"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="10"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Priority and Strategy Section -->
              <div class="pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🎯 Goal Priority & Strategy</h3>
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Which goal is most important to you right now?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="priorityGoal" value="short-term" class="mt-1 mr-3">
                        <div>
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Short-term goal</span>
                          <p class="text-xs text-gray-500">Focus on immediate needs and quick wins</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="priorityGoal" value="medium-term" class="mt-1 mr-3">
                        <div>
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Medium-term goal</span>
                          <p class="text-xs text-gray-500">Balance current needs with future planning</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="priorityGoal" value="long-term" class="mt-1 mr-3">
                        <div>
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Long-term goal</span>
                          <p class="text-xs text-gray-500">Focus on building wealth for the future</p>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="monthly-savings-budget" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      How much can you allocate to goals monthly? ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-savings-budget" 
                      name="monthlySavingsBudget"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="800"
                    />
                    <p class="text-sm text-gray-500 mt-1">This is separate from emergency fund and retirement savings</p>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 border-t border-gray-200 dark:border-gray-700">
                <button type="submit" id="calculate-goals-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Calculate Goal Timeline
                </button>
                <button type="button" id="save-goals-btn" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Save Goals
                </button>
                <button type="button" id="reset-btn" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="results-section" class="hidden mt-8 p-6 bg-linear-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">📊 Your Goal Timeline</h3>
              <div id="goal-results" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>
          )}

          <!-- Journey Navigation -->
          <div class="bg-linear-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a 
                    href={journeyNav.nextStep.url}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-linear-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href={`/journey-analysis/${journeyNav.scenarioId}`}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-linear-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
