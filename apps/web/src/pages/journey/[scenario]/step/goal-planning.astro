---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import { buildJourneyNavFromOrder } from '../../../../utils/journeyNavigation';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'goal-planning')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Find goal-planning step in this journey
const currentStep = currentScenario.models.find(m => m.id === 'goal-planning');
const currentStepOrder = currentStep?.order || 5;
const { journeyNav } = buildJourneyNavFromOrder({
  currentScenario,
  scenarioId: scenario!,
  currentStepOrder,
});

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="fa-workflow-grid">
        <!-- Main Content -->
        <div class="space-y-6">
          <JourneyStepHero
            icon="🎯"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          {scenario === 'home-buying' ? (
            <div class="fa-card p-6 mb-6">
              <h2 class="fa-panel-title mb-6">Compare Mortgage Scenarios</h2>
              
              <form id="mortgage-comparison-form" data-journey-scenario-id={journeyNav.scenarioId} class="space-y-6">
                <!-- Base Loan Information -->
                <div class="fa-panel-divider pb-6">
                  <h3 class="fa-scenario-title mb-4">🏠 Base Loan Information</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="home-price" class="fa-field-label mb-2">
                        Home Price ($) *
                      </label>
                      <input 
                        type="number" 
                        id="home-price" 
                        name="homePrice"
                        class="fa-input-surface w-full"
                        placeholder="400000"
                        required
                      />
                    </div>
                    <div>
                      <label for="loan-term" class="fa-field-label mb-2">
                        Loan Term (years) *
                      </label>
                      <select 
                        id="loan-term" 
                        name="loanTerm"
                        class="fa-input-surface w-full"
                        required
                      >
                        <option value="15">15 years</option>
                        <option value="30" selected>30 years</option>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- Scenario 1: Current Plan -->
                <div class="fa-panel-divider pb-6">
                  <h3 class="fa-scenario-title mb-4">💼 Scenario 1: Current Plan</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="scenario1-down" class="fa-field-label mb-2">
                        Down Payment ($) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario1-down" 
                        name="scenario1Down"
                        class="fa-input-surface w-full"
                        placeholder="80000"
                        required
                      />
                    </div>
                    <div>
                      <label for="scenario1-rate" class="fa-field-label mb-2">
                        Interest Rate (%) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario1-rate" 
                        name="scenario1Rate"
                        step="0.01"
                        class="fa-input-surface w-full"
                        placeholder="7.5"
                        required
                      />
                    </div>
                  </div>
                </div>

                <!-- Scenario 2: Alternative Option -->
                <div class="pb-6">
                  <h3 class="fa-scenario-title mb-4">💰 Scenario 2: Alternative Option</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="scenario2-down" class="fa-field-label mb-2">
                        Down Payment ($) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario2-down" 
                        name="scenario2Down"
                        class="fa-input-surface w-full"
                        placeholder="100000"
                        required
                      />
                    </div>
                    <div>
                      <label for="scenario2-rate" class="fa-field-label mb-2">
                        Interest Rate (%) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario2-rate" 
                        name="scenario2Rate"
                        step="0.01"
                        class="fa-input-surface w-full"
                        placeholder="6.75"
                        required
                      />
                    </div>
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                  <button type="button" id="compare-mortgages-btn" class="fa-button-primary">
                    Compare Scenarios
                  </button>
                  <button type="button" id="save-compare-btn" class="fa-button-primary">
                    Save Comparison
                  </button>
                  <button type="button" id="reset-btn" class="fa-button-secondary">
                    Reset Form
                  </button>
                </div>
              </form>

              <!-- Results Section -->
              <div id="comparison-results" class="fa-highlight-card hidden mt-8 p-6">
                <h3 class="fa-scenario-title mb-4">📊 Mortgage Comparison Results</h3>
                <div id="comparison-content">
                  <!-- Results will be populated by JavaScript -->
                </div>
              </div>
            </div>
          ) : (
            <div class="fa-card p-6 mb-6">
              <h2 class="fa-panel-title mb-6">Plan Your Financial Goals</h2>
              
              <form id="goal-planning-form" data-journey-scenario-id={journeyNav.scenarioId} class="space-y-6">
              <!-- Short-term Goals (1-2 years) -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🏃‍♂️ Short-term Goals (1-2 years)</h3>
                <div class="space-y-4">
                  <div>
                    <label for="short-term-goal-1" class="fa-field-label mb-2">
                      Goal 1: What do you want to achieve?
                    </label>
                    <input 
                      type="text" 
                      id="short-term-goal-1" 
                      name="shortTermGoal1"
                      class="fa-input-surface w-full"
                      placeholder="e.g., Build emergency fund, pay off credit card debt"
                    />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="short-term-cost-1" class="fa-field-label mb-2">
                        Estimated Cost ($)
                      </label>
                      <input 
                        type="number" 
                        id="short-term-cost-1" 
                        name="shortTermCost1"
                        class="fa-input-surface w-full"
                        placeholder="5000"
                      />
                    </div>
                    <div>
                      <label for="short-term-timeline-1" class="fa-field-label mb-2">
                        Timeline (months)
                      </label>
                      <input 
                        type="number" 
                        id="short-term-timeline-1" 
                        name="shortTermTimeline1"
                        class="fa-input-surface w-full"
                        placeholder="12"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Medium-term Goals (3-5 years) -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🚗 Medium-term Goals (3-5 years)</h3>
                <div class="space-y-4">
                  <div>
                    <label for="medium-term-goal-1" class="fa-field-label mb-2">
                      Goal 1: What's your next big milestone?
                    </label>
                    <input 
                      type="text" 
                      id="medium-term-goal-1" 
                      name="mediumTermGoal1"
                      class="fa-input-surface w-full"
                      placeholder="e.g., Buy a car, save for home down payment, travel"
                    />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="medium-term-cost-1" class="fa-field-label mb-2">
                        Estimated Cost ($)
                      </label>
                      <input 
                        type="number" 
                        id="medium-term-cost-1" 
                        name="mediumTermCost1"
                        class="fa-input-surface w-full"
                        placeholder="25000"
                      />
                    </div>
                    <div>
                      <label for="medium-term-timeline-1" class="fa-field-label mb-2">
                        Timeline (years)
                      </label>
                      <input 
                        type="number" 
                        id="medium-term-timeline-1" 
                        name="mediumTermTimeline1"
                        class="fa-input-surface w-full"
                        placeholder="3"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Long-term Goals (5+ years) -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🏠 Long-term Goals (5+ years)</h3>
                <div class="space-y-4">
                  <div>
                    <label for="long-term-goal-1" class="fa-field-label mb-2">
                      Goal 1: What's your dream?
                    </label>
                    <input 
                      type="text" 
                      id="long-term-goal-1" 
                      name="longTermGoal1"
                      class="fa-input-surface w-full"
                      placeholder="e.g., Buy a home, start a business, early retirement"
                    />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="long-term-cost-1" class="fa-field-label mb-2">
                        Estimated Cost ($)
                      </label>
                      <input 
                        type="number" 
                        id="long-term-cost-1" 
                        name="longTermCost1"
                        class="fa-input-surface w-full"
                        placeholder="100000"
                      />
                    </div>
                    <div>
                      <label for="long-term-timeline-1" class="fa-field-label mb-2">
                        Timeline (years)
                      </label>
                      <input 
                        type="number" 
                        id="long-term-timeline-1" 
                        name="longTermTimeline1"
                        class="fa-input-surface w-full"
                        placeholder="10"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Priority and Strategy Section -->
              <div class="pb-6">
                <h3 class="fa-scenario-title mb-4">🎯 Goal Priority & Strategy</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      Which goal is most important to you right now?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="priorityGoal" value="short-term" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Short-term goal</span>
                          <p class="fa-help-copy">Focus on immediate needs and quick wins</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="priorityGoal" value="medium-term" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Medium-term goal</span>
                          <p class="fa-help-copy">Balance current needs with future planning</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="priorityGoal" value="long-term" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Long-term goal</span>
                          <p class="fa-help-copy">Focus on building wealth for the future</p>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="monthly-savings-budget" class="fa-field-label mb-2">
                      How much can you allocate to goals monthly? ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-savings-budget" 
                      name="monthlySavingsBudget"
                      class="fa-input-surface w-full"
                      placeholder="800"
                    />
                    <p class="fa-help-copy mt-1">This is separate from emergency fund and retirement savings</p>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="submit" id="calculate-goals-btn" class="fa-button-primary">
                  Calculate Goal Timeline
                </button>
                <button type="button" id="save-goals-btn" class="fa-button-primary">
                  Save Goals
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="results-section" class="fa-highlight-card hidden mt-8 p-6">
              <h3 class="fa-scenario-title mb-4">📊 Your Goal Timeline</h3>
              <div id="goal-results" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>
          )}
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title mb-4 text-lg">🎯 Goal Setting Tips</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>SMART Goals:</strong> Specific, Measurable, Achievable, Relevant, Time-bound.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Start Small:</strong> Break big goals into smaller milestones.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Review Regularly:</strong> Adjust goals as life changes.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Celebrate Wins:</strong> Acknowledge progress along the way.</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-4 text-lg">💡 Goal Categories</h3>
            <div class="space-y-3 fa-list-copy">
              <p><strong>Financial Security:</strong> Emergency fund, debt payoff</p>
              <p><strong>Major Purchases:</strong> Car, home, education</p>
              <p><strong>Life Experiences:</strong> Travel, hobbies, family</p>
              <p><strong>Future Planning:</strong> Retirement, business, legacy</p>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script type="module" src="/src/scripts/journey/goal-planning.client.ts" is:inline></script>
  {scenario === 'home-buying' && (
    <script type="module" src="/src/scripts/journey/mortgage-comparison.client.ts" is:inline></script>
  )}
</Layout>
