                <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🏠 Base Loan Information</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="home-price" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Home Price ($) *
                      </label>
                      <input 
                        type="number" 
                        id="home-price" 
                        name="homePrice"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        placeholder="400000"
                        required
                      />
                    </div>
                    <div>
                      <label for="loan-term" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Loan Term (years) *
                      </label>
                      <select 
                        id="loan-term" 
                        name="loanTerm"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                        required
                      >
                        <option value="15">15 years</option>
                        <option value="30" selected>30 years</option>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- Scenario 1: Current Plan -->
                <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">💼 Scenario 1: Current Plan</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="scenario1-down" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Down Payment ($) *
                      </label>
                      <input 
                        type="number" 
                        id="scenario1-down" 
                        name="scenario1Down"
                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
