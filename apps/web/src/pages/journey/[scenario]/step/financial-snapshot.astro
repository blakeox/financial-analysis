---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'financial-snapshot')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Find financial-snapshot step in this journey
const currentStep = currentScenario.models.find(m => m.id === 'financial-snapshot');
const currentStepOrder = currentStep?.order || 1;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey" class="hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href={`/journey/${scenario}`} class="hover:text-gray-700 dark:hover:text-gray-300">{currentScenario.name}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">{currentStep?.name}</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <!-- Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">📊</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{currentStep?.name}</h1>
                <p class="text-gray-600 dark:text-gray-400">{currentStep?.description}</p>
                <div class="mt-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                    Step {currentStepOrder} of {currentScenario.models.length} - {currentScenario.name}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Journey Progress Bar -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Journey Progress</h3>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                Step {currentStepOrder} of {currentScenario.models.length}
              </span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
              <div 
                class="bg-gradient-to-r from-green-500 to-emerald-600 h-2 rounded-full transition-all duration-300"
                style={`width: ${(currentStepOrder / currentScenario.models.length) * 100}%`}
              ></div>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              {currentScenario.name} - {Math.round((currentStepOrder / currentScenario.models.length) * 100)}% Complete
            </p>
          </div>

          <!-- Financial Snapshot Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Your Financial Snapshot</h2>
            
            <form id="financial-snapshot-form" class="space-y-6">
              <!-- Income Section -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">💰 Income</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="annual-income" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Annual Gross Income ($) *
                    </label>
                    <input 
                      type="number" 
                      id="annual-income" 
                      name="annualIncome"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="65000"
                      required
                    />
                    <p class="text-sm text-gray-500 mt-1">Your total annual income before taxes</p>
                  </div>
                  <div>
                    <label for="monthly-income" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Monthly Take-Home Pay ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-income" 
                      name="monthlyIncome"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="4500"
                    />
                    <p class="text-sm text-gray-500 mt-1">After taxes and deductions</p>
                  </div>
                </div>
              </div>

              <!-- Assets Section -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🏦 Assets</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="checking-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Checking Account ($)
                    </label>
                    <input 
                      type="number" 
                      id="checking-balance" 
                      name="checkingBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="2500"
                    />
                  </div>
                  <div>
                    <label for="savings-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Savings Account ($)
                    </label>
                    <input 
                      type="number" 
                      id="savings-balance" 
                      name="savingsBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="5000"
                    />
                  </div>
                  <div>
                    <label for="investment-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Investment Accounts ($)
                    </label>
                    <input 
                      type="number" 
                      id="investment-balance" 
                      name="investmentBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="retirement-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      401(k) / Retirement ($)
                    </label>
                    <input 
                      type="number" 
                      id="retirement-balance" 
                      name="retirementBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                </div>
              </div>

              <!-- Debt Section -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">💳 Debt</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="student-loan-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Student Loan Balance ($)
                    </label>
                    <input 
                      type="number" 
                      id="student-loan-balance" 
                      name="studentLoanBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="25000"
                    />
                  </div>
                  <div>
                    <label for="credit-card-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Credit Card Debt ($)
                    </label>
                    <input 
                      type="number" 
                      id="credit-card-balance" 
                      name="creditCardBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="car-loan-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Car Loan Balance ($)
                    </label>
                    <input 
                      type="number" 
                      id="car-loan-balance" 
                      name="carLoanBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="other-debt" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Other Debt ($)
                    </label>
                    <input 
                      type="number" 
                      id="other-debt" 
                      name="otherDebt"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                </div>
              </div>

              <!-- Goals Section -->
              <div class="pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🎯 Financial Goals</h3>
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      What are your top 3 financial priorities? (Select all that apply)
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="emergency-fund" class="mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Build emergency fund</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="pay-off-debt" class="mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Pay off student loans</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="retirement" class="mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Start retirement savings</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="home" class="mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Save for home down payment</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="travel" class="mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Save for travel</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="career" class="mr-2">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Invest in career development</span>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="timeline" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      What's your timeline for achieving these goals?
                    </label>
                    <select 
                      id="timeline" 
                      name="timeline"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                    >
                      <option value="">Select timeline</option>
                      <option value="1-year">1 year</option>
                      <option value="2-3-years">2-3 years</option>
                      <option value="5-years">5 years</option>
                      <option value="10-years">10+ years</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 border-t border-gray-200 dark:border-gray-700">
                <button type="submit" id="save-snapshot-btn" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Save Financial Snapshot
                </button>
                <button type="button" id="reset-btn" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Reset Form
                </button>
              </div>
            </form>
          </div>

          <!-- Journey Navigation -->
          <div class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a 
                    href={journeyNav.nextStep.url}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href={`/journey-analysis/${journeyNav.scenarioId}`}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Complete Journey
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold mb-4">💡 Tips</h3>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400">
              <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                <p><strong>Be Honest:</strong> Accurate information helps create better financial plans.</p>
              </div>
              <div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
                <p><strong>Don't Worry:</strong> This is just a starting point - we'll help you improve!</p>
              </div>
              <div class="p-3 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg">
                <p><strong>Estimate:</strong> If you're not sure of exact amounts, make your best guess.</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
            <h3 class="text-lg font-semibold mb-4">🎯 Why This Matters</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Understanding your current financial situation is the foundation of good financial planning. 
              This snapshot will help us create personalized strategies for your debt, savings, and investment goals.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ journeyNav }}>
    // Financial Snapshot Form Handler
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('financial-snapshot-form');
      const saveBtn = document.getElementById('save-snapshot-btn');
      const resetBtn = document.getElementById('reset-btn');

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Collect form data
          const formData = new FormData(form);
          const snapshotData = {
            income: {
              annual: formData.get('annualIncome'),
              monthly: formData.get('monthlyIncome')
            },
            assets: {
              checking: formData.get('checkingBalance'),
              savings: formData.get('savingsBalance'),
              investments: formData.get('investmentBalance'),
              retirement: formData.get('retirementBalance')
            },
            debt: {
              studentLoans: formData.get('studentLoanBalance'),
              creditCards: formData.get('creditCardBalance'),
              carLoan: formData.get('carLoanBalance'),
              other: formData.get('otherDebt')
            },
            goals: formData.getAll('goals'),
            timeline: formData.get('timeline'),
            completedAt: new Date().toISOString()
          };

          // Store in journey state
          const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['financial-snapshot'] = snapshotData;
          localStorage.setItem(`fanalyx-journey-state-${journeyNav.scenarioId}`, JSON.stringify(journeyState));

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
          saveBtn.classList.add('bg-green-500');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save Financial Snapshot';
            saveBtn.classList.remove('bg-green-500');
            saveBtn.classList.add('bg-green-600', 'hover:bg-green-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'financial-snapshot',
              result: snapshotData,
              formData: snapshotData
            }
          }));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form.reset();
        });
      }
    });
  </script>
</Layout>
