---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'financial-snapshot')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Find financial-snapshot step in this journey
const currentStep = currentScenario.models.find(m => m.id === 'financial-snapshot');
const currentStepOrder = currentStep?.order || 1;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <JourneyStepHero
            icon="📊"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Financial Snapshot Form -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Your Financial Snapshot</h2>
            
            <form id="financial-snapshot-form" class="space-y-6">
              <!-- Income Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">💰 Income</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="annual-income" class="fa-field-label mb-2">
                      Annual Gross Income ($) *
                    </label>
                    <input 
                      type="number" 
                      id="annual-income" 
                      name="annualIncome"
                      class="fa-input-surface w-full"
                      placeholder="65000"
                      required
                    />
                    <p class="fa-help-copy mt-1">Your total annual income before taxes</p>
                  </div>
                  <div>
                    <label for="monthly-income" class="fa-field-label mb-2">
                      Monthly Take-Home Pay ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-income" 
                      name="monthlyIncome"
                      class="fa-input-surface w-full"
                      placeholder="4500"
                    />
                    <p class="fa-help-copy mt-1">After taxes and deductions</p>
                  </div>
                </div>
              </div>

              <!-- Assets Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🏦 Assets</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="checking-balance" class="fa-field-label mb-2">
                      Checking Account ($)
                    </label>
                    <input 
                      type="number" 
                      id="checking-balance" 
                      name="checkingBalance"
                      class="fa-input-surface w-full"
                      placeholder="2500"
                    />
                  </div>
                  <div>
                    <label for="savings-balance" class="fa-field-label mb-2">
                      Savings Account ($)
                    </label>
                    <input 
                      type="number" 
                      id="savings-balance" 
                      name="savingsBalance"
                      class="fa-input-surface w-full"
                      placeholder="5000"
                    />
                  </div>
                  <div>
                    <label for="investment-balance" class="fa-field-label mb-2">
                      Investment Accounts ($)
                    </label>
                    <input 
                      type="number" 
                      id="investment-balance" 
                      name="investmentBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="retirement-balance" class="fa-field-label mb-2">
                      401(k) / Retirement ($)
                    </label>
                    <input 
                      type="number" 
                      id="retirement-balance" 
                      name="retirementBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                </div>
              </div>

              <!-- Debt Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">💳 Debt</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="student-loan-balance" class="fa-field-label mb-2">
                      Student Loan Balance ($)
                    </label>
                    <input 
                      type="number" 
                      id="student-loan-balance" 
                      name="studentLoanBalance"
                      class="fa-input-surface w-full"
                      placeholder="25000"
                    />
                  </div>
                  <div>
                    <label for="credit-card-balance" class="fa-field-label mb-2">
                      Credit Card Debt ($)
                    </label>
                    <input 
                      type="number" 
                      id="credit-card-balance" 
                      name="creditCardBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="car-loan-balance" class="fa-field-label mb-2">
                      Car Loan Balance ($)
                    </label>
                    <input 
                      type="number" 
                      id="car-loan-balance" 
                      name="carLoanBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="other-debt" class="fa-field-label mb-2">
                      Other Debt ($)
                    </label>
                    <input 
                      type="number" 
                      id="other-debt" 
                      name="otherDebt"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                </div>
              </div>

              <!-- Goals Section -->
              <div class="pb-6">
                <h3 class="fa-scenario-title mb-4">🎯 Financial Goals</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      What are your top 3 financial priorities? (Select all that apply)
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="emergency-fund" class="mr-2">
                        <span class="fa-list-copy">Build emergency fund</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="pay-off-debt" class="mr-2">
                        <span class="fa-list-copy">Pay off student loans</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="retirement" class="mr-2">
                        <span class="fa-list-copy">Start retirement savings</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="home" class="mr-2">
                        <span class="fa-list-copy">Save for home down payment</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="travel" class="mr-2">
                        <span class="fa-list-copy">Save for travel</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="goals" value="career" class="mr-2">
                        <span class="fa-list-copy">Invest in career development</span>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="timeline" class="fa-field-label mb-2">
                      What's your timeline for achieving these goals?
                    </label>
                    <select 
                      id="timeline" 
                      name="timeline"
                      class="fa-input-surface w-full"
                    >
                      <option value="">Select timeline</option>
                      <option value="1-year">1 year</option>
                      <option value="2-3-years">2-3 years</option>
                      <option value="5-years">5 years</option>
                      <option value="10-years">10+ years</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="submit" id="save-snapshot-btn" class="fa-button-primary">
                  Save Financial Snapshot
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title text-lg mb-4">💡 Tips</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>Be Honest:</strong> Accurate information helps create better financial plans.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Don't Worry:</strong> This is just a starting point - we'll help you improve!</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Estimate:</strong> If you're not sure of exact amounts, make your best guess.</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
            <h3 class="fa-scenario-title text-lg mb-4">🎯 Why This Matters</h3>
            <p class="fa-meta-copy">
              Understanding your current financial situation is the foundation of good financial planning. 
              This snapshot will help us create personalized strategies for your debt, savings, and investment goals.
            </p>
          </div>
        </div>
      </div>
  </div>

  <script define:vars={{ journeyNav }} is:inline>
    // Financial Snapshot Form Handler
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('financial-snapshot-form');
      const saveBtn = document.getElementById('save-snapshot-btn');
      const resetBtn = document.getElementById('reset-btn');

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Collect form data
          const formData = new FormData(form);
          const snapshotData = {
            income: {
              annual: formData.get('annualIncome'),
              monthly: formData.get('monthlyIncome')
            },
            assets: {
              checking: formData.get('checkingBalance'),
              savings: formData.get('savingsBalance'),
              investments: formData.get('investmentBalance'),
              retirement: formData.get('retirementBalance')
            },
            debt: {
              studentLoans: formData.get('studentLoanBalance'),
              creditCards: formData.get('creditCardBalance'),
              carLoan: formData.get('carLoanBalance'),
              other: formData.get('otherDebt')
            },
            goals: formData.getAll('goals'),
            timeline: formData.get('timeline'),
            completedAt: new Date().toISOString()
          };

          // Store in journey state
          const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['financial-snapshot'] = snapshotData;
          localStorage.setItem(`fanalyx-journey-state-${journeyNav.scenarioId}`, JSON.stringify(journeyState));

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
          saveBtn.classList.add('fa-button-success-state');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save Financial Snapshot';
            saveBtn.classList.remove('fa-button-success-state');
            saveBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'financial-snapshot',
              result: snapshotData,
              formData: snapshotData
            }
          }));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form.reset();
        });
      }
    });
  </script>
</Layout>
