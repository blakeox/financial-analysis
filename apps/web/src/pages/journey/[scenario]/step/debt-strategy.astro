---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'debt-strategy')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Find debt-strategy step in this journey
const currentStep = currentScenario.models.find(m => m.id === 'debt-strategy');
const currentStepOrder = currentStep?.order || 2;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <JourneyStepHero
            icon="💳"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Debt Strategy Form -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Create Your Debt Strategy</h2>
            
            <form id="debt-strategy-form" class="space-y-6">
              <!-- Student Loans Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🎓 Student Loans</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="student-loan-balance" class="fa-field-label mb-2">
                      Total Student Loan Balance ($) *
                    </label>
                    <input 
                      type="number" 
                      id="student-loan-balance" 
                      name="studentLoanBalance"
                      class="fa-input-surface w-full"
                      placeholder="25000"
                      required
                    />
                  </div>
                  <div>
                    <label for="student-loan-rate" class="fa-field-label mb-2">
                      Average Interest Rate (%) *
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="student-loan-rate" 
                      name="studentLoanRate"
                      class="fa-input-surface w-full"
                      placeholder="5.5"
                      required
                    />
                  </div>
                  <div>
                    <label for="repayment-plan" class="fa-field-label mb-2">
                      Current Repayment Plan *
                    </label>
                    <select 
                      id="repayment-plan" 
                      name="repaymentPlan"
                      class="fa-input-surface w-full"
                      required
                    >
                      <option value="">Select plan</option>
                      <option value="standard">Standard (10-year)</option>
                      <option value="extended">Extended (25-year)</option>
                      <option value="income-driven">Income-Driven (REPAYE/PAYE/IBR)</option>
                      <option value="graduated">Graduated</option>
                    </select>
                  </div>
                  <div>
                    <label for="monthly-payment" class="fa-field-label mb-2">
                      Current Monthly Payment ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-payment" 
                      name="monthlyPayment"
                      class="fa-input-surface w-full"
                      placeholder="275"
                    />
                  </div>
                </div>
              </div>

              <!-- Other Debt Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">💳 Other Debt</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="credit-card-balance" class="fa-field-label mb-2">
                      Credit Card Debt ($)
                    </label>
                    <input 
                      type="number" 
                      id="credit-card-balance" 
                      name="creditCardBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="credit-card-rate" class="fa-field-label mb-2">
                      Credit Card Interest Rate (%)
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="credit-card-rate" 
                      name="creditCardRate"
                      class="fa-input-surface w-full"
                      placeholder="18.99"
                    />
                  </div>
                  <div>
                    <label for="car-loan-balance" class="fa-field-label mb-2">
                      Car Loan Balance ($)
                    </label>
                    <input 
                      type="number" 
                      id="car-loan-balance" 
                      name="carLoanBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="car-loan-rate" class="fa-field-label mb-2">
                      Car Loan Interest Rate (%)
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="car-loan-rate" 
                      name="carLoanRate"
                      class="fa-input-surface w-full"
                      placeholder="4.5"
                    />
                  </div>
                </div>
              </div>

              <!-- Strategy Section -->
              <div class="pb-6">
                <h3 class="fa-scenario-title mb-4">🎯 Debt Payoff Strategy</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      Which debt payoff method appeals to you?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="payoffMethod" value="avalanche" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Avalanche Method</span>
                            <p class="fa-help-copy">Pay highest interest rate debt first (saves most money)</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="payoffMethod" value="snowball" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Snowball Method</span>
                            <p class="fa-help-copy">Pay smallest balance first (psychological wins)</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="payoffMethod" value="hybrid" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">Hybrid Approach</span>
                            <p class="fa-help-copy">Mix of both methods based on your situation</p>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="extra-payment" class="fa-field-label mb-2">
                      How much extra can you pay toward debt each month? ($)
                    </label>
                    <input 
                      type="number" 
                      id="extra-payment" 
                      name="extraPayment"
                      class="fa-input-surface w-full"
                      placeholder="200"
                    />
                    <p class="fa-help-copy mt-1">This is in addition to minimum payments</p>
                  </div>
                  <div>
                    <label for="timeline" class="fa-field-label mb-2">
                      Target debt-free timeline
                    </label>
                    <select 
                      id="timeline" 
                      name="timeline"
                      class="fa-input-surface w-full"
                    >
                      <option value="">Select timeline</option>
                      <option value="1-year">1 year</option>
                      <option value="2-years">2 years</option>
                      <option value="3-years">3 years</option>
                      <option value="5-years">5 years</option>
                      <option value="10-years">10 years</option>
                      <option value="flexible">Flexible timeline</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="button" id="calculate-strategy-btn" class="fa-button-primary">
                  Calculate Strategy
                </button>
                <button type="submit" id="save-strategy-btn" class="fa-button-primary">
                  Save Debt Strategy
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="results-section" class="fa-highlight-card hidden mt-8 p-6">
              <h3 class="fa-scenario-title mb-4">📊 Your Debt Payoff Strategy</h3>
              <div id="strategy-results" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title text-lg mb-4">💡 Debt Tips</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>Avalanche Method:</strong> Saves the most money in interest over time.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Snowball Method:</strong> Provides psychological motivation with quick wins.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Extra Payments:</strong> Even $50 extra per month can save thousands!</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
            <h3 class="fa-scenario-title text-lg mb-4">🎯 Student Loan Tips</h3>
            <div class="space-y-3 fa-list-copy">
              <p><strong>Income-Driven Plans:</strong> Can lower payments if you're struggling.</p>
              <p><strong>Refinancing:</strong> May lower rates if you have good credit.</p>
              <p><strong>Employer Benefits:</strong> Some companies help with student loans.</p>
              <p><strong>Tax Benefits:</strong> Student loan interest may be deductible.</p>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script define:vars={{ scenarioId: scenario }} is:inline>
    // Debt Strategy Form Handler
    document.addEventListener('DOMContentLoaded', async function() {
      // Dynamically import debt payoff engine
      let DebtPayoffEngine;
      try {
        const debtPayoffModule = await import('@financial-analysis/analysis');
        DebtPayoffEngine = debtPayoffModule.DebtPayoffEngine;
      } catch (error) {
        console.error('Failed to import DebtPayoffEngine:', error);
      }

      /** @type {HTMLFormElement|null} */
      const form = document.getElementById('debt-strategy-form');
      const calculateBtn = document.getElementById('calculate-strategy-btn');
      const saveBtn = document.getElementById('save-strategy-btn');
      const resetBtn = document.getElementById('reset-btn');
      const resultsSection = document.getElementById('results-section');
      const strategyResults = document.getElementById('strategy-results');

      if (calculateBtn && DebtPayoffEngine && form) {
        calculateBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Collect form data
          const formData = new FormData(form);
          const studentLoanBalance = parseFloat(formData.get('studentLoanBalance')?.toString() || '0');
          const creditCardBalance = parseFloat(formData.get('creditCardBalance')?.toString() || '0');
          const carLoanBalance = parseFloat(formData.get('carLoanBalance')?.toString() || '0');
          
          if (studentLoanBalance === 0 && creditCardBalance === 0 && carLoanBalance === 0) {
            alert('Please enter at least one debt balance to calculate a strategy.');
            return;
          }

          // Build debts array
          const debts = [];
          if (studentLoanBalance > 0) {
            debts.push({
              name: 'Student Loans',
              balance: studentLoanBalance,
              interestRate: parseFloat(formData.get('studentLoanRate') || '0') / 100,
              minimumPayment: parseFloat(formData.get('monthlyPayment') || '100')
            });
          }
          if (creditCardBalance > 0) {
            debts.push({
              name: 'Credit Card',
              balance: creditCardBalance,
              interestRate: parseFloat(formData.get('creditCardRate') || '0') / 100,
              minimumPayment: Math.max(25, creditCardBalance * 0.02) // 2% minimum
            });
          }
          if (carLoanBalance > 0) {
            debts.push({
              name: 'Car Loan',
              balance: carLoanBalance,
              interestRate: parseFloat(formData.get('carLoanRate') || '0') / 100,
              minimumPayment: 250 // placeholder
            });
          }

          const extraPayment = parseFloat(formData.get('extraPayment') || '0');
          const payoffMethod = formData.get('payoffMethod') || 'avalanche';
          
          // Calculate results
          const result = DebtPayoffEngine.analyze({
            debts,
            extraMonthlyPayment: extraPayment,
            strategy: payoffMethod === 'avalanche' || payoffMethod === 'snowball' ? payoffMethod : 'avalanche'
          });

          // Display results
          const primary = result.summary;
          const alternative = result.alternativeStrategy;
          
          const formatMonths = (months) => {
            const years = (months / 12).toFixed(1);
            return `${months} months (${years} years)`;
          };
          
          const formatCurrency = (value) => {
            return new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: 'USD',
              minimumFractionDigits: 0,
              maximumFractionDigits: 0
            }).format(value);
          };

          const comparison = parseFloat(result.comparisonSavings || '0');
          const monthDifference = alternative ? alternative.totalMonthsToPayoff - primary.totalMonthsToPayoff : 0;
          
          strategyResults.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div class="fa-subcard">
                <h4 class="fa-scenario-title mb-4">Avalanche Method</h4>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Time to Payoff:</span>
                     <span class="fa-result-emphasis">${primary.strategy === 'avalanche' ? formatMonths(primary.totalMonthsToPayoff) : formatMonths(alternative?.totalMonthsToPayoff || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Total Interest:</span>
                     <span class="fa-result-emphasis">${primary.strategy === 'avalanche' ? formatCurrency(primary.totalInterestPaid) : formatCurrency(alternative?.totalInterestPaid || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Total Paid:</span>
                     <span class="fa-result-emphasis">${primary.strategy === 'avalanche' ? formatCurrency(primary.totalAmountPaid) : formatCurrency(alternative?.totalAmountPaid || 0)}</span>
                  </div>
                </div>
                 <p class="fa-help-copy mt-3">Pays highest interest debts first (saves most money)</p>
              </div>
              
              <div class="fa-subcard">
                <h4 class="fa-scenario-title mb-4">Snowball Method</h4>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Time to Payoff:</span>
                     <span class="fa-result-emphasis">${primary.strategy === 'snowball' ? formatMonths(primary.totalMonthsToPayoff) : formatMonths(alternative?.totalMonthsToPayoff || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Total Interest:</span>
                     <span class="fa-result-emphasis">${primary.strategy === 'snowball' ? formatCurrency(primary.totalInterestPaid) : formatCurrency(alternative?.totalInterestPaid || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                     <span class="fa-meta-copy">Total Paid:</span>
                     <span class="fa-result-emphasis">${primary.strategy === 'snowball' ? formatCurrency(primary.totalAmountPaid) : formatCurrency(alternative?.totalAmountPaid || 0)}</span>
                  </div>
                </div>
                 <p class="fa-help-copy mt-3">Pays smallest debts first (psychological wins)</p>
              </div>
            </div>

            ${comparison > 0 ? `
              <div class="fa-highlight-card p-4">
                <p class="text-sm text-emerald-800 dark:text-emerald-200">
                  <strong>💡 Avalanche saves ${formatCurrency(Math.abs(comparison))} in interest!</strong>
                </p>
              </div>
            ` : monthDifference < 0 ? `
              <div class="fa-highlight-card p-4">
                <p class="text-sm text-violet-800 dark:text-violet-200">
                  <strong>💡 Snowball pays off ${Math.abs(monthDifference)} months faster!</strong>
                </p>
              </div>
            ` : ''}

            <div class="fa-subcard">
               <h4 class="fa-scenario-title mb-3">Payoff Timeline</h4>
              <div class="space-y-2">
                ${primary.debtSummaries
                  .slice()
                  .sort((a, b) => a.monthsToPayoff - b.monthsToPayoff)
                  .map((debt, index) => `
                    <div class="flex justify-between items-center text-sm py-1 border-b border-slate-200 dark:border-slate-700">
                      <span class="fa-list-copy-strong">${index + 1}. ${debt.name}</span>
                      <span class="fa-meta-copy">${formatMonths(debt.monthsToPayoff)}</span>
                    </div>
                  `)
                  .join('')}
              </div>
            </div>
          `;

          resultsSection?.classList.remove('hidden');
        });
      } else if (calculateBtn && !DebtPayoffEngine) {
        calculateBtn.disabled = true;
        calculateBtn.textContent = 'Engine Loading...';
        alert('Debt payoff calculator is loading. Please refresh and try again.');
      }

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Collect form data
          const formData = new FormData(form);
          const strategyData = {
            studentLoans: {
              balance: formData.get('studentLoanBalance'),
              rate: formData.get('studentLoanRate'),
              plan: formData.get('repaymentPlan'),
              monthlyPayment: formData.get('monthlyPayment')
            },
            otherDebt: {
              creditCards: {
                balance: formData.get('creditCardBalance'),
                rate: formData.get('creditCardRate')
              },
              carLoan: {
                balance: formData.get('carLoanBalance'),
                rate: formData.get('carLoanRate')
              }
            },
            strategy: {
              method: formData.get('payoffMethod'),
              extraPayment: formData.get('extraPayment'),
              timeline: formData.get('timeline')
            },
            completedAt: new Date().toISOString()
          };

          // Store in journey state
          const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${scenarioId}`) || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['debt-strategy'] = strategyData;
          localStorage.setItem(`fanalyx-journey-state-${scenarioId}`, JSON.stringify(journeyState));

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
          saveBtn.classList.add('fa-button-success-state');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save Debt Strategy';
            saveBtn.classList.remove('fa-button-success-state');
            saveBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'debt-strategy',
              result: strategyData,
              formData: strategyData
            }
          }));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form.reset();
          resultsSection?.classList.add('hidden');
        });
      }
    });
  </script>
</Layout>
