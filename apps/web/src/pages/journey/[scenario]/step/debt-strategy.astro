---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'debt-strategy')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Find debt-strategy step in this journey
const currentStep = currentScenario.models.find(m => m.id === 'debt-strategy');
const currentStepOrder = currentStep?.order || 2;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey" class="hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href={`/journey/${scenario}`} class="hover:text-gray-700 dark:hover:text-gray-300">{currentScenario.name}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">{currentStep?.name}</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <!-- Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">💳</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{currentStep?.name}</h1>
                <p class="text-gray-600 dark:text-gray-400">{currentStep?.description}</p>
                <div class="mt-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                    Step {currentStepOrder} of {currentScenario.models.length} - {currentScenario.name}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Journey Progress Bar -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Journey Progress</h3>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                Step {currentStepOrder} of {currentScenario.models.length}
              </span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
              <div 
                class="bg-gradient-to-r from-green-500 to-emerald-600 h-2 rounded-full transition-all duration-300"
                style={`width: ${(currentStepOrder / currentScenario.models.length) * 100}%`}
              ></div>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              {currentScenario.name} - {Math.round((currentStepOrder / currentScenario.models.length) * 100)}% Complete
            </p>
          </div>

          <!-- Debt Strategy Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Create Your Debt Strategy</h2>
            
            <form id="debt-strategy-form" class="space-y-6">
              <!-- Student Loans Section -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🎓 Student Loans</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="student-loan-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Total Student Loan Balance ($) *
                    </label>
                    <input 
                      type="number" 
                      id="student-loan-balance" 
                      name="studentLoanBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="25000"
                      required
                    />
                  </div>
                  <div>
                    <label for="student-loan-rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Average Interest Rate (%) *
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="student-loan-rate" 
                      name="studentLoanRate"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="5.5"
                      required
                    />
                  </div>
                  <div>
                    <label for="repayment-plan" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Current Repayment Plan *
                    </label>
                    <select 
                      id="repayment-plan" 
                      name="repaymentPlan"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      required
                    >
                      <option value="">Select plan</option>
                      <option value="standard">Standard (10-year)</option>
                      <option value="extended">Extended (25-year)</option>
                      <option value="income-driven">Income-Driven (REPAYE/PAYE/IBR)</option>
                      <option value="graduated">Graduated</option>
                    </select>
                  </div>
                  <div>
                    <label for="monthly-payment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Current Monthly Payment ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-payment" 
                      name="monthlyPayment"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="275"
                    />
                  </div>
                </div>
              </div>

              <!-- Other Debt Section -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">💳 Other Debt</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="credit-card-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Credit Card Debt ($)
                    </label>
                    <input 
                      type="number" 
                      id="credit-card-balance" 
                      name="creditCardBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="credit-card-rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Credit Card Interest Rate (%)
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="credit-card-rate" 
                      name="creditCardRate"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="18.99"
                    />
                  </div>
                  <div>
                    <label for="car-loan-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Car Loan Balance ($)
                    </label>
                    <input 
                      type="number" 
                      id="car-loan-balance" 
                      name="carLoanBalance"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="0"
                    />
                  </div>
                  <div>
                    <label for="car-loan-rate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Car Loan Interest Rate (%)
                    </label>
                    <input 
                      type="number" 
                      step="0.01"
                      id="car-loan-rate" 
                      name="carLoanRate"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="4.5"
                    />
                  </div>
                </div>
              </div>

              <!-- Strategy Section -->
              <div class="pb-6">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">🎯 Debt Payoff Strategy</h3>
                <div class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Which debt payoff method appeals to you?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="payoffMethod" value="avalanche" class="mt-1 mr-3">
                        <div>
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Avalanche Method</span>
                          <p class="text-xs text-gray-500">Pay highest interest rate debt first (saves most money)</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="payoffMethod" value="snowball" class="mt-1 mr-3">
                        <div>
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Snowball Method</span>
                          <p class="text-xs text-gray-500">Pay smallest balance first (psychological wins)</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="payoffMethod" value="hybrid" class="mt-1 mr-3">
                        <div>
                          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Hybrid Approach</span>
                          <p class="text-xs text-gray-500">Mix of both methods based on your situation</p>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="extra-payment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      How much extra can you pay toward debt each month? ($)
                    </label>
                    <input 
                      type="number" 
                      id="extra-payment" 
                      name="extraPayment"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                      placeholder="200"
                    />
                    <p class="text-sm text-gray-500 mt-1">This is in addition to minimum payments</p>
                  </div>
                  <div>
                    <label for="timeline" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Target debt-free timeline
                    </label>
                    <select 
                      id="timeline" 
                      name="timeline"
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                    >
                      <option value="">Select timeline</option>
                      <option value="1-year">1 year</option>
                      <option value="2-years">2 years</option>
                      <option value="3-years">3 years</option>
                      <option value="5-years">5 years</option>
                      <option value="10-years">10 years</option>
                      <option value="flexible">Flexible timeline</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 border-t border-gray-200 dark:border-gray-700">
                <button type="button" id="calculate-strategy-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Calculate Strategy
                </button>
                <button type="submit" id="save-strategy-btn" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Save Debt Strategy
                </button>
                <button type="button" id="reset-btn" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="results-section" class="hidden mt-8 p-6 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">📊 Your Debt Payoff Strategy</h3>
              <div id="strategy-results" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>

          <!-- Journey Navigation -->
          <div class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a 
                    href={journeyNav.previousStep.url}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a 
                    href={journeyNav.journeyOverviewUrl}
                    class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>

              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a 
                    href={journeyNav.nextStep.url}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a 
                    href={`/journey-analysis/${journeyNav.scenarioId}`}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                  >
                    Complete Journey
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold mb-4">💡 Debt Tips</h3>
            <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400">
              <div class="p-3 bg-red-50 dark:bg-red-900/20 rounded-lg">
                <p><strong>Avalanche Method:</strong> Saves the most money in interest over time.</p>
              </div>
              <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                <p><strong>Snowball Method:</strong> Provides psychological motivation with quick wins.</p>
              </div>
              <div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
                <p><strong>Extra Payments:</strong> Even $50 extra per month can save thousands!</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
            <h3 class="text-lg font-semibold mb-4">🎯 Student Loan Tips</h3>
            <div class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
              <p><strong>Income-Driven Plans:</strong> Can lower payments if you're struggling.</p>
              <p><strong>Refinancing:</strong> May lower rates if you have good credit.</p>
              <p><strong>Employer Benefits:</strong> Some companies help with student loans.</p>
              <p><strong>Tax Benefits:</strong> Student loan interest may be deductible.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ scenarioId: scenario }} is:inline>
    // Debt Strategy Form Handler
    document.addEventListener('DOMContentLoaded', async function() {
      // Dynamically import debt payoff engine
      let DebtPayoffEngine;
      try {
        const debtPayoffModule = await import('@financial-analysis/analysis');
        DebtPayoffEngine = debtPayoffModule.DebtPayoffEngine;
      } catch (error) {
        console.error('Failed to import DebtPayoffEngine:', error);
      }

      /** @type {HTMLFormElement|null} */
      const form = document.getElementById('debt-strategy-form');
      const calculateBtn = document.getElementById('calculate-strategy-btn');
      const saveBtn = document.getElementById('save-strategy-btn');
      const resetBtn = document.getElementById('reset-btn');
      const resultsSection = document.getElementById('results-section');
      const strategyResults = document.getElementById('strategy-results');

      if (calculateBtn && DebtPayoffEngine && form) {
        calculateBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Collect form data
          const formData = new FormData(form);
          const studentLoanBalance = parseFloat(formData.get('studentLoanBalance')?.toString() || '0');
          const creditCardBalance = parseFloat(formData.get('creditCardBalance')?.toString() || '0');
          const carLoanBalance = parseFloat(formData.get('carLoanBalance')?.toString() || '0');
          
          if (studentLoanBalance === 0 && creditCardBalance === 0 && carLoanBalance === 0) {
            alert('Please enter at least one debt balance to calculate a strategy.');
            return;
          }

          // Build debts array
          const debts = [];
          if (studentLoanBalance > 0) {
            debts.push({
              name: 'Student Loans',
              balance: studentLoanBalance,
              interestRate: parseFloat(formData.get('studentLoanRate') || '0') / 100,
              minimumPayment: parseFloat(formData.get('monthlyPayment') || '100')
            });
          }
          if (creditCardBalance > 0) {
            debts.push({
              name: 'Credit Card',
              balance: creditCardBalance,
              interestRate: parseFloat(formData.get('creditCardRate') || '0') / 100,
              minimumPayment: Math.max(25, creditCardBalance * 0.02) // 2% minimum
            });
          }
          if (carLoanBalance > 0) {
            debts.push({
              name: 'Car Loan',
              balance: carLoanBalance,
              interestRate: parseFloat(formData.get('carLoanRate') || '0') / 100,
              minimumPayment: 250 // placeholder
            });
          }

          const extraPayment = parseFloat(formData.get('extraPayment') || '0');
          const payoffMethod = formData.get('payoffMethod') || 'avalanche';
          
          // Calculate results
          const result = DebtPayoffEngine.analyze({
            debts,
            extraMonthlyPayment: extraPayment,
            strategy: payoffMethod === 'avalanche' || payoffMethod === 'snowball' ? payoffMethod : 'avalanche'
          });

          // Display results
          const primary = result.summary;
          const alternative = result.alternativeStrategy;
          
          const formatMonths = (months) => {
            const years = (months / 12).toFixed(1);
            return `${months} months (${years} years)`;
          };
          
          const formatCurrency = (value) => {
            return new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: 'USD',
              minimumFractionDigits: 0,
              maximumFractionDigits: 0
            }).format(value);
          };

          const comparison = parseFloat(result.comparisonSavings || '0');
          const monthDifference = alternative ? alternative.totalMonthsToPayoff - primary.totalMonthsToPayoff : 0;
          
          strategyResults.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div class="bg-white dark:bg-gray-700 rounded-lg p-4 border border-gray-200 dark:border-gray-600">
                <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Avalanche Method</h4>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Time to Payoff:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">${primary.strategy === 'avalanche' ? formatMonths(primary.totalMonthsToPayoff) : formatMonths(alternative?.totalMonthsToPayoff || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Interest:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">${primary.strategy === 'avalanche' ? formatCurrency(primary.totalInterestPaid) : formatCurrency(alternative?.totalInterestPaid || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Paid:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">${primary.strategy === 'avalanche' ? formatCurrency(primary.totalAmountPaid) : formatCurrency(alternative?.totalAmountPaid || 0)}</span>
                  </div>
                </div>
                <p class="text-xs text-gray-500 mt-3">Pays highest interest debts first (saves most money)</p>
              </div>
              
              <div class="bg-white dark:bg-gray-700 rounded-lg p-4 border border-gray-200 dark:border-gray-600">
                <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Snowball Method</h4>
                <div class="space-y-3 text-sm">
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Time to Payoff:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">${primary.strategy === 'snowball' ? formatMonths(primary.totalMonthsToPayoff) : formatMonths(alternative?.totalMonthsToPayoff || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Interest:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">${primary.strategy === 'snowball' ? formatCurrency(primary.totalInterestPaid) : formatCurrency(alternative?.totalInterestPaid || 0)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Paid:</span>
                    <span class="font-semibold text-gray-900 dark:text-white">${primary.strategy === 'snowball' ? formatCurrency(primary.totalAmountPaid) : formatCurrency(alternative?.totalAmountPaid || 0)}</span>
                  </div>
                </div>
                <p class="text-xs text-gray-500 mt-3">Pays smallest debts first (psychological wins)</p>
              </div>
            </div>

            ${comparison > 0 ? `
              <div class="bg-green-50 dark:bg-green-900/20 rounded-lg p-4 mb-4">
                <p class="text-sm text-green-800 dark:text-green-200">
                  <strong>💡 Avalanche saves ${formatCurrency(Math.abs(comparison))} in interest!</strong>
                </p>
              </div>
            ` : monthDifference < 0 ? `
              <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4 mb-4">
                <p class="text-sm text-blue-800 dark:text-blue-200">
                  <strong>💡 Snowball pays off ${Math.abs(monthDifference)} months faster!</strong>
                </p>
              </div>
            ` : ''}

            <div class="bg-white dark:bg-gray-700 rounded-lg p-4 border border-gray-200 dark:border-gray-600">
              <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Payoff Timeline</h4>
              <div class="space-y-2">
                ${primary.debtSummaries
                  .slice()
                  .sort((a, b) => a.monthsToPayoff - b.monthsToPayoff)
                  .map((debt, index) => `
                    <div class="flex justify-between items-center text-sm py-1 border-b border-gray-200 dark:border-gray-600">
                      <span class="font-medium text-gray-900 dark:text-white">${index + 1}. ${debt.name}</span>
                      <span class="text-gray-600 dark:text-gray-400">${formatMonths(debt.monthsToPayoff)}</span>
                    </div>
                  `)
                  .join('')}
              </div>
            </div>
          `;

          resultsSection?.classList.remove('hidden');
        });
      } else if (calculateBtn && !DebtPayoffEngine) {
        calculateBtn.disabled = true;
        calculateBtn.textContent = 'Engine Loading...';
        alert('Debt payoff calculator is loading. Please refresh and try again.');
      }

      if (saveBtn) {
        saveBtn.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Collect form data
          const formData = new FormData(form);
          const strategyData = {
            studentLoans: {
              balance: formData.get('studentLoanBalance'),
              rate: formData.get('studentLoanRate'),
              plan: formData.get('repaymentPlan'),
              monthlyPayment: formData.get('monthlyPayment')
            },
            otherDebt: {
              creditCards: {
                balance: formData.get('creditCardBalance'),
                rate: formData.get('creditCardRate')
              },
              carLoan: {
                balance: formData.get('carLoanBalance'),
                rate: formData.get('carLoanRate')
              }
            },
            strategy: {
              method: formData.get('payoffMethod'),
              extraPayment: formData.get('extraPayment'),
              timeline: formData.get('timeline')
            },
            completedAt: new Date().toISOString()
          };

          // Store in journey state
          const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${scenarioId}`) || '{}');
          journeyState.collectedData = journeyState.collectedData || {};
          journeyState.collectedData['debt-strategy'] = strategyData;
          localStorage.setItem(`fanalyx-journey-state-${scenarioId}`, JSON.stringify(journeyState));

          // Show success message
          saveBtn.textContent = '✓ Saved!';
          saveBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
          saveBtn.classList.add('bg-green-500');
          
          setTimeout(() => {
            saveBtn.textContent = 'Save Debt Strategy';
            saveBtn.classList.remove('bg-green-500');
            saveBtn.classList.add('bg-green-600', 'hover:bg-green-700');
          }, 2000);

          // Dispatch completion event
          window.dispatchEvent(new CustomEvent('calculator-completed', {
            detail: {
              calculatorId: 'debt-strategy',
              result: strategyData,
              formData: strategyData
            }
          }));
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          form.reset();
          resultsSection?.classList.add('hidden');
        });
      }
    });
  </script>
</Layout>
