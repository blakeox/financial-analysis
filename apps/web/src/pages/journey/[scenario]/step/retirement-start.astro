---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import { buildJourneyNavFromOrder } from '../../../../utils/journeyNavigation';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'retirement-start')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Find retirement-start step in this journey
const currentStep = currentScenario.models.find(m => m.id === 'retirement-start');
const currentStepOrder = currentStep?.order || 4;
const { journeyNav } = buildJourneyNavFromOrder({
  currentScenario,
  scenarioId: scenario!,
  currentStepOrder,
});

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3">
          <JourneyStepHero
            icon="🚀"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

          <!-- Retirement Planning Form -->
          <div class="fa-card p-6 mb-6">
            <h2 class="fa-panel-title mb-6">Start Your Retirement Journey</h2>
            
            <form
              id="retirement-start-form"
              data-journey-scenario-id={journeyNav.scenarioId}
              class="space-y-6"
            >
              <!-- Current Situation Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">📊 Current Situation</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="age" class="fa-field-label mb-2">
                      Your Age *
                    </label>
                    <input 
                      type="number" 
                      id="age" 
                      name="age"
                      class="fa-input-surface w-full"
                      placeholder="28"
                      required
                    />
                  </div>
                  <div>
                    <label for="retirement-age" class="fa-field-label mb-2">
                      Target Retirement Age *
                    </label>
                    <input 
                      type="number" 
                      id="retirement-age" 
                      name="retirementAge"
                      class="fa-input-surface w-full"
                      placeholder="65"
                      required
                    />
                  </div>
                  <div>
                    <label for="current-salary" class="fa-field-label mb-2">
                      Current Annual Salary ($) *
                    </label>
                    <input 
                      type="number" 
                      id="current-salary" 
                      name="currentSalary"
                      class="fa-input-surface w-full"
                      placeholder="65000"
                      required
                    />
                  </div>
                  <div>
                    <label for="current-retirement-balance" class="fa-field-label mb-2">
                      Current Retirement Savings ($)
                    </label>
                    <input 
                      type="number" 
                      id="current-retirement-balance" 
                      name="currentRetirementBalance"
                      class="fa-input-surface w-full"
                      placeholder="0"
                    />
                  </div>
                </div>
              </div>

              <!-- Employer Benefits Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🏢 Employer Benefits</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="employer-match" class="fa-field-label mb-2">
                      Employer 401(k) Match (%)
                    </label>
                    <input 
                      type="number" 
                      step="0.1"
                      id="employer-match" 
                      name="employerMatch"
                      class="fa-input-surface w-full"
                      placeholder="3.0"
                    />
                    <p class="fa-help-copy mt-1">Common match is 3-6%</p>
                  </div>
                  <div>
                    <label for="match-limit" class="fa-field-label mb-2">
                      Match Limit (% of salary)
                    </label>
                    <input 
                      type="number" 
                      step="0.1"
                      id="match-limit" 
                      name="matchLimit"
                      class="fa-input-surface w-full"
                      placeholder="6.0"
                    />
                    <p class="fa-help-copy mt-1">Maximum % they'll match</p>
                  </div>
                </div>
              </div>

              <!-- Retirement Goals Section -->
              <div class="fa-panel-divider pb-6">
                <h3 class="fa-scenario-title mb-4">🎯 Retirement Goals</h3>
                <div class="space-y-4">
                  <div>
                    <label class="fa-field-label mb-2">
                      What percentage of your current income do you want in retirement?
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-start">
                        <input type="radio" name="retirementIncome" value="70" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">70% of current income</span>
                          <p class="fa-help-copy">Conservative - assumes lower expenses</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="retirementIncome" value="80" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">80% of current income</span>
                          <p class="fa-help-copy">Moderate - maintains lifestyle</p>
                        </div>
                      </label>
                      <label class="flex items-start">
                        <input type="radio" name="retirementIncome" value="100" class="mt-1 mr-3">
                        <div>
                          <span class="fa-list-copy-strong">100% of current income</span>
                          <p class="fa-help-copy">Comfortable - no lifestyle change</p>
                        </div>
                      </label>
                    </div>
                  </div>
                  <div>
                    <label for="monthly-contribution" class="fa-field-label mb-2">
                      How much can you contribute monthly? ($)
                    </label>
                    <input 
                      type="number" 
                      id="monthly-contribution" 
                      name="monthlyContribution"
                      class="fa-input-surface w-full"
                      placeholder="500"
                    />
                    <p class="fa-help-copy mt-1">Start with what you can afford</p>
                  </div>
                </div>
              </div>

              <!-- Investment Strategy Section -->
              <div class="pb-6">
                <h3 class="fa-scenario-title mb-4">📈 Investment Strategy</h3>
                <div class="space-y-4">
                  <div>
                    <label for="risk-tolerance" class="fa-field-label mb-2">
                      Risk Tolerance
                    </label>
                    <select 
                      id="risk-tolerance" 
                      name="riskTolerance"
                      class="fa-input-surface w-full"
                    >
                      <option value="">Select risk level</option>
                      <option value="conservative">Conservative (Lower risk, steady growth)</option>
                      <option value="moderate">Moderate (Balanced risk and growth)</option>
                      <option value="aggressive">Aggressive (Higher risk, higher potential returns)</option>
                    </select>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2">
                      Investment Preferences
                    </label>
                    <div class="space-y-2">
                      <label class="flex items-center">
                        <input type="checkbox" name="investmentPrefs" value="target-date-fund" class="mr-2">
                        <span class="fa-list-copy">Target-date fund (set it and forget it)</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="investmentPrefs" value="index-funds" class="mr-2">
                        <span class="fa-list-copy">Low-cost index funds</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="investmentPrefs" value="roth-ira" class="mr-2">
                        <span class="fa-list-copy">Roth IRA for tax-free growth</span>
                      </label>
                      <label class="flex items-center">
                        <input type="checkbox" name="investmentPrefs" value="professional-help" class="mr-2">
                        <span class="fa-list-copy">Get professional investment advice</span>
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-4 pt-6 fa-panel-divider-top">
                <button type="submit" id="calculate-retirement-btn" class="fa-button-primary">
                  Calculate Retirement Plan
                </button>
                <button type="button" id="save-plan-btn" class="fa-button-primary">
                  Save Plan
                </button>
                <button type="button" id="reset-btn" class="fa-button-secondary">
                  Reset Form
                </button>
              </div>
            </form>

            <!-- Results Section -->
            <div id="results-section" class="hidden mt-8 rounded-lg bg-linear-to-r from-violet-50 to-emerald-50 p-6 dark:from-violet-950/25 dark:to-emerald-950/20">
              <h3 class="fa-scenario-title mb-4">📊 Your Retirement Plan</h3>
              <div id="retirement-results" class="space-y-4">
                <!-- Results will be populated by JavaScript -->
              </div>
            </div>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="fa-card p-5 mb-6">
            <h3 class="fa-scenario-title mb-4">🚀 Why Start Early?</h3>
            <div class="space-y-4 fa-list-copy">
              <div class="fa-highlight-card p-3">
                <p><strong>Compound Interest:</strong> Time is your biggest advantage.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Employer Match:</strong> Free money you shouldn't miss.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Tax Benefits:</strong> Reduce taxes while saving.</p>
              </div>
              <div class="fa-highlight-card p-3">
                <p><strong>Habit Building:</strong> Start small, increase over time.</p>
              </div>
            </div>
          </div>

          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-4">💡 Retirement Tips</h3>
            <div class="space-y-3 fa-list-copy">
              <p><strong>Start Small:</strong> Even $50/month makes a difference.</p>
              <p><strong>Increase Annually:</strong> Boost contributions with raises.</p>
              <p><strong>Diversify:</strong> Don't put all eggs in one basket.</p>
              <p><strong>Review Regularly:</strong> Adjust as life changes.</p>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script type="module" is:inline>
    import '/src/scripts/journey/retirement-start.client.ts';
  </script>
</Layout>
