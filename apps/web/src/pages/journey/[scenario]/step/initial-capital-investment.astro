---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'initial-capital-investment')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

const currentStep = currentScenario.models.find(m => m.id === 'initial-capital-investment');
const currentStepOrder = currentStep?.order || 1;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<script define:vars={{ journeyNav }} is:inline>
  // Update chatbot context for this phase with journey data
  if (typeof window !== 'undefined') {
    // Load journey state to include actual data
    const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
    const currentPhaseData = journeyState.collectedData?.['initial-capital-investment'] || {};
    
    // Build context data with journey information
    const contextData = {
      phase: 1,
      phaseName: 'Initial Capital Investment',
      description: 'Planning initial capital requirements and investment structure',
      keyFields: ['totalInvestment', 'investmentTimeline', 'founderInvestment', 'angelInvestment', 'vcInvestment', 'equityOffered', 'valuation'],
      helpTopics: [
        'How to calculate initial capital needs',
        'Understanding equity dilution',
        'Valuation considerations for early stage',
        'Investment allocation strategies'
      ],
      // Include current phase data if available
      currentPhaseData: Object.keys(currentPhaseData).length > 0 ? currentPhaseData : undefined
    };

    window.dispatchEvent(new CustomEvent('chat-panel-context', {
      detail: {
        contextKey: 'startup-planning',
        label: 'Initial Capital Investment Planning',
        data: contextData
      }
    }));
  }
</script>

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
          <JourneyStepHero
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
          />

      <!-- Initial Capital Investment Form -->
      <div class="fa-card p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="fa-panel-title">Initial Capital Investment Planning</h2>
          
          <!-- View Toggle -->
          <div class="fa-segmented-control">
            <button type="button" id="basic-view-btn" class="fa-segmented-button fa-segmented-button-active" aria-pressed="true">
              Basic
            </button>
            <button type="button" id="advanced-view-btn" class="fa-segmented-button" aria-pressed="false">
              Advanced
            </button>
          </div>
        </div>
        
        <form id="initial-capital-form" class="space-y-6">
          <!-- Investment Amount Section -->
          <div class="mb-6">
            <h3 class="fa-scenario-title text-lg mb-4">Investment Amount</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="totalInvestment" class="fa-field-label mb-2">
                  Total Investment Amount <span class="text-rose-500">*</span>
                </label>
                <input type="number" id="totalInvestment" name="totalInvestment" required
                       class="fa-input-surface w-full"
                       placeholder="1000000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Total amount of initial capital investment</p>
              </div>
              
              <div>
                <label for="investmentTimeline" class="fa-field-label mb-2">
                  Investment Timeline <span class="text-rose-500">*</span>
                </label>
                <select id="investmentTimeline" name="investmentTimeline" required
                        class="fa-input-surface w-full">
                  <option value="">Select timeline</option>
                  <option value="immediate">Immediate (0-3 months)</option>
                  <option value="short-term">Short-term (3-6 months)</option>
                  <option value="medium-term">Medium-term (6-12 months)</option>
                  <option value="long-term">Long-term (12+ months)</option>
                </select>
                <p class="fa-help-copy mt-1">When will the investment be deployed?</p>
              </div>
            </div>
          </div>

          <!-- Investment Sources Section -->
          <div class="mb-6 advanced-section">
            <h3 class="fa-scenario-title text-lg mb-4">Investment Sources</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="founderInvestment" class="fa-field-label mb-2">
                  Founder Investment
                </label>
                <input type="number" id="founderInvestment" name="founderInvestment"
                       class="fa-input-surface w-full"
                       placeholder="200000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Amount invested by founders</p>
              </div>
              
              <div>
                <label for="angelInvestment" class="fa-field-label mb-2">
                  Angel Investment
                </label>
                <input type="number" id="angelInvestment" name="angelInvestment"
                       class="fa-input-surface w-full"
                       placeholder="300000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Amount from angel investors</p>
              </div>
              
              <div>
                <label for="vcInvestment" class="fa-field-label mb-2">
                  VC Investment
                </label>
                <input type="number" id="vcInvestment" name="vcInvestment"
                       class="fa-input-surface w-full"
                       placeholder="500000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Amount from venture capital</p>
              </div>
              
              <div>
                <label for="otherInvestment" class="fa-field-label mb-2">
                  Other Sources
                </label>
                <input type="number" id="otherInvestment" name="otherInvestment"
                       class="fa-input-surface w-full"
                       placeholder="0" min="0" step="1000">
                <p class="fa-help-copy mt-1">Grants, loans, or other sources</p>
              </div>
            </div>
          </div>

          <!-- Investment Allocation Section -->
          <div class="mb-6 advanced-section">
            <h3 class="fa-scenario-title text-lg mb-4">Investment Allocation</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="productDevelopment" class="fa-field-label mb-2">
                  Product Development
                </label>
                <input type="number" id="productDevelopment" name="productDevelopment"
                       class="fa-input-surface w-full"
                       placeholder="300000" min="0" step="1000">
                <p class="fa-help-copy mt-1">R&D, engineering, design</p>
              </div>
              
              <div>
                <label for="marketingSales" class="fa-field-label mb-2">
                  Marketing & Sales
                </label>
                <input type="number" id="marketingSales" name="marketingSales"
                       class="fa-input-surface w-full"
                       placeholder="200000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Customer acquisition, branding</p>
              </div>
              
              <div>
                <label for="operations" class="fa-field-label mb-2">
                  Operations
                </label>
                <input type="number" id="operations" name="operations"
                       class="fa-input-surface w-full"
                       placeholder="250000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Infrastructure, tools, systems</p>
              </div>
              
              <div>
                <label for="workingCapital" class="fa-field-label mb-2">
                  Working Capital
                </label>
                <input type="number" id="workingCapital" name="workingCapital"
                       class="fa-input-surface w-full"
                       placeholder="250000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Cash reserves, inventory</p>
              </div>
            </div>
          </div>

          <!-- Investment Terms Section -->
          <div class="mb-6">
            <h3 class="fa-scenario-title text-lg mb-4">Investment Terms</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="equityOffered" class="fa-field-label mb-2">
                  Equity Offered (%)
                </label>
                <input type="number" id="equityOffered" name="equityOffered"
                       class="fa-input-surface w-full"
                       placeholder="20" min="0" max="100" step="0.1">
                <p class="fa-help-copy mt-1">Percentage of company equity</p>
              </div>
              
              <div>
                <label for="valuation" class="fa-field-label mb-2">
                  Company Valuation
                </label>
                <input type="number" id="valuation" name="valuation"
                       class="fa-input-surface w-full"
                       placeholder="5000000" min="0" step="1000">
                <p class="fa-help-copy mt-1">Pre-money valuation</p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-4 mt-8">
            <button type="button" id="save-capital-btn" class="fa-button-primary">
              Save Capital Investment Plan
            </button>
            <button type="button" id="reset-btn" class="fa-button-secondary">
              Reset
            </button>
          </div>
        </form>
      </div>

      <!-- Journey Navigation -->
      <div class="flex justify-between items-center">
        <div>
          {journeyNav.previousStep ? (
            <a href={journeyNav.previousStep.url} 
               class="fa-button-secondary">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Previous: {journeyNav.previousStep.name}
            </a>
          ) : (
            <a href={journeyNav.journeyOverviewUrl} 
               class="fa-button-secondary">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Back to Journey
            </a>
          )}
        </div>
        
        <div>
          {journeyNav.nextStep ? (
            <a href={journeyNav.nextStep.url} 
               class="fa-button-primary">
              Next: {journeyNav.nextStep.name}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          ) : (
            <a href={`/journey-analysis/${scenario}`} 
               class="fa-button-primary">
              Complete Journey Analysis
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
  </div>
</Layout>

<script define:vars={{ journeyNav }} is:inline>
  // Initial Capital Investment Form Handler
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('initial-capital-form');
    const saveBtn = document.getElementById('save-capital-btn');
    const resetBtn = document.getElementById('reset-btn');
    const basicViewBtn = document.getElementById('basic-view-btn');
    const advancedViewBtn = document.getElementById('advanced-view-btn');

    // Initialize view state (default to basic)
    let isAdvancedView = false;
    
    // Get saved view preference
    const savedView = localStorage.getItem('fanalyx-capital-view-preference');
    if (savedView === 'advanced') {
      isAdvancedView = true;
      updateViewStyles();
    }

    // Toggle between basic and advanced views
    if (basicViewBtn) {
      basicViewBtn.addEventListener('click', function() {
        isAdvancedView = false;
        updateViewStyles();
        localStorage.setItem('fanalyx-capital-view-preference', 'basic');
      });
    }

    if (advancedViewBtn) {
      advancedViewBtn.addEventListener('click', function() {
        isAdvancedView = true;
        updateViewStyles();
        localStorage.setItem('fanalyx-capital-view-preference', 'advanced');
      });
    }

      function updateViewStyles() {
        const advancedSections = document.querySelectorAll('.advanced-section');
        const setActiveButton = (activeButton, inactiveButton) => {
          activeButton?.classList.add('fa-segmented-button-active');
          activeButton?.setAttribute('aria-pressed', 'true');
          inactiveButton?.classList.remove('fa-segmented-button-active');
          inactiveButton?.setAttribute('aria-pressed', 'false');
        };
        
       if (isAdvancedView) {
         // Show advanced sections
         advancedSections.forEach(section => {
           section.style.display = 'block';
         });
         setActiveButton(advancedViewBtn, basicViewBtn);
       } else {
         // Hide advanced sections
         advancedSections.forEach(section => {
           section.style.display = 'none';
         });
         setActiveButton(basicViewBtn, advancedViewBtn);
       }
     }

    // Initialize view on page load
    updateViewStyles();

    // Load saved data if exists
    loadSavedData();

    function loadSavedData() {
      const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
      const capitalData = journeyState.collectedData?.['initial-capital-investment'];
      
      if (capitalData) {
        // Load investment amount data
        const totalInvestmentField = document.getElementById('totalInvestment');
        if (totalInvestmentField && capitalData.investment.total > 0) {
          totalInvestmentField.value = capitalData.investment.total;
        }
        
        const timelineField = document.getElementById('investmentTimeline');
        if (timelineField && capitalData.investment.timeline) {
          timelineField.value = capitalData.investment.timeline;
        }
        
        // Load equity and valuation
        const equityField = document.getElementById('equityOffered');
        if (equityField && capitalData.terms.equityOffered > 0) {
          equityField.value = capitalData.terms.equityOffered;
        }
        
        const valuationField = document.getElementById('valuation');
        if (valuationField && capitalData.terms.valuation > 0) {
          valuationField.value = capitalData.terms.valuation;
        }
        
        // Load advanced data if in advanced view
        if (isAdvancedView) {
          // Load investment sources
          if (capitalData.investment.founder > 0) {
            document.getElementById('founderInvestment').value = capitalData.investment.founder;
          }
          if (capitalData.investment.angel > 0) {
            document.getElementById('angelInvestment').value = capitalData.investment.angel;
          }
          if (capitalData.investment.vc > 0) {
            document.getElementById('vcInvestment').value = capitalData.investment.vc;
          }
          if (capitalData.investment.other > 0) {
            document.getElementById('otherInvestment').value = capitalData.investment.other;
          }
          
          // Load allocation data
          if (capitalData.allocation.productDevelopment > 0) {
            document.getElementById('productDevelopment').value = capitalData.allocation.productDevelopment;
          }
          if (capitalData.allocation.marketingSales > 0) {
            document.getElementById('marketingSales').value = capitalData.allocation.marketingSales;
          }
          if (capitalData.allocation.operations > 0) {
            document.getElementById('operations').value = capitalData.allocation.operations;
          }
          if (capitalData.allocation.workingCapital > 0) {
            document.getElementById('workingCapital').value = capitalData.allocation.workingCapital;
          }
        }
      }
    }

    if (saveBtn) {
      saveBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Collect form data
        const formData = new FormData(form);
        const totalInvestment = parseFloat(formData.get('totalInvestment')) || 0;
        
        // In basic view, auto-calculate allocation based on typical startup splits
        const totalMonthlyExpenses = parseFloat(formData.get('productDevelopment')) || 0 +
                                     parseFloat(formData.get('marketingSales')) || 0 +
                                     parseFloat(formData.get('operations')) || 0 +
                                     parseFloat(formData.get('workingCapital')) || 0;
        
        const hasAdvancedData = totalMonthlyExpenses > 0;
        
        const capitalData = {
          investment: {
            total: totalInvestment,
            timeline: formData.get('investmentTimeline') || '',
            founder: parseFloat(formData.get('founderInvestment')) || 0,
            angel: parseFloat(formData.get('angelInvestment')) || 0,
            vc: parseFloat(formData.get('vcInvestment')) || 0,
            other: parseFloat(formData.get('otherInvestment')) || 0
          },
          allocation: {
            productDevelopment: parseFloat(formData.get('productDevelopment')) || (hasAdvancedData ? 0 : totalInvestment * 0.35),
            marketingSales: parseFloat(formData.get('marketingSales')) || (hasAdvancedData ? 0 : totalInvestment * 0.25),
            operations: parseFloat(formData.get('operations')) || (hasAdvancedData ? 0 : totalInvestment * 0.20),
            workingCapital: parseFloat(formData.get('workingCapital')) || (hasAdvancedData ? 0 : totalInvestment * 0.20)
          },
          terms: {
            equityOffered: parseFloat(formData.get('equityOffered')) || 0,
            valuation: parseFloat(formData.get('valuation')) || 0
          },
          completedAt: new Date().toISOString()
        };

        // Store in journey state
        const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
        journeyState.collectedData = journeyState.collectedData || {};
        journeyState.collectedData['initial-capital-investment'] = capitalData;
        localStorage.setItem(`fanalyx-journey-state-${journeyNav.scenarioId}`, JSON.stringify(journeyState));

        // Show success message
        saveBtn.textContent = '✓ Saved!';
        saveBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
        saveBtn.classList.add('fa-button-success-state');
        
        setTimeout(() => {
          saveBtn.textContent = 'Save Capital Investment Plan';
          saveBtn.classList.remove('fa-button-success-state');
          saveBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
        }, 2000);

        // Dispatch completion event
        window.dispatchEvent(new CustomEvent('calculator-completed', {
          detail: {
            calculatorId: 'initial-capital-investment',
            result: capitalData,
            formData: capitalData
          }
        }));
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        form.reset();
      });
    }
  });
</script>
