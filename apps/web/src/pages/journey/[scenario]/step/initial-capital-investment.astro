---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'initial-capital-investment')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

const currentStep = currentScenario.models.find(m => m.id === 'initial-capital-investment');
const nextStep = currentScenario.models.find(m => m.order === 2);
const previousStep = null; // This is the first step

// Journey navigation data
const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: 1,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step 1 of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step 1 of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<script>
  // Update chatbot context for this phase
  if (typeof window !== 'undefined') {
    window.dispatchEvent(new CustomEvent('chat-panel-context', {
      detail: {
        contextKey: 'initial-capital-investment',
        label: 'Initial Capital Investment Planning',
        data: {
          phase: 1,
          phaseName: 'Initial Capital Investment',
          description: 'Planning initial capital requirements and investment structure',
          keyFields: ['totalInvestment', 'investmentTimeline', 'founderInvestment', 'angelInvestment', 'vcInvestment', 'equityOffered', 'valuation'],
          helpTopics: [
            'How to calculate initial capital needs',
            'Understanding equity dilution',
            'Valuation considerations for early stage',
            'Investment allocation strategies'
          ]
        }
      }
    }));
  }
</script>

<Layout title={seoTitle} description={seoDescription}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="list-none p-0 inline-flex">
          <li class="flex items-center">
            <a href="/" class="text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">Home</a>
            <svg class="fill-current w-3 h-3 mx-3 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568 0 33.941z"/></svg>
          </li>
          <li class="flex items-center">
            <a href="/journey" class="text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
            <svg class="fill-current w-3 h-3 mx-3 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568 0 33.941z"/></svg>
          </li>
          <li class="flex items-center">
            <a href={`/journey/${scenario}`} class="text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">{currentScenario.name}</a>
            <svg class="fill-current w-3 h-3 mx-3 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568 0 33.941z"/></svg>
          </li>
          <li class="text-gray-500 dark:text-gray-500" aria-current="page">{currentStep?.name}</li>
        </ol>
      </nav>

      <!-- Journey Progress -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white">{currentStep?.name}</h1>
          <div class="text-sm text-gray-600 dark:text-gray-400">
            Step {journeyNav.currentStep} of {journeyNav.totalSteps}
          </div>
        </div>
        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
          <div class="bg-blue-600 h-2 rounded-full" style={`width: ${(journeyNav.currentStep / journeyNav.totalSteps) * 100}%`}></div>
        </div>
      </div>

      <!-- Step Description -->
      <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 mb-8">
        <p class="text-lg text-blue-900 dark:text-blue-100">
          {currentStep?.description}
        </p>
      </div>

      <!-- Initial Capital Investment Form -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Initial Capital Investment Planning</h2>
          
          <!-- View Toggle -->
          <div class="flex items-center space-x-2">
            <button type="button" id="basic-view-btn" class="px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 dark:bg-blue-900/20 dark:text-blue-400 rounded-lg border border-blue-200 dark:border-blue-800">
              Basic
            </button>
            <button type="button" id="advanced-view-btn" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
              Advanced
            </button>
          </div>
        </div>
        
        <form id="initial-capital-form" class="space-y-6">
          <!-- Investment Amount Section -->
          <div class="mb-6">
            <h3 class="text-lg font-semibold mb-4">Investment Amount</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="totalInvestment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Total Investment Amount <span class="text-red-500">*</span>
                </label>
                <input type="number" id="totalInvestment" name="totalInvestment" required
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="1000000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Total amount of initial capital investment</p>
              </div>
              
              <div>
                <label for="investmentTimeline" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Investment Timeline <span class="text-red-500">*</span>
                </label>
                <select id="investmentTimeline" name="investmentTimeline" required
                        class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white">
                  <option value="">Select timeline</option>
                  <option value="immediate">Immediate (0-3 months)</option>
                  <option value="short-term">Short-term (3-6 months)</option>
                  <option value="medium-term">Medium-term (6-12 months)</option>
                  <option value="long-term">Long-term (12+ months)</option>
                </select>
                <p class="text-sm text-gray-500 mt-1">When will the investment be deployed?</p>
              </div>
            </div>
          </div>

          <!-- Investment Sources Section -->
          <div class="mb-6 advanced-section">
            <h3 class="text-lg font-semibold mb-4">Investment Sources</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="founderInvestment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Founder Investment
                </label>
                <input type="number" id="founderInvestment" name="founderInvestment"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="200000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Amount invested by founders</p>
              </div>
              
              <div>
                <label for="angelInvestment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Angel Investment
                </label>
                <input type="number" id="angelInvestment" name="angelInvestment"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="300000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Amount from angel investors</p>
              </div>
              
              <div>
                <label for="vcInvestment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  VC Investment
                </label>
                <input type="number" id="vcInvestment" name="vcInvestment"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="500000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Amount from venture capital</p>
              </div>
              
              <div>
                <label for="otherInvestment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Other Sources
                </label>
                <input type="number" id="otherInvestment" name="otherInvestment"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="0" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Grants, loans, or other sources</p>
              </div>
            </div>
          </div>

          <!-- Investment Allocation Section -->
          <div class="mb-6 advanced-section">
            <h3 class="text-lg font-semibold mb-4">Investment Allocation</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="productDevelopment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Product Development
                </label>
                <input type="number" id="productDevelopment" name="productDevelopment"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="300000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">R&D, engineering, design</p>
              </div>
              
              <div>
                <label for="marketingSales" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Marketing & Sales
                </label>
                <input type="number" id="marketingSales" name="marketingSales"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="200000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Customer acquisition, branding</p>
              </div>
              
              <div>
                <label for="operations" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Operations
                </label>
                <input type="number" id="operations" name="operations"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="250000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Infrastructure, tools, systems</p>
              </div>
              
              <div>
                <label for="workingCapital" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Working Capital
                </label>
                <input type="number" id="workingCapital" name="workingCapital"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="250000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Cash reserves, inventory</p>
              </div>
            </div>
          </div>

          <!-- Investment Terms Section -->
          <div class="mb-6">
            <h3 class="text-lg font-semibold mb-4">Investment Terms</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="equityOffered" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Equity Offered (%)
                </label>
                <input type="number" id="equityOffered" name="equityOffered"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="20" min="0" max="100" step="0.1">
                <p class="text-sm text-gray-500 mt-1">Percentage of company equity</p>
              </div>
              
              <div>
                <label for="valuation" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Company Valuation
                </label>
                <input type="number" id="valuation" name="valuation"
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white"
                       placeholder="5000000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Pre-money valuation</p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-4 mt-8">
            <button type="button" id="save-capital-btn" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
              Save Capital Investment Plan
            </button>
            <button type="button" id="reset-btn" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
              Reset
            </button>
          </div>
        </form>
      </div>

      <!-- Journey Navigation -->
      <div class="flex justify-between items-center">
        <div>
          {journeyNav.previousStep ? (
            <a href={journeyNav.previousStep.url} 
               class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Previous: {journeyNav.previousStep.name}
            </a>
          ) : (
            <a href={journeyNav.journeyOverviewUrl} 
               class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Back to Journey
            </a>
          )}
        </div>
        
        <div>
          {journeyNav.nextStep ? (
            <a href={journeyNav.nextStep.url} 
               class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors duration-200">
              Next: {journeyNav.nextStep.name}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          ) : (
            <a href={`/journey-analysis/${scenario}`} 
               class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg transition-colors duration-200">
              Complete Journey Analysis
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ journeyNav }}>
  // Initial Capital Investment Form Handler
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('initial-capital-form');
    const saveBtn = document.getElementById('save-capital-btn');
    const resetBtn = document.getElementById('reset-btn');
    const basicViewBtn = document.getElementById('basic-view-btn');
    const advancedViewBtn = document.getElementById('advanced-view-btn');

    // Initialize view state (default to basic)
    let isAdvancedView = false;
    
    // Get saved view preference
    const savedView = localStorage.getItem('fanalyx-capital-view-preference');
    if (savedView === 'advanced') {
      isAdvancedView = true;
      updateViewStyles();
    }

    // Toggle between basic and advanced views
    if (basicViewBtn) {
      basicViewBtn.addEventListener('click', function() {
        isAdvancedView = false;
        updateViewStyles();
        localStorage.setItem('fanalyx-capital-view-preference', 'basic');
      });
    }

    if (advancedViewBtn) {
      advancedViewBtn.addEventListener('click', function() {
        isAdvancedView = true;
        updateViewStyles();
        localStorage.setItem('fanalyx-capital-view-preference', 'advanced');
      });
    }

    function updateViewStyles() {
      const advancedSections = document.querySelectorAll('.advanced-section');
      
      if (isAdvancedView) {
        // Show advanced sections
        advancedSections.forEach(section => {
          section.style.display = 'block';
        });
        
        // Update button styles
        if (basicViewBtn) {
          basicViewBtn.classList.remove('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20', 'dark:text-blue-400', 'border', 'border-blue-200', 'dark:border-blue-800');
          basicViewBtn.classList.add('text-gray-600', 'hover:text-gray-900', 'dark:text-gray-400', 'dark:hover:text-gray-100', 'hover:bg-gray-100', 'dark:hover:bg-gray-700');
        }
        
        if (advancedViewBtn) {
          advancedViewBtn.classList.remove('text-gray-600', 'hover:text-gray-900', 'dark:text-gray-400', 'dark:hover:text-gray-100', 'hover:bg-gray-100', 'dark:hover:bg-gray-700');
          advancedViewBtn.classList.add('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20', 'dark:text-blue-400', 'border', 'border-blue-200', 'dark:border-blue-800');
        }
      } else {
        // Hide advanced sections
        advancedSections.forEach(section => {
          section.style.display = 'none';
        });
        
        // Update button styles
        if (advancedViewBtn) {
          advancedViewBtn.classList.remove('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20', 'dark:text-blue-400', 'border', 'border-blue-200', 'dark:border-blue-800');
          advancedViewBtn.classList.add('text-gray-600', 'hover:text-gray-900', 'dark:text-gray-400', 'dark:hover:text-gray-100', 'hover:bg-gray-100', 'dark:hover:bg-gray-700');
        }
        
        if (basicViewBtn) {
          basicViewBtn.classList.remove('text-gray-600', 'hover:text-gray-900', 'dark:text-gray-400', 'dark:hover:text-gray-100', 'hover:bg-gray-100', 'dark:hover:bg-gray-700');
          basicViewBtn.classList.add('text-blue-600', 'bg-blue-50', 'dark:bg-blue-900/20', 'dark:text-blue-400', 'border', 'border-blue-200', 'dark:border-blue-800');
        }
      }
    }

    // Initialize view on page load
    updateViewStyles();

    // Load saved data if exists
    loadSavedData();

    function loadSavedData() {
      const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
      const capitalData = journeyState.collectedData?.['initial-capital-investment'];
      
      if (capitalData) {
        // Load investment amount data
        const totalInvestmentField = document.getElementById('totalInvestment');
        if (totalInvestmentField && capitalData.investment.total > 0) {
          totalInvestmentField.value = capitalData.investment.total;
        }
        
        const timelineField = document.getElementById('investmentTimeline');
        if (timelineField && capitalData.investment.timeline) {
          timelineField.value = capitalData.investment.timeline;
        }
        
        // Load equity and valuation
        const equityField = document.getElementById('equityOffered');
        if (equityField && capitalData.terms.equityOffered > 0) {
          equityField.value = capitalData.terms.equityOffered;
        }
        
        const valuationField = document.getElementById('valuation');
        if (valuationField && capitalData.terms.valuation > 0) {
          valuationField.value = capitalData.terms.valuation;
        }
        
        // Load advanced data if in advanced view
        if (isAdvancedView) {
          // Load investment sources
          if (capitalData.investment.founder > 0) {
            document.getElementById('founderInvestment').value = capitalData.investment.founder;
          }
          if (capitalData.investment.angel > 0) {
            document.getElementById('angelInvestment').value = capitalData.investment.angel;
          }
          if (capitalData.investment.vc > 0) {
            document.getElementById('vcInvestment').value = capitalData.investment.vc;
          }
          if (capitalData.investment.other > 0) {
            document.getElementById('otherInvestment').value = capitalData.investment.other;
          }
          
          // Load allocation data
          if (capitalData.allocation.productDevelopment > 0) {
            document.getElementById('productDevelopment').value = capitalData.allocation.productDevelopment;
          }
          if (capitalData.allocation.marketingSales > 0) {
            document.getElementById('marketingSales').value = capitalData.allocation.marketingSales;
          }
          if (capitalData.allocation.operations > 0) {
            document.getElementById('operations').value = capitalData.allocation.operations;
          }
          if (capitalData.allocation.workingCapital > 0) {
            document.getElementById('workingCapital').value = capitalData.allocation.workingCapital;
          }
        }
      }
    }

    if (saveBtn) {
      saveBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Collect form data
        const formData = new FormData(form);
        const totalInvestment = parseFloat(formData.get('totalInvestment')) || 0;
        
        // In basic view, auto-calculate allocation based on typical startup splits
        const totalMonthlyExpenses = parseFloat(formData.get('productDevelopment')) || 0 +
                                     parseFloat(formData.get('marketingSales')) || 0 +
                                     parseFloat(formData.get('operations')) || 0 +
                                     parseFloat(formData.get('workingCapital')) || 0;
        
        const hasAdvancedData = totalMonthlyExpenses > 0;
        
        const capitalData = {
          investment: {
            total: totalInvestment,
            timeline: formData.get('investmentTimeline') || '',
            founder: parseFloat(formData.get('founderInvestment')) || 0,
            angel: parseFloat(formData.get('angelInvestment')) || 0,
            vc: parseFloat(formData.get('vcInvestment')) || 0,
            other: parseFloat(formData.get('otherInvestment')) || 0
          },
          allocation: {
            productDevelopment: parseFloat(formData.get('productDevelopment')) || (hasAdvancedData ? 0 : totalInvestment * 0.35),
            marketingSales: parseFloat(formData.get('marketingSales')) || (hasAdvancedData ? 0 : totalInvestment * 0.25),
            operations: parseFloat(formData.get('operations')) || (hasAdvancedData ? 0 : totalInvestment * 0.20),
            workingCapital: parseFloat(formData.get('workingCapital')) || (hasAdvancedData ? 0 : totalInvestment * 0.20)
          },
          terms: {
            equityOffered: parseFloat(formData.get('equityOffered')) || 0,
            valuation: parseFloat(formData.get('valuation')) || 0
          },
          completedAt: new Date().toISOString()
        };

        // Store in journey state
        const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
        journeyState.collectedData = journeyState.collectedData || {};
        journeyState.collectedData['initial-capital-investment'] = capitalData;
        localStorage.setItem(`fanalyx-journey-state-${journeyNav.scenarioId}`, JSON.stringify(journeyState));

        // Show success message
        saveBtn.textContent = '✓ Saved!';
        saveBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
        saveBtn.classList.add('bg-green-500');
        
        setTimeout(() => {
          saveBtn.textContent = 'Save Capital Investment Plan';
          saveBtn.classList.remove('bg-green-500');
          saveBtn.classList.add('bg-green-600', 'hover:bg-green-700');
        }, 2000);

        // Dispatch completion event
        window.dispatchEvent(new CustomEvent('calculator-completed', {
          detail: {
            calculatorId: 'initial-capital-investment',
            result: capitalData,
            formData: capitalData
          }
        }));
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        form.reset();
      });
    }
  });
</script>
