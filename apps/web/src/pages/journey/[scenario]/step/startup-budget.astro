---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';

export async function getStaticPaths() {
  const journeyData = getJourneyData();
  const paths: Array<{ params: { scenario: string } }> = [];

  // Generate paths for all scenarios that have this step
  Object.keys(journeyData).forEach(scenarioId => {
    const scenario = journeyData[scenarioId];
    if (scenario.models.some(model => model.id === 'startup-budget')) {
      paths.push({ params: { scenario: scenarioId } });
    }
  });

  return paths;
}

const { scenario } = Astro.params;
const journeyData = getJourneyData();
const currentScenario = journeyData[scenario!];

if (!currentScenario) {
  throw new Error(`Journey not found: ${scenario}`);
}

// Journey navigation data
const currentStep = currentScenario.models.find(m => m.id === 'startup-budget');
const currentStepOrder = currentStep?.order || 2;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: scenario!,
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep ? {
    id: nextStep.id,
    name: nextStep.name,
    url: `/journey/${scenario}/step/${nextStep.id}`
  } : null,
  previousStep: previousStep ? {
    id: previousStep.id,
    name: previousStep.name,
    url: `/journey/${scenario}/step/${previousStep.id}`
  } : null,
  journeyOverviewUrl: `/journey/${scenario}`
};

// SEO-optimized content
const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<script define:vars={{ journeyNav }} is:inline>
  // Update chatbot context for this phase with journey data
  if (typeof window !== 'undefined') {
    // Load journey state to include actual data
    const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
    const currentPhaseData = journeyState.collectedData?.['startup-budget'] || {};
    const previousPhaseData = journeyState.collectedData?.['initial-capital-investment'] || {};
    
    // Build context data with journey information
    const contextData = {
      phase: 2,
      phaseName: 'Startup Budget Planning',
      description: 'Creating startup budget and cash flow projections',
      keyFields: ['monthlyRevenue', 'growthRate', 'salaries', 'officeRent', 'marketing', 'initialFunding', 'runwayMonths'],
      helpTopics: [
        'Revenue projection best practices',
        'Burn rate calculations',
        'Runway planning',
        'Budget allocation strategies'
      ],
      // Include current phase data if available
      currentPhaseData: Object.keys(currentPhaseData).length > 0 ? currentPhaseData : undefined,
      // Include previous phase data for reference
      previousPhases: previousPhaseData ? {
        phase1: {
          totalInvestment: previousPhaseData.investment?.total,
          equityOffered: previousPhaseData.terms?.equityOffered,
          valuation: previousPhaseData.terms?.valuation,
          allocation: previousPhaseData.allocation
        }
      } : undefined
    };

    window.dispatchEvent(new CustomEvent('chat-panel-context', {
      detail: {
        contextKey: 'startup-planning',
        label: 'Startup Budget Planning',
        data: contextData
      }
    }));
  }
</script>

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <main class="fa-page-shell">
<!-- Header -->
      <div class="mb-8">
        <div class="flex items-center mb-4">
          <span class="text-4xl mr-3">🚀</span>
          <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Startup Budget Planning</h1>
            <p class="text-lg text-gray-600 dark:text-gray-400">Step 2 of {currentScenario.models.length} - {currentScenario.name}</p>
          </div>
        </div>
        <p class="text-gray-700 dark:text-gray-300 max-w-3xl">
          Create a comprehensive budget and cash flow projections for your startup. This foundation will help you understand your financial needs and plan for sustainable growth.
        </p>
      </div>

      <!-- Progress Bar -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Progress</span>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">2 of {currentScenario.models.length}</span>
        </div>
        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
          <div class="bg-blue-600 h-2 rounded-full" style="width: 50%"></div>
        </div>
      </div>

      <!-- Capital Investment Integration -->
      <div id="capital-integration" class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 mb-8 hidden">
        <h3 class="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-4">💰 Capital Investment Integration</h3>
        <p class="text-sm text-blue-800 dark:text-blue-200 mb-4">
          💡 Your data from <strong>Phase 1: Initial Capital Investment</strong> is automatically integrated below to enhance your budget projections.
        </p>
        
        <!-- Key Metrics -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Total Investment</h4>
            <p id="total-investment-display" class="text-2xl font-bold text-blue-600 dark:text-blue-400">--</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Equity Offered</h4>
            <p id="equity-offered-display" class="text-2xl font-bold text-green-600 dark:text-green-400">--</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Company Valuation</h4>
            <p id="company-valuation-display" class="text-2xl font-bold text-purple-600 dark:text-purple-400">--</p>
          </div>
        </div>

        <!-- Investment Allocation Breakdown -->
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4">
          <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Investment Allocation Breakdown</h4>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Product Development</p>
              <p id="allocation-product" class="text-lg font-semibold text-gray-900 dark:text-white">--</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Marketing & Sales</p>
              <p id="allocation-marketing" class="text-lg font-semibold text-gray-900 dark:text-white">--</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Operations</p>
              <p id="allocation-operations" class="text-lg font-semibold text-gray-900 dark:text-white">--</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Working Capital</p>
              <p id="allocation-working" class="text-lg font-semibold text-gray-900 dark:text-white">--</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
        <form id="startup-budget-form" class="space-y-6">
          <div class="mb-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Revenue Projections</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="monthlyRevenue" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Expected Monthly Revenue <span class="text-red-500">*</span>
                </label>
                <input type="number" id="monthlyRevenue" name="monthlyRevenue" required
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="50000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Your projected monthly revenue in USD</p>
              </div>
              
              <div>
                <label for="growthRate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Monthly Growth Rate <span class="text-red-500">*</span>
                </label>
                <input type="number" id="growthRate" name="growthRate" required
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="10" min="0" max="100" step="1">
                <p class="text-sm text-gray-500 mt-1">Expected monthly growth percentage</p>
              </div>
            </div>
          </div>

          <!-- Operating Expenses -->
          <div class="mb-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Operating Expenses</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="salaries" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Monthly Salaries <span class="text-red-500">*</span>
                </label>
                <input type="number" id="salaries" name="salaries" required
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="25000" min="0" step="1000">
                <p class="text-sm text-gray-500 mt-1">Total monthly salary expenses</p>
              </div>
              
              <div>
                <label for="officeRent" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Office Rent & Utilities
                </label>
                <input type="number" id="officeRent" name="officeRent"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="5000" min="0" step="100">
                <p class="text-sm text-gray-500 mt-1">Monthly office and utility costs</p>
              </div>
              
              <div>
                <label for="marketing" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Marketing & Advertising
                </label>
                <input type="number" id="marketing" name="marketing"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="5000" min="0" step="100">
                <p class="text-sm text-gray-500 mt-1">Monthly marketing spend</p>
              </div>
              
              <div>
                <label for="otherExpenses" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Other Operating Expenses
                </label>
                <input type="number" id="otherExpenses" name="otherExpenses"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="3000" min="0" step="100">
                <p class="text-sm text-gray-500 mt-1">Other monthly operating costs</p>
              </div>
            </div>
          </div>

          <!-- Funding Information -->
          <div class="mb-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Funding Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="initialFunding" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Initial Funding Raised
                </label>
                <input type="number" id="initialFunding" name="initialFunding"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="500000" min="0" step="10000">
                <p class="text-sm text-gray-500 mt-1">Total funding raised to date</p>
              </div>
              
              <div>
                <label for="runwayMonths" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Desired Runway (Months)
                </label>
                <input type="number" id="runwayMonths" name="runwayMonths"
                       class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                       placeholder="18" min="1" max="60" step="1">
                <p class="text-sm text-gray-500 mt-1">How many months of runway you want</p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-4 mt-8">
            <button type="button" id="save-budget-btn" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
              Save Budget Plan
            </button>
            <button type="button" id="projection-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
              📊 Generate Projections
            </button>
            <button type="button" id="reset-btn" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200">
              Reset
            </button>
          </div>
        </form>
      </div>

      <!-- Revenue Projections Results -->
      <div id="projections-results" class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8 hidden">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Revenue Projections</h3>
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-2">
              <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Format:</label>
              <select id="format-toggle" class="px-3 py-1 border border-gray-300 dark:border-gray-600 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white">
                <option value="ebitda">EBITDA Format</option>
                <option value="pnl">P&L Format</option>
              </select>
            </div>
            <div class="flex items-center space-x-2">
              <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Timeline:</label>
              <select id="timeline-toggle" class="px-3 py-1 border border-gray-300 dark:border-gray-600 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white">
                <option value="1year">1 Year (Monthly)</option>
                <option value="5year">5 Years (Annual)</option>
                <option value="10year">10 Years (Annual)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Projections Table -->
        <div class="overflow-x-auto">
          <table id="projections-table" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Period</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Revenue</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Expenses</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">EBITDA</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Net Income</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Cumulative Cash</th>
              </tr>
            </thead>
            <tbody id="projections-tbody" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
              <!-- Projections will be populated here -->
            </tbody>
          </table>
        </div>

        <!-- Projection Charts -->
        <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Revenue Growth</h4>
            <canvas id="revenue-chart" width="400" height="200"></canvas>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
            <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Cash Flow</h4>
            <canvas id="cashflow-chart" width="400" height="200"></canvas>
          </div>
        </div>

        <!-- Key Metrics -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4">
            <h5 class="text-sm font-medium text-blue-900 dark:text-blue-100">Runway</h5>
            <p id="runway-metric" class="text-2xl font-bold text-blue-600 dark:text-blue-400">--</p>
          </div>
          <div class="bg-green-50 dark:bg-green-900/20 rounded-lg p-4">
            <h5 class="text-sm font-medium text-green-900 dark:text-green-100">Break-even Month</h5>
            <p id="breakeven-metric" class="text-2xl font-bold text-green-600 dark:text-green-400">--</p>
          </div>
          <div class="bg-purple-50 dark:bg-purple-900/20 rounded-lg p-4">
            <h5 class="text-sm font-medium text-purple-900 dark:text-purple-100">Peak Monthly Burn</h5>
            <p id="peak-burn-metric" class="text-2xl font-bold text-purple-600 dark:text-purple-400">--</p>
          </div>
          <div class="bg-orange-50 dark:bg-orange-900/20 rounded-lg p-4">
            <h5 class="text-sm font-medium text-orange-900 dark:text-orange-100">Year 1 Revenue</h5>
            <p id="year1-revenue-metric" class="text-2xl font-bold text-orange-600 dark:text-orange-400">--</p>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex justify-between items-center">
        {journeyNav.previousStep ? (
          <a href={journeyNav.previousStep.url} class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Previous: {journeyNav.previousStep.name}
          </a>
        ) : (
          <a href={`/journey/${scenario}`} class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Journey
          </a>
        )}
        
        {journeyNav.nextStep && (
          <a href={journeyNav.nextStep.url} class="inline-flex items-center px-6 py-3 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">
            Next: {journeyNav.nextStep.name}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        )}
      </div>
  </main>
</Layout>

<script define:vars={{ journeyNav }} is:inline>
  // Startup Budget Form Handler
  document.addEventListener('DOMContentLoaded', function() {
    // Load and integrate capital investment data
    loadCapitalInvestmentData();
    
    const form = document.getElementById('startup-budget-form');
    const saveBtn = document.getElementById('save-budget-btn');
    const projectionBtn = document.getElementById('projection-btn');
    const resetBtn = document.getElementById('reset-btn');
    const projectionsResults = document.getElementById('projections-results');
    const formatToggle = document.getElementById('format-toggle');
    const timelineToggle = document.getElementById('timeline-toggle');

    // Load capital investment data from previous step
    function loadCapitalInvestmentData() {
      const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
      const capitalData = journeyState.collectedData?.['initial-capital-investment'];
      
      if (capitalData) {
        // Show capital integration section
        const capitalIntegration = document.getElementById('capital-integration');
        capitalIntegration.classList.remove('hidden');
        
        // Update display values
        document.getElementById('total-investment-display').textContent = formatCurrency(capitalData.investment.total);
        document.getElementById('equity-offered-display').textContent = capitalData.terms.equityOffered + '%';
        document.getElementById('company-valuation-display').textContent = formatCurrency(capitalData.terms.valuation);
        
        // Update allocation breakdown
        document.getElementById('allocation-product').textContent = formatCurrency(capitalData.allocation.productDevelopment);
        document.getElementById('allocation-marketing').textContent = formatCurrency(capitalData.allocation.marketingSales);
        document.getElementById('allocation-operations').textContent = formatCurrency(capitalData.allocation.operations);
        document.getElementById('allocation-working').textContent = formatCurrency(capitalData.allocation.workingCapital);
        
        // Pre-fill form with capital investment data
        const initialFundingField = document.getElementById('initialFunding');
        if (initialFundingField && capitalData.investment.total > 0) {
          initialFundingField.value = capitalData.investment.total;
        }
        
        // Calculate runway based on investment allocation
        const workingCapital = capitalData.allocation.workingCapital || 0;
        const totalMonthlyExpenses = (capitalData.allocation.productDevelopment || 0) + 
                                   (capitalData.allocation.marketingSales || 0) + 
                                   (capitalData.allocation.operations || 0);
        
        if (totalMonthlyExpenses > 0) {
          const runwayMonths = Math.floor(workingCapital / (totalMonthlyExpenses / 12));
          const runwayField = document.getElementById('runwayMonths');
          if (runwayField && runwayMonths > 0) {
            runwayField.value = runwayMonths;
          }
        }
      }
    }

    // Revenue projection calculation
    function calculateProjections(formData) {
      const monthlyRevenue = parseFloat(formData.get('monthlyRevenue')) || 0;
      const growthRate = parseFloat(formData.get('growthRate')) || 0;
      const salaries = parseFloat(formData.get('salaries')) || 0;
      const officeRent = parseFloat(formData.get('officeRent')) || 0;
      const marketing = parseFloat(formData.get('marketing')) || 0;
      const otherExpenses = parseFloat(formData.get('otherExpenses')) || 0;
      const initialFunding = parseFloat(formData.get('initialFunding')) || 0;

      const totalMonthlyExpenses = salaries + officeRent + marketing + otherExpenses;
      const projections = [];
      let cumulativeCash = initialFunding;
      let peakBurn = 0;
      let breakevenMonth = null;

      // Calculate projections for different timelines
      const timelines = {
        '1year': 12,
        '5year': 5,
        '10year': 10
      };

      const currentTimeline = timelineToggle.value;
      const months = timelines[currentTimeline] * (currentTimeline === '1year' ? 1 : 12);

      for (let month = 1; month <= months; month++) {
        // Calculate revenue with growth
        const currentRevenue = monthlyRevenue * Math.pow(1 + growthRate / 100, month - 1);
        
        // Calculate expenses (assuming they grow at a slower rate)
        const expenseGrowthRate = Math.min(growthRate * 0.3, 5); // Cap at 5% monthly
        const currentExpenses = totalMonthlyExpenses * Math.pow(1 + expenseGrowthRate / 100, month - 1);
        
        // Calculate EBITDA (simplified - no depreciation/amortization)
        const ebitda = currentRevenue - currentExpenses;
        
        // Calculate Net Income (assuming 25% tax rate on positive income)
        const taxableIncome = Math.max(0, ebitda);
        const taxes = taxableIncome * 0.25;
        const netIncome = ebitda - taxes;
        
        // Update cumulative cash
        cumulativeCash += netIncome;
        
        // Track metrics
        const monthlyBurn = currentExpenses - currentRevenue;
        if (monthlyBurn > peakBurn) {
          peakBurn = monthlyBurn;
        }
        
        if (breakevenMonth === null && ebitda > 0) {
          breakevenMonth = month;
        }

        projections.push({
          period: currentTimeline === '1year' ? `Month ${month}` : `Year ${Math.ceil(month / 12)}`,
          revenue: currentRevenue,
          expenses: currentExpenses,
          ebitda: ebitda,
          netIncome: netIncome,
          cumulativeCash: cumulativeCash,
          month: month
        });
      }

      return {
        projections,
        metrics: {
          runway: Math.max(0, Math.floor(cumulativeCash / (totalMonthlyExpenses - monthlyRevenue))),
          breakevenMonth,
          peakBurn,
          year1Revenue: monthlyRevenue * 12
        }
      };
    }

    // Format currency
    function formatCurrency(amount) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      }).format(amount);
    }

    // Update projections table
    function updateProjectionsTable(projections, format) {
      const tbody = document.getElementById('projections-tbody');
      tbody.innerHTML = '';

      projections.forEach(projection => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-gray-50 dark:hover:bg-gray-700';
        
        if (format === 'ebitda') {
          row.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">${projection.period}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">${formatCurrency(projection.revenue)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">${formatCurrency(projection.expenses)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm ${projection.ebitda >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}">${formatCurrency(projection.ebitda)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm ${projection.netIncome >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}">${formatCurrency(projection.netIncome)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">${formatCurrency(projection.cumulativeCash)}</td>
          `;
        } else {
          // P&L format - show more detailed breakdown
          const grossMargin = projection.revenue - (projection.expenses * 0.6); // Assume 60% COGS
          const operatingIncome = grossMargin - (projection.expenses * 0.4); // 40% operating expenses
          row.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">${projection.period}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">${formatCurrency(projection.revenue)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">${formatCurrency(projection.expenses)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm ${grossMargin >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}">${formatCurrency(grossMargin)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm ${operatingIncome >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}">${formatCurrency(operatingIncome)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-white">${formatCurrency(projection.cumulativeCash)}</td>
          `;
        }
        
        tbody.appendChild(row);
      });
    }

    // Update metrics
    function updateMetrics(metrics) {
      document.getElementById('runway-metric').textContent = `${metrics.runway} months`;
      document.getElementById('breakeven-metric').textContent = metrics.breakevenMonth ? `Month ${metrics.breakevenMonth}` : 'Not reached';
      document.getElementById('peak-burn-metric').textContent = formatCurrency(metrics.peakBurn);
      document.getElementById('year1-revenue-metric').textContent = formatCurrency(metrics.year1Revenue);
    }

    // Simple chart rendering (using basic canvas)
    function renderCharts(projections) {
      const revenueCanvas = document.getElementById('revenue-chart');
      const cashflowCanvas = document.getElementById('cashflow-chart');
      
      if (!revenueCanvas || !cashflowCanvas) return;

      // Simple line chart for revenue
      const revenueCtx = revenueCanvas.getContext('2d');
      revenueCtx.clearRect(0, 0, revenueCanvas.width, revenueCanvas.height);
      
      const maxRevenue = Math.max(...projections.map(p => p.revenue));
      const stepX = revenueCanvas.width / projections.length;
      
      revenueCtx.strokeStyle = '#3B82F6';
      revenueCtx.lineWidth = 2;
      revenueCtx.beginPath();
      
      projections.forEach((projection, index) => {
        const x = index * stepX;
        const y = revenueCanvas.height - (projection.revenue / maxRevenue) * revenueCanvas.height;
        
        if (index === 0) {
          revenueCtx.moveTo(x, y);
        } else {
          revenueCtx.lineTo(x, y);
        }
      });
      
      revenueCtx.stroke();

      // Simple line chart for cash flow
      const cashflowCtx = cashflowCanvas.getContext('2d');
      cashflowCtx.clearRect(0, 0, cashflowCanvas.width, cashflowCanvas.height);
      
      const maxCash = Math.max(...projections.map(p => Math.abs(p.cumulativeCash)));
      const stepX2 = cashflowCanvas.width / projections.length;
      
      cashflowCtx.strokeStyle = '#10B981';
      cashflowCtx.lineWidth = 2;
      cashflowCtx.beginPath();
      
      projections.forEach((projection, index) => {
        const x = index * stepX2;
        const y = cashflowCanvas.height - ((projection.cumulativeCash + maxCash) / (2 * maxCash)) * cashflowCanvas.height;
        
        if (index === 0) {
          cashflowCtx.moveTo(x, y);
        } else {
          cashflowCtx.lineTo(x, y);
        }
      });
      
      cashflowCtx.stroke();
    }

    // Generate projections
    function generateProjections() {
      const formData = new FormData(form);
      const result = calculateProjections(formData);
      
      updateProjectionsTable(result.projections, formatToggle.value);
      updateMetrics(result.metrics);
      renderCharts(result.projections);
      
      projectionsResults.classList.remove('hidden');
      projectionsResults.scrollIntoView({ behavior: 'smooth' });
    }

    // Event listeners
    if (projectionBtn) {
      projectionBtn.addEventListener('click', function(e) {
        e.preventDefault();
        generateProjections();
      });
    }

    if (formatToggle) {
      formatToggle.addEventListener('change', function() {
        const formData = new FormData(form);
        const result = calculateProjections(formData);
        updateProjectionsTable(result.projections, formatToggle.value);
      });
    }

    if (timelineToggle) {
      timelineToggle.addEventListener('change', function() {
        const formData = new FormData(form);
        const result = calculateProjections(formData);
        updateProjectionsTable(result.projections, formatToggle.value);
        updateMetrics(result.metrics);
        renderCharts(result.projections);
      });
    }

    if (saveBtn) {
      saveBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Collect form data
        const formData = new FormData(form);
        const budgetData = {
          revenue: {
            monthly: formData.get('monthlyRevenue'),
            growthRate: formData.get('growthRate')
          },
          expenses: {
            salaries: formData.get('salaries'),
            officeRent: formData.get('officeRent'),
            marketing: formData.get('marketing'),
            other: formData.get('otherExpenses')
          },
          funding: {
            initial: formData.get('initialFunding'),
            runwayMonths: formData.get('runwayMonths')
          },
          completedAt: new Date().toISOString()
        };

        // Store in journey state
        const journeyState = JSON.parse(localStorage.getItem(`fanalyx-journey-state-${journeyNav.scenarioId}`) || '{}');
        journeyState.collectedData = journeyState.collectedData || {};
        journeyState.collectedData['startup-budget'] = budgetData;
        localStorage.setItem(`fanalyx-journey-state-${journeyNav.scenarioId}`, JSON.stringify(journeyState));

        // Show success message
        saveBtn.textContent = '✓ Saved!';
        saveBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
        saveBtn.classList.add('bg-green-500');
        
        setTimeout(() => {
          saveBtn.textContent = 'Save Budget Plan';
          saveBtn.classList.remove('bg-green-500');
          saveBtn.classList.add('bg-green-600', 'hover:bg-green-700');
        }, 2000);

        // Dispatch completion event
        window.dispatchEvent(new CustomEvent('calculator-completed', {
          detail: {
            calculatorId: 'startup-budget',
            result: budgetData,
            formData: budgetData
          }
        }));
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        form.reset();
        projectionsResults.classList.add('hidden');
      });
    }
  });
</script>
