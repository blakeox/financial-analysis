---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import { buildJourneyNavFromOrder } from '../../../../utils/journeyNavigation';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['auto-lease-decision'];

if (!currentScenario) {
  throw new Error('Journey not found: auto-lease-decision');
}

const currentStep = currentScenario.models.find(m => m.id === 'replacement-options');
const currentStepOrder = currentStep?.order || 3;
const { journeyNav } = buildJourneyNavFromOrder({
  currentScenario,
  scenarioId: 'auto-lease-decision',
  currentStepOrder,
});

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="fa-workflow-grid">
        <!-- Main Content -->
        <div class="space-y-6">
          <JourneyStepHero
            icon="⚖️"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
            supportingText={`Compare a new lease against financing a new car or buying one with cash. Enter each path once, avoid repeating the same numbers across steps, and mark the cash route as “not an option” if savings are short.`}
          />

          <!-- Comparison Form -->
          <div class="fa-card p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="fa-panel-title">Scenario inputs</h2>
              <span id="replacement-status" class="fa-meta-copy !mt-0"></span>
            </div>
            <form id="replacement-form" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="fa-field-label mb-2" for="horizonMonths">Comparison horizon (months)</label>
                  <input id="horizonMonths" name="horizonMonths" type="number" min="12" step="1" class="fa-input-surface w-full" placeholder="36" />
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="annualMiles">Annual miles</label>
                  <input id="annualMiles" name="annualMiles" type="number" min="5000" step="500" class="fa-input-surface w-full" placeholder="12000" />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="fa-subcard">
                  <h3 class="fa-scenario-title mb-2">New Lease Terms</h3>
                  <label class="fa-field-label mb-1" for="leaseMonthly">Monthly payment ($)</label>
                  <input id="leaseMonthly" name="leaseMonthly" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="430" />
                  <label class="fa-field-label mt-3 mb-1" for="leaseDownPayment">Down payment / drive-off ($)</label>
                  <input id="leaseDownPayment" name="leaseDownPayment" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="2500" />
                  <label class="fa-field-label mt-3 mb-1" for="leaseFees">Disposition/fees ($)</label>
                  <input id="leaseFees" name="leaseFees" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="495" />
                  <label class="fa-field-label mt-3 mb-1" for="leaseInsurance">Insurance ($/mo)</label>
                  <input id="leaseInsurance" name="leaseInsurance" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="150" />
                  <label class="fa-field-label mt-3 mb-1" for="leaseMaintenance">Maintenance ($/mo)</label>
                  <input id="leaseMaintenance" name="leaseMaintenance" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="60" />
                  <label class="fa-field-label mt-3 mb-1" for="leaseFuel">Fuel/charging ($/mo)</label>
                  <input id="leaseFuel" name="leaseFuel" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="180" />
                </div>

                <div class="fa-subcard">
                  <h3 class="fa-scenario-title mb-2">Finance a New Car</h3>
                  <label class="fa-field-label mb-1" for="financePrice">Vehicle price ($)</label>
                  <input id="financePrice" name="financePrice" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="35000" />
                  <label class="fa-field-label mt-3 mb-1" for="financeDownPayment">Down payment ($)</label>
                  <input id="financeDownPayment" name="financeDownPayment" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="5000" />
                  <label class="fa-field-label mt-3 mb-1" for="financeApr">APR (%)</label>
                  <input id="financeApr" name="financeApr" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="5.9" />
                  <label class="fa-field-label mt-3 mb-1" for="financeTermMonths">Loan term (months)</label>
                  <input id="financeTermMonths" name="financeTermMonths" type="number" min="1" step="1" class="fa-input-surface w-full" placeholder="60" />
                  <label class="fa-field-label mt-3 mb-1" for="financeResaleValue">Resale value at horizon ($)</label>
                  <input id="financeResaleValue" name="financeResaleValue" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="22000" />
                  <label class="fa-field-label mt-3 mb-1" for="financeInsurance">Insurance ($/mo)</label>
                  <input id="financeInsurance" name="financeInsurance" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="165" />
                  <label class="fa-field-label mt-3 mb-1" for="financeMaintenance">Maintenance ($/mo)</label>
                  <input id="financeMaintenance" name="financeMaintenance" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="95" />
                  <label class="fa-field-label mt-3 mb-1" for="financeFuel">Fuel/charging ($/mo)</label>
                  <input id="financeFuel" name="financeFuel" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="180" />
                </div>

                <div class="fa-subcard">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="fa-scenario-title">Buy with Cash (New Car)</h3>
                    <label class="fa-field-label !font-normal !text-xs flex items-center space-x-2">
                      <input id="cashNotOption" name="cashNotOption" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500 dark:border-slate-700 dark:bg-slate-950/40" />
                      <span>Not an option</span>
                    </label>
                  </div>
                  <p class="fa-help-copy mb-3 !mt-0">Skip this if you do not have enough cash on hand.</p>
                  <label class="fa-field-label mb-1" for="cashPrice">Purchase price (cash outlay)</label>
                  <input id="cashPrice" name="cashPrice" type="number" min="0" step="0.01" class="cash-input fa-input-surface w-full" placeholder="28000" />
                  <label class="fa-field-label mt-3 mb-1" for="cashTaxesFees">Taxes & fees ($)</label>
                  <input id="cashTaxesFees" name="cashTaxesFees" type="number" min="0" step="0.01" class="cash-input fa-input-surface w-full" placeholder="1800" />
                  <label class="fa-field-label mt-3 mb-1" for="cashResale">Resale value at horizon ($)</label>
                  <input id="cashResale" name="cashResale" type="number" min="0" step="0.01" class="cash-input fa-input-surface w-full" placeholder="19500" />
                  <label class="fa-field-label mt-3 mb-1" for="cashInsurance">Insurance ($/mo)</label>
                  <input id="cashInsurance" name="cashInsurance" type="number" min="0" step="0.01" class="cash-input fa-input-surface w-full" placeholder="145" />
                  <label class="fa-field-label mt-3 mb-1" for="cashMaintenance">Maintenance ($/mo)</label>
                  <input id="cashMaintenance" name="cashMaintenance" type="number" min="0" step="0.01" class="cash-input fa-input-surface w-full" placeholder="90" />
                  <label class="fa-field-label mt-3 mb-1" for="cashFuel">Fuel/charging ($/mo)</label>
                  <input id="cashFuel" name="cashFuel" type="number" min="0" step="0.01" class="cash-input fa-input-surface w-full" placeholder="180" />
                </div>
              </div>

              <!-- Incentives & Rebates -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">Incentives & Rebates</h3>
                <p class="fa-meta-copy mb-4 !mt-0">Enter any manufacturer, dealer, or government incentives that apply to your replacement options.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  <div>
                    <label class="fa-field-label mb-2" for="loyaltyBonus">Loyalty bonus ($)</label>
                    <input id="loyaltyBonus" name="loyaltyBonus" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="500" />
                    <p class="fa-help-copy mt-1">Returning customer bonus from same brand</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="conquestCash">Conquest cash ($)</label>
                    <input id="conquestCash" name="conquestCash" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="750" />
                    <p class="fa-help-copy mt-1">Bonus for switching from competitor brand</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="evFederalCredit">Federal EV tax credit ($)</label>
                    <input id="evFederalCredit" name="evFederalCredit" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="7500" />
                    <p class="fa-help-copy mt-1">Up to $7,500 for qualifying EVs (IRS 30D)</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="evStateCredit">State/local EV incentive ($)</label>
                    <input id="evStateCredit" name="evStateCredit" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="2000" />
                    <p class="fa-help-copy mt-1">State rebates, HOV access value, etc.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="dealerRebate">Dealer rebate/cash ($)</label>
                    <input id="dealerRebate" name="dealerRebate" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="1000" />
                    <p class="fa-help-copy mt-1">Dealer cash, manufacturer incentives</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="collegeGradRebate">College grad/military rebate ($)</label>
                    <input id="collegeGradRebate" name="collegeGradRebate" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="500" />
                    <p class="fa-help-copy mt-1">Special program discounts</p>
                  </div>
                </div>
              </div>

              <!-- Opportunity Cost / Time Value of Money -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">Opportunity Cost (NPV Comparison)</h3>
                <p class="fa-meta-copy mb-4 !mt-0">For a true cost comparison, factor in what your money could earn elsewhere.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="fa-field-label mb-2" for="discountRate">Discount rate (%)</label>
                    <input id="discountRate" name="discountRate" type="number" min="0" max="25" step="0.1" class="fa-input-surface w-full" placeholder="5" />
                    <p class="fa-help-copy mt-1">Annual rate for NPV calculations (e.g., 5%)</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="investmentReturn">Alt. investment return (%)</label>
                    <input id="investmentReturn" name="investmentReturn" type="number" min="0" max="25" step="0.1" class="fa-input-surface w-full" placeholder="7" />
                    <p class="fa-help-copy mt-1">What cash could earn if invested instead</p>
                  </div>
                </div>
              </div>

              <!-- Gap Insurance for Replacement -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">Gap Insurance (for financed/leased replacements)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="fa-field-label mb-2" for="newLeaseGapInsurance">New lease gap insurance ($/term)</label>
                    <input id="newLeaseGapInsurance" name="newLeaseGapInsurance" type="number" min="0" step="50" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">Often included in lease; enter extra cost if any</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="financeGapInsurance">Finance gap insurance ($/term)</label>
                    <input id="financeGapInsurance" name="financeGapInsurance" type="number" min="0" step="50" class="fa-input-surface w-full" placeholder="400" />
                    <p class="fa-help-copy mt-1">Covers loan/value gap if totaled</p>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap gap-4 pt-4 fa-panel-divider-top">
                <button type="button" id="calculate-options" class="fa-button-primary">
                  Compare
                </button>
                <button type="submit" class="fa-button-primary">
                  Save Scenario Inputs
                </button>
              </div>
            </form>

            <div id="replacement-results" class="results fa-highlight-card hidden mt-6 p-5">
              <h3 class="fa-scenario-title mb-3">3-year cost snapshot</h3>
              <div class="fa-list-copy-strong grid grid-cols-1 gap-4 md:grid-cols-3 !mt-0">
                <div class="fa-subcard p-3">
                  <p class="font-semibold mb-1">New Lease</p>
                  <p id="leaseResult" class="fa-list-copy !mt-0">–</p>
                </div>
                <div class="fa-subcard p-3">
                  <p class="font-semibold mb-1">Finance a New Car</p>
                  <p id="financeResult" class="fa-list-copy !mt-0">–</p>
                </div>
                <div class="fa-subcard p-3">
                  <p class="font-semibold mb-1">Buy with Cash</p>
                  <p id="cashResult" class="fa-list-copy !mt-0">–</p>
                </div>
              </div>
              <p id="optionsRecommendation" class="fa-result-emphasis mt-4"></p>
            </div>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
            forceAssignNavigation={true}
          />
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Add qualitative filters</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li>• Warranty coverage and roadside assistance</li>
              <li>• Safety/tech upgrades and fuel efficiency</li>
              <li>• EV incentives or HOV perks (if applicable)</li>
              <li>• Insurance differences by vehicle and trim</li>
            </ul>
          </div>
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Shortcuts</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li><a href="/calculator/auto-loan" class="text-teal-700 dark:text-teal-300 hover:underline">Auto loan calculator</a> for new/used purchase payments.</li>
              <li>Ask dealers for “drive-off” quotes to capture all fees up front.</li>
              <li>Use fuel/energy calculators if switching to EV or PHEV.</li>
            </ul>
          </div>
        </div>
      </div>
  </div>
</Layout>

<script>
  import '../../../../scripts/journey/auto-lease-decision/replacement-options.client.ts';
</script>
