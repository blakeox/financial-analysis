---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['auto-lease-decision'];

if (!currentScenario) {
  throw new Error('Journey not found: auto-lease-decision');
}

const currentStep = currentScenario.models.find(m => m.id === 'lease-profile');
const currentStepOrder = currentStep?.order || 1;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'auto-lease-decision',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep
    ? {
        id: nextStep.id,
        name: nextStep.name,
        url: `/journey/auto-lease-decision/step/${nextStep.id}`,
      }
    : null,
  previousStep: previousStep
    ? {
        id: previousStep.id,
        name: previousStep.name,
        url: `/journey/auto-lease-decision/step/${previousStep.id}`,
      }
    : null,
  journeyOverviewUrl: '/journey/auto-lease-decision',
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3 space-y-6">
          <JourneyStepHero
            icon="🚙"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
            supportingText={`Capture the basics of your current lease so we can benchmark options. These numbers feed the buyout math, new lease comparisons, and cost-per-mile targets later in the journey.`}
          />

          <!-- Lease Snapshot Form -->
          <div class="fa-card p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="fa-panel-title">Your Lease Snapshot</h2>
              <span id="lease-profile-status" class="fa-meta-copy !mt-0"></span>
            </div>
            <form id="lease-profile-form" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="fa-field-label mb-2" for="monthlyPayment">Monthly Payment ($)</label>
                  <input id="monthlyPayment" name="monthlyPayment" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="350" required />
                  <p class="fa-help-copy mt-1">Include taxes if rolled in.</p>
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="monthsRemaining">Months Remaining</label>
                  <input id="monthsRemaining" name="monthsRemaining" type="number" min="0" step="1" class="fa-input-surface w-full" placeholder="9" required />
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="residualValue">Residual / Buyout ($)</label>
                  <input id="residualValue" name="residualValue" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="19500" required />
                  <p class="fa-help-copy mt-1">Purchase option price at lease end.</p>
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="moneyFactor">Money Factor / APR</label>
                  <input id="moneyFactor" name="moneyFactor" type="text" class="fa-input-surface w-full" placeholder="0.00125 (≈3.0% APR)" />
                  <p class="fa-help-copy mt-1">Optional, for context on current lease cost.</p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                  <label class="fa-field-label mb-2" for="currentMileage">Current Mileage</label>
                  <input id="currentMileage" name="currentMileage" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="28000" />
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="allowedMileage">Allowed Miles (total)</label>
                  <input id="allowedMileage" name="allowedMileage" type="number" min="0" step="100" class="fa-input-surface w-full" placeholder="30000" />
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="overageFee">Mileage Overage Fee ($/mile)</label>
                  <input id="overageFee" name="overageFee" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0.25" />
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                  <label class="fa-field-label mb-2" for="dispositionFee">Disposition Fee ($)</label>
                  <input id="dispositionFee" name="dispositionFee" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="395" />
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="purchaseOptionFee">Purchase Option Fee ($)</label>
                  <input id="purchaseOptionFee" name="purchaseOptionFee" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="250" />
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="creditBand">Credit / Rate Expectation</label>
                  <select id="creditBand" name="creditBand" class="fa-input-surface w-full">
                    <option value="">Select</option>
                    <option value="excellent">Excellent (720+)</option>
                    <option value="good">Good (680-719)</option>
                    <option value="fair">Fair (640-679)</option>
                    <option value="rebuilding">Rebuilding (&lt;640)</option>
                  </select>
                </div>
              </div>

              <!-- Early Termination Section -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">Early Termination (if ending before maturity)</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <div>
                    <label class="fa-field-label mb-2" for="earlyTerminationFee">Early Termination Fee ($)</label>
                    <input id="earlyTerminationFee" name="earlyTerminationFee" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">Penalty for ending lease early.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="remainingPaymentsOwed">Remaining Payments Owed ($)</label>
                    <input id="remainingPaymentsOwed" name="remainingPaymentsOwed" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">If lender requires payment of remaining lease.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="leaseTransferFee">Lease Transfer Fee ($)</label>
                    <input id="leaseTransferFee" name="leaseTransferFee" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">Fee to transfer lease to another party.</p>
                  </div>
                </div>
              </div>

              <!-- Wear & Tear Section -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">Estimated Wear & Tear Charges</h3>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                  <div>
                    <label class="fa-field-label mb-2" for="excessWearCharges">Excess Wear Charges ($)</label>
                    <input id="excessWearCharges" name="excessWearCharges" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">Interior/exterior damage beyond normal.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="tireCharges">Tire Replacement ($)</label>
                    <input id="tireCharges" name="tireCharges" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">If tires below minimum tread.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="bodyDamageEstimate">Body Damage Estimate ($)</label>
                    <input id="bodyDamageEstimate" name="bodyDamageEstimate" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">Dents, scratches beyond allowance.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-2" for="missingEquipment">Missing Equipment ($)</label>
                    <input id="missingEquipment" name="missingEquipment" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    <p class="fa-help-copy mt-1">Keys, manuals, accessories.</p>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="fa-field-label mb-2" for="goals">What matters most?</label>
                  <select id="goals" name="goals" class="fa-input-surface w-full">
                    <option value="">Select priority</option>
                    <option value="payment">Lowest monthly payment</option>
                    <option value="total-cost">Lowest total cost</option>
                    <option value="equity">Building equity</option>
                    <option value="reliability">Reliability / warranty</option>
                    <option value="flexibility">Flexibility (short horizon)</option>
                  </select>
                </div>
                <div>
                  <label class="fa-field-label mb-2" for="notes">Constraints or preferences</label>
                  <textarea id="notes" name="notes" rows="3" class="fa-input-surface w-full" placeholder="e.g., need AWD, avoid large upfront cash, considering EV incentives"></textarea>
                </div>
              </div>

              <div class="flex flex-wrap gap-4 pt-4 fa-panel-divider-top">
                <button type="submit" class="fa-button-primary">
                  Save Lease Profile
                </button>
                <a href={journeyNav.nextStep?.url || '#'} class="fa-button-secondary">
                  Skip to {journeyNav.nextStep?.name}
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </form>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">What to collect</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li>• Lease contract (payment, term, residual, fees)</li>
              <li>• Current odometer and allowance to date</li>
              <li>• Buyout quote with taxes/fees</li>
              <li>• Any equity offers from dealers/CarMax/Vroom</li>
            </ul>
          </div>
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Pro tips</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li>• Ask your lender for a written buyout that includes taxes and fees.</li>
              <li>• Check market value from 2-3 sources (KBB/Edmunds/CarGurus) to see equity.</li>
              <li>• Note end-of-lease inspection items; fixes now can beat turn-in charges.</li>
            </ul>
          </div>
        </div>
      </div>
  </div>
</Layout>

<script>
  import '../../../../scripts/journey/auto-lease-decision/lease-profile.client.ts';
</script>
