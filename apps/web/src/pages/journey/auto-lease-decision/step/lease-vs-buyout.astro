---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['auto-lease-decision'];

if (!currentScenario) {
  throw new Error('Journey not found: auto-lease-decision');
}

const currentStep = currentScenario.models.find(m => m.id === 'lease-vs-buyout');
const currentStepOrder = currentStep?.order || 2;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'auto-lease-decision',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep
    ? {
        id: nextStep.id,
        name: nextStep.name,
        url: `/journey/auto-lease-decision/step/${nextStep.id}`,
      }
    : null,
  previousStep: previousStep
    ? {
        id: previousStep.id,
        name: previousStep.name,
        url: `/journey/auto-lease-decision/step/${previousStep.id}`,
      }
    : null,
  journeyOverviewUrl: '/journey/auto-lease-decision',
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <main class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3 space-y-6">
          <JourneyStepHero
            icon="📊"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
            supportingText={`Stack the hard dollars: total cost to finish the lease vs buying the car with financing (now or at lease-end) and compare to the vehicle’s market value. This frames your equity position and exit strategy.`}
          />

          <!-- Lease vs Buyout Calculator -->
          <div class="fa-card p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="fa-panel-title">Model the tradeoffs</h2>
              <span id="lease-buyout-status" class="fa-meta-copy !mt-0"></span>
            </div>
            <form id="lease-buyout-form" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                  <div>
                    <h3 class="fa-scenario-title mb-2">Finish the lease</h3>
                    <label class="fa-field-label mb-1" for="remainingPayments">Payments remaining ($ total)</label>
                    <input id="remainingPayments" name="remainingPayments" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="3150" />
                    <label class="fa-field-label mt-3 mb-1" for="monthsRemaining">Months remaining</label>
                    <input id="monthsRemaining" name="monthsRemaining" type="number" min="0" step="1" class="fa-input-surface w-full" placeholder="9" />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="fa-field-label mb-1" for="dispositionFee">Disposition fee ($)</label>
                      <input id="dispositionFee" name="dispositionFee" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="395" />
                    </div>
                    <div>
                      <label class="fa-field-label mb-1" for="mileagePenalty">Mileage/condition charges ($)</label>
                      <input id="mileagePenalty" name="mileagePenalty" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="0" />
                    </div>
                  </div>
                </div>

                <div class="space-y-4">
                  <div>
                    <h3 class="fa-scenario-title mb-2">Buyout path</h3>
                    <label class="fa-field-label mb-1" for="buyoutAmount">Buyout amount ($)</label>
                    <input id="buyoutAmount" name="buyoutAmount" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="19500" />
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label class="fa-field-label mb-1" for="salesTaxRate">Sales tax (%)</label>
                      <input id="salesTaxRate" name="salesTaxRate" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="8.5" />
                    </div>
                    <div>
                      <label class="fa-field-label mb-1" for="fees">Title/DMV fees ($)</label>
                      <input id="fees" name="fees" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="450" />
                    </div>
                    <div>
                      <label class="fa-field-label mb-1" for="loanTermMonths">Loan term (months)</label>
                      <input id="loanTermMonths" name="loanTermMonths" type="number" min="6" step="1" class="fa-input-surface w-full" placeholder="60" />
                    </div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="fa-field-label mb-1" for="apr">APR (%)</label>
                      <input id="apr" name="apr" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="5.5" />
                    </div>
                    <div>
                      <label class="fa-field-label mb-1" for="expectedValueNow">Market value today ($)</label>
                      <input id="expectedValueNow" name="expectedValueNow" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="21000" />
                    </div>
                  </div>
                  <div>
                    <label class="fa-field-label mb-1" for="expectedValueFuture">Estimated value at lease-end ($)</label>
                    <input id="expectedValueFuture" name="expectedValueFuture" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="18500" />
                  </div>
                </div>
              </div>

              <!-- Trade-in & Sale Options -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">If Buying Out: Exit Strategy Values</h3>
                <p class="fa-help-copy mb-4 !mt-0">Compare what you could get if you buy out and then sell/trade the vehicle.</p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <div>
                    <label class="fa-field-label mb-1" for="tradeInValue">Trade-in Value (dealer) ($)</label>
                    <input id="tradeInValue" name="tradeInValue" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="19000" />
                    <p class="fa-help-copy mt-1">What dealer would give on trade.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-1" for="privateSaleValue">Private Sale Value ($)</label>
                    <input id="privateSaleValue" name="privateSaleValue" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="21500" />
                    <p class="fa-help-copy mt-1">Estimated private party sale.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-1" for="instantOfferValue">Instant Offer Value ($)</label>
                    <input id="instantOfferValue" name="instantOfferValue" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="20000" />
                    <p class="fa-help-copy mt-1">CarMax, Carvana, Vroom offer.</p>
                  </div>
                </div>
              </div>

              <!-- Depreciation & Additional Options -->
              <div class="fa-panel-divider-top pt-6">
                <h3 class="fa-scenario-title mb-4">Additional Factors</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label class="fa-field-label mb-1" for="depreciationModel">Depreciation Model</label>
                    <select id="depreciationModel" name="depreciationModel" class="fa-input-surface w-full">
                      <option value="moderate">Moderate</option>
                      <option value="aggressive">Aggressive</option>
                    </select>
                    <p class="fa-help-copy mt-1">How fast the vehicle loses value.</p>
                  </div>
                  <div>
                    <label class="fa-field-label mb-1" for="gapInsurance">Gap Insurance ($)</label>
                    <input id="gapInsurance" name="gapInsurance" type="number" min="0" step="0.01" class="fa-input-surface w-full" placeholder="600" />
                    <p class="fa-help-copy mt-1">Estimated gap insurance cost (if applicable).</p>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap gap-4 pt-4 fa-panel-divider-top">
                <button type="button" id="calculate-lease-buyout" class="fa-button-primary">
                  Compare
                </button>
                <button type="submit" class="fa-button-primary">
                  Save Numbers
                </button>
              </div>
            </form>

            <div id="lease-buyout-results" class="results fa-highlight-card hidden mt-6 p-5">
              <h3 class="fa-scenario-title mb-3">Quick take</h3>
              <div class="fa-list-copy-strong grid grid-cols-1 gap-4 md:grid-cols-3 !mt-0">
                <div class="fa-subcard p-3">
                  <p class="font-semibold mb-1">Finish the lease</p>
                  <p id="leaseCostSummary" class="fa-list-copy !mt-0">–</p>
                </div>
                <div class="fa-subcard p-3">
                  <p class="font-semibold mb-1">Buyout financing</p>
                  <p id="buyoutSummary" class="fa-list-copy !mt-0">–</p>
                </div>
                <div class="fa-subcard p-3">
                  <p class="font-semibold mb-1">Equity check</p>
                  <p id="equitySummary" class="fa-list-copy !mt-0">–</p>
                </div>
              </div>
              <p id="recommendation" class="fa-result-emphasis mt-4"></p>
            </div>
          </div>

          <!-- Navigation -->
          <div class="fa-card p-6 mb-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a href={journeyNav.previousStep.url} class="fa-button-secondary">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a href={journeyNav.journeyOverviewUrl} class="fa-button-secondary">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>
              <div class="flex items-center space-x-4">
                {journeyNav.nextStep ? (
                  <a href={journeyNav.nextStep.url} onclick="window.location.assign(this.href); return false;" class="fa-button-primary">
                    Next: {journeyNav.nextStep.name}
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ) : (
                  <a href={`/journey-analysis/${journeyNav.scenarioId}`} class="fa-button-primary">
                    Complete Journey
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Guardrails</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li>• Check if lender restricts third-party buyouts.</li>
              <li>• Ask about taxes in your state on lease buyouts.</li>
              <li>• Compare insurance/registration costs between options.</li>
              <li>• Consider warranty coverage if you keep the car.</li>
            </ul>
          </div>
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Helpful links</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li><a href="/calculator/auto-loan" class="text-teal-700 dark:text-teal-300 hover:underline">Auto loan calculator</a> for buyout financing.</li>
              <li><a href="/calculator/risk-management" class="text-teal-700 dark:text-teal-300 hover:underline">Risk review</a> for emergency fund and payment safety.</li>
            </ul>
          </div>
        </div>
      </div>
  </main>
</Layout>

<script>
  import '../../../../scripts/journey/auto-lease-decision/lease-vs-buyout.client.ts';
</script>
