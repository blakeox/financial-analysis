---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';
import Breadcrumbs from '../../../../components/site/Breadcrumbs.astro';
import JourneyStepHero from '../../../../components/JourneyStepHero.astro';
import JourneyStepNavigation from '../../../../components/JourneyStepNavigation.astro';

const journeyData = getJourneyData();
const currentScenario = journeyData['auto-lease-decision'];

if (!currentScenario) {
  throw new Error('Journey not found: auto-lease-decision');
}

const currentStep = currentScenario.models.find(m => m.id === 'decision-review');
const currentStepOrder = currentStep?.order || 4;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'auto-lease-decision',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep
    ? {
        id: nextStep.id,
        name: nextStep.name,
        url: `/journey/auto-lease-decision/step/${nextStep.id}`,
      }
    : null,
  previousStep: previousStep
    ? {
        id: previousStep.id,
        name: previousStep.name,
        url: `/journey/auto-lease-decision/step/${previousStep.id}`,
      }
    : null,
  journeyOverviewUrl: '/journey/auto-lease-decision',
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Journey', href: '/journey' },
      { label: currentScenario.name, href: journeyNav.journeyOverviewUrl },
      { label: currentStep?.name ?? 'Current step' },
    ]}
  />

  <div class="fa-page-shell">
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3 space-y-6">
          <JourneyStepHero
            icon="✅"
            title={currentStep?.name ?? 'Current step'}
            description={currentStep?.description ?? ''}
            currentStep={currentStepOrder}
            totalSteps={currentScenario.models.length}
            scenarioName={currentScenario.name}
            supportingText={`Summarize the numbers, layer in risks, and set your action plan. This pulls together lease math, buyout options, and replacement scenarios so you can move confidently.`}
          />

          <!-- Summary Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="fa-card p-4">
              <h3 class="fa-scenario-title mb-2">Lease snapshot</h3>
              <p id="summary-lease" class="fa-list-copy !mt-0">Gathering details...</p>
            </div>
            <div class="fa-card p-4">
              <h3 class="fa-scenario-title mb-2">Buyout math</h3>
              <p id="summary-buyout" class="fa-list-copy !mt-0">Add buyout numbers to see equity.</p>
            </div>
            <div class="fa-card p-4">
              <h3 class="fa-scenario-title mb-2">Replacement options</h3>
              <p id="summary-options" class="fa-list-copy !mt-0">Compare cost-per-mile across options.</p>
            </div>
          </div>

          <!-- Early Termination & Wear Costs (Step 1 data) -->
          <div id="termination-section" class="fa-card p-6 hidden">
            <h2 class="fa-panel-title mb-4">Early termination & end-of-lease costs</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="fa-subcard">
                <h4 class="fa-scenario-title mb-2">Early termination</h4>
                <ul id="termination-details" class="fa-list-copy !mt-0 space-y-1">
                </ul>
              </div>
              <div class="fa-subcard">
                <h4 class="fa-scenario-title mb-2">Wear & tear charges</h4>
                <ul id="wear-details" class="fa-list-copy !mt-0 space-y-1">
                </ul>
              </div>
            </div>
          </div>

          <!-- Exit Strategies (Step 2 data) -->
          <div id="exit-section" class="fa-card p-6 hidden">
            <h2 class="fa-panel-title mb-4">Exit strategy comparison</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div id="exit-tradein" class="fa-subcard">
                <h4 class="fa-scenario-title mb-2">Trade-in</h4>
                <p class="fa-list-copy !mt-0">—</p>
              </div>
              <div id="exit-private" class="fa-subcard">
                <h4 class="fa-scenario-title mb-2">Private sale</h4>
                <p class="fa-list-copy !mt-0">—</p>
              </div>
              <div id="exit-instant" class="fa-subcard">
                <h4 class="fa-scenario-title mb-2">Instant offer</h4>
                <p class="fa-list-copy !mt-0">—</p>
              </div>
            </div>
            <p id="exit-recommendation" class="fa-positive-copy mt-4"></p>
          </div>

          <!-- Incentives & Rebates (Step 3 data) -->
          <div id="incentives-section" class="fa-card p-6 hidden">
            <h2 class="fa-panel-title mb-4">Incentives & rebates</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="incentives-grid">
            </div>
            <p id="incentives-total" class="fa-positive-copy mt-4"></p>
          </div>

          <!-- Scorecard -->
          <div class="fa-card p-6">
            <h2 class="fa-panel-title mb-4">Decision scorecard</h2>
            <div class="fa-list-copy-strong grid grid-cols-1 gap-4 md:grid-cols-2 !mt-0">
              <div class="fa-subcard">
                <h4 class="font-semibold mb-2">Cash & payments</h4>
                <ul class="space-y-2">
                  <li id="scorecard-cash">• How much cash is due at signing/buyout?</li>
                  <li>• Does the monthly fit your budget with buffer?</li>
                  <li>• Is insurance higher on any option?</li>
                </ul>
              </div>
              <div class="fa-subcard">
                <h4 class="font-semibold mb-2">Total cost & equity</h4>
                <ul class="space-y-2">
                  <li id="scorecard-equity">• Equity today vs lease-end vs resale value.</li>
                  <li>• Cost per mile vs your mileage pattern.</li>
                  <li>• Warranty/maintenance coverage length.</li>
                </ul>
              </div>
              <div class="fa-subcard">
                <h4 class="font-semibold mb-2">Risk checks</h4>
                <ul class="space-y-2">
                  <li>• Emergency fund covers 2-3 months of payments?</li>
                  <li>• Rates locked and valid until you decide?</li>
                  <li>• Early termination rules are clear?</li>
                </ul>
              </div>
              <div class="fa-subcard">
                <h4 class="font-semibold mb-2">Lifestyle fit</h4>
                <ul class="space-y-2">
                  <li>• Reliability, safety, tech, and warranty coverage.</li>
                  <li>• Fuel/energy costs vs commute changes.</li>
                  <li>• Flexibility if you may move or change mileage.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Next Actions -->
          <div class="fa-card p-6">
            <h2 class="fa-panel-title mb-3">Next actions</h2>
            <ol class="fa-list-copy-strong list-decimal list-inside space-y-2 !mt-0">
              <li>Lock down written quotes for buyout (with tax/fees) and any new/used options.</li>
              <li>Re-run the comparisons with the actual numbers and updated insurance estimates.</li>
              <li>Schedule inspection or payoff steps to avoid extra lease fees if buying out or selling.</li>
              <li>Use the chatbot on this page to sanity-check the tradeoffs and risks before committing.</li>
            </ol>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/calculator/auto-loan" class="fa-button-primary">
                Open auto loan calculator
              </a>
              <a href="/journey-analysis/auto-lease-decision" class="fa-button-primary">
                Generate AI summary
              </a>
            </div>
          </div>
          <JourneyStepNavigation
            scenarioId={journeyNav.scenarioId}
            journeyOverviewUrl={journeyNav.journeyOverviewUrl}
            previousStep={journeyNav.previousStep}
            nextStep={journeyNav.nextStep}
          />
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Final checks</h3>
            <ul class="fa-list-copy !mt-0 space-y-2">
              <li>• Confirm payoff instructions and timing with lender.</li>
              <li>• Verify insurance changes effective on delivery date.</li>
              <li>• Keep quotes/screenshots in case rates or offers move.</li>
              <li>• Set reminders for registration, emissions, or EV credits.</li>
            </ul>
          </div>
          <div class="fa-card p-5">
            <h3 class="fa-scenario-title mb-3">Share with the chatbot</h3>
            <p class="fa-list-copy !mt-0">Use the collected numbers below to ask for a recommendation or risk review.</p>
            <pre id="chat-prompt" class="fa-prompt-panel mt-3">Loading...</pre>
          </div>
        </div>
      </div>
  </div>
</Layout>

<script is:inline>
  const STORAGE_KEY = 'fanalyx-journey-state-auto-lease-decision';

  const isNonZeroNumberString = (value) => {
    if (value === undefined || value === null) return false;
    const asString = String(value).trim();
    if (asString === '') return false;
    const asNumber = Number(asString);
    return Number.isFinite(asNumber) && asNumber !== 0;
  };

  const formatCurrency = (value) =>
    value?.toLocaleString?.('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }) || '$0';

  const loadSummaries = () => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved) return;
    let data;
    try {
      data = JSON.parse(saved);
    } catch {
      return;
    }
    const profile = data.collectedData?.['lease-profile'];
    const buyout = data.collectedData?.['lease-vs-buyout'];
    const replacements = data.collectedData?.['replacement-options'];

    // ======= Lease snapshot (Step 1) =======
    const leaseSummary = document.getElementById('summary-lease');
    if (leaseSummary && profile) {
      leaseSummary.textContent = `Payment ${formatCurrency(Number(profile.monthlyPayment))}, ${profile.monthsRemaining || '?'} months left, residual ${formatCurrency(Number(profile.residualValue))}. Mileage: ${profile.currentMileage || '?'} / ${profile.allowedMileage || '?'}.`;
    }

    // ======= Early termination & wear/tear (Step 1) =======
    const terminationSection = document.getElementById('termination-section');
    const terminationDetails = document.getElementById('termination-details');
    const wearDetails = document.getElementById('wear-details');

    const hasTerminationData = profile && (
      isNonZeroNumberString(profile.earlyTerminationFee) ||
      isNonZeroNumberString(profile.remainingPaymentsOwed) ||
      isNonZeroNumberString(profile.leaseTransferFee)
    );
    const hasWearData = profile && (
      isNonZeroNumberString(profile.excessWearCharges) ||
      isNonZeroNumberString(profile.tireCharges) ||
      isNonZeroNumberString(profile.bodyDamageEstimate)
    );

    if ((hasTerminationData || hasWearData) && terminationSection) {
      terminationSection.classList.remove('hidden');

      if (terminationDetails && hasTerminationData) {
        const items = [];
        if (isNonZeroNumberString(profile.earlyTerminationFee)) items.push(`Early termination fee: ${formatCurrency(Number(profile.earlyTerminationFee))}`);
        if (isNonZeroNumberString(profile.remainingPaymentsOwed)) items.push(`Remaining payments owed: ${formatCurrency(Number(profile.remainingPaymentsOwed))}`);
        if (isNonZeroNumberString(profile.leaseTransferFee)) items.push(`Lease transfer fee: ${formatCurrency(Number(profile.leaseTransferFee))}`);
        terminationDetails.innerHTML = items.map(i => `<li>• ${i}</li>`).join('');
      }

      if (wearDetails && hasWearData) {
        const items = [];
        if (isNonZeroNumberString(profile.excessWearCharges)) items.push(`Excess wear charges: ${formatCurrency(Number(profile.excessWearCharges))}`);
        if (isNonZeroNumberString(profile.tireCharges)) items.push(`Tire replacement: ${formatCurrency(Number(profile.tireCharges))}`);
        if (isNonZeroNumberString(profile.bodyDamageEstimate)) items.push(`Body damage estimate: ${formatCurrency(Number(profile.bodyDamageEstimate))}`);
        wearDetails.innerHTML = items.map(i => `<li>• ${i}</li>`).join('');
      }
    }

    // ======= Buyout summary (Step 2) =======
    const buyoutSummary = document.getElementById('summary-buyout');
    if (buyoutSummary && buyout) {
      buyoutSummary.textContent = `Buyout ${formatCurrency(Number(buyout.buyoutAmount))} + taxes/fees; APR ${buyout.apr || '?'}% over ${buyout.loanTermMonths || '?'} months. Market now ${formatCurrency(Number(buyout.expectedValueNow || 0))}.`;
    }

    // ======= Exit strategies (Step 2) =======
    const exitSection = document.getElementById('exit-section');
    const hasExitData = buyout && (
      isNonZeroNumberString(buyout.tradeInValue) ||
      isNonZeroNumberString(buyout.privateSaleValue) ||
      isNonZeroNumberString(buyout.instantOfferValue)
    );

    if (hasExitData && exitSection) {
      exitSection.classList.remove('hidden');
      const buyoutAmt = Number(buyout.buyoutAmount) || 0;
      const salesTaxRate = Number(buyout.salesTaxRate) || 0;
      const fees = Number(buyout.fees) || 0;
      const buyoutSalesTax = buyoutAmt * (salesTaxRate / 100);
      const buyoutBasis = Number(buyout.buyoutTotal) || (buyoutAmt + buyoutSalesTax + fees);

      const exitTradeIn = document.getElementById('exit-tradein');
      if (exitTradeIn && isNonZeroNumberString(buyout.tradeInValue)) {
        const value = Number(buyout.tradeInValue);
        const equity = value - buyoutBasis;
        exitTradeIn.innerHTML = `<h4 class="fa-scenario-title mb-2">Trade-in</h4>
          <p class="fa-panel-title text-2xl">${formatCurrency(value)}</p>
          <p class="text-sm ${equity >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-300'}">
            ${equity >= 0 ? '+' : ''}${formatCurrency(equity)} equity
          </p>`;
      }

      const exitPrivate = document.getElementById('exit-private');
      if (exitPrivate && isNonZeroNumberString(buyout.privateSaleValue)) {
        const value = Number(buyout.privateSaleValue);
        const equity = value - buyoutBasis;
        exitPrivate.innerHTML = `<h4 class="fa-scenario-title mb-2">Private sale</h4>
          <p class="fa-panel-title text-2xl">${formatCurrency(value)}</p>
          <p class="text-sm ${equity >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-300'}">
            ${equity >= 0 ? '+' : ''}${formatCurrency(equity)} equity
          </p>`;
      }

      const exitInstant = document.getElementById('exit-instant');
      if (exitInstant && isNonZeroNumberString(buyout.instantOfferValue)) {
        const value = Number(buyout.instantOfferValue);
        const equity = value - buyoutBasis;
        exitInstant.innerHTML = `<h4 class="fa-scenario-title mb-2">Instant offer</h4>
          <p class="fa-panel-title text-2xl">${formatCurrency(value)}</p>
          <p class="text-sm ${equity >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-300'}">
            ${equity >= 0 ? '+' : ''}${formatCurrency(equity)} equity
          </p>`;
      }

      // Determine best exit strategy
      const exitRecommendation = document.getElementById('exit-recommendation');
      if (exitRecommendation) {
        const options = [
          { name: 'Trade-in', value: Number(buyout.tradeInValue) || 0 },
          { name: 'Private sale', value: Number(buyout.privateSaleValue) || 0 },
          { name: 'Instant offer', value: Number(buyout.instantOfferValue) || 0 },
        ].filter(o => o.value > 0);

        if (options.length > 1) {
          options.sort((a, b) => b.value - a.value);
          const best = options[0];
          const diff = best.value - options[1].value;
          exitRecommendation.textContent = `💡 Best exit: ${best.name.toLowerCase()} nets ${formatCurrency(diff)} more than ${options[1].name} (based on offer amounts; buyout taxes/fees included in equity above)`;
        }
      }
    }

    // ======= Replacement options summary (Step 3) =======
    const optionsSummary = document.getElementById('summary-options');
    if (optionsSummary && replacements) {
      const hasNpv = replacements.discountRate && Number(replacements.discountRate) > 0;
      const npvNote = hasNpv ? ` (NPV at ${replacements.discountRate}% discount)` : '';
      optionsSummary.textContent = `Inputs set for lease/new/used costs. Horizon ${replacements.horizonMonths || 36} months at ${replacements.annualMiles || 12000} miles/yr.${npvNote}`;
    }

    // ======= Incentives & rebates (Step 3) =======
    const incentivesSection = document.getElementById('incentives-section');
    const incentivesGrid = document.getElementById('incentives-grid');
    const incentivesTotal = document.getElementById('incentives-total');

    const incentiveFields = [
      { key: 'loyaltyBonus', label: 'Loyalty bonus' },
      { key: 'conquestCash', label: 'Conquest cash' },
      { key: 'evFederalCredit', label: 'EV federal credit' },
      { key: 'evStateCredit', label: 'EV state credit' },
      { key: 'dealerRebate', label: 'Dealer rebate' },
      { key: 'collegeGradRebate', label: 'College grad rebate' },
    ];

    let totalIncentives = 0;
    const activeIncentives = [];

    if (replacements) {
      // Loyalty vs conquest are mutually exclusive; pick the larger if both are provided.
      const loyalty = Number(replacements.loyaltyBonus) || 0;
      const conquest = Number(replacements.conquestCash) || 0;
      const chosen = Math.max(loyalty, conquest);
      if (chosen > 0) {
        activeIncentives.push({ label: chosen === loyalty ? 'Loyalty bonus' : 'Conquest cash', value: chosen });
        totalIncentives += chosen;
      }

      for (const field of incentiveFields) {
        if (field.key === 'loyaltyBonus' || field.key === 'conquestCash') continue;
        const val = Number(replacements[field.key]) || 0;
        if (val > 0) {
          activeIncentives.push({ label: field.label, value: val });
          totalIncentives += val;
        }
      }
    }

    if (activeIncentives.length > 0 && incentivesSection && incentivesGrid) {
      incentivesSection.classList.remove('hidden');
      incentivesGrid.innerHTML = activeIncentives.map(inc => `
        <div class="p-3 bg-emerald-50 dark:bg-emerald-900/20 rounded-lg">
          <p class="fa-help-copy">${inc.label}</p>
          <p class="fa-metric-value-success">${formatCurrency(inc.value)}</p>
        </div>
      `).join('');

      if (incentivesTotal) {
        incentivesTotal.textContent = `💰 Total incentives: ${formatCurrency(totalIncentives)} — applied to new vehicle options`;
      }
    }

    // ======= Chat prompt for AI analysis =======
    const chatPrompt = document.getElementById('chat-prompt');
    if (chatPrompt) {
      const prompt = {
        scenario: 'auto-lease-decision',
        leaseProfile: profile || {},
        buyout: buyout || {},
        replacements: replacements || {},
      };
      chatPrompt.textContent = JSON.stringify(prompt, null, 2);
    }
  };

  loadSummaries();
</script>
