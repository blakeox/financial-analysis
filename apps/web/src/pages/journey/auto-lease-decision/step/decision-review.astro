---
import Layout from '../../../../layouts/Layout.astro';
import { getJourneyData } from '../../../../utils/journeyData';

const journeyData = getJourneyData();
const currentScenario = journeyData['auto-lease-decision'];

if (!currentScenario) {
  throw new Error('Journey not found: auto-lease-decision');
}

const currentStep = currentScenario.models.find(m => m.id === 'decision-review');
const currentStepOrder = currentStep?.order || 4;
const nextStep = currentScenario.models.find(m => m.order === currentStepOrder + 1);
const previousStep = currentScenario.models.find(m => m.order === currentStepOrder - 1);

const journeyNav = {
  scenarioId: 'auto-lease-decision',
  scenarioName: currentScenario.name,
  currentStep: currentStepOrder,
  totalSteps: currentScenario.models.length,
  nextStep: nextStep
    ? {
        id: nextStep.id,
        name: nextStep.name,
        url: `/journey/auto-lease-decision/step/${nextStep.id}`,
      }
    : null,
  previousStep: previousStep
    ? {
        id: previousStep.id,
        name: previousStep.name,
        url: `/journey/auto-lease-decision/step/${previousStep.id}`,
      }
    : null,
  journeyOverviewUrl: '/journey/auto-lease-decision',
};

const seoTitle = `${currentStep?.name} - Step ${currentStepOrder} of ${currentScenario.name}`;
const seoDescription = `${currentStep?.description} This is step ${currentStepOrder} of ${currentScenario.models.length} in the ${currentScenario.name} financial journey.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey" class="hover:text-gray-700 dark:hover:text-gray-300">Journey</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href="/journey/auto-lease-decision" class="hover:text-gray-700 dark:hover:text-gray-300">{currentScenario.name}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">{currentStep?.name}</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-3 space-y-6">
          <!-- Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">✅</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{currentStep?.name}</h1>
                <p class="text-gray-600 dark:text-gray-400">{currentStep?.description}</p>
                <div class="mt-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200">
                    Step {currentStepOrder} of {currentScenario.models.length} - {currentScenario.name}
                  </span>
                </div>
              </div>
            </div>
            <p class="text-gray-700 dark:text-gray-300">
              Summarize the numbers, layer in risks, and set your action plan. This pulls together lease math, buyout options, and replacement scenarios so you can move confidently.
            </p>
          </div>

          <!-- Progress Bar -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Journey Progress</h3>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                Step {currentStepOrder} of {currentScenario.models.length}
              </span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
              <div
                class="bg-gradient-to-r from-teal-500 to-emerald-600 h-2 rounded-full transition-all duration-300"
                style={`width: ${(currentStepOrder / currentScenario.models.length) * 100}%`}
              ></div>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              {currentScenario.name} - {Math.round((currentStepOrder / currentScenario.models.length) * 100)}% Complete
            </p>
          </div>

          <!-- Summary Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
              <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-2">Lease snapshot</h3>
              <p id="summary-lease" class="text-sm text-gray-700 dark:text-gray-300">Gathering details...</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
              <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-2">Buyout math</h3>
              <p id="summary-buyout" class="text-sm text-gray-700 dark:text-gray-300">Add buyout numbers to see equity.</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
              <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-2">Replacement options</h3>
              <p id="summary-options" class="text-sm text-gray-700 dark:text-gray-300">Compare cost-per-mile across options.</p>
            </div>
          </div>

          <!-- Scorecard -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Decision scorecard</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-800 dark:text-gray-200">
              <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg">
                <h4 class="font-semibold mb-2">Cash & payments</h4>
                <ul class="space-y-2">
                  <li id="scorecard-cash">• How much cash is due at signing/buyout?</li>
                  <li>• Does the monthly fit your budget with buffer?</li>
                  <li>• Is insurance higher on any option?</li>
                </ul>
              </div>
              <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg">
                <h4 class="font-semibold mb-2">Total cost & equity</h4>
                <ul class="space-y-2">
                  <li id="scorecard-equity">• Equity today vs lease-end vs resale value.</li>
                  <li>• Cost per mile vs your mileage pattern.</li>
                  <li>• Warranty/maintenance coverage length.</li>
                </ul>
              </div>
              <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg">
                <h4 class="font-semibold mb-2">Risk checks</h4>
                <ul class="space-y-2">
                  <li>• Emergency fund covers 2-3 months of payments?</li>
                  <li>• Rates locked and valid until you decide?</li>
                  <li>• Early termination rules are clear?</li>
                </ul>
              </div>
              <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg">
                <h4 class="font-semibold mb-2">Lifestyle fit</h4>
                <ul class="space-y-2">
                  <li>• Reliability, safety, tech, and warranty coverage.</li>
                  <li>• Fuel/energy costs vs commute changes.</li>
                  <li>• Flexibility if you may move or change mileage.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Next Actions -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Next actions</h2>
            <ol class="list-decimal list-inside space-y-2 text-sm text-gray-800 dark:text-gray-200">
              <li>Lock down written quotes for buyout (with tax/fees) and any new/used options.</li>
              <li>Re-run the comparisons with the actual numbers and updated insurance estimates.</li>
              <li>Schedule inspection or payoff steps to avoid extra lease fees if buying out or selling.</li>
              <li>Use the chatbot on this page to sanity-check the tradeoffs and risks before committing.</li>
            </ol>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/calculator/auto-loan" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200">
                Open auto loan calculator
              </a>
              <a href="/journey-analysis/auto-lease-decision" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200">
                Generate AI summary
              </a>
            </div>
          </div>

          <!-- Navigation -->
          <div class="bg-gradient-to-r from-gray-50 to-teal-50 dark:from-gray-900/20 dark:to-teal-900/20 rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                {journeyNav.previousStep ? (
                  <a href={journeyNav.previousStep.url} class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Previous: {journeyNav.previousStep.name}
                  </a>
                ) : (
                  <a href={journeyNav.journeyOverviewUrl} class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Journey
                  </a>
                )}
              </div>
              <div class="flex items-center space-x-4">
                <a href={`/journey-analysis/${journeyNav.scenarioId}`} class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105">
                  Complete Journey
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
            <h3 class="text-lg font-semibold mb-3 text-gray-900 dark:text-white">Final checks</h3>
            <ul class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
              <li>• Confirm payoff instructions and timing with lender.</li>
              <li>• Verify insurance changes effective on delivery date.</li>
              <li>• Keep quotes/screenshots in case rates or offers move.</li>
              <li>• Set reminders for registration, emissions, or EV credits.</li>
            </ul>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
            <h3 class="text-lg font-semibold mb-3 text-gray-900 dark:text-white">Share with the chatbot</h3>
            <p class="text-sm text-gray-700 dark:text-gray-300">Use the collected numbers below to ask for a recommendation or risk review.</p>
            <pre id="chat-prompt" class="mt-3 p-3 bg-gray-100 dark:bg-gray-900 text-xs rounded-lg text-gray-800 dark:text-gray-200 overflow-x-auto whitespace-pre-wrap">Loading...</pre>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const STORAGE_KEY = 'fanalyx-journey-state-auto-lease-decision';

  const formatCurrency = (value) =>
    value?.toLocaleString?.('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }) || '$0';

  const loadSummaries = () => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved) return;
    const data = JSON.parse(saved);
    const profile = data.collectedData?.['lease-profile'];
    const buyout = data.collectedData?.['lease-vs-buyout'];
    const replacements = data.collectedData?.['replacement-options'];

    const leaseSummary = document.getElementById('summary-lease');
    if (leaseSummary && profile) {
      leaseSummary.textContent = `Payment ${formatCurrency(Number(profile.monthlyPayment))}, ${profile.monthsRemaining || '?'} months left, residual ${formatCurrency(Number(profile.residualValue))}. Mileage: ${profile.currentMileage || '?'} / ${profile.allowedMileage || '?'}.`;
    }

    const buyoutSummary = document.getElementById('summary-buyout');
    if (buyoutSummary && buyout) {
      buyoutSummary.textContent = `Buyout ${formatCurrency(Number(buyout.buyoutAmount))} + taxes/fees; APR ${buyout.apr || '?'}% over ${buyout.loanTermMonths || '?'} months. Market now ${formatCurrency(Number(buyout.expectedValueNow || 0))}.`;
    }

    const optionsSummary = document.getElementById('summary-options');
    if (optionsSummary && replacements) {
      optionsSummary.textContent = `Inputs set for lease/new/used costs. Horizon ${replacements.horizonMonths || 36} months at ${replacements.annualMiles || 12000} miles/yr.`;
    }

    const chatPrompt = document.getElementById('chat-prompt');
    if (chatPrompt) {
      const prompt = {
        scenario: 'auto-lease-decision',
        leaseProfile: profile || {},
        buyout: buyout || {},
        replacements: replacements || {},
      };
      chatPrompt.textContent = JSON.stringify(prompt, null, 2);
    }
  };

  loadSummaries();
</script>
