---
import Layout from '../layouts/Layout.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
---

<Layout title="Financial Models" description="Comprehensive financial analysis tools with AI-powered insights" canonical={Astro.url.href} noindex={true}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Main Content Container with Chat Panel Integration -->
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-16">
        <!-- Header Section -->
        <div class="text-center mb-16">
          <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Financial Models
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6">
            Comprehensive suite of financial analysis tools, each designed for precision and powered by deterministic calculations. 
            Use the AI assistant to get insights and analysis of your results.
          </p>
          <div class="flex items-center justify-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <span>Click the chat icon to get AI-powered analysis of your model results</span>
          </div>
        </div>

        <!-- Models Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16" role="main">
          
          <!-- Lease Analysis -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-blue-500 group cursor-pointer model-card"
      data-model="Lease Analysis"
      data-model-id="lease-analysis"
      data-model-description="Comprehensive lease agreement analysis with amortization schedules and IRR calculations"
      data-model-status="available"
      data-model-cta-href="/analysis"
      data-model-cta-label="Open Model"
      role="button"
      tabindex="0"
      aria-label="Select Lease Analysis model">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300">
                  Lease Analysis
                </h3>
                <div class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
                  Available
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Comprehensive lease agreement analysis with amortization schedules and IRR calculations
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Payment calculations
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Amortization schedules
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  IRR calculations
                </div>
              </div>
              <a
                href="/analysis"
                class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md transition-colors duration-200 w-full justify-center"
                data-model-cta
              >
                Open Model
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Loan Amortization -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-green-500 group cursor-pointer model-card"
      data-model="Loan Amortization"
      data-model-id="loan-amortization"
      data-model-description="Detailed loan repayment schedules with principal and interest breakdown"
      data-model-status="available"
      data-model-cta-href="/amortization"
      data-model-cta-label="Open Model"
      role="button"
      tabindex="0"
      aria-label="Select Loan Amortization model">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-green-600 dark:text-green-400 group-hover:text-green-700 dark:group-hover:text-green-300">
                  Loan Amortization
                </h3>
                <div class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
                  Available
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Detailed loan repayment schedules with principal and interest breakdown
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Principal tracking
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7-293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Interest calculations
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Payment schedules
                </div>
              </div>
              <a
                href="/amortization"
                class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-md transition-colors duration-200 w-full justify-center"
                data-model-cta
              >
                Open Model
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- EBITDA Forecasting -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-emerald-500 group cursor-pointer model-card"
      data-model="EBITDA Forecasting"
      data-model-id="ebitda-forecasting"
      data-model-description="Service industry financial projections with employee planning and expense analysis"
      data-model-status="available"
      data-model-cta-href="/ebitda-forecasting"
      data-model-cta-label="Open Model"
      role="button"
      tabindex="0"
      aria-label="Select EBITDA Forecasting model">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-emerald-600 dark:text-emerald-400 group-hover:text-emerald-700 dark:group-hover:text-emerald-300">
                  EBITDA Forecasting
                </h3>
                <div class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded-full">
                  Available
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Service industry financial projections with employee planning and expense analysis
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Revenue forecasting
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Employee planning
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Scenario analysis
                </div>
              </div>
              <a
                href="/ebitda-forecasting"
                class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-md transition-colors duration-200 w-full justify-center"
                data-model-cta
              >
                Open Model
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Bond Pricing -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-purple-500 group cursor-pointer model-card"
      data-model="Bond Pricing"
      data-model-id="bond-pricing"
      data-model-description="Fixed income securities pricing and yield calculations with duration analysis"
      data-model-status="coming-soon"
      role="button"
      tabindex="0"
      aria-label="Select Bond Pricing model (coming soon)">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-purple-600 dark:text-purple-400 group-hover:text-purple-700 dark:group-hover:text-purple-300">
                  Bond Pricing
                </h3>
                <div class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">
                  Coming Soon
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Fixed income securities pricing and yield calculations with duration analysis
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Yield calculations
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Duration analysis
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Price sensitivity
                </div>
              </div>
              <button
                disabled
                class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 cursor-not-allowed w-full justify-center"
                data-model-cta
              >
                Coming Soon
              </button>
            </div>
          </div>

          <!-- Options Pricing -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-orange-500 group cursor-pointer model-card"
      data-model="Options Pricing"
      data-model-id="options-pricing"
      data-model-description="Black-Scholes options pricing with Greeks calculations and volatility analysis"
      data-model-status="coming-soon"
      role="button"
      tabindex="0"
      aria-label="Select Options Pricing model (coming soon)">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-orange-600 dark:text-orange-400 group-hover:text-orange-700 dark:group-hover:text-orange-300">
                  Options Pricing
                </h3>
                <div class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">
                  Coming Soon
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Black-Scholes options pricing with Greeks calculations and volatility analysis
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Black-Scholes pricing
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Greeks calculations
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Volatility analysis
                </div>
              </div>
              <button
                disabled
                class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 cursor-not-allowed w-full justify-center"
                data-model-cta
              >
                Coming Soon
              </button>
            </div>
          </div>

          <!-- Cash Flow Analysis -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 border-l-4 border-indigo-500 group cursor-pointer model-card"
      data-model="Cash Flow Analysis"
      data-model-id="cashflow-analysis"
      data-model-description="NPV, IRR, and cash flow projection analysis with sensitivity testing"
      data-model-status="coming-soon"
      role="button"
      tabindex="0"
      aria-label="Select Cash Flow Analysis model (coming soon)">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-semibold text-indigo-600 dark:text-indigo-400 group-hover:text-indigo-700 dark:group-hover:text-indigo-300">
                  Cash Flow Analysis
                </h3>
                <div class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded-full">
                  Coming Soon
                </div>
              </div>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                NPV, IRR, and cash flow projection analysis with sensitivity testing
              </p>
              <div class="space-y-3 mb-6">
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  NPV calculations
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  IRR analysis
                </div>
                <div class="flex items-center text-sm text-gray-600 dark:text-gray-400" data-model-feature>
                  <svg class="w-4 h-4 mr-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  Sensitivity testing
                </div>
              </div>
              <button
                disabled
                class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-400 dark:text-gray-500 bg-gray-100 dark:bg-gray-800 cursor-not-allowed w-full justify-center"
                data-model-cta
              >
                Coming Soon
              </button>
            </div>
          </div>

        </div>

        <!-- Active Model Section -->
        <div id="selected-model-info" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <h2 id="selected-model-title" class="text-2xl font-bold text-gray-900 dark:text-white"></h2>
              <span
                id="selected-model-status"
                class="hidden px-2 py-1 text-xs font-medium rounded-full"
              ></span>
            </div>
            <button
              type="button"
              onclick="clearSelection()"
              class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
              title="Clear selection"
              aria-label="Clear model selection"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <p id="selected-model-description" class="text-gray-600 dark:text-gray-300 mb-6"></p>
          <ul
            id="selected-model-features"
            class="hidden mb-6 space-y-2 pl-4 text-sm text-gray-600 dark:text-gray-400 list-disc"
          ></ul>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
              <span>Use the AI assistant to analyze this model's results and get insights</span>
              <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <a
              id="selected-model-cta"
              class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md transition-colors duration-200"
              aria-disabled="true"
              hidden
            >
              Coming Soon
            </a>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="text-center">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              AI-Powered Financial Analysis
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              Select any model above to get started, then use our AI assistant to interpret results, run scenarios, and gain deeper insights into your financial data.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <button
                onclick="openChatPanel()"
                class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-200"
                aria-label="Open AI assistant chat panel"
              >
