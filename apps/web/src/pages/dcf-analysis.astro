---
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import StructuredData from '../components/StructuredData.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="DCF Analysis - Discounted Cash Flow Valuation Calculator | Fanalyx" 
  description="Professional DCF (Discounted Cash Flow) valuation calculator with WACC calculation, terminal value methods, free cash flow projections, sensitivity analysis, and Monte Carlo simulation."
  keywords="DCF analysis, discounted cash flow, business valuation, WACC, terminal value, free cash flow, NPV, business valuation calculator, financial modeling"
  canonical={Astro.url.href}
  type="article"
>
  <!-- Structured Data for SEO -->
  <StructuredData 
    type="breadcrumb" 
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Models', url: '/models' },
      { name: 'Business Finance', url: '/models/business' },
      { name: 'DCF Analysis', url: '/dcf-analysis' }
    ]}
  />
  
  <StructuredData 
    type="software" 
    softwareApp={{
      name: 'DCF Analysis Calculator',
      description: 'Professional DCF valuation tool with WACC calculation, terminal value methods, free cash flow projections, sensitivity analysis, and Monte Carlo simulation.',
      category: 'FinanceApplication',
      rating: 4.9,
      ratingCount: 280
    }}
  />
  
  <StructuredData 
    type="faq" 
    faqs={[
      {
        question: 'What is DCF analysis and how does it work?',
        answer: 'DCF (Discounted Cash Flow) analysis values a company by projecting future free cash flows and discounting them to present value using WACC. It\'s considered one of the most rigorous valuation methods and is widely used in finance and investment banking.'
      },
      {
        question: 'What is WACC and how do I calculate it?',
        answer: 'WACC (Weighted Average Cost of Capital) is the average rate a company pays to finance its assets. It combines the cost of equity (via CAPM) and cost of debt, weighted by their proportions. Our calculator handles WACC calculation automatically.'
      },
      {
        question: 'What is terminal value and how is it calculated?',
        answer: 'Terminal value represents the company\'s value beyond the forecast period. It can be calculated using the Gordon Growth Model (perpetuity growth) or Exit Multiple Method (comparable company multiples). Both methods are available in our calculator.'
      },
      {
        question: 'What is free cash flow?',
        answer: 'Free cash flow is cash generated by operations minus capital expenditures. It represents cash available to investors (debt and equity holders) and is the foundation of DCF valuation. FCF = Operating Cash Flow - Capital Expenditures.'
      },
      {
        question: 'How do I interpret DCF valuation results?',
        answer: 'DCF provides an enterprise value estimate. Compare it to market value to identify over/undervaluation. Use sensitivity analysis to understand how assumptions affect valuation. Our calculator includes comprehensive scenario analysis and Monte Carlo simulation.'
      }
    ]}
  />

  <div class="container mx-auto px-4 py-8">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-white">DCF Analysis</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        Professional discounted cash flow valuation with WACC, terminal value, and sensitivity analysis
      </p>

      <!-- Note: This page uses the existing dcf-valuation client script -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Use the DCF Valuation calculator to perform comprehensive discounted cash flow analysis.
        </p>
        <a
          href="/calculator/dcf-valuation"
          class="inline-flex items-center px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-md shadow-sm transition-colors duration-200"
        >
          Open DCF Valuation Calculator
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- AdSense -->
      <AdSense slot="0123456789" format="horizontal" className="mt-8" />
    </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name="dcf-valuation" />
</Layout>
