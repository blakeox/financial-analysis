---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: baseUrl },
        { '@type': 'ListItem', position: 2, name: 'Terms of Service', item: currentUrl },
      ],
    },
    {
      '@type': 'WebPage',
      name: 'Terms of Service',
      description: 'Terms of Service for Fanalyx financial calculators.',
      url: currentUrl,
      isPartOf: { '@type': 'WebSite', name: 'Fanalyx', url: baseUrl },
    },
  ],
};
---

<Layout
  title="Terms of Service - Fanalyx"
  description="Terms of Service for Fanalyx financial calculators. Free to use, no account required. Review our disclaimer, liability limitations, and user responsibilities for our 29 financial tools."
  canonical={Astro.url.href}
  keywords="terms of service, terms and conditions, user agreement, service terms, legal terms, free calculator terms, financial disclaimer"
  type="article"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Terms of Service' }]} />

  <div class="fa-page-shell-narrow">
    <div>
      <h1 class="fa-display fa-display-section !mt-0 mb-4">
        Terms of Service
      </h1>
      <p class="fa-meta-copy mb-8 !mt-0">Last updated: October 22, 2025</p>

      <div class="fa-prose-card space-y-8">
        <!-- Introduction -->
        <section>
          <h2>1. Acceptance of Terms</h2>
          <p>
            By accessing and using Fanalyx (the "Service"), you accept and agree to be bound by the
            terms and provision of this agreement. If you do not agree to these Terms of Service,
            please do not use the Service.
          </p>
        </section>

        <!-- Service Description -->
        <section>
          <h2>2. Service Description</h2>
          <p class="mb-4">
            Fanalyx provides online financial calculators and analysis tools, including but not
            limited to:
          </p>
          <ul>
            <li>Loan and mortgage calculators</li>
            <li>Investment and retirement planning tools</li>
            <li>Business financial analysis models</li>
            <li>Lease analysis calculators</li>
            <li>Budget and savings planners</li>
          </ul>
        </section>

        <!-- Disclaimer -->
        <section class="fa-highlight-card">
          <h2>3. Financial Disclaimer</h2>
          <p class="mb-4">
            <strong>IMPORTANT:</strong> The calculations and information provided by this Service are
            for informational purposes only and should not be considered professional financial advice.
          </p>
          <ul>
            <li>
              <strong>Not Financial Advice:</strong> We are not financial advisors, and nothing on this
              Service should be construed as financial, investment, tax, or legal advice.
            </li>
            <li>
              <strong>No Guarantee of Accuracy:</strong> While we strive for accuracy, we do not guarantee
              that all calculations or information are error-free or complete.
            </li>
            <li>
              <strong>Consult Professionals:</strong> Always consult with qualified financial, tax, and
              legal professionals before making any financial decisions.
            </li>
            <li>
              <strong>Your Responsibility:</strong> You are solely responsible for verifying all calculations
              and using them appropriately for your situation.
            </li>
          </ul>
        </section>

        <!-- Use of Service -->
        <section>
          <h2>4. Acceptable Use</h2>
          <p class="mb-4">
            You agree to use the Service only for lawful purposes and in accordance with these
            Terms. You agree NOT to:
          </p>
          <ul>
            <li>Use the Service in any way that violates any applicable law or regulation</li>
            <li>Attempt to interfere with or disrupt the Service or servers</li>
            <li>Attempt to gain unauthorized access to any portion of the Service</li>
            <li>Use automated systems (bots, scrapers) to access the Service without permission</li>
            <li>Reproduce, duplicate, or copy material from the Service for commercial purposes</li>
            <li>Transmit any malicious code, viruses, or harmful components</li>
          </ul>
        </section>

        <!-- Data and Privacy -->
        <section>
          <h2>5. Your Data and Privacy</h2>
          <p class="mb-4">
            <strong>Client-Side Processing:</strong> All financial calculations are performed entirely
            in your web browser. We do not collect, store, or transmit any of the financial data you enter
            into our calculators.
          </p>
          <p>
            For information about how we collect and use other types of data (such as usage
            analytics and advertising data), please review our <a
              href="/privacy"
              class="fa-inline-link">Privacy Policy</a
            >.
          </p>
        </section>

        <!-- Intellectual Property -->
        <section>
          <h2>6. Intellectual Property Rights</h2>
          <p class="mb-4">
            The Service and its original content, features, and functionality are owned by Fanalyx
            and are protected by international copyright, trademark, patent, trade secret, and other
            intellectual property laws.
          </p>
          <p>
            You may not copy, modify, distribute, sell, or lease any part of our Service or software
            without our express written permission.
          </p>
        </section>

        <!-- Third-Party Services -->
        <section>
          <h2>7. Third-Party Services and Advertising</h2>

          <h3>7.1 Google AdSense</h3>
          <p class="mb-4">
            Our Service uses Google AdSense to display advertisements. Google's use of advertising
            cookies enables it and its partners to serve ads based on your visit to our site and/or
            other sites on the Internet.
          </p>

          <h3>7.2 Third-Party Links</h3>
          <p>
            Our Service may contain links to third-party websites or services that are not owned or
            controlled by us. We have no control over, and assume no responsibility for, the
            content, privacy policies, or practices of any third-party websites or services.
          </p>
        </section>

        <!-- Limitation of Liability -->
        <section class="fa-highlight-card">
          <h2>8. Limitation of Liability</h2>
          <p class="mb-4">
            <strong>TO THE MAXIMUM EXTENT PERMITTED BY LAW:</strong>
          </p>
          <ul>
            <li>
              The Service is provided "AS IS" and "AS AVAILABLE" without warranties of any kind,
              either express or implied
            </li>
            <li>We do not warrant that the Service will be uninterrupted, secure, or error-free</li>
            <li>
              We do not warrant the accuracy, reliability, or completeness of any calculations or
              information
            </li>
            <li>
              We shall not be liable for any direct, indirect, incidental, special, consequential,
              or punitive damages
            </li>
            <li>
              This includes damages for loss of profits, revenue, data, or business opportunities
            </li>
            <li>
              Our total liability shall not exceed $100 or the amount you paid to us in the last 12
              months (if any)
            </li>
          </ul>
        </section>

        <!-- Indemnification -->
        <section>
          <h2>9. Indemnification</h2>
          <p>
            You agree to indemnify, defend, and hold harmless Fanalyx and its officers, directors,
            employees, and agents from and against any claims, liabilities, damages, losses, and
            expenses, including reasonable attorney's fees, arising out of or in any way connected
            with your access to or use of the Service, or your violation of these Terms.
          </p>
        </section>

        <!-- Service Availability -->
        <section>
          <h2>10. Service Availability and Modifications</h2>
          <p class="mb-4">
            We reserve the right to:
          </p>
          <ul>
            <li>
              Modify or discontinue the Service (or any part thereof) temporarily or permanently
            </li>
            <li>Refuse service to anyone for any reason at any time</li>
            <li>Update, change, or discontinue any content, feature, or functionality</li>
            <li>Impose limits on certain features or restrict access to parts of the Service</li>
          </ul>
        </section>

        <!-- Termination -->
        <section>
          <h2>11. Termination</h2>
          <p>
            We may terminate or suspend your access to the Service immediately, without prior notice
            or liability, for any reason, including but not limited to breach of these Terms. Upon
            termination, your right to use the Service will immediately cease.
          </p>
        </section>

        <!-- Governing Law -->
        <section>
          <h2>12. Governing Law and Jurisdiction</h2>
          <p>
            These Terms shall be governed by and construed in accordance with the laws of the United
            States, without regard to its conflict of law provisions. Any disputes arising from
            these Terms or the Service shall be resolved in the courts located in the United States.
          </p>
        </section>

        <!-- Severability -->
        <section>
          <h2>13. Severability</h2>
          <p>
            If any provision of these Terms is held to be unenforceable or invalid, such provision
            will be changed and interpreted to accomplish the objectives of such provision to the
            greatest extent possible under applicable law, and the remaining provisions will
            continue in full force and effect.
          </p>
        </section>

        <!-- Changes to Terms -->
        <section>
          <h2>14. Changes to These Terms</h2>
          <p>
            We reserve the right to modify or replace these Terms at any time. We will provide
            notice of any material changes by posting the new Terms on this page and updating the
            "Last updated" date. Your continued use of the Service after any changes constitutes
            acceptance of the new Terms.
          </p>
        </section>

        <!-- Contact -->
        <section class="fa-highlight-card p-6">
          <h2>15. Contact Information</h2>
          <p class="mb-4">
            If you have any questions about these Terms, please contact us at:
          </p>
          <div class="fa-subcard">
            <p class="fa-meta-copy !mt-0 font-mono">
              Email: legal@fanalyx.com
            </p>
          </div>
        </section>
      </div>

      <!-- Back to Home Link -->
      <div class="mt-8 text-center">
        <a href="/" class="fa-inline-link">
          ← Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
