---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';

// FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the debt avalanche method?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The debt avalanche method pays off debts with the highest interest rates first while making minimum payments on others. This mathematically optimal strategy saves the most money on interest but may take longer to see individual debts eliminated."
      }
    },
    {
      "@type": "Question",
      "name": "What is the debt snowball method?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The debt snowball method pays off debts from smallest to largest balance regardless of interest rate. This provides quick psychological wins as debts are eliminated faster, which helps maintain motivation, though it may cost more in interest than the avalanche method."
      }
    },
    {
      "@type": "Question",
      "name": "Which debt payoff method is better?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The avalanche method saves more money on interest, while the snowball method provides faster psychological wins. Use our calculator to compare both strategies with your actual debts. If you need motivation, choose snowball. If you want maximum savings, choose avalanche."
      }
    },
    {
      "@type": "Question",
      "name": "Should I use a balance transfer to pay off debt?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Balance transfers with 0% intro APR can save significant interest if you can pay off the balance before the promotional period ends. Our calculator includes balance transfer scenarios to show potential savings after accounting for transfer fees."
      }
    }
  ]
};
---

<Layout 
  title="Debt Payoff Optimizer" 
  description="Compare debt payoff strategies including avalanche, snowball, and custom approaches"
  canonical={Astro.url.href}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center mb-4">
            <a href="/models/personal" class="mr-4 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
            </a>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
              Debt Payoff Optimizer
            </h1>
          </div>
          <p class="text-gray-600 dark:text-gray-300">
            Compare avalanche vs snowball strategies and find the fastest path to debt freedom
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Input Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Debt Information</h2>
            
            <form id="debt-form" class="space-y-6">
              <!-- Monthly Extra Payment -->
              <div>
                <label for="monthlyExtraPayment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Extra Monthly Payment
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-gray-500">$</span>
                  <input
                    type="number"
                    id="monthlyExtraPayment"
                    name="monthlyExtraPayment"
                    value="500"
                    min="0"
                    step="10"
                    required
                    class="w-full pl-8 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-red-500 dark:bg-gray-700 dark:text-white"
                  />
                </div>
                <p class="text-xs text-gray-500 mt-1">Amount above minimum payments</p>
              </div>

              <!-- Debt Items -->
              <div>
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-sm font-medium text-gray-900 dark:text-white">Your Debts</h3>
                  <button type="button" id="add-debt-btn" class="text-sm text-blue-600 hover:text-blue-700">
                    + Add Debt
                  </button>
                </div>

                <div id="debts-container" class="space-y-4">
                  <!-- Debt 1 -->
                  <div class="debt-item border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                    <div class="grid grid-cols-2 gap-3">
                      <div class="col-span-2">
                        <input
                          type="text"
                          name="debt-name-0"
                          placeholder="Debt name (e.g., Credit Card)"
                          value="Credit Card"
                          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"
                        />
                      </div>
                      <div>
                        <input
                          type="number"
                          name="debt-balance-0"
                          placeholder="Balance"
                          value="5000"
                          min="0"
                          step="100"
                          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"
                        />
                      </div>
                      <div>
                        <input
                          type="number"
                          name="debt-rate-0"
                          placeholder="APR %"
                          value="18.99"
                          min="0"
                          max="100"
                          step="0.01"
                          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"
                        />
                      </div>
                      <div class="col-span-2">
                        <input
                          type="number"
                          name="debt-minimum-0"
                          placeholder="Minimum payment"
                          value="150"
                          min="0"
                          step="10"
                          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-4">
                <button
                  type="submit"
                  id="calculate-btn"
                  class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-md transition"
                >
                  Calculate Payoff
                </button>
                <button
                  type="button"
                  id="reset-btn"
                  class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition"
                >
                  Reset
                </button>
              </div>
            </form>

            <!-- Loading/Error States -->
            <div id="loading" class="hidden mt-6 text-center">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-red-600"></div>
              <p class="text-gray-600 dark:text-gray-400 mt-2">Calculating...</p>
            </div>
            <div id="error" class="hidden mt-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
              <p class="text-red-800 dark:text-red-200" id="error-message"></p>
            </div>
          </div>

          <!-- Results -->
          <div>
            <div id="results" class="hidden space-y-6">
              <!-- Strategy Comparison -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Strategy Comparison</h3>
                <div class="space-y-4">
                  <div class="border-b border-gray-200 dark:border-gray-700 pb-4">
                    <h4 class="font-semibold text-red-600 mb-2">🎯 Avalanche (Highest Interest First)</h4>
                    <div class="grid grid-cols-2 gap-2 text-sm">
                      <span class="text-gray-600 dark:text-gray-400">Payoff Time:</span>
                      <span id="avalanche-months" class="font-semibold"></span>
                      <span class="text-gray-600 dark:text-gray-400">Total Interest:</span>
                      <span id="avalanche-interest" class="font-semibold"></span>
                    </div>
                  </div>
                  <div class="pb-4">
                    <h4 class="font-semibold text-blue-600 mb-2">⛄ Snowball (Lowest Balance First)</h4>
                    <div class="grid grid-cols-2 gap-2 text-sm">
                      <span class="text-gray-600 dark:text-gray-400">Payoff Time:</span>
                      <span id="snowball-months" class="font-semibold"></span>
                      <span class="text-gray-600 dark:text-gray-400">Total Interest:</span>
                      <span id="snowball-interest" class="font-semibold"></span>
                    </div>
                  </div>
                  <div id="savings-alert" class="bg-green-50 dark:bg-green-900/20 rounded-lg p-3">
                    <p class="text-sm font-semibold text-green-800 dark:text-green-200"></p>
                  </div>
                </div>
              </div>

              <!-- Payoff Timeline -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Avalanche Payoff Order</h3>
                <div id="payoff-timeline" class="space-y-3"></div>
              </div>

              <!-- Chat Button -->
              <button
                onclick="if (window.toggleChatPanel) { window.toggleChatPanel(); if (window.updateChatContext) { window.updateChatContext('Debt Payoff Optimizer', { tool: 'analyze_debt_payoff' }); } }"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-md transition flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                Ask AI about this strategy
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { storeAnalysisResult } from '../scripts/analysis-results';
  import { DebtPayoffEngine } from '@financial-analysis/analysis';

  const form = document.getElementById('debt-form') as HTMLFormElement;
  const addDebtBtn = document.getElementById('add-debt-btn');
  const debtsContainer = document.getElementById('debts-container');
  let debtCount = 1;

  const currencyFormatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
  });

  addDebtBtn?.addEventListener('click', () => {
    const debtHtml = `
      <div class="debt-item border border-gray-200 dark:border-gray-700 rounded-lg p-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <input type="text" name="debt-name-${debtCount}" placeholder="Debt name" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
          </div>
          <div><input type="number" name="debt-balance-${debtCount}" placeholder="Balance" min="0" step="100" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
          <div><input type="number" name="debt-rate-${debtCount}" placeholder="APR %" min="0" max="100" step="0.01" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
          <div class="col-span-2"><input type="number" name="debt-minimum-${debtCount}" placeholder="Minimum payment" min="0" step="10" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
        </div>
      </div>
    `;
    debtsContainer?.insertAdjacentHTML('beforeend', debtHtml);
    debtCount++;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    document.getElementById('results')?.classList.add('hidden');
    document.getElementById('error')?.classList.add('hidden');
    document.getElementById('loading')?.classList.remove('hidden');

    try {
      const formData = new FormData(form);
      const monthlyExtraPayment = parseFloat(formData.get('monthlyExtraPayment') as string);

      const debts = [];
      for (let i = 0; i < debtCount; i++) {
        const name = formData.get(`debt-name-${i}`) as string;
        const balance = parseFloat(formData.get(`debt-balance-${i}`) as string);
        const rate = parseFloat(formData.get(`debt-rate-${i}`) as string);
        const minimum = parseFloat(formData.get(`debt-minimum-${i}`) as string);

        if (name && !isNaN(balance) && !isNaN(rate) && !isNaN(minimum)) {
          debts.push({
            name: name,
            balance: balance,
            interestRate: rate / 100,
            minimumPayment: minimum,
          });
        }
      }

      if (debts.length === 0) {
        throw new Error('Please add at least one debt');
      }

      const input = { 
        debts, 
        extraMonthlyPayment: monthlyExtraPayment,
        strategy: 'avalanche' as const
      };
      const result = DebtPayoffEngine.analyze(input);
      
      storeAnalysisResult('analyze_debt_payoff', result);
      displayResults(result);

    } catch (err) {
      const errorEl = document.getElementById('error-message');
      if (errorEl) errorEl.textContent = err instanceof Error ? err.message : 'An error occurred';
      document.getElementById('error')?.classList.remove('hidden');
    } finally {
      document.getElementById('loading')?.classList.add('hidden');
    }
  });

  document.getElementById('reset-btn')?.addEventListener('click', () => {
    form.reset();
    document.getElementById('results')?.classList.add('hidden');
    document.getElementById('error')?.classList.add('hidden');
  });

  function displayResults(result: any) {
    const avMonths = result.avalanchePayoff.totalMonths;
    const avInterest = result.avalanchePayoff.totalInterest;
    const sbMonths = result.snowballPayoff.totalMonths;
    const sbInterest = result.snowballPayoff.totalInterest;

    document.getElementById('avalanche-months')!.textContent = `${avMonths} months (${(avMonths/12).toFixed(1)} years)`;
    document.getElementById('avalanche-interest')!.textContent = avInterest;
    document.getElementById('snowball-months')!.textContent = `${sbMonths} months (${(sbMonths/12).toFixed(1)} years)`;
    document.getElementById('snowball-interest')!.textContent = sbInterest;

    const savingsEl = document.getElementById('savings-alert')?.querySelector('p');
    if (savingsEl && avMonths <= sbMonths) {
      const savings = parseFloat(sbInterest.replace(/[$,]/g, '')) - parseFloat(avInterest.replace(/[$,]/g, ''));
      savingsEl.textContent = `💡 Avalanche saves you ${currencyFormatter.format(savings)} in interest!`;
    } else if (savingsEl) {
      savingsEl.textContent = `💡 Snowball provides faster psychological wins with ${sbMonths - avMonths} fewer months!`;
    }

    const timeline = document.getElementById('payoff-timeline');
    if (timeline && result.avalanchePayoff.payoffOrder) {
      timeline.innerHTML = result.avalanchePayoff.payoffOrder.map((debt: any, idx: number) => `
        <div class="flex justify-between items-center text-sm">
          <span class="font-medium">${idx + 1}. ${debt.name}</span>
          <span class="text-gray-600 dark:text-gray-400">Month ${debt.payoffMonth}</span>
        </div>
      `).join('');
    }

    document.getElementById('results')?.classList.remove('hidden');
  }
</script>

<!-- AdSense: Bottom of page ad -->
<AdSense slot="8901234567" format="horizontal" className="container mx-auto px-4 mb-8" />
</Layout>
