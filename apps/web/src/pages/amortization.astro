---
import Layout from '../layouts/Layout.astro';
import AdSense from '../components/AdSense.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';

// FAQ Schema for SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is an amortization schedule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An amortization schedule is a table showing each loan payment over time, breaking down how much goes toward principal versus interest. Early payments consist mostly of interest, while later payments pay down more principal. This schedule helps you see exactly when you'll be debt-free."
      }
    },
    {
      "@type": "Question",
      "name": "How do extra payments affect my mortgage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Extra payments directly reduce your principal balance, which lowers future interest charges and can shorten your loan term significantly. For example, adding $200/month to a $300,000 mortgage at 6% can save over $80,000 in interest and cut years off the loan."
      }
    },
    {
      "@type": "Question",
      "name": "Should I make biweekly mortgage payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Biweekly payments (half your monthly payment every two weeks) result in 26 half-payments per year - equivalent to 13 monthly payments instead of 12. This extra payment per year can reduce a 30-year mortgage by 4-6 years and save tens of thousands in interest."
      }
    },
    {
      "@type": "Question",
      "name": "How is mortgage interest calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mortgage interest is calculated monthly on your remaining principal balance. The formula is: (annual rate ÷ 12) × current balance. As you pay down principal, the interest portion decreases while the principal portion increases, even though your total payment stays the same."
      }
    }
  ]
};

---

<Layout title="Amortization Calculator" description="Calculate loan amortization schedules with detailed payment breakdowns" canonical={Astro.url.href}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="container mx-auto px-4 py-8">
    <!-- Structured Data: Breadcrumbs + SoftwareApplication -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.url).toString() },
          { '@type': 'ListItem', position: 2, name: 'Amortization', item: Astro.url.href },
        ],
      })}
    </script>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Amortization Calculator',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web',
        url: Astro.url.href,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
      })}
    </script>
    <div class="max-w-6xl mx-auto">
      <h1 class="text-3xl font-bold mb-2">Amortization Calculator</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        Calculate loan payments and view detailed amortization schedules
      </p>

      <!-- Input Form -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-semibold mb-6">Loan Parameters</h2>

  <form id="amortization-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Loan Amount -->
            <div>
              <label for="principal" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Loan Amount ($)
              </label>
              <input
                type="number"
                id="principal"
                name="principal"
                step="0.01"
                min="0"
                value="300000"
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                placeholder="300000"
                required
              />
            </div>

            <!-- Annual Interest Rate -->
            <div>
              <label for="annualRate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Annual Interest Rate (%)
              </label>
              <input
                type="number"
                id="annualRate"
                name="annualRate"
                step="0.01"
                min="0"
                max="100"
                value="6.5"
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                placeholder="6.5"
                required
              />
            </div>

            <!-- Loan Term -->
            <div>
              <label for="termMonths" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Loan Term (Months)
              </label>
              <input
                type="number"
                id="termMonths"
                name="termMonths"
                min="1"
                value="360"
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                placeholder="360"
                required
              />
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Common: 360 (30yr), 180 (15yr), 60 (5yr)</p>
            </div>

            <!-- Extra Monthly Payment (Optional) -->
            <div>
              <label for="extraMonthlyPayment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Extra Monthly Payment ($) <span class="text-gray-500">(Optional)</span>
              </label>
              <input
                type="number"
                id="extraMonthlyPayment"
                name="extraMonthlyPayment"
                step="0.01"
                min="0"
                value="0"
                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                placeholder="0"
              />
            </div>
          </div>

          <!-- PITI Section (Tax, Insurance, HOA) -->
          <div class="mt-6 p-4 bg-purple-50 dark:bg-purple-900/20 rounded-lg border border-purple-200 dark:border-purple-800">
            <h3 class="text-md font-semibold mb-4 text-purple-900 dark:text-purple-100">Housing Costs (PITI)</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <!-- Property Tax -->
              <div>
                <label for="propertyTaxAnnual" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Annual Property Tax ($) <span class="text-gray-500">(Optional)</span>
                </label>
                <input
                  type="number"
                  id="propertyTaxAnnual"
                  name="propertyTaxAnnual"
                  step="0.01"
                  min="0"
                  value="0"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                  placeholder="0"
                />
              </div>

              <!-- Home Insurance -->
              <div>
                <label for="homeInsuranceAnnual" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Annual Home Insurance ($) <span class="text-gray-500">(Optional)</span>
                </label>
                <input
                  type="number"
                  id="homeInsuranceAnnual"
                  name="homeInsuranceAnnual"
                  step="0.01"
                  min="0"
                  value="0"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                  placeholder="0"
                />
              </div>

              <!-- HOA Fees -->
              <div>
                <label for="hoaMonthly" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Monthly HOA Fees ($) <span class="text-gray-500">(Optional)</span>
                </label>
                <input
                  type="number"
                  id="hoaMonthly"
                  name="hoaMonthly"
                  step="0.01"
                  min="0"
                  value="0"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                  placeholder="0"
                />
              </div>
            </div>
          </div>

          <!-- APR Calculation Inputs -->
          <div class="mt-6 p-4 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg border border-yellow-200 dark:border-yellow-800">
            <h3 class="text-md font-semibold mb-4 text-yellow-900 dark:text-yellow-100">APR & Cost Summary</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Down Payment -->
              <div>
                <label for="downPayment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Down Payment ($) <span class="text-gray-500">(Optional)</span>
                </label>
                <input
                  type="number"
                  id="downPayment"
                  name="downPayment"
                  step="0.01"
                  min="0"
                  value="0"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                  placeholder="0"
                />
              </div>

              <!-- Closing Costs -->
              <div>
                <label for="closingCosts" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Total Closing Costs ($) <span class="text-gray-500">(Optional)</span>
                </label>
                <input
                  type="number"
                  id="closingCosts"
                  name="closingCosts"
                  step="0.01"
                  min="0"
                  value="0"
                  class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white"
                  placeholder="0"
                />
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Includes fees, points, appraisal, title, etc.</p>
              </div>
            </div>
          </div>

          <div class="flex gap-4 mt-6">
            <button
              type="submit"
              id="analyze-btn"
              class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              Calculate Amortization
            </button>
            <button
              type="button"
              id="reset-btn"
              class="px-6 py-2 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-500 text-gray-800 dark:text-white rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2"
            >
              Reset
            </button>
          </div>
        </form>
      </div>

      <!-- Results Container -->
      <div id="results-section" class="hidden">
        <div id="results-container">
          <!-- Summary Cards -->
          <div id="summary-cards" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8"></div>

          <!-- Amortization Table -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold mb-4">Payment Schedule</h2>
            <div class="overflow-x-auto">
              <table id="amortization-table" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-900">
                  <tr>
                    <th class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Month</th>
                    <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Payment</th>
                    <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Principal</th>
                    <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Interest</th>
                    <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Balance</th>
                    <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Cumulative Interest</th>
                  </tr>
                </thead>
                <tbody id="table-body" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                  <!-- Rows will be inserted here -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- AdSense: After results ad -->
          <AdSense slot="2345678901" format="auto" className="mt-8" />
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-8">
        <div class="flex items-center justify-center py-6">
          <div class="h-8 w-8 animate-spin rounded-full border-2 border-blue-200 border-t-blue-600"></div>
          <span class="ml-3 text-gray-600 dark:text-gray-300">Calculating amortization&hellip;</span>
        </div>
      </div>

      <!-- Error State -->
      <div id="error-state" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-8">
        <div class="text-red-800 dark:text-red-200">
          <h3 class="font-semibold mb-2">Amortization Error</h3>
          <p id="error-message">We could not calculate the amortization schedule. Please review your inputs and try again.</p>
        </div>
      </div>
    </div>
  </div>
  <ClientScriptLoader client:load slot="pageScripts" name="amortization" />
</Layout>

<style>
  /* Year highlighting */
  #amortization-table tbody tr:nth-child(12n) {
    font-weight: 600;
  }
</style>
