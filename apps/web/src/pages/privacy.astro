---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: baseUrl },
        { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: currentUrl },
      ],
    },
    {
      '@type': 'WebPage',
      name: 'Privacy Policy',
      description: 'Learn how Fanalyx protects your privacy and handles your data.',
      url: currentUrl,
      isPartOf: { '@type': 'WebSite', name: 'Fanalyx', url: baseUrl },
    },
  ],
};
---

<Layout
  title="Privacy Policy - Fanalyx"
  description="Learn how Fanalyx protects your privacy. All calculator data stays in your browser - we never store your financial information. View our complete data protection and cookie policy."
  canonical={Astro.url.href}
  keywords="privacy policy, data protection, financial data privacy, user privacy, GDPR, data collection, cookie policy, no data storage"
  type="article"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />

  <div class="fa-page-shell-narrow">
    <div>
      <h1 class="fa-display fa-display-section !mt-0 mb-4">
        Privacy Policy
      </h1>
      <p class="fa-meta-copy mb-8 !mt-0">Last updated: October 22, 2025</p>

      <div class="fa-prose-card space-y-8">
        <!-- Introduction -->
        <section>
          <h2>1. Introduction</h2>
          <p>
            Welcome to Fanalyx ("we," "our," or "us"). We are committed to protecting your privacy
            and ensuring transparency about how we collect, use, and share your information. This
            Privacy Policy explains our practices regarding data collection and use when you visit
            our website.
          </p>
        </section>

        <!-- Information We Collect -->
        <section>
          <h2>
            2. Information We Collect
          </h2>

          <h3>2.1 Information You Provide</h3>
          <p class="mb-4">
            <strong>Calculator Inputs:</strong> All financial calculations are performed entirely in your
            browser. We do not collect, store, or transmit any of the financial data you enter into our
            calculators (such as loan amounts, interest rates, income, expenses, etc.). This data remains
            on your device.
          </p>

          <h3>2.2 Automatically Collected Information</h3>
          <ul>
            <li>
              <strong>Usage Data:</strong> We collect information about how you interact with our website,
              including pages visited, features used, and time spent on pages.
            </li>
            <li>
              <strong>Device Information:</strong> We collect information about the device you use to
              access our site, including browser type, operating system, and IP address.
            </li>
            <li>
              <strong>Cookies and Similar Technologies:</strong> We use cookies and similar tracking technologies
              to enhance your experience and analyze site usage.
            </li>
          </ul>
        </section>

        <!-- Google AdSense -->
        <section class="fa-highlight-card">
          <h2>
            3. Third-Party Advertising (Google AdSense)
          </h2>

          <p class="mb-4">
            We use <strong>Google AdSense</strong> to display advertisements on our website. Google AdSense
            uses cookies and other tracking technologies to serve ads based on your prior visits to our
            website or other websites on the Internet.
          </p>

          <h3>3.1 How Google AdSense Works</h3>
          <ul class="mb-4">
            <li>
              Google uses cookies to serve ads based on your previous visits to this site and other
              sites
            </li>
            <li>
              Google's use of advertising cookies enables it and its partners to serve ads based on
              your visit to our site and/or other sites on the Internet
            </li>
            <li>
              Users may opt out of personalized advertising by visiting <a
                href="https://www.google.com/settings/ads"
                class="fa-inline-link"
                target="_blank"
                rel="noopener noreferrer">Google Ads Settings</a>
            </li>
            <li>
              Users may opt out of third-party vendor's use of cookies by visiting <a
                href="http://www.aboutads.info/choices/"
                class="fa-inline-link"
                target="_blank"
                rel="noopener noreferrer">aboutads.info</a>
            </li>
          </ul>

          <h3>3.2 Data Collected by Google AdSense</h3>
          <p class="mb-4">
            Google may collect the following types of information:
          </p>
          <ul class="mb-4">
            <li>Information about your visit, such as pages viewed and time spent on pages</li>
            <li>Device and browser information</li>
            <li>IP address and location data (approximate geographic location)</li>
            <li>Advertising cookies and identifiers</li>
          </ul>

          <p>
            For more information about Google's privacy practices, please review the
            <a
              href="https://policies.google.com/privacy"
                class="fa-inline-link"
                target="_blank"
                rel="noopener noreferrer">Google Privacy Policy</a
            >.
          </p>
        </section>

        <!-- How We Use Information -->
        <section>
          <h2>
            4. How We Use Information
          </h2>
          <p class="mb-4">
            We use the information we collect to:
          </p>
          <ul>
            <li>Provide, maintain, and improve our services</li>
            <li>Analyze usage patterns to enhance user experience</li>
            <li>Display relevant advertisements through Google AdSense</li>
            <li>Detect and prevent fraud or abuse</li>
            <li>Comply with legal obligations</li>
          </ul>
        </section>

        <!-- Data Security -->
        <section>
          <h2>
            5. Data Security
          </h2>
          <p>
            We implement appropriate technical and organizational measures to protect your
            information. However, please note that no method of transmission over the Internet or
            electronic storage is 100% secure. Since all financial calculations are performed
            locally in your browser, your sensitive financial data never leaves your device.
          </p>
        </section>

        <!-- Your Rights and Choices -->
        <section>
          <h2>
            6. Your Rights and Choices
          </h2>

          <h3>6.1 Cookie Management</h3>
          <p class="mb-4">
            You can control and manage cookies in various ways:
          </p>
          <ul class="mb-4">
            <li>Browser settings: Most browsers allow you to refuse or accept cookies</li>
            <li>
              Opt-out tools: Use the opt-out tools provided by Google and other advertising networks
            </li>
            <li>Do Not Track: We respond to Do Not Track (DNT) signals</li>
          </ul>

          <h3>6.2 Personalized Advertising</h3>
          <p class="mb-4">
            You can opt out of personalized advertising by:
          </p>
          <ul>
            <li>
              Visiting <a
                href="https://www.google.com/settings/ads"
                class="fa-inline-link"
                target="_blank"
                rel="noopener noreferrer">Google Ads Settings</a>
            </li>
            <li>
              Using the <a
                href="http://www.aboutads.info/choices/"
                class="fa-inline-link"
                target="_blank"
                rel="noopener noreferrer">Digital Advertising Alliance opt-out tool</a>
            </li>
            <li>
              Using the <a
                href="http://www.youronlinechoices.eu/"
                class="fa-inline-link"
                target="_blank"
                rel="noopener noreferrer"
                >European Interactive Digital Advertising Alliance opt-out tool</a
              > (for users in the EU)
            </li>
          </ul>
        </section>

        <!-- International Data Transfers -->
        <section>
          <h2>
            7. International Data Transfers
          </h2>
          <p>
            Our services are hosted on Cloudflare Workers, which may process data in various
            locations globally. Google AdSense may also transfer and process data internationally.
            When we transfer data internationally, we ensure appropriate safeguards are in place to
            protect your information.
          </p>
        </section>

        <!-- Children's Privacy -->
        <section>
          <h2>
            8. Children's Privacy
          </h2>
          <p>
            Our services are not directed to children under the age of 13 (or 16 in the European
            Economic Area). We do not knowingly collect personal information from children. If you
            believe we have collected information from a child, please contact us immediately.
          </p>
        </section>

        <!-- GDPR and CCPA Compliance -->
        <section>
          <h2>
            9. GDPR and CCPA Rights
          </h2>

          <h3>9.1 For European Users (GDPR)</h3>
          <p class="mb-4">
            If you are located in the European Economic Area, you have the following rights:
          </p>
          <ul class="mb-4">
            <li>
              <strong>Right to access:</strong> You can request information about the personal data we
              hold about you
            </li>
            <li>
              <strong>Right to rectification:</strong> You can request correction of inaccurate data
            </li>
            <li>
              <strong>Right to erasure:</strong> You can request deletion of your personal data
            </li>
            <li>
              <strong>Right to restrict processing:</strong> You can request that we limit how we use
              your data
            </li>
            <li>
              <strong>Right to data portability:</strong> You can request a copy of your data in a machine-readable
              format
            </li>
            <li>
              <strong>Right to object:</strong> You can object to processing of your personal data
            </li>
          </ul>

          <h3>9.2 For California Users (CCPA)</h3>
          <p class="mb-4">
            If you are a California resident, you have the following rights:
          </p>
          <ul>
            <li>
              <strong>Right to know:</strong> You can request information about the personal data we collect
            </li>
            <li>
              <strong>Right to delete:</strong> You can request deletion of your personal data
            </li>
            <li>
              <strong>Right to opt-out:</strong> You can opt out of the sale of your personal data (note:
              we do not sell personal data)
            </li>
            <li>
              <strong>Right to non-discrimination:</strong> You will not receive discriminatory treatment
              for exercising your privacy rights
            </li>
          </ul>
        </section>

        <!-- Changes to This Policy -->
        <section>
          <h2>
            10. Changes to This Privacy Policy
          </h2>
          <p>
            We may update this Privacy Policy from time to time. We will notify you of any changes
            by posting the new Privacy Policy on this page and updating the "Last updated" date. We
            encourage you to review this Privacy Policy periodically for any changes.
          </p>
        </section>

        <!-- Contact Us -->
        <section class="fa-highlight-card p-6">
          <h2>11. Contact Us</h2>
          <p class="mb-4">
            If you have any questions about this Privacy Policy or our data practices, please
            contact us at:
          </p>
          <div class="fa-subcard">
            <p class="fa-meta-copy !mt-0 font-mono">
              Email: privacy@fanalyx.com
            </p>
          </div>
        </section>

        <!-- Summary Box -->
        <section
          class="fa-highlight-card p-6"
        >
          <h3>📝 Key Takeaways</h3>
          <ul>
            <li>
              <strong>Your financial data stays on your device</strong> - We don't collect or store calculator
              inputs
            </li>
            <li>
              <strong>We use Google AdSense</strong> - Ads are displayed based on cookies and browsing
              history
            </li>
            <li>
              <strong>You have control</strong> - You can opt out of personalized ads and manage cookies
            </li>
            <li>
              <strong>We're transparent</strong> - This policy clearly explains what data we collect and
              why
            </li>
            <li><strong>Your rights matter</strong> - We respect GDPR and CCPA privacy rights</li>
          </ul>
        </section>
      </div>

      <!-- Back to Home Link -->
      <div class="mt-8 text-center">
        <a href="/" class="fa-inline-link">
          ← Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
