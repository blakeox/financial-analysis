---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';

const baseUrl = 'https://fanalyx.com';

// Structured data for 404 page - helps search engines understand it's an error page
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Page Not Found",
  "description": "The page you're looking for doesn't exist. Explore our 29 free financial calculators and tools.",
  "url": `${baseUrl}/404`,
  "isPartOf": {
    "@type": "WebSite",
    "name": "Fanalyx",
    "url": baseUrl
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${baseUrl}/calculators`,
    "name": "Browse Calculators"
  }
};
---

<Layout 
  title="Page Not Found - 404 | Fanalyx" 
  description="The page you're looking for doesn't exist. Explore our 29 free financial calculators and tools."
  noindex={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: '404' }]} />

  <div class="fa-page-shell-narrow">
      <div class="text-center mb-10">
        <div class="mb-4 text-8xl font-bold text-violet-600">404</div>
        <PageHero
          title="Page Not Found"
          description="The page you're looking for doesn't exist or has been moved."
          actions={[{ href: '/', label: 'Go to Homepage' }]}
        />
      </div>

      <SurfaceCard>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
          Popular Financial Calculators
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a 
            href="/calculator/amortization" 
            class="p-3 text-center rounded-lg bg-gray-50 dark:bg-gray-700 hover:bg-blue-50 dark:hover:bg-blue-900 transition-colors"
          >
            <div class="text-2xl mb-2">🏠</div>
            <div class="text-sm font-medium text-gray-900 dark:text-white">Mortgage</div>
          </a>
          <a 
            href="/calculator/auto-loan" 
            class="p-3 text-center rounded-lg bg-gray-50 dark:bg-gray-700 hover:bg-blue-50 dark:hover:bg-blue-900 transition-colors"
          >
            <div class="text-2xl mb-2">🚗</div>
            <div class="text-sm font-medium text-gray-900 dark:text-white">Auto Loan</div>
          </a>
          <a 
            href="/calculator/retirement" 
            class="p-3 text-center rounded-lg bg-gray-50 dark:bg-gray-700 hover:bg-blue-50 dark:hover:bg-blue-900 transition-colors"
          >
            <div class="text-2xl mb-2">🏖️</div>
            <div class="text-sm font-medium text-gray-900 dark:text-white">Retirement</div>
          </a>
          <a 
            href="/lease-analysis" 
            class="p-3 text-center rounded-lg bg-gray-50 dark:bg-gray-700 hover:bg-blue-50 dark:hover:bg-blue-900 transition-colors"
          >
            <div class="text-2xl mb-2">📊</div>
            <div class="text-sm font-medium text-gray-900 dark:text-white">Lease Analysis</div>
          </a>
        </div>
      </SurfaceCard>

      <div class="mt-8 text-sm text-gray-600 dark:text-gray-400">
        Or explore our 
        <a href="/models" class="fa-inline-link">full calculator suite</a>, 
        <a href="/journey" class="fa-inline-link">financial journeys</a>, or
        <a href="/sitemap-index.xml" class="fa-inline-link">browse sitemap</a>
      </div>
  </div>
</Layout>
