---
import AgentChatPanel from '../components/AgentChatPanel';
import Layout from '../layouts/Layout.astro';

const title = 'Fanalyx Agent | Cloudflare Project Think';
const description =
  'Use the Fanalyx Project Think agent for persistent financial conversations backed by deterministic amortization and lease analysis tools.';
const keywords =
  'cloudflare agents, project think, financial analysis agent, amortization agent, lease analysis agent';
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-8 max-w-3xl">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-blue-600 dark:text-blue-300"
      >
        Agents Week update
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Persistent financial chat, now on Cloudflare Project Think
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        This is the new Fanalyx agent runtime. It keeps its own Cloudflare Durable Object-backed
        session, uses deterministic finance tools for calculations, and sits alongside the legacy
        enhanced chat without replacing it.
      </p>
    </div>

    <div class="mb-8 grid gap-4 md:grid-cols-3">
      <div
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950"
      >
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Persistent sessions</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Each browser gets a stable agent session name so the conversation can continue across page
          reloads.
        </p>
      </div>
      <div
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950"
      >
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Deterministic tools</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Amortization and lease calculations run through the existing analysis engines instead of
          freeform LLM math.
        </p>
      </div>
      <div
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950"
      >
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
          Same-origin agent route
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          The app proxies Cloudflare agent traffic through the existing web worker so the React
          client can connect over the app origin.
        </p>
      </div>
    </div>

    <AgentChatPanel client:only="react" />
  </section>
</Layout>
