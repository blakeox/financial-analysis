---
import AgentChatPanel from '../components/AgentChatPanel';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Fanalyx Agent | Cloudflare Project Think';
const description =
  'Use the Fanalyx Project Think agent as a persistent workspace for longer-running financial conversations backed by deterministic amortization and lease analysis tools.';
const keywords =
  'cloudflare agents, project think, financial analysis agent, amortization agent, lease analysis agent';
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={Astro.url.href}
  showChat={false}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Agent' }]} />

  <section class="fa-page-shell">
    <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
      <div>
        <PageHero
          eyebrow="Advanced workspace"
          title="Persistent financial workspace for ongoing analysis"
          description="Use the Fanalyx agent when you want a longer-running thread that survives page reloads, keeps your context together, and leans on deterministic tools when the math matters."
        />

        <div class="mt-6 grid gap-4">
          <SurfaceCard
            title="Persistent sessions"
            description="Each browser gets a stable session name so the conversation can continue across reloads."
          />
          <SurfaceCard
            title="Deterministic tools"
            description="Amortization and lease calculations still run through the analysis engines instead of freeform LLM math."
            className="fa-surface-accent"
          />
          <SurfaceCard
            title="Same-origin agent route"
            description="The web worker proxies Cloudflare agent traffic so the client stays on the app origin."
          />
        </div>
      </div>

      <SurfaceCard className="fa-surface-glow">
        <AgentChatPanel client:only="react" />
      </SurfaceCard>
    </div>
  </section>
</Layout>
