---
import Layout from '../layouts/Layout.astro';

const title = "Enhanced Lease Analysis Calculator | Fanalyx";
const description = "Advanced lease analysis with sensitivity testing, lease-vs-buy comparison, and NPV calculations. Free professional lease calculator for commercial and equipment leases.";
const keywords = "lease analysis, lease calculator, NPV calculator, lease vs buy, commercial lease, equipment lease, lease comparison, sensitivity analysis";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl },
        { "@type": "ListItem", "position": 2, "name": "Enhanced Lease Analysis", "item": currentUrl }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Enhanced Lease Analysis Calculator",
      "description": description,
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "url": currentUrl,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      }
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  
  <!-- Breadcrumb Navigation -->
  <nav class="container mx-auto px-4 py-4" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
      <li><a href="/" class="hover:text-blue-600">Home</a></li>
      <li><span aria-hidden="true">/</span></li>
      <li><span class="text-gray-900 dark:text-white font-medium" aria-current="page">Enhanced Lease Analysis</span></li>
    </ol>
  </nav>
  
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">
        Enhanced Lease Analysis Calculator
      </h1>
      <p class="text-slate-600 dark:text-slate-400">
        Professional lease analysis with sensitivity testing, lease-vs-buy comparison, and NPV calculations.
      </p>
    </div>
    <div id="enhanced-lease-container"></div>
  </main>
</Layout>

<script>
  import { LeaseAnalysisDashboard } from '@financial-analysis/ui';
  import { createElement } from 'react';
  import { createRoot } from 'react-dom/client';

  const container = document.getElementById('enhanced-lease-container');
  if (container) {
    const root = createRoot(container);
    root.render(
      createElement(LeaseAnalysisDashboard, {
        onAnalyze: (result) => {
          console.log('Enhanced lease analysis result:', result);
        }
      })
    );
  }
</script>