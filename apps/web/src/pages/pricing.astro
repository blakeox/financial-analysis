---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';
import ClientScriptLoader from '../components/ClientScriptLoader.tsx';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';

const title = 'API Pricing Plans - Financial Analysis | Free & Pro Tiers';
const description =
  'Simple, transparent pricing for the Financial Analysis API. Start free with 1,000 requests/month, upgrade to Pro or Enterprise as you grow. No hidden fees.';
const keywords =
  'api pricing, financial api cost, free api tier, developer pricing, financial calculator api pricing, rest api plans';

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Pricing',
          item: currentUrl,
        },
      ],
    },
    {
      '@type': 'Product',
      name: 'Fanalyx Financial Analysis API',
      description: description,
      brand: {
        '@type': 'Brand',
        name: 'Fanalyx',
      },
      offers: [
        {
          '@type': 'Offer',
          name: 'Free Tier',
          price: '0',
          priceCurrency: 'USD',
          description: '1,000 requests/month, 1 request/second rate limit',
        },
        {
          '@type': 'Offer',
          name: 'Pro Tier',
          price: '29',
          priceCurrency: 'USD',
          description: '50,000 requests/month, 10 requests/second rate limit',
        },
        {
          '@type': 'Offer',
          name: 'Enterprise',
          description: '1,000,000 requests/month, custom rate limits, dedicated support',
        },
      ],
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Pricing' }]} />

  <div class="fa-page-shell">
      <section class="relative overflow-hidden rounded-[32px] border border-gray-200 bg-white/90 px-6 py-10 shadow-[0_18px_50px_rgba(9,14,36,0.08)] sm:px-8 lg:px-12 lg:py-14">
        <div
          class="absolute inset-y-0 right-0 w-1/2 bg-[radial-gradient(circle_at_top,rgba(109,74,255,0.16),transparent_55%)]"
          aria-hidden="true"
        >
        </div>
        <div class="relative grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <PageHero
            eyebrow="Pricing"
            title="Simple, Transparent Pricing"
            description="Start free, upgrade as you grow, and keep the economics readable. Fanalyx pricing is built for teams using the API for financial calculations and AI-assisted workflows."
            actions={[
              { href: '/developers', label: 'Get Your Free API Key' },
              { href: '/agent', label: 'Explore the product', variant: 'secondary' },
            ]}
          />

          <div class="grid gap-4 sm:grid-cols-2">
            <SurfaceCard className="bg-gray-50" title="Starting point">
              <p class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-gray-900">$0</p>
              <p class="mt-2 text-sm leading-7 text-gray-600">
                Free tier for trying the API, validating use cases, and testing contract shapes.
              </p>
            </SurfaceCard>
            <SurfaceCard className="bg-violet-50/80" title="Scaling up">
              <p class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-gray-900">$29</p>
              <p class="mt-2 text-sm leading-7 text-gray-600">
                Pro tier for live integrations, higher throughput, and direct support when needed.
              </p>
            </SurfaceCard>
            <SurfaceCard className="sm:col-span-2" title="Built for clarity">
              <p class="mt-3 text-sm leading-7 text-gray-600">
                No vague enterprise-only pricing wall up front. You can start small, see the math,
                and talk to us when your usage becomes real.
              </p>
            </SurfaceCard>
          </div>
        </div>
      </section>

      <section class="mt-14">
        <div class="mb-10 text-center">
          <h2
            class="text-3xl font-semibold tracking-[-0.04em] text-gray-900 sm:text-4xl"
            style="font-family: var(--font-serif);"
          >
            Compare plans
          </h2>
          <p class="mt-4 text-base leading-7 text-gray-600">
            The pricing cards below are loaded from the current pricing configuration.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-3" id="pricing-tiers">
          <div
            class="col-span-3 rounded-[28px] border border-gray-200 bg-white p-12 text-center shadow-[0_18px_50px_rgba(9,14,36,0.07)]"
          >
            <div
              class="inline-block h-12 w-12 animate-spin rounded-full border-b-2 border-violet-600"
            >
            </div>
            <p class="mt-4 text-gray-600">Loading pricing...</p>
          </div>
        </div>
      </section>

      <section
        class="mt-20 rounded-[32px] border border-gray-200 bg-white p-4 shadow-[0_18px_50px_rgba(9,14,36,0.07)] sm:p-6"
      >
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <h2
              class="text-3xl font-semibold tracking-[-0.04em] text-gray-900"
              style="font-family: var(--font-serif);"
            >
              Compare Features
            </h2>
            <p class="mt-2 text-sm text-gray-600">
              The same core analysis surface, with more room to scale as usage grows.
            </p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead>
              <tr class="text-left text-sm font-semibold text-gray-900">
                <th class="px-4 py-4">Feature</th>
                <th class="px-4 py-4 text-center">Free</th>
                <th class="px-4 py-4 text-center">Pro</th>
                <th class="px-4 py-4 text-center">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm">
              <tr>
                <td class="px-4 py-4 text-gray-900">Monthly Requests</td>
                <td class="px-4 py-4 text-center text-gray-600">1,000</td>
                <td class="px-4 py-4 text-center text-gray-600">50,000</td>
                <td class="px-4 py-4 text-center text-gray-600">1,000,000</td>
              </tr>
              <tr class="bg-gray-50/80">
                <td class="px-4 py-4 text-gray-900">Rate Limit</td>
                <td class="px-4 py-4 text-center text-gray-600">1/sec</td>
                <td class="px-4 py-4 text-center text-gray-600">10/sec</td>
                <td class="px-4 py-4 text-center text-gray-600">100/sec</td>
              </tr>
              <tr>
                <td class="px-4 py-4 text-gray-900">Lease Analysis</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
              </tr>
              <tr class="bg-gray-50/80">
                <td class="px-4 py-4 text-gray-900">Amortization Schedules</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
              </tr>
              <tr>
                <td class="px-4 py-4 text-gray-900">EBITDA Forecasting</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
              </tr>
              <tr class="bg-gray-50/80">
                <td class="px-4 py-4 text-gray-900">Email Support</td>
                <td class="px-4 py-4 text-center">—</td>
                <td class="px-4 py-4 text-center">✓</td>
                <td class="px-4 py-4 text-center">✓</td>
              </tr>
              <tr>
                <td class="px-4 py-4 text-gray-900">Priority Support</td>
                <td class="px-4 py-4 text-center">—</td>
                <td class="px-4 py-4 text-center">—</td>
                <td class="px-4 py-4 text-center">✓</td>
              </tr>
              <tr class="bg-gray-50/80">
                <td class="px-4 py-4 text-gray-900">SLA Guarantee</td>
                <td class="px-4 py-4 text-center">—</td>
                <td class="px-4 py-4 text-center">—</td>
                <td class="px-4 py-4 text-center text-gray-600">99.9%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mx-auto mt-20 max-w-3xl">
        <div class="mb-10 text-center">
          <h2
            class="text-3xl font-semibold tracking-[-0.04em] text-gray-900 sm:text-4xl"
            style="font-family: var(--font-serif);"
          >
            Frequently asked questions
          </h2>
        </div>

        <div class="space-y-5">
          <details
            class="group rounded-[24px] border border-gray-200 bg-white p-6 shadow-[0_18px_50px_rgba(9,14,36,0.06)]"
          >
            <summary
              class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-gray-900"
            >
              What happens if I exceed my quota?
              <span class="ml-2 transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-sm leading-7 text-gray-600">
              Once you reach your monthly quota, additional requests are charged at the overage rate
              for your tier. You can also upgrade to increase your quota before you hit that
              ceiling.
            </p>
          </details>

          <details
            class="group rounded-[24px] border border-gray-200 bg-white p-6 shadow-[0_18px_50px_rgba(9,14,36,0.06)]"
          >
            <summary
              class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-gray-900"
            >
              Can I cancel anytime?
              <span class="ml-2 transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-sm leading-7 text-gray-600">
              Yes. You can cancel a paid plan any time and keep access through the current billing
              period before dropping back to the free tier.
            </p>
          </details>

          <details
            class="group rounded-[24px] border border-gray-200 bg-white p-6 shadow-[0_18px_50px_rgba(9,14,36,0.06)]"
          >
            <summary
              class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-gray-900"
            >
              Do you offer custom enterprise plans?
              <span class="ml-2 transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-4 text-sm leading-7 text-gray-600">
              Yes. If you need custom quotas, support, or deployment requirements, contact{' '}
              <a href="mailto:enterprise@fanalyx.com" class="text-violet-700 hover:text-violet-800">
                enterprise@fanalyx.com
              </a>
              .
            </p>
          </details>
        </div>
      </section>

      <section
        class="mt-20 rounded-[32px] bg-[radial-gradient(circle_at_20%_20%,rgba(109,74,255,0.38),transparent_30%),linear-gradient(135deg,#050816,#160B38)] px-6 py-10 text-white shadow-[0_24px_80px_rgba(17,24,39,0.18)] sm:px-10 lg:px-14"
      >
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <h2
              class="text-3xl font-semibold tracking-[-0.04em] sm:text-4xl"
              style="font-family: var(--font-serif);"
            >
              Ready to get started?
            </h2>
            <p class="mt-4 max-w-2xl text-base leading-8 text-white/78">
              Start with the free tier, evaluate the contract, and scale only when your use case is
              ready.
            </p>
          </div>
          <a
            href="/developers"
            class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-gray-900 transition hover:-translate-y-0.5"
          >
            Get Your Free API Key
          </a>
        </div>
      </section>
  </div>
  <ClientScriptLoader client:load slot="pageScripts" name="pricing" />
</Layout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
