---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Developer Dashboard - Financial Analysis API';
const description = 'Manage your Financial Analysis API subscription, view usage analytics, access API keys, and manage billing. Monitor your API requests in real-time.';
const keywords = "api dashboard, developer portal, api usage, api management, financial api console, billing management";
---

<Layout title={title} description={description} keywords={keywords} canonical={Astro.url.href} noindex={true}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Dashboard' }]} />

  <div class="fa-page-shell">
      <PageHero
        eyebrow="Account"
        title="Dashboard"
        description="Manage your API subscription, view usage, and handle billing from one shared workspace."
      />

      <SurfaceCard className="mb-6">
        <h2 class="fa-panel-title mb-4">Account Information</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="fa-field-label">Email</label>
            <p class="mt-1 text-gray-900" id="user-email">Loading...</p>
          </div>
          <div>
            <label class="fa-field-label">Customer ID</label>
            <p class="mt-1 text-gray-600 font-mono text-sm" id="customer-id">Loading...</p>
          </div>
        </div>
      </SurfaceCard>

      <div id="current-plan">
      <SurfaceCard className="mb-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="fa-panel-title">Current Plan</h2>
          <button 
            onclick="manageBilling()"
            class="fa-button-primary"
          >
            Manage Billing
          </button>
        </div>
        
        <div class="text-center py-8">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
          <p class="fa-meta-copy mt-2">Loading plan details...</p>
        </div>
      </SurfaceCard>
      </div>

      <div id="usage-stats">
      <SurfaceCard className="mb-6">
        <h2 class="fa-panel-title mb-4">Usage This Month</h2>
        
        <div class="text-center py-8">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
          <p class="fa-meta-copy mt-2">Loading usage data...</p>
        </div>
      </SurfaceCard>
      </div>

      <SurfaceCard>
        <div class="flex justify-between items-center mb-4">
          <h2 class="fa-panel-title">API Keys</h2>
          <a 
            href="/developers" 
            class="fa-inline-link"
          >
            View Documentation →
          </a>
        </div>
        
        <div id="api-keys-list">
          <div class="text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
            <p class="fa-meta-copy mt-2">Loading API keys...</p>
          </div>
        </div>
      </SurfaceCard>

      <div class="mt-8 grid md:grid-cols-3 gap-6">
        <a 
          href="/pricing" 
          class="block transition hover:-translate-y-1"
        >
          <SurfaceCard title="Upgrade Plan" description="Get more requests and higher rate limits." className="h-full" />
        </a>
        
        <a 
          href="/developers" 
          class="block transition hover:-translate-y-1"
        >
          <SurfaceCard title="API Documentation" description="Learn how to integrate the API." className="h-full" />
        </a>
        
        <a 
          href="mailto:support@fanalyx.com" 
          class="block transition hover:-translate-y-1"
        >
          <SurfaceCard title="Get Support" description="Contact us for help or questions." className="h-full" />
        </a>
      </div>
  </div>
</Layout>

<script>
  const API_BASE = 'https://fanalyx-api-production.blakeoxford.workers.dev';

  // Get customer info from localStorage
  const customerId = localStorage.getItem('customerId');
  const customerEmail = localStorage.getItem('customerEmail');

  // Display customer info
  const emailEl = document.getElementById('user-email');
  const customerIdEl = document.getElementById('customer-id');
  
  if (emailEl && customerEmail) {
    emailEl.textContent = customerEmail;
  }
  if (customerIdEl && customerId) {
    customerIdEl.textContent = customerId;
  }

  // Load API keys and usage
  async function loadDashboardData() {
    if (!customerId) {
      // No customer ID - redirect to get started
      window.location.href = '/developers';
      return;
    }

    try {
      // Load API keys
      const keysResponse = await fetch(`${API_BASE}/v1/keys?customerId=${customerId}`);
      const keysData = await keysResponse.json();

      if (keysData.success && keysData.keys.length > 0) {
        renderApiKeys(keysData.keys);
        renderCurrentPlan(keysData.keys[0]);

        // Load usage for first key
        const usageResponse = await fetch(`${API_BASE}/v1/keys/${keysData.keys[0].id}/usage`);
        const usageData = await usageResponse.json();
        
        if (usageData.success) {
          renderUsageStats(usageData.usage, keysData.keys[0]);
        }
      } else {
        renderNoKeys();
      }
    } catch (error) {
      console.error('Failed to load dashboard data:', error);
      renderError();
    }
  }

  function renderCurrentPlan(key: any) {
    const container = document.getElementById('current-plan');
    if (!container) return;

    const tierNames: Record<string, string> = {
      free: 'Free Tier',
      pro: 'Pro Tier',
      enterprise: 'Enterprise Tier',
      test: 'Test Tier'
    };

    container.innerHTML = `
      <article class="fa-card">
        <div class="flex justify-between items-center mb-4 gap-4">
          <h2 class="fa-panel-title">Current Plan</h2>
          <button 
            onclick="manageBilling()"
            class="fa-button-primary"
          >
            Manage Billing
          </button>
        </div>
        
        <div class="grid md:grid-cols-3 gap-6">
          <div class="fa-subcard">
            <label class="fa-field-label">Plan</label>
            <p class="mt-1 text-2xl font-bold text-gray-900 capitalize">${tierNames[key.tier] || key.tier}</p>
          </div>
          <div class="fa-subcard">
            <label class="fa-field-label">Monthly Quota</label>
            <p class="mt-1 text-2xl font-bold text-gray-900">${key.monthlyQuota.toLocaleString()}</p>
            <p class="fa-meta-copy">requests/month</p>
          </div>
          <div class="fa-subcard">
            <label class="fa-field-label">Rate Limit</label>
            <p class="mt-1 text-2xl font-bold text-gray-900">${key.rateLimitPerSec}</p>
            <p class="fa-meta-copy">requests/second</p>
          </div>
        </div>

        ${key.tier === 'free' ? `
          <div class="fa-highlight-card mt-6">
            <p class="text-indigo-900 font-semibold">Ready to scale?</p>
            <p class="text-indigo-700 text-sm mt-1">Upgrade to Pro for 50,000 requests/month and 10x faster rate limits.</p>
            <a href="/pricing" class="fa-button-primary mt-3">
              View Pricing
            </a>
          </div>
        ` : ''}
      </article>
    `;
  }

  function renderUsageStats(usage: any, key: any) {
    const container = document.getElementById('usage-stats');
    if (!container) return;

    const current = usage.currentMonth || { totalRequests: 0 };
    const percentage = (current.totalRequests / key.monthlyQuota) * 100;
    const remaining = Math.max(0, key.monthlyQuota - current.totalRequests);

    container.innerHTML = `
      <article class="fa-card">
         <h2 class="fa-panel-title mb-6">Usage This Month</h2>
        
        <div class="mb-6">
          <div class="flex justify-between items-center mb-2">
            <span class="fa-field-label">Requests Used</span>
            <span class="fa-list-copy-strong">${current.totalRequests.toLocaleString()} / ${key.monthlyQuota.toLocaleString()}</span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
            <div 
              class="h-3 rounded-full ${percentage > 80 ? 'bg-red-500' : percentage > 50 ? 'bg-yellow-500' : 'bg-green-500'}" 
              style="width: ${Math.min(percentage, 100)}%"
            ></div>
          </div>
          <p class="fa-meta-copy mt-1">${remaining.toLocaleString()} requests remaining</p>
        </div>

        <div class="grid md:grid-cols-4 gap-4">
          <div class="fa-subcard">
            <p class="fa-meta-copy">Total Requests</p>
            <p class="text-2xl font-bold text-gray-900">${(current.totalRequests || 0).toLocaleString()}</p>
          </div>
          <div class="fa-subcard">
            <p class="fa-meta-copy">Successful</p>
            <p class="text-2xl font-bold text-green-600">${(current.successfulRequests || 0).toLocaleString()}</p>
          </div>
          <div class="fa-subcard">
            <p class="fa-meta-copy">Failed</p>
            <p class="text-2xl font-bold text-red-600">${(current.failedRequests || 0).toLocaleString()}</p>
          </div>
          <div class="fa-subcard">
            <p class="fa-meta-copy">Avg Response</p>
            <p class="text-2xl font-bold text-gray-900">${current.totalRequests > 0 ? Math.round(current.totalResponseTimeMs / current.totalRequests) : 0}ms</p>
          </div>
        </div>

        ${percentage > 80 ? `
          <div class="fa-highlight-card mt-6">
            <p class="text-yellow-900 font-semibold">⚠️ Approaching quota limit</p>
            <p class="text-yellow-700 text-sm mt-1">You've used ${percentage.toFixed(1)}% of your monthly quota. Consider upgrading to avoid service interruption.</p>
          </div>
        ` : ''}
      </article>
    `;
  }

  function renderApiKeys(keys: any[]) {
    const container = document.getElementById('api-keys-list');
    if (!container) return;

    container.innerHTML = `
      <div class="space-y-4">
        ${keys.map(key => `
          <div class="fa-subcard">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-sm text-gray-900">${key.keyPrefix}••••••••••••</span>
                  ${key.active ? 
                    '<span class="fa-chip fa-chip-success">Active</span>' : 
                    '<span class="fa-chip fa-chip-muted">Inactive</span>'
                  }
                  <span class="fa-chip fa-chip-accent capitalize">${key.tier}</span>
                </div>
                <p class="text-sm text-gray-600 mt-2">${key.metadata?.description || 'API Key'}</p>
                <p class="text-xs text-gray-500 mt-1">Created: ${new Date(key.createdAt).toLocaleDateString()}</p>
                ${key.lastUsedAt ? `<p class="text-xs text-gray-500">Last used: ${new Date(key.lastUsedAt).toLocaleDateString()}</p>` : ''}
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  function renderNoKeys() {
    const planContainer = document.getElementById('current-plan');
    const usageContainer = document.getElementById('usage-stats');
    const keysContainer = document.getElementById('api-keys-list');

    if (planContainer) {
      planContainer.innerHTML = `
        <article class="fa-card text-center py-8">
          <p class="text-gray-600">No API keys found.</p>
          <a href="/developers" class="fa-button-primary mt-4">
            Create Your First API Key
          </a>
        </article>
      `;
    }
    
    if (usageContainer) usageContainer.style.display = 'none';
    if (keysContainer) keysContainer.style.display = 'none';
  }

  function renderError() {
    const container = document.getElementById('current-plan');
    if (!container) return;

    container.innerHTML = `
      <article class="fa-card text-center py-8">
        <p class="text-red-600">Failed to load dashboard data. Please try again later.</p>
      </article>
    `;
  }

  // Manage billing via Stripe Customer Portal
  (window as any).manageBilling = async function() {
    if (!customerId) {
      alert('No customer ID found. Please create an API key first.');
      window.location.href = '/developers';
      return;
    }

    try {
      const response = await fetch(`${API_BASE}/v1/stripe/create-portal`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ customerId })
      });

      const data = await response.json();

      if (data.success && data.url) {
        window.location.href = data.url;
      } else {
        alert('Unable to access billing portal. You may not have an active subscription yet.');
      }
    } catch (error) {
      console.error('Portal error:', error);
      alert('An error occurred. Please try again.');
    }
  };

  // Load data on page load
  loadDashboardData();
</script>
