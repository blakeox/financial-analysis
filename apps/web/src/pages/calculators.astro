---
import { CALCULATOR_CONFIGS } from '../components/CalculatorTemplate.tsx';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import PageHero from '../components/site/PageHero.astro';
import SurfaceCard from '../components/site/SurfaceCard.astro';
import Layout from '../layouts/Layout.astro';

const calculators = Object.values(CALCULATOR_CONFIGS);

const keywords = "financial calculators, mortgage calculator, auto loan calculator, retirement planning, savings goal, debt payoff, student loans, budget planner";
const enhancedDescription = "Comprehensive collection of free financial calculators for mortgages, auto loans, retirement planning, savings goals, debt payoff, student loans, and budgeting. Professional-grade financial analysis tools.";

const baseUrl = 'https://fanalyx.com';
const currentUrl = `${baseUrl}${Astro.url.pathname}`;

// JSON-LD Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Financial Calculators",
  "description": enhancedDescription,
  "url": currentUrl,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": baseUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Calculators",
        "item": currentUrl
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": calculators.map((calc, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": calc.title,
      "description": calc.description,
      "url": `${baseUrl}/calculator/${calc.id}`
    }))
  }
};
---

<Layout 
  title="Financial Calculators" 
  description={enhancedDescription}
  canonical={Astro.url.href}
  keywords={keywords}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Calculators' }]} />

  <div class="fa-page-shell">
      <PageHero
        eyebrow="Calculators"
        title="Financial Calculators"
        description="Professional-grade financial analysis tools to help you evaluate mortgages, loans, retirement, savings, debt payoff, and other everyday decisions."
      />

      <div class="grid grid-cols-1 gap-6 mb-12 md:grid-cols-2 lg:grid-cols-3">
        {calculators.map((calculator) => (
          <SurfaceCard className="h-full">
            <div class="flex items-center mb-4">
              <span class="mr-3 text-3xl">{calculator.icon}</span>
              <h2 class="fa-panel-title">
                {calculator.title}
              </h2>
            </div>

            <p class="fa-scenario-copy mb-4">
              {calculator.description}
            </p>

              <div class="mb-4 flex flex-wrap gap-2">
                {calculator.keywords.slice(0, 3).map((keyword) => (
                  <span class="fa-chip fa-chip-accent">
                    {keyword}
                  </span>
                ))}
              </div>

              <div class="mt-auto pt-2">
                <a 
                  href={`/calculator/${calculator.id}`}
                  class="fa-button-primary w-full"
                >
                  Use Calculator
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </SurfaceCard>
        ))}
      </div>

      <SurfaceCard className="mb-12">
        <h2 class="fa-panel-title text-2xl mb-6 text-center">
          Why Choose Our Financial Calculators?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-info mx-auto mb-4">
              <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="fa-scenario-title mb-2">Professional Grade</h3>
            <p class="fa-scenario-copy">Built with industry-standard formulas and validated calculations for accurate results.</p>
          </div>
          <div class="text-center">
            <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-success mx-auto mb-4">
              <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="fa-scenario-title mb-2">Lightning Fast</h3>
            <p class="fa-scenario-copy">Instant calculations with real-time updates as you adjust parameters.</p>
          </div>
          <div class="text-center">
            <div class="fa-icon-tile fa-icon-tile-lg fa-icon-tile-accent mx-auto mb-4">
              <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <h3 class="fa-scenario-title mb-2">Privacy First</h3>
            <p class="fa-scenario-copy">All calculations happen in your browser. No data is stored or transmitted.</p>
          </div>
        </div>
      </SurfaceCard>

      <div class="fa-highlight-card text-center">
        <h2 class="fa-panel-title text-2xl mb-4">
          Ready to Take Control of Your Finances?
        </h2>
        <p class="fa-scenario-copy mb-6">
          Start with any calculator above or explore our comprehensive financial journey guides.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/journey/young-professional"
            class="fa-button-primary"
          >
            Start Financial Journey
          </a>
          <a 
            href="/models"
            class="fa-button-secondary"
          >
            Browse All Models
          </a>
        </div>
      </div>
  </div>
</Layout>
