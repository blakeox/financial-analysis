---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Student Loan Analyzer" 
  description="Optimize student loan repayment with avalanche, snowball, income-driven, and refinancing strategies"
  canonical={Astro.url.href}
>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center mb-4">
            <a href="/models/personal" class="mr-4 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
            </a>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
              Student Loan Analyzer
            </h1>
          </div>
          <p class="text-gray-600 dark:text-gray-300">
            Compare repayment strategies including standard, income-driven, and refinancing options
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Input Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6">Loan Information</h2>
            
            <form id="loan-form" class="space-y-6">
              <!-- Extra Monthly Payment -->
              <div>
                <label for="extraMonthlyPayment" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Extra Monthly Payment
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-gray-500">$</span>
                  <input
                    type="number"
                    id="extraMonthlyPayment"
                    name="extraMonthlyPayment"
                    value="200"
                    min="0"
                    step="10"
                    class="w-full pl-8 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  />
                </div>
              </div>

              <!-- Payment Strategy -->
              <div>
                <label for="paymentStrategy" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Payment Strategy
                </label>
                <select
                  id="paymentStrategy"
                  name="paymentStrategy"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                >
                  <option value="avalanche">Avalanche (Highest Interest First)</option>
                  <option value="snowball">Snowball (Lowest Balance First)</option>
                  <option value="standard">Standard (Even Payments)</option>
                </select>
              </div>

              <!-- Loans -->
              <div>
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-sm font-medium text-gray-900 dark:text-white">Your Loans</h3>
                  <button type="button" id="add-loan-btn" class="text-sm text-blue-600 hover:text-blue-700">
                    + Add Loan
                  </button>
                </div>

                <div id="loans-container" class="space-y-4">
                  <!-- Loan 1 -->
                  <div class="loan-item border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                    <div class="grid grid-cols-2 gap-3">
                      <div class="col-span-2">
                        <input type="text" name="loan-name-0" placeholder="Loan name" value="Federal Unsubsidized" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                      </div>
                      <div>
                        <input type="number" name="loan-balance-0" placeholder="Balance" value="25000" min="0" step="100" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                      </div>
                      <div>
                        <input type="number" name="loan-rate-0" placeholder="APR %" value="5.5" min="0" max="100" step="0.01" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                      </div>
                      <div>
                        <input type="number" name="loan-minimum-0" placeholder="Min payment" value="275" min="0" step="10" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" />
                      </div>
                      <div>
                        <select name="loan-type-0" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm">
                          <option value="federal_unsubsidized">Federal Unsubsidized</option>
                          <option value="federal_subsidized">Federal Subsidized</option>
                          <option value="private">Private</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex gap-4">
                <button type="submit" id="calculate-btn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition">
                  Calculate Payoff
                </button>
                <button type="button" id="reset-btn" class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                  Reset
                </button>
              </div>
            </form>

            <!-- Loading/Error States -->
            <div id="loading" class="hidden mt-6 text-center">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
              <p class="text-gray-600 dark:text-gray-400 mt-2">Calculating...</p>
            </div>
            <div id="error" class="hidden mt-6 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
              <p class="text-red-800 dark:text-red-200" id="error-message"></p>
            </div>
          </div>

          <!-- Results -->
          <div>
            <div id="results" class="hidden space-y-6">
              <!-- Summary -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Payoff Summary</h3>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Balance:</span>
                    <span id="total-balance" class="font-semibold"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Payoff Time:</span>
                    <span id="payoff-time" class="font-semibold"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Total Interest:</span>
                    <span id="total-interest" class="font-semibold text-red-600"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600 dark:text-gray-400">Monthly Payment:</span>
                    <span id="monthly-payment" class="font-semibold"></span>
                  </div>
                </div>
              </div>

              <!-- Payoff Order -->
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Payoff Order</h3>
                <div id="payoff-order" class="space-y-3"></div>
              </div>

              <!-- Chat Button -->
              <button
                onclick="if (window.toggleChatPanel) { window.toggleChatPanel(); if (window.updateChatContext) { window.updateChatContext('Student Loan Analyzer', { tool: 'analyze_student_loans' }); } }"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-md transition flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                Ask AI about this strategy
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { storeAnalysisResult } from '../scripts/analysis-results';
  import { StudentLoanEngine } from '@financial-analysis/analysis';

  const form = document.getElementById('loan-form') as HTMLFormElement;
  const addLoanBtn = document.getElementById('add-loan-btn');
  const loansContainer = document.getElementById('loans-container');
  let loanCount = 1;

  const currencyFormatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
  });

  addLoanBtn?.addEventListener('click', () => {
    const loanHtml = `
      <div class="loan-item border border-gray-200 dark:border-gray-700 rounded-lg p-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2"><input type="text" name="loan-name-${loanCount}" placeholder="Loan name" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
          <div><input type="number" name="loan-balance-${loanCount}" placeholder="Balance" min="0" step="100" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
          <div><input type="number" name="loan-rate-${loanCount}" placeholder="APR %" min="0" max="100" step="0.01" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
          <div><input type="number" name="loan-minimum-${loanCount}" placeholder="Min payment" min="0" step="10" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm" /></div>
          <div><select name="loan-type-${loanCount}" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-700 dark:text-white text-sm"><option value="federal_unsubsidized">Federal Unsubsidized</option><option value="federal_subsidized">Federal Subsidized</option><option value="private">Private</option></select></div>
        </div>
      </div>
    `;
    loansContainer?.insertAdjacentHTML('beforeend', loanHtml);
    loanCount++;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    document.getElementById('results')?.classList.add('hidden');
    document.getElementById('error')?.classList.add('hidden');
    document.getElementById('loading')?.classList.remove('hidden');

    try {
      const formData = new FormData(form);
      const extraMonthlyPayment = parseFloat(formData.get('extraMonthlyPayment') as string) || 0;
      const paymentStrategy = formData.get('paymentStrategy') as 'avalanche' | 'snowball' | 'standard';

      const loans = [];
      for (let i = 0; i < loanCount; i++) {
        const name = formData.get(`loan-name-${i}`) as string;
        const balance = parseFloat(formData.get(`loan-balance-${i}`) as string);
        const rate = parseFloat(formData.get(`loan-rate-${i}`) as string);
        const minimum = parseFloat(formData.get(`loan-minimum-${i}`) as string);
        const loanType = formData.get(`loan-type-${i}`) as 'federal_subsidized' | 'federal_unsubsidized' | 'private';

        if (name && !isNaN(balance) && !isNaN(rate) && !isNaN(minimum)) {
          loans.push({
            name,
            balance,
            interestRate: rate / 100,
            minimumPayment: minimum,
            loanType: loanType || 'federal_unsubsidized',
          });
        }
      }

      if (loans.length === 0) {
        throw new Error('Please add at least one loan');
      }

      const input = { 
        loans, 
        extraMonthlyPayment, 
        paymentStrategy,
        forgivenessEligible: false
      };
      const result = StudentLoanEngine.analyze(input);
      
      storeAnalysisResult('analyze_student_loans', result);
      displayResults(result);

    } catch (err) {
      const errorEl = document.getElementById('error-message');
      if (errorEl) errorEl.textContent = err instanceof Error ? err.message : 'An error occurred';
      document.getElementById('error')?.classList.remove('hidden');
    } finally {
      document.getElementById('loading')?.classList.add('hidden');
    }
  });

  document.getElementById('reset-btn')?.addEventListener('click', () => {
    form.reset();
    document.getElementById('results')?.classList.add('hidden');
    document.getElementById('error')?.classList.add('hidden');
  });

  function displayResults(result: any) {
    document.getElementById('total-balance')!.textContent = result.summary.totalBalance;
    document.getElementById('payoff-time')!.textContent = `${result.summary.payoffMonths} months (${(result.summary.payoffMonths/12).toFixed(1)} years)`;
    document.getElementById('total-interest')!.textContent = result.summary.totalInterest;
    document.getElementById('monthly-payment')!.textContent = result.summary.totalMonthlyPayment;

    const orderEl = document.getElementById('payoff-order');
    if (orderEl && result.payoffSchedule) {
      orderEl.innerHTML = result.payoffSchedule.map((loan: any, idx: number) => `
        <div class="flex justify-between items-center text-sm">
          <span class="font-medium">${idx + 1}. ${loan.loanName || loan.name}</span>
          <span class="text-gray-600 dark:text-gray-400">${loan.balance || loan.remainingBalance}</span>
        </div>
      `).join('');
    }

    document.getElementById('results')?.classList.remove('hidden');
  }
</script>
</Layout>
