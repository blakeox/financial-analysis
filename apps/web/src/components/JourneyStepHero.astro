---
import WorkflowHero from './WorkflowHero.astro';

export interface Props {
  title: string;
  description: string;
  currentStep: number;
  totalSteps: number;
  scenarioName: string;
  icon?: string;
  supportingText?: string;
}

const props = Astro.props as Props;
---

