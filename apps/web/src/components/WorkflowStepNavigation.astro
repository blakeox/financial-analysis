---
export interface StepLink {
  name: string;
  url: string;
}

export interface Props {
  helperText: string;
  backLabel: string;
  backHref: string;
  previousStep?: StepLink | null;
  nextStep?: StepLink | null;
  completeHref?: string;
  completeLabel?: string;
}

const {
  helperText,
  backLabel,
  backHref,
  previousStep = null,
  nextStep = null,
  completeHref,
  completeLabel = 'Complete journey',
} = Astro.props as Props;
---

<section class="fa-card p-5">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="fa-card-copy fa-card-copy-sm !mt-0">{helperText}</div>
    <div class="flex flex-col gap-3 sm:flex-row">
      {
        previousStep ? (
          <a href={previousStep.url} class="fa-button-secondary inline-flex px-4 py-2 text-sm">
            {previousStep.name}
          </a>
        ) : (
          <a href={backHref} class="fa-button-secondary inline-flex px-4 py-2 text-sm">
            {backLabel}
          </a>
        )
      }

      {
        nextStep ? (
          <a href={nextStep.url} class="fa-button-primary inline-flex px-4 py-2 text-sm">
            Next: {nextStep.name}
          </a>
        ) : (
          completeHref && (
            <a href={completeHref} class="fa-button-primary inline-flex px-4 py-2 text-sm">
              {completeLabel}
            </a>
          )
        )
      }
    </div>
  </div>
</section>
