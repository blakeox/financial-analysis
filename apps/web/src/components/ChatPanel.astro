---
import '../styles/chat-theme.css';

export interface Props {
  variant?: 'global' | 'embedded';
}

const { variant = 'global' } = Astro.props as Props;
const isEmbedded = variant === 'embedded';
---

<!-- VS Code-style chat panel component for contextual model assistance -->
<div
  id="chat-panel"
  class="chat-panel"
  data-chat-variant={variant}
  role={isEmbedded ? 'region' : 'dialog'}
  aria-modal={isEmbedded ? undefined : 'true'}
  aria-labelledby="chat-panel-title"
  aria-hidden={isEmbedded ? 'false' : 'true'}
>
  <div class="chat-header">
    <div class="chat-title" id="chat-panel-title">
      <span>{isEmbedded ? 'Guided analysis' : 'Site guide'}</span>
      <span class="context-indicator" id="context-indicator"></span>
    </div>
    {!isEmbedded && (
      <button id="chat-close" class="chat-close" type="button" aria-label="Close chat panel">
        <svg width="16" height="16" viewBox="0 0 16 16">
          <path fill="currentColor" d="m8.746 8 3.1-3.1a.527.527 0 1 0-.746-.746L8 7.254l-3.1-3.1a.527.527 0 0 0-.746.746l3.1 3.1-3.1 3.1a.527.527 0 1 0 .746.746l3.1-3.1 3.1 3.1a.527.527 0 1 0 .746-.746L8.746 8Z"/>
        </svg>
        <span class="sr-only">Close chat</span>
      </button>
    )}
  </div>

  <div id="assistant-status" class="assistant-status hidden" aria-live="polite"></div>
  
  <div class="chat-content">
    <div id="chat-messages" class="chat-messages">
      <div class="system-message">
        <p>{isEmbedded ? 'Calculate once, then ask me to explain the result, compare scenarios, or update the form in plain English.' : 'Hi — I can explain this page, point you to the right workflow, and answer questions about the tools available here.'}</p>
        <ul>
          <li>{isEmbedded ? '"What changed my payment the most?"' : '"Which model should I start with for this goal?"'}</li>
          <li>{isEmbedded ? '"Compare this with a 20-year term"' : '"What does this page help me do?"'}</li>
          <li>{isEmbedded ? '"Raise the loan amount to $400,000"' : '"Where should I go for a lease or amortization analysis?"'}</li>
        </ul>
      </div>
    </div>
    
    <div class="chat-input-container">
      <div class="thinking-indicator hidden" id="thinking-indicator">
        <div class="thinking-dots">
          <span></span><span></span><span></span>
        </div>
        <span class="thinking-text">AI is thinking...</span>
      </div>
      <form id="chat-form" class="chat-input-wrapper">
          <textarea 
            id="chat-input" 
            class="chat-input" 
            placeholder={isEmbedded ? 'After you calculate, ask what changed, compare scenarios, or update fields in plain English...' : 'Ask about this page, workflow, or available tools...'}
            rows="1"
            maxlength="2000"
            aria-label="Chat message input"
          aria-describedby="chat-char-counter"
        ></textarea>
        <div class="input-controls">
          <span id="chat-char-counter" class="char-counter" aria-live="polite">0/2000</span>
          <button
            id="chat-send"
            class="chat-send"
            type="submit"
            disabled
            aria-label="Send chat message"
          >
            <svg width="16" height="16" viewBox="0 0 16 16">
              <path fill="currentColor" d="M2.5 2v4.5L9 8 2.5 9.5V14l11-6-11-6z"/>
            </svg>
            <span class="sr-only">Send</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

{!isEmbedded && (
  <button
    id="chat-toggle"
    class="chat-toggle"
    type="button"
    title="Open site guide"
    aria-label="Open site guide"
    aria-controls="chat-panel"
    aria-expanded="false"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M5 4c-1.657 0-3 1.343-3 3v6c0 1.657 1.343 3 3 3h2.382a1 1 0 01.707.293l2.828 2.828A1 1 0 0012 18.828V17h7c1.657 0 3-1.343 3-3V7c0-1.657-1.343-3-3-3H5zm0 2h14a1 1 0 011 1v7a1 1 0 01-1 1H11a1 1 0 00-1 1v1.586l-1.414-1.414A1 1 0 008.172 14H5a1 1 0 01-1-1V7a1 1 0 011-1zm2 3a1 1 0 000 2h8a1 1 0 000-2H7zm0 3a1 1 0 000 2h5a1 1 0 000-2H7z"
      />
    </svg>
    <span class="sr-only">Toggle site guide</span>
  </button>
)}

<script>
  import '../scripts/chat/chat-panel.ts';
</script>

<script is:inline>
  // Diagnostic script to detect what might be blocking the chat button
  (function() {
    console.log('[ChatPanel Diagnostic] Starting element inspection...');
    
        // Global click listener to see what's receiving clicks
    document.addEventListener('click', (e) => {
      const target = e.target;
      console.log('[Global Click] User clicked on:', target);
      console.log('[Global Click] Element details:', {
        tagName: target.tagName,
        id: target.id,
        className: target.className,
        classList: Array.from(target.classList || []),
        pointerEvents: window.getComputedStyle(target).pointerEvents,
        zIndex: window.getComputedStyle(target).zIndex,
        position: window.getComputedStyle(target).position,
        parent: target.parentElement?.tagName,
        parentId: target.parentElement?.id
      });
      
      // Check if button has event listeners
      if (target.id === 'chat-toggle') {
        console.log('[Global Click] Button clicked!');
        console.log('[Global Click] Button onclick:', target.onclick);
      }
    }, true);
    
    // Monitor if button gets replaced
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.removedNodes.forEach((node) => {
          if (node.nodeType === 1 && node.id === 'chat-toggle') {
            console.error('[ChatPanel Diagnostic] ⚠️ BUTTON WAS REMOVED FROM DOM!', node);
          }
        });
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === 1 && node.id === 'chat-toggle') {
            console.error('[ChatPanel Diagnostic] ⚠️ NEW BUTTON ADDED TO DOM!', node);
          }
        });
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
    
    function inspectButton() {
      const button = document.getElementById('chat-toggle');
      if (!button) {
        console.error('[ChatPanel Diagnostic] Button not found!');
        return;
      }
      
      console.log('[ChatPanel Diagnostic] Button found:', button);
      
      const rect = button.getBoundingClientRect();
      console.log('[ChatPanel Diagnostic] Button position:', {
        top: rect.top,
        left: rect.left,
        bottom: rect.bottom,
        right: rect.right,
        width: rect.width,
        height: rect.height
      });
      
      const computedStyle = window.getComputedStyle(button);
      console.log('[ChatPanel Diagnostic] Button computed style:', {
        position: computedStyle.position,
        zIndex: computedStyle.zIndex,
        pointerEvents: computedStyle.pointerEvents,
        display: computedStyle.display,
        visibility: computedStyle.visibility,
        opacity: computedStyle.opacity,
        userSelect: computedStyle.userSelect,
        cursor: computedStyle.cursor
      });
      
      // Check what element is at the button's center
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const elementAtPoint = document.elementFromPoint(centerX, centerY);
      
      console.log('[ChatPanel Diagnostic] Element at button center:', elementAtPoint);
      console.log('[ChatPanel Diagnostic] Button ID match?', elementAtPoint?.id === 'chat-toggle');
      
      if (elementAtPoint?.id === 'chat-toggle') {
        console.log('[ChatPanel Diagnostic] ✅ Button is at center');
        console.log('[ChatPanel Diagnostic] 👆 NOW CLICK THE RED BUTTON WITH YOUR MOUSE!');
      }
    }
    
    // Run on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(inspectButton, 500);
      });
    } else {
      setTimeout(inspectButton, 500);
    }
  })();
</script>
