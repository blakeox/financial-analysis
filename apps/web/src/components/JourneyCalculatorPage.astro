---
import Breadcrumbs from './site/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';
import AdSense from './AdSense.astro';
import { CALCULATOR_CONFIGS, generateFormHTMLWithValidation } from './CalculatorTemplate.tsx';
import { getJourneyCalculatorConfig } from '../utils/journeyCalculatorConfigs';
import ClientScriptLoader from './ClientScriptLoader.tsx';
import type { ClientScriptName } from './ClientScriptLoader.tsx';
import WorkflowPageIntro from './WorkflowPageIntro.astro';
import WorkflowProgressStrip from './WorkflowProgressStrip.astro';
import JourneyStepNavigation from './JourneyStepNavigation.astro';
import WorkflowSupportRail from './WorkflowSupportRail.astro';
import { hasAnalysisEngine } from '../scripts/analysis/analysis-event-contract.ts';

export interface Props {
  calculatorId: string;
  title?: string;
  description?: string;
  journeyNav?: {
    scenarioId: string;
    scenarioName: string;
    currentStep: number;
    totalSteps: number;
    nextStep: { id: string; name: string; url: string } | null;
    previousStep: { id: string; name: string; url: string } | null;
    journeyOverviewUrl: string;
  };
}

const { calculatorId, title, description, journeyNav } = Astro.props as Props;

let config;
let isJourneySpecific = false;

if (journeyNav) {
  const journeyConfig = getJourneyCalculatorConfig(journeyNav.scenarioId, calculatorId);
  if (journeyConfig) {
    config = journeyConfig;
    isJourneySpecific = true;
  } else {
    config = CALCULATOR_CONFIGS[calculatorId];
  }
} else {
  config = CALCULATOR_CONFIGS[calculatorId];
}

if (!config) {
  throw new Error(`Calculator configuration not found for: ${calculatorId}`);
}

let backHref = '/models';
let backLabel = 'Models';

if (journeyNav) {
  backHref = journeyNav.journeyOverviewUrl;
  backLabel = journeyNav.scenarioName;
} else if (config.category === 'business') {
  backHref = '/models/business';
  backLabel = 'Business Models';
}

const formHTML = generateFormHTMLWithValidation(config.formFields);
const primaryClientScript = (config.clientScript ?? null) as ClientScriptName | null;

const journeyContext = {
  scenarioId: journeyNav?.scenarioId ?? null,
  currentStep: journeyNav?.currentStep ?? null,
  totalSteps: journeyNav?.totalSteps ?? null,
  isJourneySpecific,
  calculatorId,
};

const journeyContextScript = `
  if (typeof window !== 'undefined') {
    const journeyContext = ${JSON.stringify(journeyContext).replace(/</g, '\\u003c')};
    window.journeyContext = journeyContext;
    window.dispatchEvent(new CustomEvent('journey-context-loaded', { detail: journeyContext }));
  }
`;
---

<Layout
  title={title || config.title}
  description={description || config.description}
  canonical={Astro.url.href}
  keywords={config.keywords.join(', ')}
  showChat={false}
  showToolAnalysis={false}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: backLabel, href: backHref },
      { label: config.title },
    ]}
  />

  <div class="fa-page-shell">
    <div class="fa-workflow-grid">
      <div class="space-y-6">
        <WorkflowPageIntro
          backHref={backHref}
          backLabel={backLabel}
          title={config.title}
          description={config.description}
          icon={config.icon}
          badgeText={isJourneySpecific && journeyNav
            ? `Step ${journeyNav.currentStep} of ${journeyNav.totalSteps} - ${journeyNav.scenarioName}`
            : undefined}
        />

        {
          journeyNav && (
            <WorkflowProgressStrip
              label={`${journeyNav.scenarioName} progress`}
              currentStep={journeyNav.currentStep}
              totalSteps={journeyNav.totalSteps}
            />
          )
        }

        <section class="fa-card p-6">
          <div id="calculator-form-container">
            <div set:html={formHTML} />
          </div>

          <div id="loading" class="hidden py-8 text-center">
            <div class="fa-button-primary cursor-not-allowed opacity-90">
              <svg
                class="-ml-1 mr-3 h-5 w-5 animate-spin text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
              Calculating...
            </div>
          </div>

          <div id="error" class="fa-callout-danger hidden mb-6">
            <div class="flex">
              <div class="shrink-0">
                <svg class="h-5 w-5 text-rose-400" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="fa-callout-title-danger">Error</h3>
                <div class="mt-2 fa-callout-copy-danger">
                  <p id="error-message"></p>
                </div>
              </div>
            </div>
          </div>

          <div id="results" class="hidden">
            <div class="fa-callout-success mb-6">
              <div class="flex">
                <div class="shrink-0">
                  <svg class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="fa-callout-title-success">
                    Analysis Complete
                  </h3>
                  <div class="mt-2 fa-callout-copy-success">
                    <p>
                      Your {config.title.toLowerCase()} analysis is ready. Review the results in the rail
                      before moving on.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        {
          journeyNav && (
            <JourneyStepNavigation
              scenarioId={journeyNav.scenarioId}
              journeyOverviewUrl={journeyNav.journeyOverviewUrl}
              previousStep={journeyNav.previousStep}
              nextStep={journeyNav.nextStep}
            />
          )
        }
      </div>

      <WorkflowSupportRail
        modelType={config.analysisType}
        showImpactSummary={hasAnalysisEngine(config.analysisType)}
      />
    </div>

    <div class="ad-container mx-auto mt-6 max-w-4xl">
      <AdSense slot="3456789012" />
    </div>
  </div>

  {
    primaryClientScript && (
      <ClientScriptLoader client:load slot="pageScripts" name={primaryClientScript} />
    )
  }
  {journeyNav && <ClientScriptLoader client:load slot="pageScripts" name="journey-navigation" />}
  <script is:inline set:html={journeyContextScript} />
</Layout>
