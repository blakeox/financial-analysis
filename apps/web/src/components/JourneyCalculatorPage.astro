---
import Layout from '../layouts/Layout.astro';
import AdSense from './AdSense.astro';
import { CALCULATOR_CONFIGS, generateFormHTMLWithValidation } from './CalculatorTemplate.tsx';
import { getJourneyCalculatorConfig, hasJourneySpecificConfig } from '../utils/journeyCalculatorConfigs';
import ClientScriptLoader from './ClientScriptLoader.tsx';
import EnhancedAnalysisResults from './EnhancedAnalysisResults.tsx';

export interface Props {
  calculatorId: string;
  title?: string;
  description?: string;
  journeyNav?: {
    scenarioId: string;
    scenarioName: string;
    currentStep: number;
    totalSteps: number;
    nextStep: { id: string; name: string; url: string } | null;
    previousStep: { id: string; name: string; url: string } | null;
    journeyOverviewUrl: string;
  };
}

const { calculatorId, title, description, journeyNav } = Astro.props as Props;

// Determine if this is a journey-specific calculator
let config;
let isJourneySpecific = false;

if (journeyNav) {
  const journeyConfig = getJourneyCalculatorConfig(journeyNav.scenarioId, calculatorId);
  if (journeyConfig) {
    config = journeyConfig;
    isJourneySpecific = true;
  } else {
    config = CALCULATOR_CONFIGS[calculatorId];
  }
} else {
  config = CALCULATOR_CONFIGS[calculatorId];
}

if (!config) {
  throw new Error(`Calculator configuration not found for: ${calculatorId}`);
}

// Determine back navigation based on context
let backHref = '/models';
let backLabel = 'Models';

if (journeyNav) {
  // If we're in a journey, go back to journey overview
  backHref = journeyNav.journeyOverviewUrl;
  backLabel = journeyNav.scenarioName;
} else if (config.category === 'business') {
  backHref = '/models/business';
  backLabel = 'Business Models';
}

const formHTML = generateFormHTMLWithValidation(config.formFields);
---

<Layout 
  title={title || config.title}
  description={description || config.description}
  canonical={Astro.url.href}
  keywords={config.keywords.join(', ')}
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href={backHref} class="hover:text-gray-700 dark:hover:text-gray-300">{backLabel}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">{config.title}</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Calculator Content -->
        <div class="lg:col-span-3">
          <!-- Calculator Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">{config.icon}</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{config.title}</h1>
                <p class="text-gray-600 dark:text-gray-400">{config.description}</p>
                {isJourneySpecific && journeyNav && (
                  <div class="mt-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                      Step {journeyNav.currentStep} of {journeyNav.totalSteps} - {journeyNav.scenarioName}
                    </span>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Journey Progress Bar -->
          {journeyNav && (
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Journey Progress</h3>
                <span class="text-sm text-gray-600 dark:text-gray-400">
                  Step {journeyNav.currentStep} of {journeyNav.totalSteps}
                </span>
              </div>
              <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                <div 
                  class="bg-gradient-to-r from-blue-500 to-indigo-600 h-2 rounded-full transition-all duration-300"
                  style={`width: ${(journeyNav.currentStep / journeyNav.totalSteps) * 100}%`}
                ></div>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                {journeyNav.scenarioName} - {Math.round((journeyNav.currentStep / journeyNav.totalSteps) * 100)}% Complete
              </p>
            </div>
          )}

          <!-- Calculator Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div id="calculator-form-container">
              <Fragment set:html={formHTML} />
            </div>
            
            <!-- Loading State -->
            <div id="loading" class="hidden text-center py-8">
              <div class="inline-flex items-center px-4 py-2 font-semibold leading-6 text-sm shadow rounded-md text-white bg-blue-500 hover:bg-blue-400 transition ease-in-out duration-150 cursor-not-allowed">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Calculating...
              </div>
            </div>

            <!-- Error State -->
            <div id="error" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Error</h3>
                  <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                    <p id="error-message"></p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Results Section -->
            <div id="results" class="hidden">
              <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4 mb-6">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-green-800 dark:text-green-200">Analysis Complete</h3>
                    <div class="mt-2 text-sm text-green-700 dark:text-green-300">
                      <p>Your {config.title.toLowerCase()} analysis is ready. Review the results below and proceed to the next step.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Journey Navigation -->
          {journeyNav && (
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg shadow-md p-6 mb-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                  {journeyNav.previousStep ? (
                    <a 
                      href={journeyNav.previousStep.url}
                      class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                      </svg>
                      Previous: {journeyNav.previousStep.name}
                    </a>
                  ) : (
                    <a 
                      href={journeyNav.journeyOverviewUrl}
                      class="inline-flex items-center px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                    >
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                      </svg>
                      Back to Journey
                    </a>
                  )}
                </div>

                <div class="flex items-center space-x-4">
                  {journeyNav.nextStep ? (
                    <a 
                      href={journeyNav.nextStep.url}
                      class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                    >
                      Next: {journeyNav.nextStep.name}
                      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  ) : (
                    <a 
                      href={`/journey-analysis/${journeyNav.scenarioId}`}
                      class="flex-1 sm:flex-none inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-105"
                    >
                      Complete Journey
                      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          )}

          <!-- Floating Next Button (Mobile) -->
          {journeyNav && journeyNav.nextStep && (
            <div class="fixed bottom-4 right-4 z-50 sm:hidden">
              <a 
                href={journeyNav.nextStep.url}
                class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-sm font-semibold rounded-full shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:scale-110"
              >
                Next
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          )}

          {journeyNav && !journeyNav.nextStep && (
            <div class="fixed bottom-4 right-4 z-50 sm:hidden">
              <a 
                href={`/journey-analysis/${journeyNav.scenarioId}`}
                class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white text-sm font-semibold rounded-full shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:scale-110"
              >
                Complete
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </a>
            </div>
          )}
        </div>

        <!-- Quick Access Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold mb-4">Quick Access</h3>
            <div class="space-y-4">
              <!-- Favorites -->
              <div>
                <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Favorites</h4>
                <div id="favorites-list" class="space-y-2">
                  <!-- Populated by JavaScript -->
                </div>
              </div>
              <!-- Recent -->
              <div>
                <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Recent</h4>
                <div id="recent-list" class="space-y-2">
                  <!-- Populated by JavaScript -->
                </div>
              </div>
              <!-- Actions -->
              <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
                <button id="favorite-btn" class="w-full px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-md transition-colors duration-200">
                  <span id="favorite-text">Add to Favorites</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Analysis Results -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
          <EnhancedAnalysisResults 
            modelType={config.analysisType}
            modelData={{}}
            className="h-full"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div id="results-section" class="mt-6 hidden">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
      <h2 class="text-lg font-semibold mb-4">Analysis Results</h2>
      <div id="results-content"></div>
    </div>
  </div>

  <!-- AdSense -->
  <div class="ad-container max-w-4xl mx-auto mt-6">
    <AdSense />
  </div>
</main>

<!-- Client Scripts -->
<ClientScriptLoader client:load slot="pageScripts" name={config.clientScript as any} />
<ClientScriptLoader client:load slot="pageScripts" name="calculator-quick-access" />
{journeyNav && (
  <ClientScriptLoader client:load slot="pageScripts" name="journey-navigation" />
)}

<script>
  // Journey-specific initialization
  if (typeof window !== 'undefined') {
    // Add journey context to window for client scripts
    window.journeyContext = {
      scenarioId: journeyNav?.scenarioId || null,
      currentStep: journeyNav?.currentStep || null,
      totalSteps: journeyNav?.totalSteps || null,
      isJourneySpecific: isJourneySpecific,
      calculatorId: calculatorId
    };

    // Dispatch journey context event
    window.dispatchEvent(new CustomEvent('journey-context-loaded', {
      detail: window.journeyContext
    }));
  }
</script>
</Layout>



