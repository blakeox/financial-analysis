---
export interface Props {
  label: string;
  currentStep: number;
  totalSteps: number;
}

const { label, currentStep, totalSteps } = Astro.props as Props;
const progress = totalSteps > 0 ? Math.min(100, Math.max(0, (currentStep / totalSteps) * 100)) : 0;
---

<section class="fa-card fa-progress-panel p-5">
  <h2 class="fa-scenario-title text-base">{label}</h2>
  <p class="fa-list-copy mt-1">
    Step {currentStep} of {totalSteps}
  </p>
  <div class="fa-progress-track mt-4">
    <div class="fa-progress-bar" style={`width: ${progress}%`}></div>
  </div>
</section>
