---
import Layout from '../layouts/Layout.astro';
import AdSense from './AdSense.astro';
import { CALCULATOR_CONFIGS, generateFormHTMLWithValidation } from './CalculatorTemplate.tsx';
import ClientScriptLoader from './ClientScriptLoader.tsx';
import EnhancedAnalysisResults from './EnhancedAnalysisResults.tsx';

export interface Props {
  calculatorId: string;
  title?: string;
  description?: string;
}

const { calculatorId, title, description } = Astro.props as Props;

const config = CALCULATOR_CONFIGS[calculatorId];

if (!config) {
  throw new Error(`Calculator configuration not found for: ${calculatorId}`);
}

// Determine back navigation based on category
let backHref = '/models';
let backLabel = 'Models';

if (config.category === 'business') {
  backHref = '/models/business';
  backLabel = 'Business Models';
} else {
  backHref = '/models/personal';
  backLabel = 'Personal Models';
}

const formHTML = generateFormHTMLWithValidation(config.formFields);
---

<Layout 
  title={title || config.title}
  description={description || config.description}
  canonical={Astro.url.href}
  keywords={config.keywords.join(', ')}
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href={backHref} class="hover:text-gray-700 dark:hover:text-gray-300">{backLabel}</a>
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-900 dark:text-white">{config.title}</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Main Calculator Content -->
        <div class="lg:col-span-3">
          <!-- Calculator Header -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div class="flex items-center mb-4">
              <span class="text-3xl mr-3">{config.icon}</span>
              <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{config.title}</h1>
                <p class="text-gray-600 dark:text-gray-400">{config.description}</p>
                <div class="mt-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                    {config.category === 'personal' ? 'Personal Finance' : 'Business Finance'}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Calculator Form -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 mb-6">
            <div id="calculator-form-container">
              <Fragment set:html={formHTML} />
            </div>
            
            <!-- Loading State -->
            <div id="loading" class="hidden text-center py-8">
              <div class="inline-flex items-center px-4 py-2 font-semibold leading-6 text-sm shadow rounded-md text-white bg-blue-500 hover:bg-blue-400 transition ease-in-out duration-150 cursor-not-allowed">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Calculating...
              </div>
            </div>

            <!-- Error State -->
            <div id="error" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
              <div class="flex">
                <div class="shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Error</h3>
                  <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                    <p id="error-message"></p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Results Section -->
            <div id="results" class="hidden">
              <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4 mb-6">
                <div class="flex">
                  <div class="shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 002.828 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-green-800 dark:text-green-200">Analysis Complete</h3>
                    <div class="mt-2 text-sm text-green-700 dark:text-green-300">
                      <p>Your {config.title.toLowerCase()} analysis is ready. Review the results below.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Results Section -->
          <div id="results-section" class="mt-6 hidden">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
              <h2 class="text-lg font-semibold mb-4">Analysis Results</h2>
              <div id="results-content">
                <!-- Summary Cards -->
                <div id="summary-cards" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                  <!-- Summary cards will be populated here -->
                </div>
                
                <!-- Results Container -->
                <div id="results-container" class="hidden">
                  <!-- Results will be populated here -->
                </div>
              </div>
            </div>
          </div>
          
          <!-- Amortization Chart -->
          <div id="amortization-chart-container" class="mt-6 hidden">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
              <h2 class="text-lg font-semibold mb-4">Payment Breakdown Chart</h2>
              <div id="amortization-chart">
                <!-- Chart will be rendered here -->
              </div>
            </div>
          </div>
          
          <!-- Amortization Schedule Table (if applicable) -->
          <div id="amortization-table-container" class="mt-6 hidden">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
              <h2 class="text-lg font-semibold mb-4">Amortization Schedule</h2>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                  <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                      <th class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Month</th>
                      <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Payment</th>
                      <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Principal</th>
                      <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Interest</th>
                      <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Balance</th>
                      <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Cumulative Interest</th>
                    </tr>
                  </thead>
                  <tbody id="table-body" class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                    <!-- Table rows will be populated here -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Access Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5 mb-6">
            <h3 class="text-lg font-semibold mb-4">Quick Access</h3>
            <div class="space-y-4">
              <!-- Favorites -->
              <div>
                <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Favorites</h4>
                <div id="favorites-list" class="space-y-2">
                  <!-- Populated by JavaScript -->
                </div>
              </div>
              <!-- Recent -->
              <div>
                <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Recent</h4>
                <div id="recent-list" class="space-y-2">
                  <!-- Populated by JavaScript -->
                </div>
              </div>
              <!-- Actions -->
              <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
                <button id="favorite-btn" class="w-full px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-md transition-colors duration-200">
                  <span id="favorite-text">Add to Favorites</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Analysis Results -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-5">
            <EnhancedAnalysisResults 
              modelType={config.analysisType}
              modelData={{}}
              className="h-full"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- AdSense -->
    <div class="ad-container max-w-4xl mx-auto mt-6">
      <AdSense slot="3456789012" />
    </div>
  </main>

  <!-- Client Scripts -->
  <ClientScriptLoader client:load slot="pageScripts" name={config.clientScript as any} />
  <ClientScriptLoader client:load slot="pageScripts" name="calculator-quick-access" />

  <script define:vars={{ calculatorId, config }}>
    // Individual calculator initialization
    if (typeof window !== 'undefined') {
      // Add calculator context to window for client scripts
      window.calculatorContext = {
        calculatorId: calculatorId,
        category: config.category,
        isIndividualCalculator: true,
        isJourneyCalculator: false
      };

      // Dispatch calculator context event
      window.dispatchEvent(new CustomEvent('calculator-context-loaded', {
        detail: window.calculatorContext
      }));
    }
  </script>
</Layout>

