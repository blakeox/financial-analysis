---
import Layout from '../layouts/Layout.astro';
import AdSense from './AdSense.astro';
import { CALCULATOR_CONFIGS, generateFormHTMLWithValidation } from './CalculatorTemplate.tsx';
import ClientScriptLoader from './ClientScriptLoader.tsx';
import WorkflowPageIntro from './WorkflowPageIntro.astro';
import WorkflowProgressStrip from './WorkflowProgressStrip.astro';
import WorkflowStepNavigation from './WorkflowStepNavigation.astro';
import WorkflowSupportRail from './WorkflowSupportRail.astro';

export interface Props {
  calculatorId: string;
  title?: string;
  description?: string;
  journeyNav?: {
    scenarioId: string;
    scenarioName: string;
    currentStep: number;
    totalSteps: number;
    nextStep: { id: string; name: string; url: string } | null;
    previousStep: { id: string; name: string; url: string } | null;
    journeyOverviewUrl: string;
  };
}

const { calculatorId, title, description, journeyNav } = Astro.props as Props;
const config = CALCULATOR_CONFIGS[calculatorId];

if (!config) {
  throw new Error(`Calculator configuration not found for: ${calculatorId}`);
}

let backHref = '/models';
let backLabel = 'Models';

if (journeyNav) {
  backHref = journeyNav.journeyOverviewUrl;
  backLabel = journeyNav.scenarioName;
} else if (config.category === 'business') {
  backHref = '/models/business';
  backLabel = 'Business Models';
}

const formHTML = generateFormHTMLWithValidation(config.formFields);

---

<Layout
  title={title || config.title}
  description={description || config.description}
  canonical={Astro.url.href}
  keywords={config.keywords.join(', ')}
  showChat={false}
  showToolAnalysis={false}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(config.faqSchema)} />

  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div id="main-container" class="transition-all duration-300 ease-in-out">
      <div class="container mx-auto px-4 py-6">
        <WorkflowPageIntro
          backHref={backHref}
          backLabel={backLabel}
          title={config.title}
          description={config.description}
        />

        {journeyNav && (
          <div class="mb-6">
            <WorkflowProgressStrip
              label={journeyNav.scenarioName}
              currentStep={journeyNav.currentStep}
              totalSteps={journeyNav.totalSteps}
            />
          </div>
        )}

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1.55fr)_minmax(320px,0.95fr)]">
          <div class="space-y-6">
            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
              <h2 class="mb-4 text-lg font-semibold">Calculator Parameters</h2>
              <div set:html={formHTML} />
            </section>

            {journeyNav && (
              <WorkflowStepNavigation
                helperText="Continue through the journey once the refreshed result looks right."
                backLabel="Back to journey"
                backHref={journeyNav.journeyOverviewUrl}
                previousStep={journeyNav.previousStep}
                nextStep={journeyNav.nextStep}
                completeHref={`/journey-analysis/${journeyNav.scenarioId}`}
              />
            )}
          </div>

          <WorkflowSupportRail modelType={config.analysisType} />
        </div>

        <AdSense slot="3456789012" format="horizontal" className="mx-auto mt-6 max-w-4xl" />
      </div>
    </div>
  </div>

  <ClientScriptLoader client:load slot="pageScripts" name={config.clientScript as any} />
  <ClientScriptLoader client:load slot="pageScripts" name="calculator-quick-access" />
  <ClientScriptLoader client:load slot="pageScripts" name="journey-navigation" />
</Layout>
