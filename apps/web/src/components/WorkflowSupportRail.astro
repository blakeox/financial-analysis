---
import ChatPanel from './ChatPanel.astro';
import EnhancedAnalysisResults from './EnhancedAnalysisResults.tsx';
import { hasAnalysisEngine } from '../scripts/analysis/analysis-event-contract.ts';

export interface Props {
  modelType: string;
  resultsTitle?: string;
  analysisTitle?: string;
  showImpactSummary?: boolean;
}

const {
  modelType,
  resultsTitle = 'Live results',
  analysisTitle = 'Impact summary',
  showImpactSummary,
} = Astro.props as Props;

const showImpact = showImpactSummary ?? hasAnalysisEngine(modelType);
---

<aside class="space-y-4 xl:sticky xl:top-24">
  <!-- Journey tip cards / guidance — optional; calculators leave this empty -->
  <slot name="tips" />

  <ChatPanel variant="embedded" />

  <section id="results-section" class="fa-rail-card hidden">
    <div class="fa-rail-card-header">
      <h2 class="fa-rail-card-title">{resultsTitle}</h2>
      <p class="fa-rail-card-copy">
        Updated after each calculation and assistant-applied change.
      </p>
    </div>
    <div class="fa-rail-card-body">
      <slot name="results-content">
        <div id="results-content"></div>
      </slot>
    </div>
  </section>

  {
    showImpact ? (
      <section class="fa-rail-card">
        <div class="fa-rail-card-header">
          <h2 class="fa-rail-card-title">{analysisTitle}</h2>
          <p class="fa-rail-card-copy">
            Plain-English takeaways tied to the latest model output.
          </p>
        </div>
        <div class="fa-rail-card-body">
          <EnhancedAnalysisResults
            client:load
            modelType={modelType}
            modelData={{}}
            className="h-full"
          />
        </div>
      </section>
    ) : null
  }
</aside>
