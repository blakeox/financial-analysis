---
import ChatPanel from './ChatPanel.astro';
import EnhancedAnalysisResults from './EnhancedAnalysisResults.tsx';

export interface Props {
  modelType: string;
  resultsTitle?: string;
  analysisTitle?: string;
}

const {
  modelType,
  resultsTitle = 'Live results',
  analysisTitle = 'Impact summary',
} = Astro.props as Props;
---

<aside class="space-y-4 xl:sticky xl:top-24">
  <ChatPanel variant="embedded" />

  <section
    id="results-section"
    class="fa-card hidden overflow-hidden p-0"
  >
    <div class="fa-panel-divider px-5 py-4">
      <h2 class="fa-panel-title text-base">{resultsTitle}</h2>
      <p class="fa-card-copy fa-card-copy-sm !mt-1">
        Updated after each calculation and assistant-applied change.
      </p>
    </div>
    <div class="p-5">
      <slot name="results-content">
        <div id="results-content"></div>
      </slot>
    </div>
  </section>

  <section class="fa-card overflow-hidden p-0">
    <div class="fa-panel-divider px-5 py-4">
      <h2 class="fa-panel-title text-base">{analysisTitle}</h2>
      <p class="fa-card-copy fa-card-copy-sm !mt-1">
        Plain-English takeaways tied to the latest model output.
      </p>
    </div>
    <div class="p-5">
      <EnhancedAnalysisResults client:load modelType={modelType} modelData={{}} className="h-full" />
    </div>
  </section>
</aside>
