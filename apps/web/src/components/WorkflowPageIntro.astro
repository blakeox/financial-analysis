---
export interface Props {
  backHref: string;
  backLabel: string;
  title: string;
  description: string;
  icon?: string;
  badgeText?: string;
  badgeTone?: 'blue' | 'slate';
}

const {
  backHref,
  backLabel,
  title,
  description,
  icon,
  badgeText,
  badgeTone = 'blue',
} = Astro.props as Props;

const badgeClasses =
  badgeTone === 'slate'
    ? 'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-100'
    : 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
---

<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <div class="mb-4 flex items-center gap-3 text-sm text-slate-600 dark:text-slate-300">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      {backLabel}
    </a>
  </div>

  <div class="flex items-start gap-4">
    {icon && <span class="mt-0.5 text-3xl">{icon}</span>}
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">{title}</h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{description}</p>
      {badgeText && (
        <div class="mt-3">
          <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${badgeClasses}`}>
            {badgeText}
          </span>
        </div>
      )}
    </div>
  </div>
</section>
