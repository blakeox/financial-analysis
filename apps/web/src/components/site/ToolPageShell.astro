---
import Breadcrumbs from './Breadcrumbs.astro';
import PageHero from './PageHero.astro';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  eyebrow?: string;
  title: string;
  description: string;
  /** Optional extra classes on the inner content wrapper (prefer shell tokens — no nested max-w-*). */
  contentClassName?: string;
}

const {
  items,
  eyebrow = 'Analysis',
  title,
  description,
  contentClassName = '',
} = Astro.props as Props;
---

<Breadcrumbs items={items} />

<div class="fa-page-shell">
  <div class={contentClassName || undefined}>
    <PageHero eyebrow={eyebrow} title={title} description={description} />
    <slot />
  </div>
</div>
