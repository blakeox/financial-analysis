---
/**
 * Static site footer — Astro twin of ModernNavBar (no React hydration).
 * Styled with fa-* / shell tokens only (#364).
 */
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
const currentYear = new Date().getFullYear();
---

<footer class:list={['fa-site-footer', className]}>
  <div class="fa-site-footer-inner">
    <div class="fa-site-footer-grid">
      <div class="fa-site-footer-brand">
        <div class="fa-site-footer-brand-row">
          <span class="fa-shell-brand-mark" aria-hidden="true">F</span>
          <h2 class="fa-site-footer-title">Fanalyx</h2>
        </div>
        <p class="fa-site-footer-tagline">
          AI-powered financial analysis for clearer questions, clearer formulas, and clearer
          decisions.
        </p>
      </div>

      <div>
        <h3 class="fa-site-footer-heading">Product</h3>
        <ul class="fa-site-footer-list">
          <li><a href="/" class="fa-shell-link-accent">Home</a></li>
          <li><a href="/models" class="fa-shell-link-accent">Models</a></li>
          <li><a href="/agent" class="fa-shell-link-accent">Agent</a></li>
          <li><a href="/pricing" class="fa-shell-link-accent">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h3 class="fa-site-footer-heading">Resources</h3>
        <ul class="fa-site-footer-list">
          <li><a href="/developers" class="fa-shell-link-accent">Developers</a></li>
          <li><a href="/blog" class="fa-shell-link-accent">Blog</a></li>
          <li><a href="/status" class="fa-shell-link-accent">Status</a></li>
          <li><a href="/disclaimer" class="fa-shell-link-accent">Disclaimer</a></li>
        </ul>
      </div>

      <div>
        <h3 class="fa-site-footer-heading">Legal</h3>
        <ul class="fa-site-footer-list">
          <li><a href="/privacy" class="fa-shell-link-accent">Privacy</a></li>
          <li><a href="/terms" class="fa-shell-link-accent">Terms</a></li>
          <li>
            <a href="mailto:support@fanalyx.com" class="fa-shell-link-accent">Contact</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="fa-site-footer-legal">
      <p>
        &copy; {currentYear} Fanalyx. Educational decision support only. Not financial advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .fa-site-footer {
    border-top: 1px solid var(--fa-border-default);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--fa-surface) 96%, transparent),
      color-mix(in srgb, var(--fa-surface-subtle) 98%, transparent)
    );
  }

  .fa-site-footer-inner {
    margin: 0 auto;
    max-width: 80rem;
    padding: 3rem 1rem;
  }

  @media (min-width: 64rem) {
    .fa-site-footer-inner {
      padding: 4rem 2rem;
    }
  }

  .fa-site-footer-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 64rem) {
    .fa-site-footer-grid {
      grid-template-columns: 1.1fr 0.9fr 0.9fr 0.9fr;
    }
  }

  .fa-site-footer-brand-row {
    align-items: center;
    display: flex;
    gap: 0.75rem;
  }

  .fa-site-footer-title {
    color: var(--fa-text-primary);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .fa-site-footer-tagline {
    color: var(--fa-text-muted);
    font-size: 0.875rem;
    line-height: 1.75;
    margin-top: 1.25rem;
    max-width: 20rem;
  }

  .fa-site-footer-heading {
    color: var(--fa-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .fa-site-footer-list {
    color: var(--fa-text-muted);
    display: flex;
    flex-direction: column;
    font-size: 0.875rem;
    gap: 0.75rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .fa-site-footer-legal {
    border-top: 1px solid var(--fa-border-default);
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .fa-site-footer-legal p {
    color: var(--fa-text-muted);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  @media (min-width: 80rem) {
    .fa-site-footer-legal p {
      text-align: center;
    }
  }
</style>
