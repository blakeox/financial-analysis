{
  "name": "@financial-analysis/tools",
  "version": "0.1.1",
  "description": "Financial tool modules for MCP integration",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @financial-analysis/analysis build && pnpm --filter @financial-analysis/capabilities build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@financial-analysis/analysis": "workspace:*",
    "@financial-analysis/capabilities": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
