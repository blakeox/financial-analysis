{
  "name": "@financial-analysis/tools",
  "version": "0.1.1",
  "description": "Financial tool modules for MCP integration",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @financial-analysis/analysis build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@financial-analysis/analysis": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "0.28.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  }
}
