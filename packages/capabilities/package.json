{
  "name": "@financial-analysis/capabilities",
  "version": "0.1.1",
  "description": "Provider-neutral contracts for financial analysis capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build tsconfig.json --force",
    "lint": "eslint src --ext .ts --ignore-pattern '*.d.ts'",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@financial-analysis/config": "workspace:*",
    "eslint": "^10.6.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  }
}
