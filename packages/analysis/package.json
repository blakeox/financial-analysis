{
  "name": "@financial-analysis/analysis",
  "version": "0.1.1",
  "description": "Deterministic financial analysis engines",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build tsconfig.json --force",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts --ignore-pattern '*.d.ts'",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run --config ./vitest.config.mjs",
    "test:fast": "pnpm run build && vitest run --config ./vitest.config.mjs --exclude **/performance.test.ts",
    "test:slow": "pnpm run build && vitest run --config ./vitest.config.mjs --include **/performance.test.ts",
    "test:coverage": "pnpm run build && vitest run --coverage --config ./vitest.config.mjs",
    "test:coverage:ci": "pnpm run build && vitest run --coverage --config ./vitest.config.mjs --coverage.thresholds.perFile=false --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@financial-analysis/config": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
