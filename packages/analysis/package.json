{
  "name": "@financial-analysis/analysis",
  "version": "0.1.1",
  "description": "Deterministic financial analysis engines",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build tsconfig.json --force",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts --ignore-pattern '*.d.ts'",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run --config ./vitest.config.mjs",
    "test:coverage": "pnpm run build && vitest --coverage --config ./vitest.config.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@financial-analysis/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "4.0.2",
    "esbuild": "0.25.11",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.2"
  }
}
