# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values

# Cloudflare Account Information
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=cc3bb24ae3c87cff38c2be85df3dab29

# Development Configuration
NODE_ENV=development
LOG_LEVEL=debug

# API Configuration  
API_BASE_URL=http://localhost:8787

# Worker Development Ports
API_WORKER_PORT=8787
WEB_WORKER_PORT=8788

# Database Configuration (for local testing)
DATABASE_URL=file:./dev.db

# Security (generate strong secrets for production)
AUTH_SECRET=dev-secret-key-replace-in-production

# MCP Configuration (if using AI features)
MCP_API_KEY=your_mcp_api_key_here
ANALYSIS_CACHE_TTL=3600

# Feature Flags
ENABLE_DEBUG_LOGGING=true
ENABLE_RATE_LIMITING=false