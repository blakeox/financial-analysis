{
  "name": "@financial-analysis/mcp-worker",
  "version": "0.1.0",
  "description": "Stateless public MCP edge boundary (createMcpHandler scaffold; no production traffic)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env=development --port 8791 --local",
    "build": "tsc --noEmit",
    "deploy:preview": "echo 'Scaffold only: production traffic not enabled' && exit 1",
    "test": "vitest run --config ./vitest.config.mjs",
    "pretest": "pnpm --filter @financial-analysis/analysis run build && pnpm --filter @financial-analysis/capabilities run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@financial-analysis/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.17.1",
    "zod": "^4.4.3"
  }
}
