{
  "name": "@financial-analysis/mcp-worker",
  "version": "0.1.0",
  "description": "Stateless public MCP edge boundary (scaffold; no production traffic)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env=development --port 8791 --local",
    "build": "tsc --noEmit",
    "deploy:preview": "echo 'Scaffold only: production traffic not enabled' && exit 1",
    "test": "vitest run --config ./vitest.config.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.9",
    "wrangler": "^4.105.0"
  }
}
