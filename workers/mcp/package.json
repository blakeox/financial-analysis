{
  "name": "@financial-analysis/mcp-worker",
  "version": "0.1.0",
  "description": "Stateless public MCP edge boundary (createMcpHandler scaffold; no production traffic)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env=development --port 8791 --local",
    "build": "tsc --noEmit",
    "types:generate": "wrangler types worker-configuration.d.ts --config wrangler.toml --include-runtime=false",
    "types:check": "wrangler types worker-configuration.d.ts --config wrangler.toml --include-runtime=false --check",
    "deploy:preview": "echo 'Scaffold only: production traffic not enabled' && exit 1",
    "test": "vitest run --config ./vitest.config.mjs",
    "pretest": "pnpm --filter @financial-analysis/analysis run build && pnpm --filter @financial-analysis/capabilities run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vitest": "4.1.12",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@financial-analysis/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agents": "^0.17.4",
    "zod": "^4.6.7"
  }
}
