{
  "name": "@financial-analysis/api",
  "version": "0.1.1",
  "description": "Cloudflare Workers API with MCP server for financial analysis",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env=preview",
    "deploy:production": "wrangler deploy --env=production",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:dry-run:preview": "wrangler deploy --dry-run --env=preview",
    "deploy:dry-run:production": "wrangler deploy --dry-run --env=production",
  "build": "tsc --noEmit",
  "pretest": "pnpm --filter @financial-analysis/analysis run build",
  "test": "vitest run --config ./vitest.config.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250917.0",
    "@financial-analysis/tools": "workspace:*",
    "@financial-analysis/analysis": "workspace:*",
  "@asteasolutions/zod-to-openapi": "^8.0.0",
  "zod": "^4.0.0",
    "itty-router": "^5.0.22"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.38.0",
    "vitest": "3.2.4",
    "esbuild": "0.25.10",
    "miniflare": "^3.0.0",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.46.2",
    "prettier": "^3.0.0"
  }
}
