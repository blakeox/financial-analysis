                        },
                        "totalRevenue": {
                          "type": "number",
                        },
                      },
                      "required": [
                        "totalRevenue",
                        "totalEbitda",
                        "averageEbitdaMargin",
                        "totalEmployeeCosts",
                        "totalOperatingExpenses",
                        "finalEmployeeCount",
                        "revenueGrowth",
                        "ebitdaGrowth",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "scenario",
                    "forecast",
                    "summary",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "EBITDA forecast result",
          },
          "400": {
            "description": "Invalid request body",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
        },
      },
    },
    "/v1/api/analysis/lease": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "annualRate": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                  },
                  "principal": {
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "type": "number",
                  },
                  "residualValue": {
                    "default": 0,
                    "minimum": 0,
                    "type": "number",
                  },
                  "termMonths": {
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "type": "integer",
                  },
                },
                "required": [
                  "principal",
                  "annualRate",
                  "termMonths",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "monthlyPayment": {
                      "type": "number",
                    },
                    "schedule": {
                      "items": {
                        "properties": {
                          "balance": {
                            "type": "number",
                          },
                          "interest": {
                            "type": "number",
                          },
                          "month": {
                            "type": "number",
                          },
                          "payment": {
                            "type": "number",
                          },
                          "principal": {
                            "type": "number",
                          },
                        },
                        "required": [
                          "month",
                          "payment",
                          "principal",
                          "interest",
                          "balance",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "totalInterest": {
                      "type": "number",
                    },
                    "totalPayments": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "monthlyPayment",
                    "totalPayments",
                    "totalInterest",
                    "schedule",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Lease analysis result",
          },
          "400": {
            "description": "Invalid request body",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
        },
      },
    },
    "/v1/chat": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "messages": {
                    "items": {
                      "properties": {
                        "content": {
                          "type": "string",
                        },
                        "role": {
                          "enum": [
                            "system",
                            "user",
                            "assistant",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "role",
                        "content",
                      ],
                      "type": "object",
                    },
                    "minItems": 1,
                    "type": "array",
                  },
                  "model": {
                    "type": "string",
                  },
                },
                "required": [
                  "messages",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "content": {
                      "type": "string",
                    },
                    "model": {
                      "type": "string",
                    },
                    "role": {
                      "enum": [
                        "assistant",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "role",
                    "content",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Assistant reply (uses Workers AI when configured, otherwise a deterministic response)",
          },
          "400": {
            "description": "Bad request",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
        },
      },
    },
    "/v1/storage/finalize": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "uploadId": {
                    "format": "uuid",
                    "type": "string",
                  },
                },
                "required": [
                  "uploadId",
                ],
                "type": "object",
              },
            },
          },
          "description": "Finalize a session-bound R2 upload after exact size, content type, and SHA-256 verification.",
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "contentType": {
                      "type": "string",
                    },
                    "documentKey": {
                      "type": "string",
                    },
                    "filename": {
                      "type": "string",
                    },
                    "sha256": {
                      "type": "string",
                    },
                    "sizeBytes": {
                      "exclusiveMinimum": true,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "success": {
                      "enum": [
                        true,
                      ],
                      "type": "boolean",
                    },
                    "uploadId": {
                      "format": "uuid",
                      "type": "string",
                    },
                  },
                  "required": [
                    "success",
                    "uploadId",
                    "documentKey",
                    "filename",
                    "contentType",
                    "sizeBytes",
                    "sha256",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Verified object promoted to stored document metadata",
          },
          "400": {
            "description": "Invalid finalization request",
          },
          "403": {
            "description": "Quota locked or unavailable",
          },
          "404": {
            "description": "Upload session not found",
          },
          "409": {
            "description": "Upload has not completed or is no longer pending",
          },
          "422": {
            "description": "Object metadata or checksum mismatch",
          },
          "503": {
            "description": "Storage or metadata unavailable",
          },
        },
      },
    },
    "/v1/storage/object/{key}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                    },
                    "key": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "key",
                    "deleted",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Object deleted",
          },
          "400": {
            "description": "Invalid key",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string",
                        },
                        "message": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "message",
                        "code",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "error",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Storage not configured",
          },
        },
      },
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string",
              },
            },
          },
          "description": "Binary object data. You must provide Content-Length (or X-Content-Length) header to indicate size. Max object size and quota limits enforced.",
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "etag": {
                      "nullable": true,
                      "type": "string",
                    },
                    "key": {
                      "type": "string",
                    },
                    "size": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "key",
                    "etag",
                    "size",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Object stored successfully",
          },
          "400": {
            "description": "Invalid key or Content-Length",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string",
                        },
                        "message": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "message",
                        "code",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "error",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Quota locked or soft limit reached",
          },
          "411": {
            "description": "Content-Length required",
          },
          "413": {
            "description": "Object too large",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string",
                        },
                        "message": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "message",
                        "code",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "error",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Storage not configured",
          },
        },
      },
    },
    "/v1/storage/presign": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "properties": {
                      "key": {
                        "maxLength": 1024,
                        "minLength": 1,
                        "type": "string",
                      },
                      "operation": {
                        "enum": [
                          "download",
                        ],
                        "type": "string",
                      },
                    },
                    "required": [
                      "operation",
                      "key",
                    ],
                    "type": "object",
                  },
                  {
                    "properties": {
                      "contentType": {
                        "maxLength": 128,
                        "minLength": 1,
                        "type": "string",
                      },
                      "operation": {
                        "enum": [
                          "upload",
                        ],
                        "type": "string",
                      },
                      "originalName": {
                        "maxLength": 255,
                        "minLength": 1,
                        "type": "string",
                      },
                      "sha256": {
                        "pattern": "^[a-f0-9]{64}$/i",
                        "type": "string",
                      },
                      "sizeBytes": {
                        "exclusiveMinimum": true,
                        "minimum": 0,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "operation",
                      "originalName",
                      "contentType",
                      "sizeBytes",
                      "sha256",
                    ],
                    "type": "object",
                  },
                ],
              },
            },
          },
          "description": "Issue a short-lived owner-checked R2 GET URL or a session-bound PUT URL. PUT objects must be finalized before they become stored documents.",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "properties": {
                        "contentType": {
                          "type": "string",
                        },
                        "expiresAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "expiresInSeconds": {
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "key": {
                          "type": "string",
                        },
                        "operation": {
                          "enum": [
                            "download",
                          ],
                          "type": "string",
                        },
                        "sha256": {
                          "type": "string",
                        },
                        "sizeBytes": {
                          "minimum": 0,
                          "type": "integer",
                        },
                        "url": {
                          "format": "uri",
                          "type": "string",
                        },
                      },
                      "required": [
                        "operation",
                        "key",
                        "url",
                        "expiresAt",
                        "expiresInSeconds",
                        "contentType",
                        "sizeBytes",
                        "sha256",
                      ],
                      "type": "object",
                    },
                    {
                      "properties": {
                        "expiresAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "expiresInSeconds": {
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "headers": {
                          "properties": {
                            "Content-Type": {
                              "type": "string",
                            },
                          },
                          "required": [
                            "Content-Type",
                          ],
                          "type": "object",
                        },
                        "key": {
                          "type": "string",
                        },
                        "operation": {
                          "enum": [
                            "upload",
                          ],
                          "type": "string",
                        },
                        "sha256": {
                          "type": "string",
                        },
                        "sizeBytes": {
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "uploadId": {
                          "format": "uuid",
                          "type": "string",
                        },
                        "url": {
                          "format": "uri",
                          "type": "string",
                        },
                      },
                      "required": [
                        "operation",
                        "uploadId",
                        "key",
                        "url",
                        "expiresAt",
                        "expiresInSeconds",
                        "headers",
                        "sizeBytes",
                        "sha256",
                      ],
                      "type": "object",
                    },
                  ],
                },
              },
            },
            "description": "Short-lived signed R2 download or upload URL",
          },
          "400": {
            "description": "Invalid operation or object key",
          },
          "404": {
            "description": "Object not found or not owned by the caller",
          },
          "503": {
            "description": "R2 signing or metadata is not configured",
          },
        },
      },
    },
    "/v1/storage/reconcile": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "complete": {
                      "type": "boolean",
                    },
                    "locked": {
                      "type": "boolean",
                    },
                    "scanned": {
                      "type": "number",
                    },
                    "timestamp": {
                      "type": "string",
                    },
                    "usedBytes": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "usedBytes",
                    "locked",
                    "scanned",
                    "complete",
                    "timestamp",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Reconciled usage and lock state",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
      },
    },
    "/v1/storage/status": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "approxBytes": {
                      "type": "number",
                    },
                    "bucket": {
                      "enum": [
                        "configured",
                        "absent",
                      ],
                      "type": "string",
                    },
                    "hardLimit": {
                      "type": "number",
                    },
                    "locked": {
                      "type": "boolean",
                    },
                    "softLimit": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "bucket",
                    "approxBytes",
                    "softLimit",
                    "hardLimit",
                    "locked",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Storage quota status for the configured R2 bucket",
          },
        },
      },
    },
    "/v1/storage/usage": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "hardLimit": {
                      "type": "number",
                    },
                    "locked": {
                      "type": "boolean",
                    },
                    "maxObjectSize": {
                      "type": "number",
                    },
                    "softLimit": {
                      "type": "number",
                    },
                    "timestamp": {
                      "type": "string",
                    },
                    "usedBytes": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "usedBytes",
                    "softLimit",
                    "hardLimit",
                    "maxObjectSize",
                    "locked",
                    "timestamp",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Current approximate usage and thresholds",
          },
        },
      },
    },
    "/version": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "commit": {
                      "type": "string",
                    },
                    "controls": {
                      "properties": {
                        "budgetEnforcementEnabled": {
                          "type": "boolean",
                        },
                        "codeModeEnabled": {
                          "type": "boolean",
                        },
                        "connectorEgressEnabled": {
                          "type": "boolean",
                        },
                        "modelEgressEnabled": {
                          "type": "boolean",
                        },
                        "oauthEnabled": {
                          "type": "boolean",
                        },
                      },
                      "required": [
                        "oauthEnabled",
                        "modelEgressEnabled",
                        "budgetEnforcementEnabled",
                        "connectorEgressEnabled",
                        "codeModeEnabled",
                      ],
                      "type": "object",
                    },
                    "environment": {
                      "type": "string",
                    },
                    "mcp": {
                      "properties": {
                        "capabilityPolicyVersion": {
                          "type": "string",
                        },
                        "protocolVersion": {
                          "type": "string",
                        },
                        "serverVersion": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "serverVersion",
                        "protocolVersion",
                        "capabilityPolicyVersion",
                      ],
                      "type": "object",
                    },
                    "service": {
                      "type": "string",
                    },
                    "timestamp": {
                      "type": "string",
                    },
                    "version": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "service",
                    "version",
                    "environment",
                    "commit",
                    "timestamp",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Service version and environment metadata",
          },
        },
      },
    },
  },
  "servers": [
    {
      "url": "https://example.workers.dev",
    },
  ],
  "tags": [
    {
      "description": "Health and monitoring",
      "name": "health",
    },
    {
      "description": "Financial analysis endpoints",
      "name": "analysis",
    },
    {
      "description": "R2 storage guardrails and operations",
      "name": "storage",
    },
  ],
}
`;
