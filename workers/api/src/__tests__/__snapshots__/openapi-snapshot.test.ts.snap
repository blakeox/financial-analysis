                },
                "payment": {
                  "type": "number",
                },
                "principal": {
                  "type": "number",
                },
              },
              "required": [
                "month",
                "payment",
                "principal",
                "interest",
                "balance",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "totalInterest": {
            "type": "number",
          },
          "totalPayments": {
            "type": "number",
          },
        },
        "required": [
          "monthlyPayment",
          "totalPayments",
          "totalInterest",
          "schedule",
        ],
        "type": "object",
      },
      "StorageDeleteResponse": {
        "properties": {
          "deleted": {
            "type": "boolean",
          },
          "key": {
            "type": "string",
          },
        },
        "required": [
          "key",
          "deleted",
        ],
        "type": "object",
      },
      "StorageFinalizeResponse": {
        "properties": {
          "contentType": {
            "type": "string",
          },
          "documentKey": {
            "type": "string",
          },
          "filename": {
            "type": "string",
          },
          "sha256": {
            "type": "string",
          },
          "sizeBytes": {
            "exclusiveMinimum": true,
            "minimum": 0,
            "type": "integer",
          },
          "success": {
            "enum": [
              true,
            ],
            "type": "boolean",
          },
          "uploadId": {
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "success",
          "uploadId",
          "documentKey",
          "filename",
          "contentType",
          "sizeBytes",
          "sha256",
        ],
        "type": "object",
      },
      "StoragePresignResponse": {
        "properties": {
          "contentType": {
            "type": "string",
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
          },
          "expiresInSeconds": {
            "exclusiveMinimum": true,
            "minimum": 0,
            "type": "integer",
          },
          "key": {
            "type": "string",
          },
          "operation": {
            "enum": [
              "download",
            ],
            "type": "string",
          },
          "sha256": {
            "type": "string",
          },
          "sizeBytes": {
            "minimum": 0,
            "type": "integer",
          },
          "url": {
            "format": "uri",
            "type": "string",
          },
        },
        "required": [
          "operation",
          "key",
          "url",
          "expiresAt",
          "expiresInSeconds",
          "contentType",
          "sizeBytes",
          "sha256",
        ],
        "type": "object",
      },
      "StorageStatus": {
        "properties": {
          "approxBytes": {
            "type": "number",
          },
          "bucket": {
            "enum": [
              "configured",
              "absent",
            ],
            "type": "string",
          },
          "hardLimit": {
            "type": "number",
          },
          "locked": {
            "type": "boolean",
          },
          "softLimit": {
            "type": "number",
          },
        },
        "required": [
          "bucket",
          "approxBytes",
          "softLimit",
          "hardLimit",
          "locked",
        ],
        "type": "object",
      },
      "StorageUploadPresignResponse": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string",
          },
          "expiresInSeconds": {
            "exclusiveMinimum": true,
            "minimum": 0,
            "type": "integer",
          },
          "headers": {
            "properties": {
              "Content-Type": {
                "type": "string",
              },
            },
            "required": [
              "Content-Type",
            ],
            "type": "object",
          },
          "key": {
            "type": "string",
          },
          "operation": {
            "enum": [
              "upload",
            ],
            "type": "string",
          },
          "sha256": {
            "type": "string",
          },
          "sizeBytes": {
            "exclusiveMinimum": true,
            "minimum": 0,
            "type": "integer",
          },
          "uploadId": {
            "format": "uuid",
            "type": "string",
          },
          "url": {
            "format": "uri",
            "type": "string",
          },
        },
        "required": [
          "operation",
          "uploadId",
          "key",
          "url",
          "expiresAt",
          "expiresInSeconds",
          "headers",
          "sizeBytes",
          "sha256",
        ],
        "type": "object",
      },
      "StorageUploadResponse": {
        "properties": {
          "etag": {
            "nullable": true,
            "type": "string",
          },
          "key": {
            "type": "string",
          },
          "size": {
            "type": "number",
          },
        },
        "required": [
          "key",
          "etag",
          "size",
        ],
        "type": "object",
      },
      "StorageUsage": {
        "properties": {
          "hardLimit": {
            "type": "number",
          },
          "locked": {
            "type": "boolean",
          },
          "maxObjectSize": {
            "type": "number",
          },
          "softLimit": {
            "type": "number",
          },
          "timestamp": {
            "type": "string",
          },
          "usedBytes": {
            "type": "number",
          },
        },
        "required": [
          "usedBytes",
          "softLimit",
          "hardLimit",
          "maxObjectSize",
          "locked",
          "timestamp",
        ],
        "type": "object",
      },
      "Version": {
        "properties": {
          "commit": {
            "type": "string",
          },
          "controls": {
            "properties": {
              "budgetEnforcementEnabled": {
                "type": "boolean",
              },
              "codeModeEnabled": {
                "type": "boolean",
              },
              "connectorEgressEnabled": {
                "type": "boolean",
              },
              "modelEgressEnabled": {
                "type": "boolean",
              },
              "oauthEnabled": {
                "type": "boolean",
              },
            },
            "required": [
              "oauthEnabled",
              "modelEgressEnabled",
              "budgetEnforcementEnabled",
              "connectorEgressEnabled",
              "codeModeEnabled",
            ],
            "type": "object",
          },
          "environment": {
            "type": "string",
          },
          "mcp": {
            "properties": {
              "capabilityPolicyVersion": {
                "type": "string",
              },
              "protocolVersion": {
                "type": "string",
              },
              "serverVersion": {
                "type": "string",
              },
            },
            "required": [
              "serverVersion",
              "protocolVersion",
              "capabilityPolicyVersion",
            ],
            "type": "object",
          },
          "service": {
            "type": "string",
          },
          "timestamp": {
            "type": "string",
          },
          "version": {
            "type": "string",
          },
        },
        "required": [
          "service",
          "version",
          "environment",
          "commit",
          "timestamp",
        ],
        "type": "object",
      },
    },
  },
  "info": {
    "description": "Cloudflare Workers API for financial analysis with MCP integration",
    "title": "Financial Analysis API",
    "version": "1.0.0",
  },
  "openapi": "3.0.3",
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "environment": {
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "ok",
                      ],
                      "type": "string",
                    },
                    "timestamp": {
                      "type": "string",
                    },
                    "version": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "environment",
                    "version",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "API health status",
          },
        },
      },
    },
    "/ping": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Lightweight uptime check",
          },
        },
      },
    },
    "/v1/admin/knowledge/invalidate": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "delaySeconds": {
                    "maximum": 900,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "paths": {
                    "items": {
                      "type": "string",
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [
                  "paths",
                ],
                "type": "object",
              },
            },
          },
          "description": "Queue a tombstone-first invalidation for source paths and their derived cache/vector artifacts.",
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "backlogCount": {
                      "type": "number",
                    },
                    "operation": {
                      "enum": [
                        "invalidate",
                      ],
                      "type": "string",
                    },
                    "pathCount": {
                      "type": "number",
                    },
                    "queuedAt": {
                      "type": "string",
                    },
                    "source": {
                      "enum": [
                        "manual",
                      ],
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "enqueued",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                    "operation",
                    "backlogCount",
                    "queuedAt",
                    "source",
                    "pathCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Knowledge invalidation job accepted for background processing",
          },
          "400": {
            "description": "Invalid request body",
          },
          "401": {
            "description": "Unauthorized",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
          "503": {
            "description": "Knowledge invalidation queue not configured",
          },
        },
      },
    },
    "/v1/admin/knowledge/reindex": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "delaySeconds": {
                    "maximum": 900,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "paths": {
                    "items": {
                      "type": "string",
                    },
                    "maxItems": 50,
                    "type": "array",
                  },
                  "warmCache": {
                    "type": "boolean",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Queue a knowledge reindex job for AI Search and fallback cache warming.",
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "backlogCount": {
                      "type": "number",
                    },
                    "pathCount": {
                      "type": "number",
                    },
                    "queuedAt": {
                      "type": "string",
                    },
                    "source": {
                      "enum": [
                        "manual",
                      ],
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "enqueued",
                      ],
                      "type": "string",
                    },
                    "warmCache": {
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "status",
                    "backlogCount",
                    "queuedAt",
                    "source",
                    "warmCache",
                    "pathCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Knowledge reindex job accepted for background processing",
          },
          "400": {
            "description": "Invalid request body",
          },
          "401": {
            "description": "Unauthorized",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
          "503": {
            "description": "Knowledge reindex queue not configured",
          },
        },
      },
    },
    "/v1/admin/knowledge/status": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "aiSearch": {
                      "properties": {
                        "available": {
                          "type": "boolean",
                        },
                        "configured": {
                          "type": "boolean",
                        },
                        "error": {
                          "type": "string",
                        },
                        "info": {
                          "nullable": true,
                        },
                        "instanceName": {
                          "nullable": true,
                          "type": "string",
                        },
                        "recentJobs": {
                          "items": {
                            "nullable": true,
                          },
                          "type": "array",
                        },
                        "stats": {
                          "nullable": true,
                        },
                      },
                      "required": [
                        "configured",
                        "instanceName",
                        "available",
                        "recentJobs",
                      ],
                      "type": "object",
                    },
                    "browserRendering": {
                      "properties": {
                        "configured": {
                          "type": "boolean",
                        },
                        "enabled": {
                          "type": "boolean",
                        },
                        "pathPrefixes": {
                          "items": {
                            "type": "string",
                          },
                          "type": "array",
                        },
                      },
                      "required": [
                        "configured",
                        "enabled",
                        "pathPrefixes",
                      ],
                      "type": "object",
                    },
                    "queue": {
                      "properties": {
                        "backlogBytes": {
                          "nullable": true,
                          "type": "number",
                        },
                        "backlogCount": {
                          "nullable": true,
                          "type": "number",
                        },
                        "configured": {
                          "type": "boolean",
                        },
                        "error": {
                          "type": "string",
                        },
                        "oldestMessageTimestamp": {
                          "nullable": true,
                          "type": "string",
                        },
                      },
                      "required": [
                        "configured",
                        "backlogCount",
                        "backlogBytes",
                        "oldestMessageTimestamp",
                      ],
                      "type": "object",
                    },
                    "timestamp": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "queue",
                    "aiSearch",
                    "browserRendering",
                    "timestamp",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Current status of the Cloudflare-backed knowledge pipeline",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
      },
    },
    "/v1/api/analysis": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "lease",
                "amortization",
                "cashflow",
                "ebitda-forecast",
                "auto-loan-analysis",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "environment": {
                      "type": "string",
                    },
                    "message": {
                      "type": "string",
                    },
                    "requestedType": {
                      "enum": [
                        "lease",
                        "amortization",
                        "cashflow",
                        "ebitda-forecast",
                        "auto-loan-analysis",
                      ],
                      "type": "string",
                    },
                    "version": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "message",
                    "version",
                    "environment",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Analysis API base route",
          },
        },
      },
    },
    "/v1/api/analysis/amortization": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "annualRate": {
                    "type": "number",
                  },
                  "principal": {
                    "type": "number",
                  },
                  "termMonths": {
                    "type": "number",
                  },
                },
                "required": [
                  "principal",
                  "annualRate",
                  "termMonths",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "monthlyPayment": {
                      "type": "number",
                    },
                    "schedule": {
                      "items": {
                        "properties": {
                          "balance": {
                            "type": "number",
                          },
                          "interest": {
                            "type": "number",
                          },
                          "month": {
                            "type": "number",
                          },
                          "payment": {
                            "type": "number",
                          },
                          "principal": {
                            "type": "number",
                          },
                        },
                        "required": [
                          "month",
                          "payment",
                          "principal",
                          "interest",
                          "balance",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "totalInterest": {
                      "type": "number",
                    },
                    "totalPayments": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "monthlyPayment",
                    "totalPayments",
                    "totalInterest",
                    "schedule",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Amortization analysis result",
          },
          "400": {
            "description": "Invalid request body",
          },
          "415": {
            "description": "Unsupported Media Type",
          },
        },
      },
    },
    "/v1/api/analysis/auto-loan-analysis": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "analysis": {
                    "properties": {
                      "includeLeaseComparison": {
                        "default": true,
                        "type": "boolean",
                      },
                      "includePaymentSchedule": {
                        "default": true,
                        "type": "boolean",
                      },
                      "includeRefinancingAnalysis": {
                        "default": true,
                        "type": "boolean",
                      },
                      "includeTCOAnalysis": {
                        "default": true,
                        "type": "boolean",
                      },
                      "ownershipYears": {
                        "default": 5,
                        "maximum": 10,
                        "minimum": 1,
                        "type": "number",
                      },
                      "refinancingRates": {
                        "default": [
                          0.03,
                          0.04,
                          0.05,
                          0.06,
                        ],
                        "items": {
                          "type": "number",
                        },
                        "type": "array",
                      },
                    },
                    "type": "object",
                  },
                  "leaseTerms": {
                    "properties": {
                      "acquisitionFee": {
                        "default": 1000,
                        "minimum": 0,
                        "type": "number",
                      },
                      "dispositionFee": {
                        "default": 400,
                        "minimum": 0,
                        "type": "number",
                      },
                      "leaseAmount": {
                        "minimum": 0,
                        "type": "number",
                      },
                      "moneyFactor": {
                        "maximum": 0.01,
                        "minimum": 0,
                        "type": "number",
                      },
                      "residualValue": {
                        "minimum": 0,
                        "type": "number",
                      },
                      "securityDeposit": {
                        "default": 0,
                        "minimum": 0,
                        "type": "number",
                      },
                      "termMonths": {
                        "maximum": 48,
                        "minimum": 24,
                        "type": "number",
                      },
                    },
                    "required": [
                      "leaseAmount",
                      "moneyFactor",
                      "termMonths",
                      "residualValue",
                    ],
                    "type": "object",
                  },
                  "loanTerms": {
                    "properties": {
                      "fees": {
                        "properties": {
                          "documentationFee": {
                            "default": 500,
                            "minimum": 0,
                            "type": "number",
                          },
                          "otherFees": {
                            "default": 0,
                            "minimum": 0,
                            "type": "number",
                          },
                          "registrationFee": {
                            "default": 200,
                            "minimum": 0,
                            "type": "number",
                          },
                          "titleFee": {
                            "default": 100,
                            "minimum": 0,
                            "type": "number",
                          },
                        },
                        "type": "object",
                      },
                      "interestRate": {
                        "maximum": 0.5,
                        "minimum": 0,
                        "type": "number",
                      },
                      "loanAmount": {
                        "minimum": 0,
                        "type": "number",
                      },
                      "salesTaxRate": {
                        "default": 0.08,
                        "maximum": 0.2,
                        "minimum": 0,
                        "type": "number",
                      },
                      "termMonths": {
                        "maximum": 84,
                        "minimum": 12,
                        "type": "number",
                      },
                    },
                    "required": [
                      "loanAmount",
                      "interestRate",
                      "termMonths",
                      "fees",
                    ],
                    "type": "object",
                  },
                  "tcoParameters": {
                    "properties": {
                      "annualMileage": {
                        "default": 12000,
                        "minimum": 0,
                        "type": "number",
                      },
                      "depreciationRate": {
                        "default": 0.15,
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number",
                      },
                      "fuelCostPerGallon": {
                        "default": 3.5,
                        "minimum": 0,
                        "type": "number",
                      },
                      "insuranceCostPerYear": {
                        "default": 1200,
                        "minimum": 0,
                        "type": "number",
                      },
                      "maintenanceCostPerYear": {
                        "default": 1000,
                        "minimum": 0,
                        "type": "number",
                      },
                      "mpg": {
                        "default": 25,
                        "minimum": 0,
                        "type": "number",
                      },
                      "registrationCostPerYear": {
                        "default": 100,
                        "minimum": 0,
                        "type": "number",
                      },
                    },
                    "type": "object",
                  },
                  "vehicle": {
                    "properties": {
                      "downPayment": {
                        "default": 0,
                        "minimum": 0,
                        "type": "number",
                      },
                      "make": {
                        "type": "string",
                      },
                      "model": {
                        "type": "string",
                      },
                      "msrp": {
                        "minimum": 0,
                        "type": "number",
                      },
                      "negotiatedPrice": {
                        "minimum": 0,
                        "type": "number",
                      },
                      "tradeInValue": {
                        "default": 0,
                        "minimum": 0,
                        "type": "number",
                      },
                      "year": {
                        "maximum": 2028,
                        "minimum": 1990,
                        "type": "number",
                      },
                    },
                    "required": [
                      "make",
                      "model",
                      "year",
                      "msrp",
                      "negotiatedPrice",
                    ],
                    "type": "object",
                  },
                },
                "required": [
                  "vehicle",
                  "loanTerms",
                  "analysis",
                  "tcoParameters",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "comparison": {
                      "properties": {
                        "loanVsLease": {
                          "properties": {
                            "breakEvenPoint": {
                              "type": "number",
                            },
                            "monthlyPaymentDifference": {
                              "type": "number",
                            },
                            "reasoning": {
                              "items": {
                                "type": "string",
                              },
                              "type": "array",
                            },
                            "recommendation": {
                              "enum": [
                                "loan",
                                "lease",
                                "depends",
                              ],
                              "type": "string",
                            },
                            "totalCostDifference": {
                              "type": "number",
                            },
                          },
                          "required": [
                            "monthlyPaymentDifference",
                            "totalCostDifference",
                            "breakEvenPoint",
                            "recommendation",
                            "reasoning",
                          ],
                          "type": "object",
                        },
                      },
                      "required": [
                        "loanVsLease",
                      ],
                      "type": "object",
                    },
                    "insights": {
