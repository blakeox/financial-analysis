{
  "name": "@financial-analysis/web-worker",
  "version": "0.1.1",
  "description": "Standalone Cloudflare Worker serving the Astro web app static assets",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env=development --port 8788 --local",
    "dev:remote": "wrangler dev --env=development",
    "deploy": "wrangler deploy --env=production",
    "deploy:preview": "wrangler deploy --env=preview",
    "deploy:production": "wrangler deploy --env=production",
    "prebuild": "pnpm -C ../../apps/web run build",
    "build": "wrangler deploy --dry-run --env=production",
    "test": "vitest run --config ./vitest.config.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.9",
    "wrangler": "^4.105.0"
  }
}
