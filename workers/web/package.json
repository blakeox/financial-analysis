{
  "name": "@financial-analysis/web-worker",
  "version": "0.1.1",
  "description": "Standalone Cloudflare Worker serving the Astro web app static assets",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8788 --local",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env=preview",
    "deploy:production": "wrangler deploy --env=production",
    "prebuild": "pnpm -C ../../apps/web run build",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run --config ./vitest.config.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250917.0",
    "@types/node": "^20.0.0",
    "globals": "^15.11.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.38.0",
    "vitest": "3.2.4",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "prettier": "^3.0.0"
  }
}
