{
  "name": "@financial-analysis/web-worker",
  "version": "0.1.1",
  "description": "Standalone Cloudflare Worker serving the Astro web app static assets",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8788 --local --var ENVIRONMENT:development",
    "dev:remote": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env=preview",
    "deploy:production": "wrangler deploy",
    "prebuild": "pnpm -C ../../apps/web run build",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run --config ./vitest.config.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251125.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "4.0.9",
    "wrangler": "^4.50.0"
  }
}
