{
  "name": "@financial-analysis/agent-worker",
  "version": "0.1.0",
  "description": "First-party Agent, workspace state, and memory boundary (scaffold; no production traffic)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env=development --port 8792 --local",
    "build": "tsc --noEmit",
    "types:generate": "wrangler types worker-configuration.d.ts --config wrangler.toml --include-runtime=false",
    "types:check": "wrangler types worker-configuration.d.ts --config wrangler.toml --include-runtime=false --check",
    "deploy:preview": "echo 'Scaffold only: production traffic not enabled' && exit 1",
    "test": "vitest run --config ./vitest.config.mjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.9",
    "wrangler": "^4.105.0"
  }
}
